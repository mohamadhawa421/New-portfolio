# Copy to .env and replace every CHANGE_ME with a fresh random value.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"

HOST=0.0.0.0
PORT=1337

# Comma-separated list of at least two keys
APP_KEYS=CHANGE_ME_KEY_ONE,CHANGE_ME_KEY_TWO
API_TOKEN_SALT=CHANGE_ME
ADMIN_JWT_SECRET=CHANGE_ME
TRANSFER_TOKEN_SALT=CHANGE_ME
JWT_SECRET=CHANGE_ME
ENCRYPTION_KEY=CHANGE_ME

# Database — sqlite is the zero-setup default for local development.
# For production set DATABASE_CLIENT=postgres and fill in the connection details.
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=data/portfolio.db

# DATABASE_CLIENT=postgres
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=5432
# DATABASE_NAME=mohamad_hawa
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=
# DATABASE_SSL=false

# Origins allowed to call this API from a browser
CORS_ORIGINS=http://localhost:4321,http://127.0.0.1:4321

# Used by scripts/seed.js
STRAPI_URL=http://localhost:1337
SEED_API_TOKEN=
