---
import '../styles/tokens.css';
import '../styles/global.css';

import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import IntroCurtain from '../components/IntroCurtain.astro';
import Cursor from '../components/Cursor.astro';
import { ClientRouter } from 'astro:transitions';
import { getSiteSettings } from '../lib/content';
import type { Seo } from '../lib/types';

interface Props {
  seo?: Seo;
  /** Falls back to the site SEO defaults when a page has none of its own. */
  title?: string;
  description?: string;
}

const { seo, title, description } = Astro.props;

const settings = await getSiteSettings();

const pageTitle =
  title ?? seo?.metaTitle ?? settings.seo.metaTitle ?? `${settings.siteName} — ${settings.roleTitle}`;
const pageDescription =
  description ?? seo?.metaDescription ?? settings.seo.metaDescription ?? '';
// A page's own image, then the CMS default, then the generated card. The
// portrait is deliberately not used: cropped to 1.91:1 it becomes a chin.
const shareImage = seo?.shareImage ?? settings.seo.shareImage ?? null;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const shareImageUrl = new URL(shareImage?.url ?? '/og.png', canonical).href;
const faviconHref = settings.logoMark?.url ?? '/favicon.svg';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical.href} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={shareImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={settings.siteName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={shareImageUrl} />

    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <link rel="apple-touch-icon" href={faviconHref} />

    {/* No web font is loaded on purpose. The stack in tokens.css starts with
        system-ui / -apple-system, which resolves on every platform — SF Pro on
        Apple, Segoe UI on Windows, Roboto on Android — so the Inter fallback
        that used to be fetched from Google Fonts was never actually reached.
        That request was render-blocking third-party CSS: ~275ms of blank page
        on a warm connection and considerably worse on a cold one, which is the
        flash of nothing-then-everything on first load. */}

    {/* Swaps pages in place instead of a full reload, so the nav and styles are
        never re-fetched and navigation keeps its momentum. Every script below
        re-initialises on `astro:page-load` because of it.

        fallback="none": browsers without native view transitions fall back to
        an ordinary navigation rather than Astro's hand-rolled swap, which
        rebuilds the document in JS and can show a frame of unstyled content. */}
    {/* Runs before anything paints. Reading the stored choice here — rather
        than from the deferred module — is what stops a dark-mode visitor
        seeing a white page for a frame on every load. */}
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('mh-theme');
          if (saved === 'dark' || saved === 'light') {
            document.documentElement.dataset.theme = saved;
          }
        } catch (e) {
          /* private mode — fall through to the system preference */
        }
      })();
    </script>

    <ClientRouter fallback="none" />

  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    {settings.showIntro && <IntroCurtain logo={settings.logoFull} />}

    <a
      class="site-logo"
      data-logo="1"
      transition:persist="site-logo"
      href="/"
      aria-label={`${settings.siteName} — home`}
    >
      {
        settings.logoMark && (
          <img src={settings.logoMark.url} alt={settings.siteName} width="34" height="34" />
        )
      }
    </a>

    <SiteNav pathname={Astro.url.pathname} settings={settings} />

    <slot />

    <SiteFooter settings={settings} />

    <Cursor transition:persist="site-cursor" />

    {/* Runs while the parser is still in <body>, so it executes before the
        first paint but after the layout above it exists. It marks only the
        elements that are genuinely below the fold, which means content in the
        first screen is never hidden and there is nothing to flash. */}
    <script is:inline>
      (function () {
        var vh = window.innerHeight || 800;
        var nodes = document.querySelectorAll('[data-reveal],[data-rise],[data-num]');
        for (var i = 0; i < nodes.length; i++) {
          var el = nodes[i];
          var trigger = el.hasAttribute('data-rise') && el.parentElement ? el.parentElement : el;
          if (trigger.getBoundingClientRect().top >= vh * 0.94) {
            el.setAttribute('data-hidden', '');
          }
        }
      })();
    </script>

    <script>
      import '../scripts/chrome.ts';
      import '../scripts/theme.ts';
    </script>

    <style>
      .skip-link {
        position: fixed;
        left: -9999px;
        top: 12px;
        z-index: 500;
        background: var(--blue);
        color: #fff;
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        padding: 0 18px;
        border-radius: var(--r-pill);
        font-size: 14px;
      }

      .skip-link:focus-visible {
        left: 12px;
      }

      .site-logo {
        position: fixed;
        top: 18px;
        left: clamp(20px, 4vw, 56px);
        z-index: 201;
        display: flex;
        align-items: center;
        min-height: 44px;
        opacity: var(--logo-op, 1);
        transform: translateY(var(--logo-y, 0px));
        pointer-events: var(--logo-pe, auto);
        transition:
          opacity 480ms var(--ease-out),
          transform 520ms var(--ease-out);
      }

      .site-logo img {
        height: 34px;
        width: auto;
        display: block;
      }

      /* On desktop the logo fades out as the nav pill condenses. On phones the
         logo and the burger together are the header, so it has to stay. */
      @media (max-width: 767px) {
        .site-logo {
          opacity: 1;
          transform: none;
          pointer-events: auto;
        }
      }
    </style>
  </body>
</html>
