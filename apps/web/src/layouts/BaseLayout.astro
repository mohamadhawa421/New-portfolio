---
import '../styles/tokens.css';
import '../styles/global.css';

import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import IntroCurtain from '../components/IntroCurtain.astro';
import SiteLogo from '../components/SiteLogo.astro';
import GridOverlay from '../components/GridOverlay.astro';
import Cursor from '../components/Cursor.astro';
import { ClientRouter } from 'astro:transitions';
import { getSiteSettings } from '../lib/content';
import type { Seo } from '../lib/types';

interface Props {
  seo?: Seo;
  /** Falls back to the site SEO defaults when a page has none of its own. */
  title?: string;
  description?: string;
}

const { seo, title, description } = Astro.props;

const settings = await getSiteSettings();

const pageTitle =
  title ?? seo?.metaTitle ?? settings.seo.metaTitle ?? `${settings.siteName} — ${settings.roleTitle}`;
const pageDescription =
  description ?? seo?.metaDescription ?? settings.seo.metaDescription ?? '';
// A page's own image, then the CMS default, then the generated card. The
// portrait is deliberately not used: cropped to 1.91:1 it becomes a chin.
const shareImage = seo?.shareImage ?? settings.seo.shareImage ?? null;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const shareImageUrl = new URL(shareImage?.url ?? '/og.png', canonical).href;
const faviconHref = settings.logoMark?.url ?? '/favicon.svg';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical.href} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={shareImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={settings.siteName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={shareImageUrl} />

    {/* Safari and Chrome tint their own chrome from this, which is what stops
        the page ending on a band of browser-default black above the address
        bar on a phone. Two of them so the system preference is right before a
        single line of script has run; theme.ts rewrites both the moment the
        visitor takes the switch off the system. The values are --surface in
        each palette. */}
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0b0d" media="(prefers-color-scheme: dark)" />

    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <link rel="apple-touch-icon" href={faviconHref} />

    {/* No web font is loaded on purpose. The stack in tokens.css starts with
        system-ui / -apple-system, which resolves on every platform — SF Pro on
        Apple, Segoe UI on Windows, Roboto on Android — so the Inter fallback
        that used to be fetched from Google Fonts was never actually reached.
        That request was render-blocking third-party CSS: ~275ms of blank page
        on a warm connection and considerably worse on a cold one, which is the
        flash of nothing-then-everything on first load. */}

    {/* Swaps pages in place instead of a full reload, so the nav and styles are
        never re-fetched and navigation keeps its momentum. Every script below
        re-initialises on `astro:page-load` because of it.

        fallback="none": browsers without native view transitions fall back to
        an ordinary navigation rather than Astro's hand-rolled swap, which
        rebuilds the document in JS and can show a frame of unstyled content. */}
    {/* Runs before anything paints. Reading the stored choice here — rather
        than from the deferred module — is what stops a dark-mode visitor
        seeing a white page for a frame on every load. */}
    <script is:inline>
      (function () {
        try {
          // Session-scoped: a new visit starts from the system preference.
          var saved = sessionStorage.getItem('mh-theme');
          if (saved === 'dark' || saved === 'light') {
            document.documentElement.dataset.theme = saved;
          }
        } catch (e) {
          /* private mode — fall through to the system preference */
        }

        /*
         * The mark draws itself on arrival, but only when it will be on screen
         * to be seen. The nav hides the logo as soon as the page is scrolled,
         * so drawing it while returning to a restored position meant it
         * animated and then vanished.
         *
         * This script re-runs on every client-side navigation, which is why
         * the check lives here as well as in chrome.ts: setting the flag
         * unconditionally here would undo that decision moments after it was
         * made. The offset is read from history because the scroll has not
         * been restored yet at this point.
         */
        var restoringTo = (history.state && history.state.scrollY) || 0;
        if (restoringTo <= 90) {
          document.documentElement.dataset.logoDraw = '1';
        } else {
          delete document.documentElement.dataset.logoDraw;
        }
      })();
    </script>

    <ClientRouter fallback="none" />

  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    {settings.showIntro && <IntroCurtain logo={settings.logoFull} />}

    <a
      class="site-logo"
      data-logo="1"
      transition:persist="site-logo"
      href="/"
      aria-label={`${settings.siteName} — home`}
    >
      {settings.logoMark && <SiteLogo src={settings.logoMark.url} alt={settings.siteName} />}
    </a>

    <SiteNav pathname={Astro.url.pathname} settings={settings} />

    <slot />

    <SiteFooter settings={settings} />

    {/* Both persist themselves, on their own root elements. A
        transition:persist here — on the component tag — is accepted and then
        silently dropped, which is how they came to be replaced on every
        navigation. */}
    <Cursor />
    <GridOverlay />

    {/* Runs while the parser is still in <body>, so it executes before the
        first paint but after the layout above it exists. It marks only the
        elements that are genuinely below the fold, which means content in the
        first screen is never hidden and there is nothing to flash. */}
    <!--
      Sets the start state for the entrance animations, and plays the entrance
      for whatever is already on screen.

      This is inline and blocking on purpose. It has to run before the first
      paint: an element that is painted visible and only hidden afterwards
      flashes, which is exactly the bug this replaced. And the reveal has to be
      here too rather than in the deferred module — waiting for that module
      leaves the heading blank for a beat on arrival.

      It does run again on a client-side navigation, which this used to say it
      did not. The router re-executes the scripts it swapped in, and it does so
      from `updateCallbackDone.finally` — after the update callback, and so
      after the new page has been painted. primePage() in chrome.ts has by then
      already primed that page from astro:after-swap, which is inside the
      callback and before the paint.

      Priming a second time is what made the featured project flicker on the
      way back to the home page and not on a reload: the first pass hid it and
      revealed it, the paint landed, and this pass hid everything again and
      revealed it a second time. Below the fold it simply went out and stayed
      out until the observer caught it on scroll. Hence the guard in the loop —
      anything already spoken for is left alone, so on a swap this finds nothing
      to do and primePage owns the arrival.

      Keep the two in step — the stagger numbers below match the ones there.
    -->
    <script is:inline>
      (function () {
        var vh = window.innerHeight || 800;
        /* Matches REVEAL_AT in chrome.ts: a touch screen scrolls too fast for
           an entrance that only starts once the element is well inside the
           viewport, so there the trigger sits at the edge. */
        var revealAt = matchMedia('(pointer: coarse)').matches ? 0.995 : 0.94;
        var nodes = document.querySelectorAll('[data-reveal],[data-rise],[data-num]');
        var above = [];

        /*
         * Two arrivals leave the page exactly as they found it, and only two.
         * A cover morphing back into its card is already one animation, and
         * replaying every card's fade underneath it is a second one over the
         * same content. And an arrival that restores a scroll position lands
         * mid-page, where an entrance would animate what is already being
         * looked at.
         *
         * Everything else plays it — a reload included. Mirrors
         * arrivingQuietly() in chrome.ts; `__mhMorph` is set there, at the
         * start of the navigation that led here.
         */
        var restoringTo = (history.state && history.state.scrollY) || 0;
        if (window.__mhMorph || restoringTo > 0) return;

        for (var i = 0; i < nodes.length; i++) {
          var el = nodes[i];

          // Already primed — by primePage() on a swap, or by an earlier run of
          // this script. Setting the hidden state again would take back a
          // reveal that has already been paid for and played.
          if (el.dataset.shown || el.hasAttribute('data-hidden')) continue;

          var trigger = el.hasAttribute('data-rise') && el.parentElement ? el.parentElement : el;
          var onScreen = trigger.getBoundingClientRect().top < vh * revealAt;

          // A counting figure on screen is left alone: hiding it would show a
          // blank where a number belongs, and it has no entrance to gain.
          if (onScreen && el.hasAttribute('data-num')) continue;

          el.setAttribute('data-hidden', '');
          if (onScreen) {
            el.dataset.shown = '1';
            above.push(el);
          }
        }

        if (!above.length) return;

        function reveal(el, extra) {
          if (!el.hasAttribute('data-num')) {
            var isRise = el.hasAttribute('data-rise');
            var index = parseInt(el.getAttribute(isRise ? 'data-rise' : 'data-reveal') || '0', 10);
            var delay = index * (isRise ? 90 : 70) + (extra || 0);
            if (delay) {
              el.style.transitionDelay = delay + 'ms';
              // Left in place it would also delay this element's hover.
              setTimeout(function () {
                el.style.removeProperty('transition-delay');
                if (!el.getAttribute('style')) el.removeAttribute('style');
              }, delay + 760);
            }
          }
          el.removeAttribute('data-hidden');
        }

        /*
         * Cascades whatever asked for it. Mirrors revealGroup in chrome.ts —
         * keep STAGGER_MS and CASCADE_MS there in step with the 85 and 420
         * below.
         *
         * The step divides to fit the budget once there are enough items to
         * overrun it, so a cascade takes about the same time however long it
         * is. A fixed 85ms apiece is right for a row of three and wrong for a
         * grid of twelve, where the last one waited most of a second before it
         * began.
         */
        function revealGroup(els) {
          var queued = 0;
          for (var q = 0; q < els.length; q++) {
            if (els[q].hasAttribute('data-stagger')) queued++;
          }
          var gap = queued > 1 ? Math.min(85, 420 / (queued - 1)) : 0;

          var step = 0;
          for (var n = 0; n < els.length; n++) {
            var el = els[n];
            reveal(el, el.hasAttribute('data-stagger') ? step++ * gap : 0);
          }
        }

        if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
          revealGroup(above);
          return;
        }

        var done = false;
        function run() {
          if (done) return;
          done = true;
          revealGroup(above);
        }

        // Two frames: the hidden state has to be painted once or there is no
        // value to transition from and everything just pops in.
        requestAnimationFrame(function () {
          requestAnimationFrame(run);
        });

        /*
         * Safety net. requestAnimationFrame does not merely slow down in a
         * backgrounded tab, it stops entirely — so a page opened in a tab the
         * visitor has not switched to yet would paint its heading hidden and
         * leave it that way. Timers are throttled there but still fire, so this
         * guarantees the content appears whether or not the entrance ever runs.
         */
        setTimeout(run, 500);
      })();
    </script>

    <script>
      import '../scripts/chrome.ts';
      import '../scripts/theme.ts';
    </script>

    <style>
      .skip-link {
        position: fixed;
        left: -9999px;
        top: 12px;
        z-index: 500;
        background: var(--blue-fill);
        color: #fff;
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        padding: 0 18px;
        border-radius: var(--r-pill);
        font-size: 14px;
      }

      .skip-link:focus-visible {
        left: 12px;
      }

      /*
       * The nav's offset uses `translate`, not `transform`, so that designer
       * mode can throw the logo.
       *
       * The logo is a piece like every other piece, but it is the only one that
       * was already driving its own transform — and this rule is scoped, so it
       * outranks .dm-piece and won. The shock reached the logo and nothing
       * happened; it then arrived late on its own 520ms easing, a beat behind
       * everything around it, which read as falling behind and snapping into
       * place rather than being blown away.
       *
       * `translate` is an independent property and composes with `transform`
       * instead of replacing it, so the nav can keep lifting the logo by ten
       * pixels while the storm has it.
       */
      .site-logo {
        position: fixed;
        top: 18px;
        left: clamp(20px, 4vw, 56px);
        z-index: 201;
        display: flex;
        align-items: center;
        min-height: 44px;
        opacity: var(--logo-op, 1);
        translate: 0 var(--logo-y, 0px);
        pointer-events: var(--logo-pe, auto);
        color: var(--nav-ink, #1d1d1f);
        transition:
          opacity 480ms var(--ease-out),
          translate 520ms var(--ease-out),
          color 300ms var(--ease-out);
      }

      .site-logo img {
        height: 34px;
        width: auto;
        display: block;
      }

      /* On desktop the logo fades out as the nav pill condenses. On phones the
         logo and the burger together are the header, so it has to stay. */
      @media (max-width: 767px) {
        .site-logo {
          opacity: 1;
          translate: none;
          pointer-events: auto;
        }
      }
    </style>
  </body>
</html>
