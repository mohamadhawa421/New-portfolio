---
import '../styles/tokens.css';
import '../styles/global.css';

import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import IntroCurtain from '../components/IntroCurtain.astro';
import SiteLogo from '../components/SiteLogo.astro';
import GridOverlay from '../components/GridOverlay.astro';
import Cursor from '../components/Cursor.astro';
import { ClientRouter } from 'astro:transitions';
import { getSiteSettings } from '../lib/content';
import type { Seo } from '../lib/types';

interface Props {
  seo?: Seo;
  /** Falls back to the site SEO defaults when a page has none of its own. */
  title?: string;
  description?: string;
}

const { seo, title, description } = Astro.props;

const settings = await getSiteSettings();

const pageTitle =
  title ?? seo?.metaTitle ?? settings.seo.metaTitle ?? `${settings.siteName} — ${settings.roleTitle}`;
const pageDescription =
  description ?? seo?.metaDescription ?? settings.seo.metaDescription ?? '';
// A page's own image, then the CMS default, then the generated card. The
// portrait is deliberately not used: cropped to 1.91:1 it becomes a chin.
const shareImage = seo?.shareImage ?? settings.seo.shareImage ?? null;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const shareImageUrl = new URL(shareImage?.url ?? '/og.png', canonical).href;
const faviconHref = settings.logoMark?.url ?? '/favicon.svg';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical.href} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={shareImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={settings.siteName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={shareImageUrl} />

    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <link rel="apple-touch-icon" href={faviconHref} />

    {/* No web font is loaded on purpose. The stack in tokens.css starts with
        system-ui / -apple-system, which resolves on every platform — SF Pro on
        Apple, Segoe UI on Windows, Roboto on Android — so the Inter fallback
        that used to be fetched from Google Fonts was never actually reached.
        That request was render-blocking third-party CSS: ~275ms of blank page
        on a warm connection and considerably worse on a cold one, which is the
        flash of nothing-then-everything on first load. */}

    {/* Swaps pages in place instead of a full reload, so the nav and styles are
        never re-fetched and navigation keeps its momentum. Every script below
        re-initialises on `astro:page-load` because of it.

        fallback="none": browsers without native view transitions fall back to
        an ordinary navigation rather than Astro's hand-rolled swap, which
        rebuilds the document in JS and can show a frame of unstyled content. */}
    {/* Runs before anything paints. Reading the stored choice here — rather
        than from the deferred module — is what stops a dark-mode visitor
        seeing a white page for a frame on every load. */}
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('mh-theme');
          if (saved === 'dark' || saved === 'light') {
            document.documentElement.dataset.theme = saved;
          }
        } catch (e) {
          /* private mode — fall through to the system preference */
        }

        /*
         * The mark draws itself on arrival at every page. Set here, before the
         * first paint, so it is never briefly solid and then restarted as a
         * line. Client-side navigations are handled in chrome.ts, which has to
         * replay it by hand — the logo is a persisted element, so it does not
         * get re-created and its animation would otherwise only ever run once.
         */
        document.documentElement.dataset.logoDraw = '1';
      })();
    </script>

    <ClientRouter fallback="none" />

  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    {settings.showIntro && <IntroCurtain logo={settings.logoFull} />}

    <a
      class="site-logo"
      data-logo="1"
      transition:persist="site-logo"
      href="/"
      aria-label={`${settings.siteName} — home`}
    >
      {settings.logoMark && <SiteLogo src={settings.logoMark.url} alt={settings.siteName} />}
    </a>

    <SiteNav pathname={Astro.url.pathname} settings={settings} />

    <slot />

    <SiteFooter settings={settings} />

    <Cursor transition:persist="site-cursor" />
    <GridOverlay transition:persist="grid-egg" />

    {/* Runs while the parser is still in <body>, so it executes before the
        first paint but after the layout above it exists. It marks only the
        elements that are genuinely below the fold, which means content in the
        first screen is never hidden and there is nothing to flash. */}
    <!--
      Sets the start state for the entrance animations, and plays the entrance
      for whatever is already on screen.

      This is inline and blocking on purpose. It has to run before the first
      paint: an element that is painted visible and only hidden afterwards
      flashes, which is exactly the bug this replaced. And the reveal has to be
      here too rather than in the deferred module — waiting for that module
      leaves the heading blank for a beat on arrival.

      Client-side navigations do not re-run this; primePage() in chrome.ts
      mirrors it on astro:after-swap. Keep the two in step — the stagger
      numbers below match the ones there.
    -->
    <script is:inline>
      (function () {
        var vh = window.innerHeight || 800;
        var nodes = document.querySelectorAll('[data-reveal],[data-rise],[data-num]');
        var above = [];

        /*
         * The client router re-runs this script on every navigation, so this is
         * the first thing that touches the incoming page — before chrome.ts
         * gets a look at it. The flag lives on window because the router
         * replaces the <html> element's attributes during a swap.
         */
        var isSwap = !!window.__mhPrimed;
        window.__mhPrimed = 1;

        /*
         * A page plays its entrance once per session, not once per visit.
         * Coming back from a case study used to replay every row's fade while
         * the cover was still morphing back into its card — two animations of
         * the same content at the same time. Leaving the page as it was found
         * is both calmer and closer to what actually happened: the visitor
         * never left it.
         */
        var seenKey = 'mh-seen:' + location.pathname;
        var seenBefore = false;
        try {
          seenBefore = sessionStorage.getItem(seenKey) === '1';
          sessionStorage.setItem(seenKey, '1');
        } catch (e) {
          /* private mode — every visit animates, which is the old behaviour */
        }
        if (seenBefore) return;

        for (var i = 0; i < nodes.length; i++) {
          var el = nodes[i];

          /*
           * A project cover and the case study's cover share a
           * view-transition-name, so the browser morphs one into the other
           * across a navigation. Hiding the destination means the snapshot
           * flies to it and then disappears, leaving a gap until the visitor
           * scrolls far enough to trigger the reveal. Claim it instead, so
           * nothing hides it later either.
           */
          if (isSwap && (el.matches('[data-morph]') || el.querySelector('[data-morph]'))) {
            el.dataset.shown = '1';
            continue;
          }

          var trigger = el.hasAttribute('data-rise') && el.parentElement ? el.parentElement : el;
          var onScreen = trigger.getBoundingClientRect().top < vh * 0.94;

          // A counting figure on screen is left alone: hiding it would show a
          // blank where a number belongs, and it has no entrance to gain.
          if (onScreen && el.hasAttribute('data-num')) continue;

          el.setAttribute('data-hidden', '');
          if (onScreen) {
            el.dataset.shown = '1';
            above.push(el);
          }
        }

        if (!above.length) return;

        function reveal(el) {
          if (!el.hasAttribute('data-num')) {
            var isRise = el.hasAttribute('data-rise');
            var index = parseInt(el.getAttribute(isRise ? 'data-rise' : 'data-reveal') || '0', 10);
            var delay = index * (isRise ? 90 : 70);
            if (delay) {
              el.style.transitionDelay = delay + 'ms';
              // Left in place it would also delay this element's hover.
              setTimeout(function () {
                el.style.transitionDelay = '';
              }, delay + 940);
            }
          }
          el.removeAttribute('data-hidden');
        }

        if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
          above.forEach(reveal);
          return;
        }

        var done = false;
        function run() {
          if (done) return;
          done = true;
          above.forEach(reveal);
        }

        // Two frames: the hidden state has to be painted once or there is no
        // value to transition from and everything just pops in.
        requestAnimationFrame(function () {
          requestAnimationFrame(run);
        });

        /*
         * Safety net. requestAnimationFrame does not merely slow down in a
         * backgrounded tab, it stops entirely — so a page opened in a tab the
         * visitor has not switched to yet would paint its heading hidden and
         * leave it that way. Timers are throttled there but still fire, so this
         * guarantees the content appears whether or not the entrance ever runs.
         */
        setTimeout(run, 500);
      })();
    </script>

    <script>
      import '../scripts/chrome.ts';
      import '../scripts/theme.ts';
    </script>

    <style>
      .skip-link {
        position: fixed;
        left: -9999px;
        top: 12px;
        z-index: 500;
        background: var(--blue);
        color: #fff;
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        padding: 0 18px;
        border-radius: var(--r-pill);
        font-size: 14px;
      }

      .skip-link:focus-visible {
        left: 12px;
      }

      .site-logo {
        position: fixed;
        top: 18px;
        left: clamp(20px, 4vw, 56px);
        z-index: 201;
        display: flex;
        align-items: center;
        min-height: 44px;
        opacity: var(--logo-op, 1);
        transform: translateY(var(--logo-y, 0px));
        pointer-events: var(--logo-pe, auto);
        transition:
          opacity 480ms var(--ease-out),
          transform 520ms var(--ease-out);
      }

      .site-logo {
        color: var(--nav-ink, #1d1d1f);
        transition:
          opacity 480ms var(--ease-out),
          transform 520ms var(--ease-out),
          color 300ms var(--ease-out);
      }

      .site-logo img {
        height: 34px;
        width: auto;
        display: block;
      }

      /* On desktop the logo fades out as the nav pill condenses. On phones the
         logo and the burger together are the header, so it has to stay. */
      @media (max-width: 767px) {
        .site-logo {
          opacity: 1;
          transform: none;
          pointer-events: auto;
        }
      }
    </style>
  </body>
</html>
