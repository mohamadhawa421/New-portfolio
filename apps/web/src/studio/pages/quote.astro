---
/**
 * Quote builder.
 *
 * Behind the same door as the editor — the middleware checks every /studio
 * path — and like it, desktop only. Everything after this frontmatter runs in
 * the browser: the quote is never sent anywhere, and the PDF is drawn on the
 * page (see ../quote/pdf.ts).
 *
 * The server's only job is the defaults: who is quoting, and the five
 * process steps the site already promises, which become the timeline.
 */
import '../../styles/tokens.css';
import { getProcessSteps, getSiteSettings } from '../../lib/content';
import type { Defaults } from '../quote/model';

export const prerender = false;

const settings = await getSiteSettings();
const steps = await getProcessSteps();

const defaults: Defaults = {
  from: {
    name: settings.siteName,
    role: settings.roleTitle,
    location: settings.location,
    email: settings.email,
    phone: settings.phoneLabel,
  },
  phases: steps.map((s) => s.title).filter(Boolean),
  site: (Astro.site?.host ?? 'mohamadhawa.com').replace(/^www\./, ''),
  logoFull: settings.logoFull?.url ?? '',
  logoMark: settings.logoMark?.url ?? '',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Quotes · Portfolio Studio</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      try {
        var t = sessionStorage.getItem('mh-theme');
        if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <div class="gate">
      <img src="/art/character-thinking-320.webp" width="160" height="189" alt="" />
      <p class="gate__title">The quote builder is designed for desktop.</p>
      <p class="gate__body">Open admin.mohamadhawa.com on a computer to write a quote.</p>
    </div>

    <div class="qb" data-quote data-defaults={JSON.stringify(defaults)}>
      <header class="bar">
        <div class="bar__left">
          <a class="bar__mark" href="/studio" title="Back to the editor" aria-label="Back to the editor">MH</a>
          <nav class="tabs" aria-label="Studio">
            <a class="tab" href="/studio">Editor</a>
            <a class="tab" href="/studio/quote" aria-current="page">Quotes</a>
          </nav>
        </div>

        <div class="bar__status" data-status role="status" aria-live="polite">Loading…</div>

        <div class="bar__right">
          <button class="btn btn--ghost" type="button" data-new>New quote</button>
          <button class="btn btn--ghost" type="button" data-open title="Open a PDF made here to edit it">Open a quote…</button>
          <input type="file" accept="application/pdf,.pdf" data-file hidden />
          <button class="btn btn--primary" type="button" data-download>Download PDF</button>
          <form method="post" action="/studio/api/logout">
            <button class="icon" type="submit" aria-label="Sign out" title="Sign out">
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M12 4H5v12h7M9 10h8m-3-3 3 3-3 3"></path></svg>
            </button>
          </form>
        </div>
      </header>

      <main class="split">
        <div class="form" data-form></div>
        <div class="preview">
          <iframe data-pdf title="The quote, as the client will receive it"></iframe>
          <iframe data-pdf title="The quote, as the client will receive it" hidden></iframe>
        </div>
      </main>

      <div class="toast" data-toast hidden role="status" aria-live="polite"></div>

      <dialog class="dialog" data-new-dialog aria-labelledby="new-title">
        <form method="dialog">
          <h2 class="dialog__title" id="new-title">Start a new quote?</h2>
          <p class="dialog__body">
            The form is cleared and gets the next number. If you have not downloaded this one, it is gone — nothing
            is kept anywhere else.
          </p>
          <footer class="dialog__actions">
            <button class="btn btn--ghost" value="cancel">Cancel</button>
            <button class="btn btn--primary" value="confirm">New quote</button>
          </footer>
        </form>
      </dialog>
    </div>

    <script>
      if (matchMedia('(min-width: 1024px)').matches) {
        const root = document.querySelector<HTMLElement>('[data-quote]')!;
        import('../quote/app').then(({ startQuote }) => startQuote(root, JSON.parse(root.dataset.defaults!)));
      }
    </script>

    <style is:global>
      :root {
        --st-bg: #ececef;
        --st-panel: #ffffff;
        --st-line: rgba(0, 0, 0, 0.08);
        --st-line-strong: rgba(0, 0, 0, 0.14);
        --st-ink: var(--ink);
        --st-muted: var(--ink-muted);
        --st-soft: #f4f4f6;
        --st-accent: #7c3aed;
        --st-accent-ink: #6d28d9;
        --st-accent-soft: rgba(124, 58, 237, 0.1);
        --st-warn: #b25000;
        --st-radius: 12px;
      }
      :root[data-theme='dark'] {
        --st-bg: #050506;
        --st-panel: #111113;
        --st-line: rgba(255, 255, 255, 0.08);
        --st-line-strong: rgba(255, 255, 255, 0.16);
        --st-soft: #1c1c20;
        --st-accent: #a855f7;
        --st-accent-ink: #c084fc;
        --st-accent-soft: rgba(168, 85, 247, 0.14);
        --st-warn: #ffb340;
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme='light']) {
          --st-bg: #050506;
          --st-panel: #111113;
          --st-line: rgba(255, 255, 255, 0.08);
          --st-line-strong: rgba(255, 255, 255, 0.16);
          --st-soft: #1c1c20;
          --st-accent: #a855f7;
          --st-accent-ink: #c084fc;
          --st-accent-soft: rgba(168, 85, 247, 0.14);
          --st-warn: #ffb340;
        }
      }
      html,
      body {
        margin: 0;
        height: 100%;
        background: var(--st-bg);
        color: var(--st-ink);
        font-family: var(--font-sans);
        font-size: 13px;
        -webkit-font-smoothing: antialiased;
      }
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
      }
      :focus-visible {
        outline: 2px solid var(--st-accent);
        outline-offset: 2px;
      }
      svg {
        fill: none;
        stroke: currentColor;
        stroke-width: 1.6;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      .gate {
        display: none;
      }
      @media (max-width: 1023px) {
        .qb {
          display: none !important;
        }
        .gate {
          display: grid;
          min-height: 100dvh;
          place-content: center;
          justify-items: center;
          gap: 0.5rem;
          padding: 1.5rem;
          text-align: center;
        }
        .gate img {
          width: 140px;
          height: auto;
        }
        .gate__title {
          margin: 0.5rem 0 0;
          font-size: 1.25rem;
          font-weight: 600;
        }
        .gate__body {
          margin: 0;
          max-width: 22rem;
          color: var(--st-muted);
          font-size: 0.95rem;
          line-height: 1.5;
        }
      }

      .qb {
        display: grid;
        grid-template-rows: 52px 1fr;
        height: 100dvh;
      }

      /* ---- bar, as in the editor ---- */
      .bar {
        position: relative;
        z-index: 20;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 12px;
        padding: 0 10px;
        background: var(--st-panel);
        border-bottom: 1px solid var(--st-line);
      }
      .bar__left,
      .bar__right {
        display: flex;
        align-items: center;
        gap: 6px;
        min-width: 0;
      }
      .bar__right {
        justify-content: flex-end;
      }
      .bar__right form {
        margin: 0;
      }
      .bar__mark {
        display: grid;
        place-items: center;
        width: 30px;
        height: 30px;
        border-radius: 9px;
        background: var(--st-ink);
        color: var(--st-panel);
        font-weight: 700;
        font-size: 11px;
        letter-spacing: 0.02em;
        margin-right: 2px;
        text-decoration: none;
      }
      .bar__status {
        color: var(--st-muted);
        font-size: 12px;
      }
      .tabs {
        display: flex;
        gap: 2px;
        padding: 2px;
        border-radius: 10px;
        background: var(--st-soft);
      }
      .tab {
        display: inline-flex;
        align-items: center;
        height: 28px;
        padding: 0 12px;
        border-radius: 8px;
        color: var(--st-muted);
        font-weight: 500;
        text-decoration: none;
      }
      .tab:hover {
        color: var(--st-ink);
      }
      .tab[aria-current='page'] {
        background: var(--st-panel);
        color: var(--st-ink);
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.12);
      }

      .icon,
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        height: 32px;
        border: 1px solid transparent;
        border-radius: 9px;
        background: transparent;
        color: inherit;
        font: inherit;
        font-weight: 500;
        cursor: pointer;
        white-space: nowrap;
      }
      .icon {
        width: 32px;
        flex: none;
        color: var(--st-muted);
      }
      .icon svg {
        width: 18px;
        height: 18px;
      }
      .icon--small {
        width: 26px;
        height: 26px;
        border-radius: 7px;
      }
      .icon--small svg {
        width: 15px;
        height: 15px;
      }
      .icon:hover,
      .btn--ghost:hover {
        background: var(--st-soft);
        color: var(--st-ink);
      }
      .btn {
        padding: 0 12px;
      }
      .btn--ghost {
        color: var(--st-muted);
      }
      .btn--primary {
        background: var(--st-accent);
        color: #fff;
        font-weight: 600;
        padding: 0 16px;
      }
      .btn--primary:hover {
        filter: brightness(1.08);
      }
      .btn--small {
        justify-self: start;
        height: 28px;
        padding: 0 10px;
        border-color: var(--st-line-strong);
        font-size: 12px;
      }
      .btn--small svg {
        width: 14px;
        height: 14px;
      }

      /* ---- the two halves ---- */
      .split {
        display: grid;
        grid-template-columns: minmax(440px, 520px) 1fr;
        min-height: 0;
      }
      .form {
        overflow-y: auto;
        background: var(--st-panel);
        border-right: 1px solid var(--st-line);
        padding: 8px 20px 80px;
      }
      .preview {
        position: relative;
        min-height: 0;
      }
      .preview iframe {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        border: 0;
        background: var(--st-bg);
      }

      /* ---- form ---- */
      .group {
        padding: 18px 0 20px;
        border-bottom: 1px solid var(--st-line);
      }
      .group:last-child {
        border-bottom: 0;
      }
      .group__head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 12px;
      }
      .group__title {
        margin: 0;
        font-size: 14px;
        font-weight: 600;
        letter-spacing: -0.01em;
      }
      .group__aside {
        color: var(--st-muted);
        font-size: 12px;
        font-variant-numeric: tabular-nums;
      }
      .group__aside b {
        color: var(--st-ink);
        font-weight: 600;
      }
      .group__body {
        display: grid;
        gap: 12px;
      }
      .row {
        display: grid;
        gap: 10px;
      }
      .row--2 {
        grid-template-columns: 1fr 1fr;
      }
      .row--3 {
        grid-template-columns: 1fr 1fr 1fr;
      }
      .row--split {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
      }
      .empty {
        margin: 0;
        color: var(--st-muted);
        line-height: 1.5;
      }

      .field {
        display: grid;
        gap: 6px;
        min-width: 0;
      }
      .field__label {
        color: var(--st-muted);
        font-size: 12px;
        font-weight: 500;
      }
      .field__input {
        width: 100%;
        min-width: 0;
        box-sizing: border-box;
        min-height: 32px;
        padding: 6px 10px;
        border: 1px solid var(--st-line-strong);
        border-radius: 9px;
        background: var(--st-panel);
        color: inherit;
        font: inherit;
        font-size: 13px;
        line-height: 1.45;
        resize: vertical;
        outline: none;
        transition: border-color 120ms ease, box-shadow 120ms ease;
      }
      .field__input:hover {
        border-color: color-mix(in srgb, var(--st-ink) 30%, transparent);
      }
      .field__input:focus {
        border-color: var(--st-accent);
        box-shadow: 0 0 0 3px var(--st-accent-soft);
      }
      .field__input[type='number'] {
        font-variant-numeric: tabular-nums;
        text-align: right;
      }
      .field__hint {
        margin: 0;
        color: var(--st-muted);
        font-size: 11.5px;
        line-height: 1.45;
      }
      .field__hint code {
        font-size: 11px;
        padding: 1px 4px;
        border-radius: 4px;
        background: var(--st-soft);
      }

      .chips {
        display: flex;
        gap: 6px;
      }
      .chips--wrap {
        flex-wrap: wrap;
      }
      .chip {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        height: 28px;
        padding: 0 10px;
        border: 1px solid var(--st-line-strong);
        border-radius: 999px;
        background: var(--st-panel);
        color: var(--st-muted);
        font: inherit;
        font-size: 12px;
        font-weight: 500;
        cursor: pointer;
      }
      .chip svg {
        width: 13px;
        height: 13px;
      }
      .chip:hover {
        color: var(--st-ink);
        border-color: color-mix(in srgb, var(--st-ink) 30%, transparent);
      }
      .chip--on {
        background: var(--st-accent-soft);
        border-color: transparent;
        color: var(--st-accent-ink);
      }
      .chip--add {
        border-style: dashed;
      }

      .switch {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        cursor: pointer;
        position: relative;
        font-weight: 500;
      }
      .switch input {
        position: absolute;
        opacity: 0;
        width: 34px;
        height: 20px;
        margin: 0;
      }
      .switch__track {
        flex: none;
        width: 34px;
        height: 20px;
        border-radius: 999px;
        background: var(--st-line-strong);
        position: relative;
        transition: background-color 160ms ease;
      }
      .switch__track::after {
        content: '';
        position: absolute;
        top: 2px;
        left: 2px;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        background: #fff;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
        transition: transform 180ms var(--ease-out);
      }
      .switch input:checked + .switch__track {
        background: var(--st-accent);
      }
      .switch input:checked + .switch__track::after {
        transform: translateX(14px);
      }
      .switch input:focus-visible + .switch__track {
        outline: 2px solid var(--st-accent);
        outline-offset: 2px;
      }
      .opt {
        display: grid;
        gap: 10px;
      }
      .sum {
        margin: 0;
        display: flex;
        justify-content: space-between;
        padding-top: 10px;
        border-top: 1px solid var(--st-line);
        color: var(--st-muted);
        font-variant-numeric: tabular-nums;
      }
      .sum b {
        color: var(--st-ink);
        font-size: 15px;
      }

      .tick {
        display: inline-grid;
        place-items: center;
        width: 26px;
        height: 26px;
        flex: none;
        cursor: pointer;
      }
      .tick input {
        width: 15px;
        height: 15px;
        margin: 0;
        accent-color: var(--st-accent);
        cursor: pointer;
      }

      /* scope cards */
      .card {
        display: grid;
        gap: 8px;
        padding: 12px;
        border: 1px solid var(--st-line-strong);
        border-radius: var(--st-radius);
        background: var(--st-panel);
      }
      .card__head {
        display: grid;
        grid-template-columns: auto 1fr auto 96px auto;
        align-items: center;
        gap: 6px;
      }
      .card__head > .field__input:first-of-type {
        font-weight: 600;
      }
      .card__no {
        width: 22px;
        color: var(--st-muted);
        font-size: 11px;
        font-weight: 600;
        font-variant-numeric: tabular-nums;
      }
      .money {
        color: var(--st-muted);
        font-size: 11px;
        font-weight: 600;
      }
      .card__tools {
        display: flex;
        gap: 0;
      }
      .items,
      .phases,
      .steps,
      .terms {
        margin: 0;
        padding: 0;
        list-style: none;
        display: grid;
        gap: 4px;
      }
      .item,
      .phase,
      .step {
        display: flex;
        align-items: center;
        gap: 4px;
      }
      .item .field__input,
      .phase .field__input,
      .step .field__input {
        min-height: 28px;
        padding: 4px 8px;
        border-color: transparent;
        background: transparent;
      }
      .item .field__input:hover,
      .phase .field__input:hover,
      .step .field__input:hover {
        border-color: var(--st-line-strong);
      }
      .item .field__input:focus,
      .phase .field__input:focus,
      .step .field__input:focus {
        border-color: var(--st-accent);
        background: var(--st-panel);
      }
      .item--off > .field__input,
      .item--off .term__head > .field__input,
      .term.item--off > .field__input {
        color: var(--st-muted);
        text-decoration: line-through;
        text-decoration-color: var(--st-line-strong);
      }
      .add-line {
        padding-left: 30px;
      }
      .add-line .field__input {
        min-height: 28px;
        padding: 4px 8px;
        border-style: dashed;
      }
      .phase .field__input[type='number'],
      .step .field__input[type='number'] {
        flex: 0 0 56px;
      }
      .phase__unit {
        color: var(--st-muted);
        font-size: 12px;
        width: 18px;
      }
      .phase__when {
        flex: 0 0 104px;
        color: var(--st-muted);
        font-size: 11.5px;
        text-align: right;
        font-variant-numeric: tabular-nums;
      }
      .step .field__input:first-child {
        flex: 0 0 150px;
      }
      .warn {
        color: var(--st-warn);
        font-size: 12px;
        font-weight: 500;
      }
      .warn[hidden] {
        display: none;
      }
      .term {
        display: grid;
        gap: 4px;
        padding: 8px 0 10px;
        border-bottom: 1px solid var(--st-line);
      }
      .term__head {
        display: flex;
        align-items: center;
        gap: 4px;
      }
      .term__head .field__input {
        font-weight: 600;
      }
      .term > .field__input {
        margin-left: 30px;
        width: calc(100% - 30px);
        color: var(--st-muted);
      }

      .toast {
        position: fixed;
        z-index: 40;
        left: 50%;
        bottom: 24px;
        transform: translateX(-50%);
        max-width: min(560px, calc(100vw - 48px));
        padding: 10px 16px;
        border-radius: 12px;
        background: #1d1d1f;
        color: #f5f5f7;
        box-shadow: 0 16px 40px -10px rgba(0, 0, 0, 0.5);
        line-height: 1.45;
      }
      .toast--bad {
        background: #8a0010;
      }
      .toast[hidden] {
        display: none;
      }

      .dialog {
        width: min(440px, calc(100vw - 48px));
        padding: 22px;
        border: 1px solid var(--st-line);
        border-radius: 18px;
        background: var(--st-panel);
        color: inherit;
        box-shadow: 0 40px 100px -24px rgba(0, 0, 0, 0.5);
      }
      .dialog::backdrop {
        background: rgba(10, 10, 12, 0.36);
      }
      .dialog form {
        margin: 0;
      }
      .dialog__title {
        margin: 0;
        font-size: 18px;
        font-weight: 600;
        letter-spacing: -0.01em;
      }
      .dialog__body {
        margin: 6px 0 0;
        color: var(--st-muted);
        line-height: 1.5;
      }
      .dialog__actions {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        margin-top: 20px;
      }

      @media (prefers-reduced-motion: reduce) {
        .switch__track,
        .switch__track::after {
          transition: none;
        }
      }
    </style>
  </body>
</html>
