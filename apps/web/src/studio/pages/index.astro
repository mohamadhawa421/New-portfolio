---
/**
 * Portfolio Studio.
 *
 * Reaching this frontmatter means the middleware already checked the session
 * and the admins table. The page is chrome around one thing — the real
 * portfolio in a frame — and is built to stay out of its way: panels are
 * narrow, the bar is one line, and everything that is not the work is quiet.
 *
 * Desktop only, on purpose. Below 1024px the editor is not started at all and
 * the page says so; the portfolio itself stays fully responsive, and "Mobile"
 * in the bar previews it at phone width.
 */
import '../../styles/tokens.css';

export const prerender = false;

const { env } = Astro.locals.studio;
const supabaseUrl = env?.url ?? '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Portfolio Studio</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      try {
        var t = sessionStorage.getItem('mh-theme');
        if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <div class="gate">
      <img src="/art/character-thinking-320.webp" width="160" height="189" alt="" />
      <p class="gate__title">Portfolio Studio is designed for desktop.</p>
      <p class="gate__body">Open admin.mohamadhawa.com on a computer to edit the site. The portfolio itself works everywhere.</p>
    </div>

    <div class="studio" data-studio data-supabase={supabaseUrl}>
      <header class="bar">
        <div class="bar__brand">Portfolio Studio</div>

        <label class="bar__page">
          <span class="sr-only">Page</span>
          <select data-page aria-label="Page"></select>
        </label>

        <div class="bar__group" role="group" aria-label="History">
          <button class="icon" type="button" data-undo disabled aria-label="Undo" title="Undo (⌘Z)">
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7 5 3 9l4 4M3.5 9H12a5 5 0 0 1 0 10h-2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button class="icon" type="button" data-redo disabled aria-label="Redo" title="Redo (⇧⌘Z)">
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m13 5 4 4-4 4M16.5 9H8a5 5 0 0 0 0 10h2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>

        <div class="bar__status" data-status role="status" aria-live="polite">Loading…</div>

        <div class="bar__group bar__device" role="group" aria-label="Preview width">
          <button class="seg" type="button" data-device="desktop" aria-pressed="true">Desktop</button>
          <button class="seg" type="button" data-device="mobile" aria-pressed="false">Mobile</button>
        </div>

        <button class="btn btn--ghost" type="button" data-preview aria-pressed="false">Preview</button>
        <button class="btn btn--ghost" type="button" data-revisions>Revisions</button>
        <button class="btn btn--primary" type="button" data-publish disabled>Publish</button>

        <form method="post" action="/studio/api/logout">
          <button class="icon" type="submit" aria-label="Sign out" title="Sign out">
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M12 4H5v12h7M9 10h8m-3-3 3 3-3 3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </form>
      </header>

      <div class="banner" data-banner hidden role="alert"></div>

      <aside class="panel panel--left" aria-label="Layers">
        <div class="panel__title">Layers</div>
        <div class="layers" data-layers></div>
      </aside>

      <main class="canvas">
        <div class="stage" data-stage data-device="desktop">
          <iframe data-frame title="Portfolio canvas"></iframe>
        </div>
      </main>

      <aside class="panel panel--right" aria-label="Properties">
        <div class="props" data-props></div>
      </aside>

      <dialog class="dialog" data-publish-dialog aria-labelledby="publish-title">
        <h2 id="publish-title" class="dialog__title">Publish changes</h2>
        <p class="dialog__body">This makes the draft live on mohamadhawa.com.</p>
        <ul class="dialog__list" data-summary role="list"></ul>
        <p class="dialog__result" data-result role="status"></p>
        <div class="dialog__actions">
          <button class="btn btn--ghost" type="button" data-close>Close</button>
          <button class="btn btn--primary" type="button" data-confirm>Publish</button>
        </div>
      </dialog>

      <dialog class="dialog" data-revisions-dialog aria-labelledby="rev-title">
        <h2 id="rev-title" class="dialog__title">Revisions</h2>
        <p class="dialog__body">The last twenty published versions. Restoring one makes it live and resets the draft to it.</p>
        <ul class="dialog__list dialog__list--releases" data-releases role="list"></ul>
        <div class="dialog__actions">
          <button class="btn btn--ghost" type="button" data-close>Close</button>
        </div>
      </dialog>
    </div>

    <script>
      // Not on a phone: the editor is never started below the desktop width.
      if (matchMedia('(min-width: 1024px)').matches) {
        const root = document.querySelector<HTMLElement>('[data-studio]')!;
        import('../client/studio').then(({ startStudio }) =>
          startStudio(root, { supabaseUrl: root.dataset.supabase ?? '' })
        );
      }
    </script>

    <style is:global>
      :root {
        --st-bg: var(--surface-parchment);
        --st-panel: var(--surface);
        --st-line: var(--line);
        --st-ink: var(--ink);
        --st-muted: var(--ink-muted);
        --st-accent: #7c3aed;
        --st-accent-soft: color-mix(in srgb, #7c3aed 12%, transparent);
        --st-danger: #c4001a;
      }
      :root[data-theme='dark'] {
        --st-bg: #070709;
        --st-accent: #a855f7;
        --st-danger: var(--error-on-dark);
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme='light']) {
          --st-bg: #070709;
          --st-accent: #a855f7;
          --st-danger: var(--error-on-dark);
        }
      }
      html,
      body {
        margin: 0;
        height: 100%;
        background: var(--st-bg);
        color: var(--st-ink);
        font-family: var(--font-sans);
        font-size: 13px;
        -webkit-font-smoothing: antialiased;
      }
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
      }
      :focus-visible {
        outline: 2px solid var(--st-accent);
        outline-offset: 2px;
      }

      /* ---- phone ---- */
      .gate {
        display: none;
      }
      @media (max-width: 1023px) {
        .studio {
          display: none !important;
        }
        .gate {
          display: grid;
          min-height: 100dvh;
          place-content: center;
          justify-items: center;
          gap: 0.5rem;
          padding: 1.5rem;
          text-align: center;
        }
        .gate img {
          width: 140px;
          height: auto;
        }
        .gate__title {
          margin: 0.5rem 0 0;
          font-size: 1.25rem;
          font-weight: 600;
        }
        .gate__body {
          margin: 0;
          max-width: 22rem;
          color: var(--st-muted);
          font-size: 0.95rem;
          line-height: 1.5;
        }
      }

      /* ---- frame of the tool ---- */
      .studio {
        display: grid;
        grid-template:
          'bar bar bar' 48px
          'banner banner banner' auto
          'left canvas right' 1fr / 248px minmax(0, 1fr) 300px;
        height: 100dvh;
      }
      .studio[data-previewing] {
        grid-template-columns: 0 minmax(0, 1fr) 0;
      }
      .studio[data-previewing] .panel {
        visibility: hidden;
      }

      .bar {
        grid-area: bar;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 0 10px 0 14px;
        background: var(--st-panel);
        border-bottom: 1px solid var(--st-line);
      }
      .bar__brand {
        font-weight: 600;
        letter-spacing: -0.01em;
        margin-right: 6px;
        white-space: nowrap;
      }
      .bar__page select {
        height: 30px;
        max-width: 240px;
        padding: 0 28px 0 10px;
        border: 1px solid var(--st-line);
        border-radius: 8px;
        background: var(--st-bg);
        color: inherit;
        font: inherit;
      }
      .bar__group {
        display: flex;
        gap: 2px;
      }
      .bar__status {
        margin-left: auto;
        margin-right: 6px;
        color: var(--st-muted);
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
      }
      .bar__status[data-state='unsaved'] {
        color: var(--st-ink);
      }
      .bar__status[data-state='error'],
      .bar__status[data-state='offline'] {
        color: var(--st-danger);
      }
      .bar__status[data-state='published'] {
        color: var(--st-accent);
      }
      .bar__status::before {
        content: '';
        display: inline-block;
        width: 6px;
        height: 6px;
        margin-right: 7px;
        border-radius: 50%;
        background: currentColor;
        vertical-align: 1px;
        opacity: 0.7;
      }
      .bar form {
        margin: 0;
      }

      .icon,
      .seg,
      .btn {
        height: 30px;
        border: 1px solid transparent;
        border-radius: 8px;
        background: transparent;
        color: inherit;
        font: inherit;
        cursor: pointer;
      }
      .icon {
        width: 30px;
        display: grid;
        place-items: center;
        color: var(--st-muted);
      }
      .icon svg {
        width: 18px;
        height: 18px;
      }
      .icon:hover:not(:disabled),
      .seg:hover,
      .btn--ghost:hover {
        background: var(--surface-chip);
        color: var(--st-ink);
      }
      .icon:disabled {
        opacity: 0.35;
        cursor: default;
      }
      .seg {
        padding: 0 10px;
        color: var(--st-muted);
      }
      .seg[aria-pressed='true'] {
        background: var(--surface-chip);
        color: var(--st-ink);
      }
      .btn {
        padding: 0 12px;
        font-weight: 500;
      }
      .btn--ghost {
        color: var(--st-muted);
      }
      .btn--primary {
        background: var(--st-accent);
        color: #fff;
        font-weight: 600;
      }
      .btn--primary:hover:not(:disabled) {
        filter: brightness(1.08);
      }
      .btn--primary:disabled {
        opacity: 0.5;
        cursor: default;
      }
      .btn--small {
        height: 28px;
        padding: 0 10px;
        border-color: var(--st-line);
        font-size: 12px;
      }

      .banner {
        grid-area: banner;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 14px;
        background: var(--st-accent-soft);
        border-bottom: 1px solid var(--st-line);
      }
      .banner[hidden] {
        display: none;
      }
      .banner .btn {
        height: 26px;
        border-color: var(--st-line);
        background: var(--st-panel);
      }

      /* ---- panels ---- */
      .panel {
        background: var(--st-panel);
        overflow: auto;
        overscroll-behavior: contain;
      }
      .panel--left {
        grid-area: left;
        border-right: 1px solid var(--st-line);
      }
      .panel--right {
        grid-area: right;
        border-left: 1px solid var(--st-line);
      }
      .panel__title {
        padding: 14px 14px 6px;
        font-weight: 600;
      }

      .layers__group {
        padding: 6px 6px 8px;
      }
      .layers__heading {
        padding: 6px 8px 4px;
        color: var(--st-muted);
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.02em;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .layers ul {
        margin: 0;
        padding: 0;
        list-style: none;
      }
      .layer {
        display: flex;
        align-items: center;
        gap: 8px;
        width: 100%;
        min-height: 28px;
        padding: 0 8px;
        border: 0;
        border-radius: 6px;
        background: none;
        color: inherit;
        font: inherit;
        text-align: left;
        cursor: pointer;
      }
      .layer:hover {
        background: var(--surface-chip);
      }
      .layer[aria-current='true'] {
        background: var(--st-accent-soft);
        color: var(--st-accent);
      }
      .layer__name {
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
      }
      .layer__icon {
        flex: none;
        width: 12px;
        height: 12px;
        border: 1.5px solid currentColor;
        border-radius: 2px;
        opacity: 0.55;
      }
      .layer[data-kind='text'] .layer__icon {
        border: 0;
        opacity: 0.55;
        background: linear-gradient(currentColor, currentColor) center 1px / 10px 1.5px no-repeat,
          linear-gradient(currentColor, currentColor) center / 1.5px 10px no-repeat;
      }
      .layer[data-kind='image'] .layer__icon {
        border-radius: 3px;
        background: linear-gradient(135deg, transparent 55%, currentColor 55%);
      }

      .props {
        padding: 14px;
        display: grid;
        gap: 14px;
      }
      .props__head {
        display: grid;
        gap: 2px;
      }
      .props__title {
        font-size: 14px;
        font-weight: 600;
        overflow-wrap: anywhere;
      }
      .props__sub,
      .props__meta {
        color: var(--st-muted);
        font-size: 12px;
      }
      .props__image {
        width: 100%;
        max-height: 200px;
        object-fit: contain;
        border-radius: 8px;
        background: var(--surface-chip);
      }
      .props__row {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
      }
      .props__section {
        border-top: 1px solid var(--st-line);
        padding-top: 10px;
        display: grid;
        gap: 12px;
      }
      .props__section summary {
        cursor: pointer;
        font-weight: 600;
      }

      .field {
        display: grid;
        gap: 5px;
      }
      .field__label {
        color: var(--st-muted);
        font-size: 11px;
        font-weight: 600;
      }
      .field__input {
        width: 100%;
        box-sizing: border-box;
        padding: 7px 9px;
        border: 1px solid var(--st-line);
        border-radius: 7px;
        background: var(--st-bg);
        color: inherit;
        font: inherit;
        line-height: 1.45;
        resize: vertical;
      }
      .field__input:focus {
        outline: none;
        border-color: var(--st-accent);
        box-shadow: 0 0 0 3px var(--st-accent-soft);
      }
      .field__hint {
        color: var(--st-muted);
        font-size: 11px;
        line-height: 1.4;
      }
      .toggle {
        display: flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
      }
      .toggle input {
        accent-color: var(--st-accent);
        width: 16px;
        height: 16px;
      }

      .drop {
        display: grid;
        gap: 2px;
        padding: 16px 12px;
        border: 1px dashed color-mix(in srgb, var(--st-ink) 25%, transparent);
        border-radius: 10px;
        text-align: center;
        cursor: pointer;
      }
      .drop:hover,
      .drop[data-state='over'] {
        border-color: var(--st-accent);
        background: var(--st-accent-soft);
      }
      .drop[data-state='error'] .drop__hint {
        color: var(--st-danger);
      }
      .drop__title {
        font-weight: 600;
      }
      .drop__hint {
        color: var(--st-muted);
        font-size: 12px;
      }

      /* ---- canvas ---- */
      .canvas {
        grid-area: canvas;
        overflow: hidden;
        display: grid;
        padding: 14px;
      }
      .stage {
        justify-self: center;
        width: 100%;
        height: 100%;
        border-radius: 10px;
        overflow: hidden;
        background: var(--surface);
        box-shadow:
          0 0 0 1px var(--st-line),
          0 8px 30px -12px rgba(0, 0, 0, 0.25);
        transition: width 320ms var(--ease-out);
      }
      .stage[data-device='mobile'] {
        width: 390px;
      }
      .stage iframe {
        display: block;
        width: 100%;
        height: 100%;
        border: 0;
      }

      /* ---- dialogs ---- */
      .dialog {
        width: min(440px, calc(100vw - 32px));
        padding: 20px;
        border: 1px solid var(--st-line);
        border-radius: 14px;
        background: var(--st-panel);
        color: inherit;
        box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.45);
      }
      .dialog::backdrop {
        background: rgba(0, 0, 0, 0.35);
      }
      .dialog__title {
        margin: 0;
        font-size: 17px;
      }
      .dialog__body {
        margin: 6px 0 14px;
        color: var(--st-muted);
        line-height: 1.45;
      }
      .dialog__list {
        margin: 0;
        padding: 0;
        list-style: none;
        display: grid;
        gap: 6px;
        max-height: 50vh;
        overflow: auto;
      }
      .dialog__list li {
        padding: 8px 10px;
        border-radius: 8px;
        background: var(--st-bg);
        line-height: 1.4;
      }
      .release {
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: center;
        gap: 2px 10px;
      }
      .release__when {
        font-weight: 600;
      }
      .release__what {
        grid-column: 1;
        color: var(--st-muted);
        font-size: 12px;
      }
      .release .btn {
        grid-row: 1 / span 2;
        grid-column: 2;
      }
      .dialog__result {
        min-height: 1.2em;
        margin: 12px 0 0;
        line-height: 1.45;
      }
      .dialog__actions {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        margin-top: 16px;
      }

      @media (prefers-reduced-motion: reduce) {
        .stage {
          transition: none;
        }
      }
    </style>
  </body>
</html>
