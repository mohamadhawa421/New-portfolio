---
/**
 * The work, at the size it was made.
 *
 * A case study's images are the case study, and on a laptop a gallery tile is
 * three hundred pixels of something that was designed at fifteen hundred. This
 * opens one over the page: the thumbnail grows from exactly where it sits into
 * the middle of the screen, and closing puts it back in the same place.
 *
 * It is one dialog reused for every image rather than one per image. The
 * markup is here, the wiring is in scripts/lightbox.ts, and every image that
 * can be opened is marked in the page with `data-zoom` — so a new section with
 * pictures in it opts in by saying so and nothing here has to know about it.
 */
---

<div class="lightbox" data-lightbox hidden aria-hidden="true">
  {/*
    The ground the image sits on. Its own element rather than a background on
    the dialog, because it fades on its own clock — the veil is up before the
    picture has finished travelling, and still there for a moment after it has
    gone home.
  */}
  <div class="lightbox__veil" data-lightbox-veil></div>

  {/*
    The image is inserted here rather than written here: it is a clone of the
    one that was clicked, so it arrives with the same src, the same srcset if
    it ever has one, and the same alt — and it is already decoded, because the
    browser has it on screen.
  */}
  {/*
    The room, and nothing in it.

    The stage is measured, never filled: the script reads this rectangle to
    work out how large the picture is allowed to be, and then places the
    travelling surface over the whole dialog rather than inside here. A box
    that also held the picture would clip it during the travel, when it is
    still out at the thumbnail's rectangle and a long way outside this one.
  */}
  <div class="lightbox__stage" data-lightbox-stage></div>

  {/*
    How far in the picture is, and a way to change it.

    The same vocabulary as the page's own scrollbar — a hairline track and a
    small rounded fill in the ink colour — because it is the same kind of
    object: a thin indicator at the edge of the viewport that is also a
    control. It is only useful once there is something to zoom, so the dialog
    reveals it on open and the fill sits at nothing until it is asked for.
  */}
  <div class="lightbox__zoom" data-zoom-bar aria-hidden="true">
    <div class="lightbox__zoom-track">
      <div class="lightbox__zoom-fill" data-zoom-fill></div>
    </div>
    <span class="lightbox__zoom-label" data-zoom-label>100%</span>
  </div>

  <button class="lightbox__close" data-lightbox-close type="button" aria-label="Close image">
    {/*
      The same two strokes as the menu's close, at the same weight as the
      nav's own marks. Currency of the site rather than an icon set.
    */}
    <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false">
      <path d="M5 5 L15 15 M15 5 L5 15" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
    </svg>
  </button>
</div>

<script>
  import { bindLightbox } from '../scripts/lightbox';

  /*
   * Bound once for the life of the tab.
   *
   * The listeners are delegated from `document`, which the router never
   * replaces, so a second binding would open two dialogs on one click. The
   * expand badges are stamped per page instead, from inside the module.
   */
  if (!(window as unknown as { __mhLightbox?: boolean }).__mhLightbox) {
    (window as unknown as { __mhLightbox?: boolean }).__mhLightbox = true;
    bindLightbox();
  }
</script>

<style is:global>
  /* ------------------------------------------------------------------ */
  /* The invitation                                                      */
  /* ------------------------------------------------------------------ */

  /*
   * Anything that can be opened says so, and says it the same way.
   *
   * The container is what carries this rather than the image: the badge is
   * positioned against the frame, and the frame is what already has the
   * rounding and the overflow clip the picture is cut to.
   */
  [data-zoom] {
    position: relative;
    cursor: zoom-in;
  }

  /*
   * The badge.
   *
   * Four corner marks and nothing in the middle, which is what "this gets
   * bigger" looks like without a magnifying glass on it — and it is the same
   * hairline geometry the grid overlay and the nav's marks are drawn with. It
   * sits on a dark scrim so it reads on a screenshot of anything, and the
   * scrim is small enough to be furniture rather than a panel.
   */
  .zoom-badge {
    position: absolute;
    /*
     * Set in from the corner by an amount the corner decides.
     *
     * A single inset cannot serve surfaces with different radii: at a flat
     * 14px the badge cleared the approach shot's 36px corner by five pixels
     * and a gallery tile's 21px corner by eleven, so the same control looked
     * crowded on one picture and comfortably placed on the next. The frame
     * passes its own figure in `--zoom-inset` — see the case study's
     * stylesheet, where it is derived from the same radius token the surface
     * is cut with, so the relationship survives every breakpoint.
     */
    top: var(--zoom-inset, 14px);
    right: var(--zoom-inset, 14px);
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: #fff;
    background: rgba(20, 20, 22, 0.52);
    -webkit-backdrop-filter: blur(10px) saturate(140%);
    backdrop-filter: blur(10px) saturate(140%);
    pointer-events: none;
    /*
     * Held back until the pointer is on the picture. An always-lit control in
     * the corner of every image is a watermark; appearing under the cursor is
     * the picture answering.
     */
    opacity: 0;
    scale: 0.86;
    transition:
      opacity 260ms var(--ease-out),
      scale 260ms var(--ease-out);
  }

  [data-zoom]:hover .zoom-badge,
  [data-zoom]:focus-visible .zoom-badge {
    opacity: 1;
    scale: 1;
  }

  /*
   * On a touch screen there is no hover to answer, so it is simply there.
   *
   * Quieter than the hover state it replaces — it is permanent, and a
   * permanent mark has to be lighter than one that arrives.
   */
  @media (hover: none) {
    .zoom-badge {
      opacity: 0.82;
      scale: 1;
    }
  }

  /* ------------------------------------------------------------------ */
  /* The dialog                                                          */
  /* ------------------------------------------------------------------ */

  /*
   * Above the page and the nav, and below the storm.
   *
   * The shockwave lives at 9999 and its flash has to be over everything; the
   * scrollbar is at 190 and has no business in front of a picture opened over
   * the whole screen.
   */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 320;
    display: grid;
    place-items: center;
  }

  .lightbox[hidden] {
    display: none;
  }

  .lightbox__veil {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--surface-dark) 88%, transparent);
    -webkit-backdrop-filter: blur(18px) saturate(120%);
    backdrop-filter: blur(18px) saturate(120%);
    opacity: 0;
    /* The veil closes the page off, so it is what takes the click that opens
       it back up. */
    cursor: zoom-out;
    transition: opacity 420ms var(--ease-glide);
  }

  .lightbox.is-open .lightbox__veil {
    /*
     * And it thins as the picture is pulled away.
     *
     * `--pull` runs 0 to 1 while a finger is dragging the picture off the
     * screen. Letting the room come back through as it goes is what makes the
     * gesture reversible by eye: halfway through, it looks halfway through, so
     * letting go is an obvious way to change your mind rather than a gamble.
     */
    opacity: calc(1 - var(--pull, 0) * 0.72);
  }

  /*
   * Where the picture ends up.
   *
   * Sized by the image itself rather than by the box: the stage is only a
   * position, and the clone inside it is capped to the viewport with a margin
   * so nothing ever meets an edge. The travel is a Web Animations flip from
   * the thumbnail's own rectangle, which is why there is no transition here.
   */
  .lightbox__stage {
    position: relative;
    /*
     * A definite box, not one the picture inflates.
     *
     * The stage is the room the picture is allowed: the script reads this
     * rectangle and fits the image into it itself, which is the only way the
     * arriving size is known on the frame the dialog opens. A clone of an
     * <img> starts its own request even from cache, so for a frame or two it
     * has no intrinsic size at all — and a stage sized by its content is
     * therefore a stage of nothing, measured as nothing, animated from
     * nothing. Fixing the room and fitting the picture to it needs neither
     * the network nor a decode.
     */
    width: min(1400px, 92vw);
    height: 88vh;
    display: grid;
    place-items: center;
    pointer-events: none;
  }

  /*
   * The travelling surface.
   *
   * Fixed to the viewport and positioned in viewport coordinates, because the
   * rectangle it starts from is a thumbnail's `getBoundingClientRect` and the
   * one it ends at is the stage's — both of which are viewport coordinates,
   * and converting between spaces mid-travel is how a shared element ends up
   * landing a scrollbar's width away from home.
   *
   * `overflow: hidden` is not decoration here. It is the crop: the picture
   * inside is `object-fit: cover`, so this box decides how much of it is
   * visible, and animating the box is what opens the crop.
   */
  .lightbox__surface {
    position: fixed;
    overflow: hidden;
    z-index: 1;
    /* The picture is the only lit thing on the screen, and a hard edge against
       the blur is what stops it looking pasted on. */
    box-shadow: 0 40px 120px rgba(0, 0, 0, 0.45);
    /* Off the pointer until it has arrived — a click that lands on a surface
       still travelling would zoom a picture that is not yet anywhere. */
    cursor: zoom-in;
    touch-action: none;
  }

  .lightbox__surface[data-zoomed='yes'] {
    cursor: grab;
  }

  .lightbox__surface[data-zoomed='yes']:active {
    cursor: grabbing;
  }

  .lightbox__pic {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /*
     * The zoom lives on this, and the travel lives on the box around it, so
     * the two never write to the same property and cannot cancel each other.
     */
    transform-origin: 50% 50%;
    user-select: none;
    -webkit-user-drag: none;
  }

  /* ------------------------------------------------------------------ */
  /* The zoom bar                                                        */
  /* ------------------------------------------------------------------ */

  .lightbox__zoom {
    position: fixed;
    right: 18px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    display: grid;
    justify-items: center;
    gap: 10px;
    opacity: 0;
    transition: opacity 320ms var(--ease-out);
    pointer-events: none;
  }

  .lightbox.is-open .lightbox__zoom {
    opacity: 0.55;
    pointer-events: auto;
  }

  .lightbox.is-open .lightbox__zoom:hover,
  .lightbox.is-zoomed .lightbox__zoom {
    opacity: 1;
  }

  /*
   * A hairline with a fill climbing it, which is the scrollbar's own idea.
   *
   * The whole strip is the target rather than the fill — five pixels is not
   * something anybody hits on a phone — so the track carries the padding and
   * the fill is only ever a readout of where the zoom is.
   */
  .lightbox__zoom-track {
    position: relative;
    width: 5px;
    height: min(220px, 30vh);
    border-radius: 999px;
    background: color-mix(in srgb, var(--ink-on-dark, #fff) 18%, transparent);
    cursor: ns-resize;
    touch-action: none;
  }

  .lightbox__zoom-fill {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: calc(var(--at, 0) * 100%);
    border-radius: 999px;
    background: var(--ink-on-dark, #fff);
    /* No transition on the height: it follows a drag, and a control that lags
       the finger holding it does not feel like a control. */
  }

  .lightbox__zoom-label {
    font-size: 11px;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
    color: var(--ink-on-dark, #fff);
    opacity: 0.7;
  }

  @media (prefers-reduced-motion: reduce) {
    .lightbox__zoom {
      transition: none;
    }
  }

  /* ------------------------------------------------------------------ */
  /* On a phone                                                          */
  /* ------------------------------------------------------------------ */

  /*
   * The room gets bigger, not smaller.
   *
   * On a laptop the stage is inset so the veil reads as a room the picture is
   * shown in. A phone has no room to give away: 92vw of a 390px screen leaves
   * a case-study screenshot about 350 pixels wide, which is smaller than the
   * thumbnail on the page behind it. The insets shrink to the width of the
   * close button's reach and the picture takes what is left.
   */
  @media (max-width: 767px) {
    .lightbox__stage {
      width: 100vw;
      height: 100dvh;
      padding: 64px 10px 96px;
      box-sizing: border-box;
    }

    /*
     * The bar lies down along the bottom.
     *
     * Vertically at the right edge it sits under the thumb holding the phone
     * and in front of the picture. Along the bottom it is where every other
     * control on a phone is, out of the way of the image, and a horizontal
     * drag is the gesture a slider there invites.
     */
    .lightbox__zoom {
      right: auto;
      left: 50%;
      top: auto;
      bottom: calc(18px + env(safe-area-inset-bottom, 0px));
      transform: translateX(-50%);
      grid-auto-flow: column;
      align-items: center;
      gap: 12px;
      /* Its own ground, because a hairline over a photograph is invisible. */
      padding: 10px 16px;
      border-radius: 999px;
      background: rgba(0, 0, 0, 0.55);
      -webkit-backdrop-filter: blur(14px);
      backdrop-filter: blur(14px);
    }

    .lightbox__zoom-track {
      width: min(180px, 42vw);
      height: 5px;
      cursor: ew-resize;
    }

    /*
     * Filled from the left rather than from the bottom, because the track is
     * now horizontal and a fill that still grew upward would be a five pixel
     * square that never moved.
     */
    .lightbox__zoom-fill {
      top: 0;
      bottom: 0;
      right: auto;
      height: auto;
      width: calc(var(--at, 0) * 100%);
    }

    /*
     * Always visible on touch, because there is no hover to reveal it with and
     * a control that only appears once you have used it is not a control.
     */
    .lightbox.is-open .lightbox__zoom {
      opacity: 1;
    }

    /* Clear of the notch, and a target a thumb can actually hit. */
    .lightbox__close {
      top: calc(10px + env(safe-area-inset-top, 0px));
      right: 10px;
      width: 48px;
      height: 48px;
    }
  }

  .lightbox__close {
    position: absolute;
    top: clamp(14px, 2.4vw, 28px);
    right: clamp(14px, 2.4vw, 28px);
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 50%;
    color: #fff;
    background: rgba(255, 255, 255, 0.1);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    cursor: pointer;
    opacity: 0;
    transition:
      opacity 320ms var(--ease-out),
      background 200ms var(--ease-out);
  }

  .lightbox.is-open .lightbox__close {
    opacity: 1;
    /* Last in and first out: the way out should not arrive before the thing it
       closes has finished arriving. */
    transition-delay: 180ms;
  }

  .lightbox__close:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  :root.has-custom-cursor .lightbox__close,
  :root.has-custom-cursor [data-zoom],
  :root.has-custom-cursor .lightbox__veil {
    cursor: none;
  }

  /* His room takes it too — the veil is violet and the picture keeps its
     halo. */
  :root[data-super] .lightbox__veil {
    background: color-mix(in srgb, var(--dm-deep) 88%, transparent);
  }

  :root[data-super] .lightbox__stage img {
    box-shadow: 0 40px 120px color-mix(in srgb, var(--dm-core) 34%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .lightbox__veil,
    .lightbox__close,
    .zoom-badge {
      transition-duration: 1ms;
    }
  }
</style>
