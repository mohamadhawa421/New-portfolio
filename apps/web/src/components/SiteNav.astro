---
import ThemeToggle from './ThemeToggle.astro';
import type { SiteSettings } from '../lib/types';

interface Props {
  pathname: string;
  settings: SiteSettings;
}

const { pathname, settings } = Astro.props;

const links = [
  { label: 'Home', href: '/', match: (p: string) => p === '/' },
  { label: 'Work', href: '/work', match: (p: string) => p.startsWith('/work') },
  { label: 'About', href: '/about', match: (p: string) => p.startsWith('/about') },
  { label: 'Contact', href: '/contact', match: (p: string) => p.startsWith('/contact') },
];

// Trailing slashes vary between dev and the built output.
const current = pathname.length > 1 ? pathname.replace(/\/+$/, '') || '/' : '/';
const items = links.map((link) => ({ ...link, active: link.match(current) }));
---

{/* Desktop: the centred pill from the design. Hidden below 768px, where it
    would collide with the fixed logo mark. */}
<nav class="nav" data-nav="1" aria-label="Primary" transition:persist="site-nav">
  {
    items.map((item) => (
      <a
        class="nav__link"
        class:list={[{ 'nav__link--active': item.active }]}
        href={item.href}
        aria-current={item.active ? 'page' : undefined}
      >
        {item.label}
      </a>
    ))
  }
  <ThemeToggle />
</nav>

{/* Mobile: burger → slide-in sidebar. */}
<button
  type="button"
  class="burger"
  data-burger
  aria-label="Open menu"
  aria-expanded="false"
  aria-controls="mobile-menu"
>
  <span class="burger__box" aria-hidden="true">
    <span class="burger__line burger__line--top"></span>
    <span class="burger__line burger__line--bottom"></span>
  </span>
</button>

{/* Mobile only. The logo and burger are fixed, so page content scrolls
    underneath them; without a backdrop the icons sit directly on top of
    photographs and headlines and become unreadable. This is the same glass the
    desktop pill picks up on scroll, driven by the same variables. */}
<div class="topbar" aria-hidden="true" transition:persist="site-topbar"></div>

<div class="scrim" data-scrim hidden transition:persist="site-scrim"></div>

<aside id="mobile-menu" class="panel" data-panel aria-label="Menu" inert transition:persist="site-menu">
  <nav class="panel__links" aria-label="Mobile">
    {
      items.map((item) => (
        <a
          class="panel__link"
          class:list={[{ 'panel__link--active': item.active }]}
          href={item.href}
          aria-current={item.active ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </nav>

  <div class="panel__foot">
    <a class="panel__contact" href={settings.waHref} target="_blank" rel="noopener">
      <span>WhatsApp</span>
      <span class="panel__arrow" aria-hidden="true">↗</span>
    </a>
    <a class="panel__contact" href={settings.mailHref}>
      <span>Email</span>
      <span class="panel__arrow" aria-hidden="true">↗</span>
    </a>
    <div class="panel__theme">
      <ThemeToggle />
    </div>
    <p class="panel__location">{settings.location}</p>
  </div>
</aside>

<script>
  /**
   * The client router re-renders this component on every navigation, so the
   * burger and panel are new elements each time and have to be re-bound. The
   * document- and window-level listeners are not — those are bound once and
   * delegate to whichever panel is currently on the page.
   */
  interface MenuController {
    isOpen: () => boolean;
    setOpen: (next: boolean) => void;
    panel: HTMLElement;
    focusable: () => HTMLElement[];
  }

  let current: MenuController | null = null;
  let globalsBound = false;

  /** The nav survives navigation, so its active state is updated by hand. */
  function markActive() {
    const path = location.pathname.replace(/\/+$/, '') || '/';
    document.querySelectorAll<HTMLAnchorElement>('.nav__link, .panel__link').forEach((link) => {
      const href = link.getAttribute('href') || '/';
      const active = href === '/' ? path === '/' : path.startsWith(href);
      link.classList.toggle('nav__link--active', active && link.classList.contains('nav__link'));
      link.classList.toggle('panel__link--active', active && link.classList.contains('panel__link'));
      if (active) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    });
  }

  function setup() {
    markActive();

    const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
    const panel = document.querySelector<HTMLElement>('[data-panel]');
    const scrim = document.querySelector<HTMLElement>('[data-scrim]');

    if (!burger || !panel || !scrim) {
      current = null;
      return;
    }

    // A navigation can land mid-transition; make sure nothing is left locked.
    document.documentElement.classList.remove('menu-open');
    document.body.style.position = '';
    document.body.style.top = '';
    document.body.style.width = '';

    const focusable = () =>
      Array.from(panel.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'));

    let open = false;
    let scrollY = 0;

    function setOpen(next: boolean) {
      if (next === open) return;
      open = next;

      burger!.setAttribute('aria-expanded', String(open));
      burger!.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      document.documentElement.classList.toggle('menu-open', open);

      if (open) {
        scrim!.hidden = false;
        panel!.removeAttribute('inert');
        // Lock the page behind the panel without losing the scroll position.
        scrollY = window.scrollY;
        document.body.style.position = 'fixed';
        document.body.style.top = `-${scrollY}px`;
        document.body.style.width = '100%';
        focusable()[0]?.focus();
      } else {
        panel!.setAttribute('inert', '');
        document.body.style.position = '';
        document.body.style.top = '';
        document.body.style.width = '';
        // Must be instant: the page sets `scroll-behavior: smooth`, which would
        // otherwise animate the restore and look like the page jumped away.
        window.scrollTo({ top: scrollY, behavior: 'instant' });
        burger!.focus();
        // Keep the scrim in the DOM until its fade-out finishes.
        window.setTimeout(() => {
          if (!open) scrim!.hidden = true;
        }, 400);
      }
    }

    if (burger.dataset.bound) {
      // Persisted from the previous page — listeners are still attached.
      return;
    }
    burger.dataset.bound = '1';

    burger.addEventListener('click', () => setOpen(!open));
    scrim.addEventListener('click', () => setOpen(false));

    // With the client router the link does not reload the page, so the panel
    // has to be closed explicitly or it would stay open over the new page.
    panel.querySelectorAll('a[href]').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    current = { isOpen: () => open, setOpen, panel, focusable };

    if (globalsBound) return;
    globalsBound = true;

    document.addEventListener('keydown', (event) => {
      if (!current || !current.isOpen()) return;

      if (event.key === 'Escape') {
        event.preventDefault();
        current.setOpen(false);
        return;
      }

      if (event.key !== 'Tab') return;

      // Keep focus inside the panel while it is open.
      const items = current.focusable();
      if (!items.length) return;
      const first = items[0];
      const last = items[items.length - 1];
      const active = document.activeElement;

      if (event.shiftKey && (active === first || !current.panel.contains(active))) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && active === last) {
        event.preventDefault();
        first.focus();
      }
    });

    // Crossing the breakpoint while the menu is open — rotating a phone to
    // landscape is enough — hides the panel by CSS but would leave the body
    // scroll-locked with nothing left to close, trapping the page. Watch both
    // resize and the media query: resize always fires, the media query is the
    // cheaper signal when it does.
    const closeIfDesktop = () => {
      if (window.innerWidth >= 768) current?.setOpen(false);
    };

    window.addEventListener('resize', closeIfDesktop, { passive: true });
    window.addEventListener('orientationchange', closeIfDesktop);
    window.matchMedia('(min-width: 768px)').addEventListener('change', closeIfDesktop);
  }

  document.addEventListener('astro:page-load', setup);
</script>

<style>
  /* ------------------------------------------------------------------ */
  /* Desktop pill                                                        */
  /* ------------------------------------------------------------------ */
  .nav {
    position: fixed;
    top: var(--nav-top, 18px);
    left: 50%;
    transform: translateX(-50%);
    z-index: 200;
    display: flex;
    align-items: center;
    gap: var(--nav-gap, clamp(16px, 4.6vw, 56px));
    padding: var(--nav-pad, 2px 12px);
    border-radius: var(--r-pill);
    background: var(--nav-bg, rgba(255, 255, 255, 0));
    backdrop-filter: var(--nav-blur, saturate(180%) blur(0px));
    -webkit-backdrop-filter: var(--nav-blur, saturate(180%) blur(0px));
    box-shadow: var(--nav-shadow, 0 1px 8px rgba(0, 0, 0, 0));
    max-width: calc(100vw - 20px);
    transition:
      top 620ms var(--ease-out),
      gap 620ms var(--ease-out),
      padding 620ms var(--ease-out),
      background 520ms ease,
      box-shadow 520ms ease,
      backdrop-filter 520ms ease;
  }

  .nav__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: var(--nav-link-pad, 0 6px);
    border-radius: var(--r-pill);
    font-size: 15px;
    letter-spacing: -0.014em;
    font-weight: 400;
    color: var(--nav-ink, #1d1d1f);
    white-space: nowrap;
    transition:
      padding 620ms var(--ease-out),
      color 420ms ease,
      font-weight 200ms ease,
      background 240ms var(--ease-glide);
  }

  /* Same treatment as the theme switch sitting next to them: a soft pill of
     the current ink rather than a dip in opacity. color-mix keeps it correct
     in both themes, because it tints whatever the nav ink currently is. */
  .nav__link:hover {
    background: color-mix(in srgb, currentColor 10%, transparent);
    color: var(--nav-ink, #1d1d1f);
  }

  .nav__link--active:hover {
    background: color-mix(in srgb, var(--blue) 12%, transparent);
  }

  .nav__link--active,
  .nav__link--active:hover {
    color: var(--blue);
    font-weight: 600;
  }

  /* ------------------------------------------------------------------ */
  /* Mobile top bar                                                      */
  /* ------------------------------------------------------------------ */
  .topbar {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 68px;
    z-index: 199;
    background: var(--nav-bg, rgba(255, 255, 255, 0));
    backdrop-filter: var(--nav-blur, saturate(180%) blur(0px));
    -webkit-backdrop-filter: var(--nav-blur, saturate(180%) blur(0px));
    box-shadow: var(--nav-shadow, 0 1px 8px rgba(0, 0, 0, 0));
    transition:
      background 520ms ease,
      box-shadow 520ms ease,
      backdrop-filter 520ms ease;
  }

  /* The bar is the surface; it must not sit above the open menu. */
  :global(html.menu-open) .topbar {
    opacity: 0;
  }

  /* ------------------------------------------------------------------ */
  /* Burger                                                              */
  /* ------------------------------------------------------------------ */
  .burger {
    display: none;
    position: fixed;
    top: 18px;
    right: clamp(20px, 4vw, 56px);
    z-index: 402;
    width: 44px;
    height: 44px;
    padding: 0;
    border: none;
    background: transparent;
    cursor: pointer;
    align-items: center;
    justify-content: center;
  }

  .burger__box {
    position: relative;
    display: block;
    width: 24px;
    height: 14px;
  }

  .burger__line {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.5px;
    border-radius: 2px;
    background: var(--nav-ink, #1d1d1f);
    transition:
      transform 420ms var(--ease-out),
      background 420ms ease;
  }

  .burger__line--top {
    top: 0;
  }

  .burger__line--bottom {
    bottom: 0;
  }

  /* Open: the two rules cross into an X, and the panel behind them is
     always light, so the ink stops following the section underneath. */
  :global(html.menu-open) .burger__line {
    background: var(--ink);
  }

  :global(html.menu-open) .burger__line--top {
    transform: translateY(6.25px) rotate(45deg);
  }

  :global(html.menu-open) .burger__line--bottom {
    transform: translateY(-6.25px) rotate(-45deg);
  }

  /* ------------------------------------------------------------------ */
  /* Scrim + panel                                                       */
  /* ------------------------------------------------------------------ */
  .scrim {
    position: fixed;
    inset: 0;
    z-index: 400;
    background: rgba(0, 0, 0, 0.38);
    opacity: 0;
    transition: opacity 420ms var(--ease-smooth);
  }

  .scrim[hidden] {
    display: none;
  }

  :global(html.menu-open) .scrim {
    opacity: 1;
  }

  .panel {
    --panel-inset: 20px;
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 401;
    width: min(340px, 80vw);
    display: none;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
    padding: 96px clamp(24px, 7vw, 36px) clamp(28px, 5vh, 44px);
    /*
     * Opaque, and following the theme surface rather than a hardcoded white
     * that left the sidebar glaring over a dark page.
     *
     * Deliberately not glass: the translucent version let the hero headline
     * and portrait read straight through the menu, and the backdrop-filter
     * that was supposed to blur them was being dropped entirely. A menu has to
     * be legible before it is pretty.
     */
    background: var(--surface);
    /* A drop shadow separates the panel on a light page but disappears against
       a dark one, so the edge is drawn as a line as well. */
    border-left: 1px solid var(--line);
    box-shadow: -1px 0 24px rgba(0, 0, 0, 0.14);
    visibility: hidden;
    transform: translateX(100%);
    overflow-y: auto;
    overscroll-behavior: contain;
    transition:
      transform 520ms var(--ease-out),
      visibility 0s linear 520ms;
  }

  :global(html.menu-open) .panel {
    visibility: visible;
    transform: none;
    transition:
      transform 520ms var(--ease-out),
      visibility 0s;
  }

  .panel__links {
    display: flex;
    flex-direction: column;
    /* Pulled wide so the hover fill extends to the panel's edges while the
       text still lines up with everything else inside it. */
    margin-inline: calc(-1 * var(--panel-inset));
  }

  .panel__link {
    position: relative;
    display: flex;
    align-items: center;
    /* Real vertical padding rather than a bare min-height, so the tap target
       and the hover fill are the same shape as the text block inside them. */
    padding: 18px var(--panel-inset);
    min-height: 62px;
    font-size: clamp(23px, 6.6vw, 29px);
    line-height: 1.15;
    letter-spacing: -0.018em;
    font-weight: 600;
    color: var(--ink);
    /* A pill. On a fill this wide and this tall the fully rounded ends read as
       a deliberate control rather than a rounded-off rectangle. */
    border-radius: var(--r-pill);
    transition:
      color 0.25s ease,
      background 240ms var(--ease-glide);
  }

  /* Divider drawn as an inset line. A border on a rounded box curls at the
     corners once the hover fill rounds them — the same reason the project
     rows use a pseudo-element. */
  .panel__link + .panel__link::before {
    content: '';
    position: absolute;
    top: 0;
    left: var(--panel-inset);
    right: var(--panel-inset);
    height: 1px;
    background: var(--line);
  }

  .panel__link:hover {
    color: var(--blue);
    background: color-mix(in srgb, currentColor 10%, transparent);
  }

  .panel__link--active,
  .panel__link--active:hover {
    color: var(--blue);
  }

  .panel__foot {
    display: flex;
    flex-direction: column;
  }

  .panel__contact {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    min-height: 48px;
    font-size: 17px;
    letter-spacing: -0.022em;
    color: var(--ink-muted);
    border-top: 1px solid var(--line);
    transition: color 0.25s ease;
  }

  .panel__contact:hover {
    color: var(--blue);
  }

  .panel__arrow {
    color: var(--blue);
  }

  .panel__theme {
    display: flex;
    justify-content: flex-start;
    margin-top: 18px;
    margin-left: -10px;
  }

  .panel__location {
    margin-top: 18px;
    font-size: 13px;
    letter-spacing: -0.01em;
    color: var(--ink-softer);
  }

  /* ------------------------------------------------------------------ */
  /* Breakpoint                                                          */
  /* ------------------------------------------------------------------ */
  @media (max-width: 767px) {
    .nav {
      display: none;
    }

    .burger {
      display: inline-flex;
    }

    .panel {
      display: flex;
    }

    .topbar {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .panel,
    .scrim,
    .burger__line {
      transition-duration: 0.001ms !important;
    }
  }
</style>
