---
import type { ContactPage, Service, SiteSettings } from '../lib/types';

interface Props {
  contact: ContactPage;
  services: Service[];
  settings: SiteSettings;
  id?: string;
}

const { contact, services, settings, id = 'mh' } = Astro.props;

const serviceOptions = [...services.map((service) => service.title), contact.unsureLabel];
const budgetOptions = [...contact.budgetOptions, contact.unsureLabel];

// WhatsApp stays as a second route for people who prefer it; the primary button
// now sends the message from the page instead of opening a mail client.
const showWhatsApp = settings.contactMode !== 'Email';

const config = {
  whatsapp: settings.whatsappNumber.replace(/[^\d]/g, ''),
  greeting: contact.formGreeting,
  errorName: contact.formErrorName,
  errorEmail: contact.formErrorEmail,
  errorBrief: contact.formErrorBrief,
  sentWhatsapp: contact.formSentWhatsapp,
  sending: contact.formSendingLabel,
  success: contact.formSuccess,
  sendError: contact.formSendError,
  sendCta: contact.formSendCta,
  hint: contact.formHint,
  services: serviceOptions,
};
---

<form class="enquiry" data-enquiry data-config={JSON.stringify(config)} novalidate>
  <div class="enquiry__row">
    <div class="enquiry__field enquiry__field--half">
      <label for={`${id}-name`}>{contact.formNameLabel}</label>
      <input
        id={`${id}-name`}
        name="name"
        type="text"
        placeholder={contact.formNamePlaceholder}
        autocomplete="name"
      />
    </div>

    <div class="enquiry__field enquiry__field--half">
      <label for={`${id}-email`}>{contact.formEmailLabel}</label>
      <input
        id={`${id}-email`}
        name="email"
        type="email"
        inputmode="email"
        placeholder={contact.formEmailPlaceholder}
        autocomplete="email"
      />
    </div>
  </div>

  <div class="enquiry__row">
    <div class="enquiry__field enquiry__field--half">
      <label for={`${id}-service`}>{contact.formServiceLabel}</label>
      <select id={`${id}-service`} name="service">
        {serviceOptions.map((option) => <option value={option}>{option}</option>)}
      </select>
    </div>

    <div class="enquiry__field enquiry__field--half">
      <label for={`${id}-budget`}>{contact.formBudgetLabel}</label>
      <select id={`${id}-budget`} name="budget">
        {budgetOptions.map((option) => <option value={option}>{option}</option>)}
      </select>
    </div>
  </div>

  <div class="enquiry__field">
    <label for={`${id}-brief`}>{contact.formBriefLabel}</label>
    <textarea
      id={`${id}-brief`}
      name="brief"
      rows="4"
      placeholder={contact.formBriefPlaceholder}></textarea>
  </div>

  {/* Left empty by people, filled in by bots. */}
  <div class="enquiry__trap" aria-hidden="true">
    <label for={`${id}-company`}>Company</label>
    <input id={`${id}-company`} name="company" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div class="enquiry__error" role="alert" data-error hidden></div>

  <div class="enquiry__actions">
    <button type="submit" class="enquiry__send enquiry__send--primary" data-submit>
      {contact.formSendCta}
    </button>
    {
      showWhatsApp && (
        <button type="button" class="enquiry__send enquiry__send--wa" data-send="whatsapp">
          {contact.formWhatsappCta}
        </button>
      )
    }
  </div>

  <p class="enquiry__hint" data-hint>{contact.formHint}</p>
</form>

<script>
  interface EnquiryConfig {
    whatsapp: string;
    greeting: string;
    errorName: string;
    errorEmail: string;
    errorBrief: string;
    sentWhatsapp: string;
    sending: string;
    success: string;
    sendError: string;
    sendCta: string;
    hint: string;
    services: string[];
  }

  function setupForms() {
    document.querySelectorAll<HTMLFormElement>('[data-enquiry]').forEach((form) => {
      // The client router re-runs this on every navigation; the home and contact
      // pages each carry a form, so guard against binding one twice.
      if (form.dataset.bound) return;
      form.dataset.bound = '1';

      const config: EnquiryConfig = JSON.parse(form.dataset.config || '{}');

      const field = <T extends HTMLElement>(name: string) =>
        form.querySelector<T>(`[name="${name}"]`)!;

      const nameInput = field<HTMLInputElement>('name');
      const emailInput = field<HTMLInputElement>('email');
      const serviceInput = field<HTMLSelectElement>('service');
      const budgetInput = field<HTMLSelectElement>('budget');
      const briefInput = field<HTMLTextAreaElement>('brief');
      const trapInput = field<HTMLInputElement>('company');
      const errorBox = form.querySelector<HTMLElement>('[data-error]')!;
      const hintBox = form.querySelector<HTMLElement>('[data-hint]')!;
      const submitButton = form.querySelector<HTMLButtonElement>('[data-submit]')!;

      // A service card on the home page links here with ?service=… so the right
      // option is already chosen when the visitor arrives.
      const preset = new URLSearchParams(window.location.search).get('service');
      if (preset && config.services.includes(preset)) serviceInput.value = preset;

      const showError = (message: string, focus?: HTMLElement) => {
        errorBox.textContent = message;
        errorBox.hidden = false;
        focus?.focus();
      };

      const clearError = () => {
        errorBox.textContent = '';
        errorBox.hidden = true;
      };

      form.addEventListener('input', clearError);

      const values = () => ({
        name: nameInput.value.trim(),
        email: emailInput.value.trim(),
        service: serviceInput.value,
        budget: budgetInput.value,
        brief: briefInput.value.trim(),
        company: trapInput.value,
      });

      /** Shared by both routes. WhatsApp does not need the email address. */
      function validate(requireEmail: boolean) {
        const v = values();
        if (!v.name) {
          showError(config.errorName, nameInput);
          return null;
        }
        if (requireEmail && !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v.email)) {
          showError(config.errorEmail, emailInput);
          return null;
        }
        if (v.brief.length < 10) {
          showError(config.errorBrief, briefInput);
          return null;
        }
        clearError();
        return v;
      }

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const v = validate(true);
        if (!v) return;

        submitButton.disabled = true;
        submitButton.textContent = config.sending;

        try {
          const response = await fetch('/api/enquiry', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(v),
          });

          if (!response.ok) throw new Error(String(response.status));

          form.reset();
          hintBox.textContent = config.success;
        } catch {
          showError(config.sendError);
        } finally {
          submitButton.disabled = false;
          submitButton.textContent = config.sendCta;
        }
      });

      form
        .querySelector<HTMLButtonElement>('[data-send="whatsapp"]')
        ?.addEventListener('click', () => {
          const v = validate(false);
          if (!v) return;

          const body =
            `${config.greeting}\n\n` +
            `Name: ${v.name}\n` +
            (v.email ? `Email: ${v.email}\n` : '') +
            `Service: ${v.service}\n` +
            `Budget: ${v.budget}\n\n` +
            v.brief;

          window.open(
            `https://wa.me/${config.whatsapp}?text=${encodeURIComponent(body)}`,
            '_blank',
            'noopener'
          );
          hintBox.textContent = config.sentWhatsapp;
        });
    });
  }

  document.addEventListener('astro:page-load', setupForms);
</script>

<style>
  .enquiry {
    background: var(--surface-form);
    border-radius: var(--r-xl);
    padding: clamp(20px, 2.4vw, 30px);
    display: flex;
    flex-direction: column;
    gap: 16px;
    color: var(--ink-on-dark);
  }

  .enquiry__field {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  .enquiry__row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .enquiry__field--half {
    flex: 1 1 170px;
  }

  .enquiry label {
    font-size: 14px;
    letter-spacing: -0.016em;
    color: var(--ink-on-dark-muted);
  }

  .enquiry input,
  .enquiry select,
  .enquiry textarea {
    width: 100%;
    box-sizing: border-box;
    font-size: 17px;
    letter-spacing: -0.022em;
    padding: 14px 16px;
    border-radius: var(--r-xs);
    border: none;
    background: var(--surface-input);
    color: var(--ink-on-dark);
  }

  .enquiry input,
  .enquiry select {
    min-height: 50px;
  }

  .enquiry select {
    appearance: none;
    -webkit-appearance: none;
    cursor: pointer;
  }

  .enquiry textarea {
    line-height: 1.45;
    resize: vertical;
  }

  .enquiry ::placeholder {
    color: var(--ink-softer);
  }

  /* Off-screen rather than display:none, which some bots skip. */
  .enquiry__trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .enquiry__error {
    font-size: 14px;
    line-height: 1.45;
    letter-spacing: -0.016em;
    color: var(--error-on-dark);
  }

  .enquiry__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 4px;
  }

  .enquiry__send {
    cursor: pointer;
    flex: 1 1 auto;
    text-align: center;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 0 24px;
    border: none;
    border-radius: var(--r-xs);
    color: var(--ink-on-dark);
    font-size: 17px;
    letter-spacing: -0.022em;
    transition:
      transform 300ms var(--spring),
      background 0.2s,
      opacity 0.2s;
  }

  .enquiry__send:active {
    transform: scale(0.96);
  }

  .enquiry__send:disabled {
    opacity: 0.6;
    cursor: default;
  }

  .enquiry__send--primary {
    background: var(--blue);
  }

  .enquiry__send--primary:hover:not(:disabled) {
    background: var(--blue-hover);
  }

  .enquiry__send--wa {
    background: var(--surface-button-dark);
  }

  .enquiry__send--wa:hover {
    background: var(--surface-button-dark-hover);
  }

  .enquiry__hint {
    font-size: 13px;
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--ink-softer);
  }
</style>
