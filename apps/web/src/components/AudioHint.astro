---
/**
 * The one thing the page cannot show you.
 *
 * Several parts of this site make sound — the shock when the portrait is
 * pressed, the sweep under the theme wipe — and none of it survives a laptop
 * speaker in a quiet room, let alone a phone held at arm's length. There is no
 * way to demonstrate that; the visitor either has something on their ears
 * before they trigger it or they do not.
 *
 * So it has to be said, and it has to be said *first*. The mute switch already
 * exists and already carries the word "sound", but it arrives 700ms into the
 * storm — which is to say after the loudest thing on the site has already
 * played to somebody who might have had the wrong hardware for it. A
 * recommendation delivered after the thing it was recommending for is not a
 * recommendation, it is a receipt.
 *
 * Shaped like a system notification on purpose. A recommendation about
 * *hardware* is not the site talking about itself, and the notification is the
 * one form the whole web already reads as an aside from somewhere else — it
 * carries "this is about your setup, not about this page" without a word being
 * spent on saying so. It is drawn in this site's own material rather than
 * Apple's, though: a pixel-faithful macOS card is only native on a Mac and is
 * borrowed chrome on every other machine, which is a strange note to open on.
 */
---

<div class="ahint" data-audio-hint role="status" aria-live="polite" hidden>
  <div class="ahint__icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" focusable="false">
      <path
        d="M4.4 14.2v-2.4a7.6 7.6 0 0 1 15.2 0v2.4"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"></path>
      <rect x="2.5" y="13.3" width="4.3" height="7.2" rx="2.15" fill="currentColor"></rect>
      <rect x="17.2" y="13.3" width="4.3" height="7.2" rx="2.15" fill="currentColor"></rect>
    </svg>
  </div>

  <div class="ahint__body">
    <p class="ahint__title">
      Best with sound
      <span class="ahint__when">now</span>
    </p>
    <p class="ahint__text">Parts of this page are scored — headphones recommended.</p>
  </div>

  <button class="ahint__close" type="button" data-audio-hint-close aria-label="Dismiss">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path
        d="M7 7l10 10M17 7L7 17"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"></path>
    </svg>
  </button>
</div>

<style>
  .ahint {
    position: fixed;
    /* Clear of the nav, and tucked to the corner a notification comes from. */
    top: calc(var(--nav-h, 64px) + 14px);
    right: clamp(12px, 2vw, 22px);
    z-index: 9986;

    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: start;
    gap: 11px;

    width: min(340px, calc(100vw - 24px));
    padding: 13px 13px 14px;

    /*
     * The notification's material, which is the site's own.
     *
     * Same construction as the nav: a translucent ground with the page blurred
     * behind it and a hairline that is lighter than the fill. That is what
     * makes it read as a pane floating over the document rather than a box
     * drawn on it, and it is the reason this can be said in the site's voice
     * without looking like a cookie banner.
     */
    background: var(--ahint-bg);
    -webkit-backdrop-filter: blur(20px) saturate(1.6);
    /*
     * Prefixed first, standard last. The minifier drops the earlier of two
     * declarations it considers equivalent, and the nav shipped its tint with
     * no blur once by getting this the other way round — see the note in
     * SiteNav.astro, which cost a production round to find.
     */
    backdrop-filter: blur(20px) saturate(1.6);
    border: 1px solid var(--ahint-line);
    border-radius: 15px;
    box-shadow: var(--ahint-shadow);
    color: var(--ahint-ink);

    /* The resting state is off-stage; `is-in` below brings it on. */
    opacity: 0;
    transform: translate3d(16px, -10px, 0) scale(0.96);
    pointer-events: none;
  }

  /*
   * Light is the base, and the values are the page's own rather than a grey.
   *
   * A neutral white card on this background reads as a browser dialog. Mixing
   * a little of the accent into both the fill and the hairline is what keeps
   * it part of the site while still sitting clearly on top of it.
   */
  .ahint {
    --ahint-bg: color-mix(in srgb, var(--blue) 4%, rgb(255 255 255 / 0.82));
    --ahint-line: color-mix(in srgb, var(--blue) 14%, rgb(0 0 0 / 0.08));
    --ahint-ink: var(--ink);
    --ahint-muted: var(--ink-muted);
    --ahint-shadow:
      0 12px 32px rgb(0 0 0 / 0.14),
      0 2px 6px rgb(0 0 0 / 0.06);
  }

  :global(:root[data-theme='dark']) .ahint,
  :global(:root[data-surface='void']) .ahint {
    --ahint-bg: color-mix(in srgb, var(--blue) 7%, rgb(28 28 32 / 0.8));
    --ahint-line: color-mix(in srgb, #fff 12%, transparent);
    --ahint-shadow:
      0 14px 38px rgb(0 0 0 / 0.55),
      0 2px 6px rgb(0 0 0 / 0.35);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .ahint {
      --ahint-bg: color-mix(in srgb, var(--blue) 7%, rgb(28 28 32 / 0.8));
      --ahint-line: color-mix(in srgb, #fff 12%, transparent);
      --ahint-shadow:
        0 14px 38px rgb(0 0 0 / 0.55),
        0 2px 6px rgb(0 0 0 / 0.35);
    }
  }

  /* Super mode is already violet; the card joins it rather than fighting it. */
  :global(:root[data-super]) .ahint {
    --ahint-bg: color-mix(in srgb, var(--dm-deep) 34%, rgb(16 0 42 / 0.82));
    --ahint-line: color-mix(in srgb, var(--dm-arc) 34%, transparent);
  }

  .ahint[data-shown] {
    pointer-events: auto;
  }

  .ahint.is-in {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
    /*
     * In on a curve that overshoots slightly and settles, which is what a
     * panel pushed onto the screen does. Out is quicker and straight back the
     * way it came — leaving is not an event and should not be given one.
     */
    transition:
      opacity 260ms cubic-bezier(0.2, 0.8, 0.25, 1),
      transform 420ms cubic-bezier(0.16, 1.1, 0.3, 1);
  }

  .ahint.is-out {
    opacity: 0;
    transform: translate3d(14px, -6px, 0) scale(0.97);
    transition:
      opacity 200ms ease,
      transform 240ms ease;
  }

  /*
   * The icon tile.
   *
   * A notification's icon is the sender, and the squircle is what says so —
   * the shape is doing the "this is an application speaking" work that the
   * rest of the card deliberately does not.
   */
  .ahint__icon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: linear-gradient(
      150deg,
      color-mix(in srgb, var(--blue) 88%, #fff),
      color-mix(in srgb, var(--blue) 70%, #000)
    );
    color: #fff;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.22);
  }

  .ahint__icon svg {
    width: 20px;
    height: 20px;
    display: block;
  }

  .ahint__body {
    min-width: 0;
  }

  .ahint__title {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    margin: 1px 0 2px;
    font-size: 0.8125rem;
    font-weight: 650;
    letter-spacing: -0.005em;
    line-height: 1.25;
  }

  /* The timestamp every notification carries, and the only part that is set
     dressing. It is what makes the shape legible as a notification at a
     glance, before a word of it has been read. */
  .ahint__when {
    flex: none;
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--ahint-muted);
  }

  .ahint__text {
    margin: 0;
    font-size: 0.78125rem;
    line-height: 1.4;
    color: var(--ahint-muted);
    text-wrap: pretty;
  }

  /*
   * Present, not hidden until hover.
   *
   * macOS reveals the close control on hover, which is fine on a pointer and
   * is nothing at all on a touch screen — where this is most likely to be in
   * the way. It is quiet instead: low contrast until it is wanted.
   */
  .ahint__close {
    flex: none;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    margin: -2px -2px 0 0;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--ahint-muted);
    opacity: 0.55;
    cursor: pointer;
    transition:
      opacity 160ms ease,
      background-color 160ms ease;
  }

  .ahint__close svg {
    width: 13px;
    height: 13px;
    display: block;
  }

  .ahint__close:hover,
  .ahint__close:focus-visible {
    opacity: 1;
    background: color-mix(in srgb, currentColor 12%, transparent);
  }

  @media (max-width: 560px) {
    .ahint {
      left: clamp(12px, 3vw, 22px);
      right: clamp(12px, 3vw, 22px);
      width: auto;
    }
  }

  /*
   * Asked for less movement, not less information.
   *
   * The card still arrives and still leaves — it is the only way the visitor
   * learns there is sound at all. It simply stops travelling to do it.
   */
  @media (prefers-reduced-motion: reduce) {
    .ahint {
      transform: none;
    }

    .ahint.is-in {
      transform: none;
      transition: opacity 200ms linear;
    }

    .ahint.is-out {
      transform: none;
      transition: opacity 160ms linear;
    }
  }
</style>

<script>
  import * as sound from '../scripts/designer-sound';

  const KEY = 'mh-audio-hint-seen';

  /**
   * When it arrives, and why it is two numbers.
   *
   * The intro curtain owns the first two and a half seconds of a first visit
   * and removes itself at 2500ms, so anything appearing underneath it is
   * either invisible or fighting it. On a later page in the same session the
   * curtain never plays, and waiting three seconds to say this would mean
   * saying it after the visitor has already started reading — or already
   * pressed the portrait.
   */
  const AFTER_CURTAIN = 2900;
  const WITHOUT_CURTAIN = 1100;

  /** Long enough to read twice, which is the bar for something nobody asked for. */
  const LINGER = 9000;

  let timers: number[] = [];

  function clearTimers(): void {
    for (const id of timers) window.clearTimeout(id);
    timers = [];
  }

  function setup(): void {
    const card = document.querySelector<HTMLElement>('[data-audio-hint]');
    if (!card) return;

    clearTimers();

    /*
     * The home page only, and once.
     *
     * It is a recommendation about the visit rather than about the page, so
     * repeating it on the way to a case study would be nagging — and the
     * client router would otherwise offer it again on every navigation, since
     * the markup is part of every document.
     */
    if (window.location.pathname !== '/') {
      card.remove();
      return;
    }

    let seen = false;
    try {
      seen = sessionStorage.getItem(KEY) === '1';
    } catch {
      /* Private mode, or storage refused. Treat it as a first arrival — the
         cost of showing this twice is far below the cost of never showing it. */
    }

    /*
     * Somebody who has already muted the sound has answered this.
     *
     * Recommending headphones to a visitor who turned the audio off is not a
     * helpful aside, it is not listening.
     */
    if (seen || sound.isMuted()) {
      card.remove();
      return;
    }

    const curtain = document.querySelector('[data-intro]');
    const wait = curtain ? AFTER_CURTAIN : WITHOUT_CURTAIN;

    let gone = false;

    function dismiss(): void {
      if (gone) return;
      gone = true;
      clearTimers();
      card!.classList.remove('is-in');
      card!.classList.add('is-out');
      card!.removeAttribute('data-shown');
      timers.push(window.setTimeout(() => card!.remove(), 320));
    }

    timers.push(
      window.setTimeout(() => {
        try {
          sessionStorage.setItem(KEY, '1');
        } catch {
          /* not fatal */
        }

        card.hidden = false;
        card.setAttribute('data-shown', '');
        // A frame between being laid out and being told to move, or the
        // transition has no start value to leave from and it simply appears.
        requestAnimationFrame(() => card.classList.add('is-in'));

        timers.push(window.setTimeout(dismiss, LINGER));
      }, wait)
    );

    /*
     * Hovering holds it open, which is the one borrowed behaviour worth
     * keeping: the reason a notification pauses under the pointer is that
     * somebody reaching for it is plainly still reading it.
     */
    card.addEventListener('pointerenter', clearTimers);
    card.addEventListener('pointerleave', () => {
      if (!gone) timers.push(window.setTimeout(dismiss, 2200));
    });

    card.querySelector('[data-audio-hint-close]')?.addEventListener('click', dismiss);
    card.addEventListener('click', dismiss);
  }

  /*
   * Bound to `document`, because the client router replaces the page on every
   * navigation and a listener on the card is a listener on a node that is
   * about to be detached.
   */
  document.addEventListener('astro:page-load', setup);
  document.addEventListener('astro:before-swap', clearTimers);
</script>
