---
/**
 * The one thing the page cannot show you.
 *
 * Several parts of this site make sound — the shock when the portrait is
 * pressed, the sweep under the theme wipe — and none of it survives a laptop
 * speaker in a quiet room, let alone a phone held at arm's length. There is no
 * way to demonstrate that; the visitor either has something on their ears
 * before they trigger it or they do not.
 *
 * So it has to be said, and it has to be said *first*. The mute switch already
 * exists and already carries the word "sound", but it arrives 700ms into the
 * storm — which is to say after the loudest thing on the site has already
 * played to somebody who might have had the wrong hardware for it. A
 * recommendation delivered after the thing it was recommending for is not a
 * recommendation, it is a receipt.
 *
 * It is not a notification and is deliberately not dressed as one. The first
 * version was: an icon on a coloured tile, a title, a body, a timestamp. All
 * of that is an operating system's furniture, and none of it belongs to a site
 * that has its own. There is no sender here, nothing has just happened, and
 * there is no moment to stamp — it is one sentence of advice, so it is one
 * line, in the shape this site already uses for the one thing that floats over
 * the page: the nav.
 */
---

<div class="ahint" data-audio-hint role="status" aria-live="polite" hidden>
  <svg class="ahint__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M4.4 13.6v-1.8a7.6 7.6 0 0 1 15.2 0v1.8"></path>
    <rect x="2.9" y="13.5" width="4.2" height="6.6" rx="2.1"></rect>
    <rect x="16.9" y="13.5" width="4.2" height="6.6" rx="2.1"></rect>
  </svg>

  <span class="ahint__text">For a better experience, raising your audio is recommended</span>

  <button class="ahint__close" type="button" data-audio-hint-close aria-label="Dismiss">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M7 7l10 10M17 7L7 17"></path>
    </svg>
  </button>
</div>

<style>
  /*
   * The nav's glass, and the same shape.
   *
   * Every value here is the bar's own scrolled state, copied rather than
   * referenced — and that is not laziness. `--nav-bg`, `--nav-blur` and
   * `--nav-shadow` are live: `chrome.ts` sets them to `transparent` and `none`
   * whenever the page is at the top, which is exactly where this appears. A
   * card reading those tokens would arrive completely invisible on the one
   * screen it exists for. What is wanted is the *dressed* bar, always, so the
   * dressed values are written out.
   *
   * The pill radius, the absence of any border, the double shadow and the
   * saturate-and-blur are all the nav's. A hairline was tried and is wrong
   * here for the reason it is wrong there: the bar is a sheet of glass lit
   * from behind, and an outline turns it into a drawn box.
   */
  .ahint {
    position: fixed;
    top: calc(var(--nav-top, 18px) + 54px);
    right: clamp(12px, 2.4vw, 26px);
    z-index: 9986;

    display: inline-flex;
    align-items: center;
    gap: 9px;
    max-width: calc(100vw - 24px);
    padding: 9px 12px 9px 14px;

    border-radius: var(--r-pill);
    background: var(--ahint-bg);
    -webkit-backdrop-filter: var(--ahint-blur);
    /*
     * Prefixed first, standard last. The minifier drops the earlier of two
     * declarations it considers equivalent, and the nav shipped its tint with
     * no blur once by getting this the other way round — see the note in
     * SiteNav.astro, which cost a production round to find.
     */
    backdrop-filter: var(--ahint-blur);
    box-shadow: var(--ahint-shadow);
    color: var(--ahint-ink);

    /* Off-stage at rest; `is-in` brings it on. */
    opacity: 0;
    transform: translate3d(0, -8px, 0);
    pointer-events: none;
  }

  /* Light: the bar's own light-ground values. */
  .ahint {
    --ahint-bg: rgba(255, 255, 255, 0.72);
    --ahint-ink: #1d1d1f;
    --ahint-blur: saturate(200%) contrast(1.03) brightness(1) blur(16px);
    --ahint-shadow:
      0 1px 2px rgba(0, 0, 0, 0.04),
      0 8px 28px rgba(0, 0, 0, 0.08);
  }

  :global(:root[data-theme='dark']) .ahint,
  :global(:root[data-surface='void']) .ahint {
    --ahint-bg: rgba(22, 22, 26, 0.68);
    --ahint-ink: #ffffff;
    --ahint-blur: saturate(200%) contrast(1.03) brightness(1.05) blur(16px);
    --ahint-shadow:
      0 1px 2px rgba(0, 0, 0, 0.14),
      0 8px 28px rgba(0, 0, 0, 0.28);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .ahint {
      --ahint-bg: rgba(22, 22, 26, 0.68);
      --ahint-ink: #ffffff;
      --ahint-blur: saturate(200%) contrast(1.03) brightness(1.05) blur(16px);
      --ahint-shadow:
        0 1px 2px rgba(0, 0, 0, 0.14),
        0 8px 28px rgba(0, 0, 0, 0.28);
    }
  }

  /* Super mode has its own ground in the bar, and this takes the same one. */
  :global(:root[data-super]) .ahint {
    --ahint-bg: rgba(20, 7, 40, 0.7);
    --ahint-ink: #ffffff;
  }

  .ahint[data-shown] {
    pointer-events: auto;
  }

  .ahint.is-in {
    opacity: 1;
    transform: translate3d(0, 0, 0);
    transition:
      opacity 320ms ease,
      transform 420ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ahint.is-out {
    opacity: 0;
    transform: translate3d(0, -6px, 0);
    transition:
      opacity 240ms ease,
      transform 240ms ease;
  }

  /*
   * Line art, and nothing behind it.
   *
   * The icon had a filled squircle under it, which is the one detail that
   * gives away a borrowed operating system: a tile means an application, and
   * an application means a sender. There is no sender. Stroked at the same
   * weight as the type it sits beside and inheriting the same colour, it is a
   * mark in the sentence rather than a badge in front of it.
   */
  .ahint__icon {
    flex: none;
    width: 17px;
    height: 17px;
    display: block;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    /* Optically centred against the cap height rather than the line box. */
    margin-top: -1px;
  }

  .ahint__text {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: -0.003em;
    line-height: 1.2;
    white-space: nowrap;
  }

  .ahint__close {
    flex: none;
    display: grid;
    place-items: center;
    width: 18px;
    height: 18px;
    margin-left: 1px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: inherit;
    opacity: 0.4;
    cursor: pointer;
    transition:
      opacity 160ms ease,
      background-color 160ms ease;
  }

  .ahint__close svg {
    width: 11px;
    height: 11px;
    display: block;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
  }

  .ahint__close:hover,
  .ahint__close:focus-visible {
    opacity: 1;
    background: color-mix(in srgb, currentColor 14%, transparent);
  }

  /*
   * Narrow screens let the sentence wrap rather than shrink it.
   *
   * A pill that runs off the side of a phone is worse than a pill on two
   * lines, and the radius carries either.
   */
  @media (max-width: 430px) {
    .ahint {
      left: clamp(12px, 3vw, 26px);
      right: clamp(12px, 3vw, 26px);
      justify-content: center;
    }

    .ahint__text {
      white-space: normal;
    }
  }

  /*
   * Asked for less movement, not less information.
   *
   * It still arrives and still leaves — it is the only way the visitor learns
   * there is sound at all. It simply stops travelling to do it.
   */
  @media (prefers-reduced-motion: reduce) {
    .ahint,
    .ahint.is-in,
    .ahint.is-out {
      transform: none;
    }

    .ahint.is-in {
      transition: opacity 240ms linear;
    }

    .ahint.is-out {
      transition: opacity 180ms linear;
    }
  }
</style>

<script>
  import * as sound from '../scripts/designer-sound';

  const KEY = 'mh-audio-hint-seen';

  /**
   * When it arrives, and why it is two numbers.
   *
   * The intro curtain owns the first two and a half seconds of a first visit
   * and removes itself at 2500ms, so anything appearing underneath it is
   * either invisible or fighting it. On a later page in the same session the
   * curtain never plays, and waiting three seconds to say this would mean
   * saying it after the visitor has already started reading — or already
   * pressed the portrait.
   */
  const AFTER_CURTAIN = 2900;
  const WITHOUT_CURTAIN = 1100;

  /** Long enough to read twice, which is the bar for something nobody asked for. */
  const LINGER = 9000;

  let timers: number[] = [];

  function clearTimers(): void {
    for (const id of timers) window.clearTimeout(id);
    timers = [];
  }

  function setup(): void {
    const card = document.querySelector<HTMLElement>('[data-audio-hint]');
    if (!card) return;

    clearTimers();

    /*
     * The home page only, and once.
     *
     * It is a recommendation about the visit rather than about the page, so
     * repeating it on the way to a case study would be nagging — and the
     * client router would otherwise offer it again on every navigation, since
     * the markup is part of every document.
     */
    if (window.location.pathname !== '/') {
      card.remove();
      return;
    }

    let seen = false;
    try {
      seen = sessionStorage.getItem(KEY) === '1';
    } catch {
      /* Private mode, or storage refused. Treat it as a first arrival — the
         cost of showing this twice is far below the cost of never showing it. */
    }

    /*
     * Somebody who has already muted the sound has answered this.
     *
     * Recommending headphones to a visitor who turned the audio off is not a
     * helpful aside, it is not listening.
     */
    if (seen || sound.isMuted()) {
      card.remove();
      return;
    }

    const curtain = document.querySelector('[data-intro]');
    const wait = curtain ? AFTER_CURTAIN : WITHOUT_CURTAIN;

    let gone = false;
    let shown = false;

    function dismiss(): void {
      if (gone) return;
      gone = true;
      clearTimers();
      card!.classList.remove('is-in');
      card!.classList.add('is-out');
      card!.removeAttribute('data-shown');
      timers.push(window.setTimeout(() => card!.remove(), 320));
    }

    /*
     * And it waits for somebody to be there.
     *
     * Timers keep running in a background tab, throttled but running, so
     * without this the pill would show itself and time out while the tab was
     * in the background — spending the one chance this gets on an empty room.
     * If the page is hidden when its moment comes, it simply waits for the
     * visitor to come back and starts then.
     */
    function reveal(): void {
      if (shown || gone) return;

      if (document.hidden) {
        document.addEventListener('visibilitychange', reveal, { once: true });
        return;
      }

      shown = true;

      /*
       * Spent here, at the moment it is actually shown to somebody.
       *
       * Not when the timer was set and not on arrival: this is the one chance
       * per session, and marking it used before it has been seen is how the
       * visitor ends up never getting it at all.
       */
      try {
        sessionStorage.setItem(KEY, '1');
      } catch {
        /* not fatal */
      }

      card!.hidden = false;
      card!.setAttribute('data-shown', '');

      /*
       * A forced reflow to start the transition, not a frame.
       *
       * The transition needs the element to have been laid out at its starting
       * value before the end value is set, or there is nothing to interpolate
       * from and it simply appears. `requestAnimationFrame` is the usual way to
       * buy that and it is the wrong one here: rAF does not fire at all in a
       * tab that is not being presented, so opening the home page in a
       * background tab left `is-in` unset and the pill stuck at zero opacity.
       * Reading `offsetWidth` settles the layout synchronously and owes nothing
       * to the frame clock.
       */
      void card!.offsetWidth;
      card!.classList.add('is-in');

      timers.push(window.setTimeout(dismiss, LINGER));
    }

    timers.push(window.setTimeout(reveal, wait));

    /*
     * Hovering holds it open. Not borrowed furniture this time — somebody
     * reaching for a line of text is plainly still reading it.
     */
    card.addEventListener('pointerenter', clearTimers);
    card.addEventListener('pointerleave', () => {
      if (!gone) timers.push(window.setTimeout(dismiss, 2200));
    });

    card.querySelector('[data-audio-hint-close]')?.addEventListener('click', dismiss);
    card.addEventListener('click', dismiss);
  }

  /*
   * Bound to `document`, because the client router replaces the page on every
   * navigation and a listener on the card is a listener on a node that is
   * about to be detached.
   */
  document.addEventListener('astro:page-load', setup);
  document.addEventListener('astro:before-swap', clearTimers);
</script>
