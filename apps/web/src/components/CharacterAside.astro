---
/**
 * A character leaning into the page with something to say.
 *
 * Deliberately not an illustration section. It sits at the end of whatever it
 * is put in, aligned to the right edge of the same shell as everything else, at
 * about the size of a large avatar — close enough to the page's own furniture
 * that it reads as an aside rather than a banner. Nothing above it moves to
 * make room, because it takes up the width that was already there.
 *
 * Two of these exist: the thinking one at the end of the home page, and the
 * hushing one under the older work. Both are found rather than presented, so
 * neither is in the document until the visitor has come far enough to earn it.
 */
interface Props {
  /** Character artwork. Transparent background, no frame. */
  src: string;
  /**
   * The artwork's own pixel size. Declared so the browser can reserve the right
   * shape before the file arrives: the art is lazy and sits at the end of a
   * page, which is exactly where an unsized image shifts the layout under
   * someone who has just scrolled to it.
   */
  width: number;
  height: number;
  /** What he is doing, not what he looks like — he is the aside, not content. */
  alt: string;
  /**
   * What he says, in order. The first is what he arrives with; every press
   * takes the next, and the last wraps round to the second — the opening line
   * only makes sense as an opening.
   */
  lines: string[];
  /**
   * Which set of surfaces the bubble is built from. The home page's last
   * section is a dark panel in both themes and needs the on-dark set, the
   * same one the enquiry form's menu uses; everywhere else follows the page.
   */
  tone?: 'page' | 'dark';
}

const { src, alt, lines, width, height, tone = 'page' } = Astro.props;
---

<aside
  class="aside"
  class:list={[`aside--${tone}`]}
  data-character
  data-lines={JSON.stringify(lines)}
>
  <div class="aside__inner">
    <p class="aside__bubble">
      {/* The bolt that crosses the bubble as one line becomes the next. Its own
          clipping box, because the bubble cannot have one — the tail hangs
          outside it. */}
      <span class="aside__bolt" aria-hidden="true"></span>
      <span class="aside__say" data-say aria-live="polite">{lines[0]}</span>
    </p>

    <button class="aside__figure" type="button" data-say-more aria-label="Ask him again">
      {/* The flicker. One element, behind him, that blooms and goes out. */}
      <span class="aside__spark" aria-hidden="true"></span>
      <img
        class="aside__art"
        src={src}
        alt={alt}
        width={width}
        height={height}
        loading="lazy"
        decoding="async"
      />
    </button>
  </div>
</aside>

<script>
  /**
   * Brings each character in once, then stops watching.
   *
   * A scroll listener on a timestamp throttle. The throttle is 120ms and the
   * listener takes itself off as soon as the last character has arrived, so
   * the cost is a handful of rect reads spread across one scroll and nothing
   * at all afterwards.
   */
  import * as sound from '../scripts/designer-sound';

  /**
   * Takes the previous page's scroll listener off.
   *
   * Without this the listener outlives the page that added it: it is only
   * removed once every character on that page has arrived, and one who never
   * did — the usual case, since he sits at the foot of a long page — leaves it
   * attached for good. The stale closure then answers the next page's scrolls
   * while holding an element that is no longer in the document, and a detached
   * element reports a rect of zeros, so it is always considered to be in view.
   *
   * That is why pressing a nav link made a strike: the router scrolls the new
   * page to the top, the old page's listener heard it, measured a character
   * who had been thrown away, decided he had just been reached, and rang.
   */
  let detach: (() => void) | null = null;

  /**
   * Opens the audio device on the first press anywhere, once per visit.
   *
   * Without this he is silent on the work page however far you scroll to him.
   * The easter egg already does exactly this, but it only exists on the home
   * page, so nothing there had ever created a context and the arrival could
   * not be heard at all — the sound was only ever reaching people who had been
   * to the home page first in the same visit.
   *
   * A press is the gesture the autoplay policy asks for, and most visitors
   * press something long before they reach the foot of the page. It costs one
   * context and about fifty milliseconds of synthesis, and only on the two
   * pages a character actually stands on.
   */
  let armed = false;

  function armVoice() {
    if (armed) return;
    armed = true;
    document.addEventListener('pointerdown', () => sound.unlock(), {
      once: true,
      passive: true,
    });
  }

  function setupCharacters() {
    detach?.();
    detach = null;

    const nodes = Array.from(document.querySelectorAll<HTMLElement>('[data-character]'));
    if (!nodes.length) return;

    armVoice();

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /** Still waiting to be shown. Emptied as they arrive. */
    const pending = nodes.filter((el) => {
      if (el.dataset.arrived) return false;
      el.dataset.arrived = '1';
      return true;
    });
    if (!pending.length) return;

    /**
     * Brings him in. `reached` is true only when the visitor got here by
     * scrolling to him.
     *
     * The strike used to fire on every arrival and kept landing a beat after a
     * nav link or a back button, which read as the link having made the sound.
     * Three things had to be true before it could be trusted, and only one of
     * them was:
     *
     *  - the listener from the page before is taken off at before-swap, and a
     *    detached element is never measured. That was the real fault: a
     *    detached element reports a rect of zeros, which reads as in view, so
     *    the old page's listener heard the new page scroll to the top and rang
     *    for a character that had already been thrown away.
     *  - the pass at setup is silent. He may already be on screen because the
     *    page is short or a scroll position was restored, and neither is
     *    something the visitor did.
     *  - a scroll in the first stretch after a page settles is the router
     *    restoring a position, not the visitor moving. Also silent.
     *
     * He still arrives in all of those cases. He just does it quietly.
     */
    function arrive(el: HTMLElement, reached: boolean) {
      // Reduced motion gets him without the entrance rather than without him.
      el.classList.add(reduced ? 'aside--instant' : 'aside--here');
      // Quiet, and only if the page is already making sound. A reduced-motion
      // visitor still gets it: a sound is not something that moves.
      if (reached) sound.spark(0.16);
    }

    /**
     * Hands over the next line, under a bolt.
     *
     * The text is swapped while it is hidden, a third of the way through, so
     * the two lines are never both legible and the change reads as the flash
     * doing it rather than as a word replacement. Reduced motion swaps
     * straight over; the bolt is the animation, so there is nothing to soften.
     */
    function speak(el: HTMLElement) {
      const say = el.querySelector<HTMLElement>('[data-say]');
      const script: string[] = JSON.parse(el.dataset.lines || '[]');
      if (!say || script.length < 2) return;

      const at = Number(el.dataset.line || 0);
      // Round to the second line, never the first: the opener only opens.
      const next = at + 1 >= script.length ? 1 : at + 1;
      el.dataset.line = String(next);

      /*
       * Pressing him is what gives him a voice.
       *
       * The easter egg opens the audio device on the first press anywhere, but
       * it only exists on the home page — so on the work page nothing had ever
       * created a context and he was mute however many times he was pressed.
       * This is a press on a control that makes a sound, which is exactly the
       * gesture the autoplay policy is asking for, and it means his arrival can
       * be heard from then on too.
       */
      sound.unlock();
      sound.spark(0.28);

      if (reduced) {
        say.textContent = script[next];
        return;
      }

      el.classList.remove('aside--zap');
      // Reading a layout property flushes the removal, so a second press
      // restarts the bolt instead of being swallowed by the running one.
      void el.offsetWidth;
      el.classList.add('aside--zap');

      window.setTimeout(() => {
        say.textContent = script[next];
      }, 130);

      window.setTimeout(() => el.classList.remove('aside--zap'), 480);
    }

    /*
     * He arrives when the visitor reaches him, and not on any measure of the
     * page as a whole. Two thirds up the viewport rather than at the edge, so
     * he is properly on screen before the light goes — announcing himself from
     * the bottom edge means the flash happens where nobody is looking.
     */
    function due(el: HTMLElement): boolean {
      return el.getBoundingClientRect().top < window.innerHeight * 0.66;
    }

    let waiting = pending;
    let last = 0;

    /** When this page settled. Scrolls before this are the router's, not his. */
    const settledAt = Date.now();
    const OWN_SCROLL_AFTER = 600;

    function pass(reached: boolean) {
      waiting = waiting.filter((el) => {
        // An element that has left the document is not waiting for anything,
        // and a detached one reports a rect of zeros — which reads as in view.
        if (!el.isConnected) return false;
        if (!due(el)) return true;
        arrive(el, reached);
        return false;
      });

      if (!waiting.length) {
        window.removeEventListener('scroll', onScroll);
        detach = null;
      }
    }

    function onScroll() {
      const now = Date.now();
      if (now - last < 120) return;
      last = now;
      pass(now - settledAt > OWN_SCROLL_AFTER);
    }

    for (const el of pending) {
      el.querySelector<HTMLElement>('[data-say-more]')?.addEventListener('click', () =>
        speak(el)
      );
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    detach = () => window.removeEventListener('scroll', onScroll);

    // The trigger may already be met on arrival — a short page, or a restored
    // scroll position that lands past it. Silently: see arrive().
    pass(false);
  }

  document.addEventListener('astro:page-load', setupCharacters);

  // The page is going; so is anything it was still listening for.
  document.addEventListener('astro:before-swap', () => {
    detach?.();
    detach = null;
  });
</script>

<style>
  .aside {
    /* The same shell and gutter as the section it sits in, so he lines up with
       the content above rather than with the window. */
    max-width: var(--shell);
    margin: 0 auto;
    padding-top: clamp(30px, 4vw, 52px);
  }

  .aside__inner {
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    gap: clamp(10px, 1.4vw, 16px);
    /* He is an aside to the page, not a second column of it. Past this the
       bubble stops reading as a remark and starts reading as a paragraph. */
    max-width: 520px;
    margin-left: auto;
  }

  /* ------------------------------------------------------------------ */
  /* The character                                                       */
  /* ------------------------------------------------------------------ */

  /* A button, and it has to say so: this is the only thing on the page that
     asks to be pressed twice. */
  .aside__figure {
    appearance: none;
    border: 0;
    padding: 0;
    background: none;
    cursor: pointer;
    position: relative;
    flex: none;
    width: clamp(88px, 11vw, 124px);
    /* Bottom-aligned with the bubble, and sitting on the same line as the end
       of the section. */
    display: flex;
    align-items: flex-end;
  }

  .aside__figure:focus-visible {
    outline: 2px solid var(--dm-core);
    outline-offset: 4px;
    border-radius: 10px;
  }

  .aside__figure:active .aside__art {
    scale: 0.97;
  }

  .aside__art {
    transition: scale 180ms var(--ease-out);
    display: block;
    width: 100%;
    height: auto;
    /* He starts a little low and a little small, and settles. */
    opacity: 0;
    transform: translate3d(0, 10px, 0) scale(0.97);
  }

  /*
   * The light that says look here.
   *
   * This has a job beyond decoration: he arrives at the edge of a page the
   * visitor is reading down the middle of, and without something to catch the
   * eye he is simply missed. So the bloom covers the whole of him rather than
   * sitting behind his head, and it is bright enough to register in peripheral
   * vision — which is the only place it will be seen from.
   *
   * Still the storm's palette, spent carefully: --dm-glow and --dm-wave carry
   * the mass, and the hot --dm-core is the middle of it and nothing else.
   * Bright for about a third of a second, then gone.
   */
  .aside__spark {
    position: absolute;
    left: 50%;
    top: 42%;
    width: 150%;
    aspect-ratio: 1;
    translate: -50% -50%;
    border-radius: 50%;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--dm-core) 62%, transparent) 0%,
      color-mix(in srgb, var(--dm-glow) 40%, transparent) 26%,
      color-mix(in srgb, var(--dm-wave) 20%, transparent) 48%,
      color-mix(in srgb, var(--dm-deep) 8%, transparent) 66%,
      transparent 78%
    );
  }

  /* ------------------------------------------------------------------ */
  /* The bubble                                                          */
  /* ------------------------------------------------------------------ */

  /*
   * The bolt that crosses the bubble as the line changes.
   *
   * It needs a clipping box and the bubble cannot be one — the tail hangs
   * outside it — so this is a layer of its own, inset to the bubble's shape,
   * with the light swept across inside it.
   */
  .aside__bolt {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
  }

  .aside__bolt::before {
    content: '';
    position: absolute;
    top: -40%;
    bottom: -40%;
    left: 0;
    width: 38%;
    rotate: 8deg;
    filter: blur(1px);
    translate: -160% 0;
    background: linear-gradient(
      100deg,
      transparent 0%,
      color-mix(in srgb, var(--dm-arc) 42%, transparent) 38%,
      color-mix(in srgb, var(--dm-core) 82%, transparent) 50%,
      color-mix(in srgb, var(--dm-arc) 42%, transparent) 62%,
      transparent 100%
    );
  }

  .aside--zap .aside__bolt {
    opacity: 1;
  }

  .aside--zap .aside__bolt::before {
    animation: aside-bolt 420ms var(--ease-out) both;
  }

  @keyframes aside-bolt {
    from {
      translate: -160% 0;
    }
    to {
      translate: 420% 0;
    }
  }

  /*
   * The text is gone while the bolt is over it and comes back lit, so the
   * change reads as the flash having done it rather than as a word being
   * swapped. The swap itself happens at 130ms, inside the dark stretch.
   */
  .aside--zap .aside__say {
    animation: aside-say 460ms var(--ease-out) both;
  }

  @keyframes aside-say {
    0% {
      opacity: 1;
      color: var(--aside-ink);
    }
    20% {
      opacity: 0;
      color: var(--aside-ink);
    }
    42% {
      opacity: 0;
    }
    58% {
      opacity: 1;
      color: var(--dm-arc);
      text-shadow: 0 0 14px color-mix(in srgb, var(--dm-core) 65%, transparent);
    }
    100% {
      opacity: 1;
      color: var(--aside-ink);
      text-shadow: none;
    }
  }

  .aside__bubble {
    position: relative;
    flex: 1 1 auto;
    min-width: 0;
    margin-bottom: clamp(14px, 2vw, 26px);
    padding: 13px 16px;
    border-radius: var(--r-md);
    border: 1px solid var(--aside-line);
    background: var(--aside-surface);
    color: var(--aside-ink);
    box-shadow: var(--aside-shadow);
    font-size: 15px;
    line-height: 1.45;
    letter-spacing: -0.014em;
    text-wrap: pretty;

    opacity: 0;
    transform: translate3d(0, 6px, 0) scale(0.98);
    /* Grows out of the corner nearest him. */
    transform-origin: 100% 100%;
  }

  /*
   * The pointer, aimed at him.
   *
   * A small square rotated behind the bubble so only the corner clears the
   * edge. The two borders it carries are the two that meet at that corner, so
   * the outer point is drawn in the bubble's own line and the rest of the
   * square hides behind the bubble with no seam.
   *
   * Side by side he is to the right, so it leaves from the right edge, low
   * down — the bubble sits above his shoulder and the tail runs back to him.
   */
  .aside__bubble::after {
    content: '';
    position: absolute;
    right: -6px;
    bottom: 14px;
    width: 11px;
    height: 11px;
    background: var(--aside-surface);
    border-top: 1px solid var(--aside-line);
    border-right: 1px solid var(--aside-line);
    transform: rotate(45deg);
    /* A squircle on an 11px nub reads as a blob. */
    corner-shape: round;
    border-top-right-radius: 2px;
  }

  /* ---- The two tones ------------------------------------------------ */

  /*
   * Everything above paints from these four, and only these four change.
   */
  .aside--page {
    --aside-surface: var(--surface-card);
    --aside-ink: var(--ink);
    --aside-line: var(--line);
    --aside-shadow: 0 10px 26px rgba(0, 0, 0, 0.07), 0 1px 3px rgba(0, 0, 0, 0.05);
  }

  /* The home page's last section is a dark panel in both themes, so the bubble
     is built the way the enquiry form's menu is: a step lighter than the
     surface it floats over, with a hairline of caught light. */
  .aside--dark {
    --aside-surface: var(--surface-button-dark);
    --aside-ink: var(--ink-on-dark);
    --aside-line: var(--line-menu);
    --aside-shadow: 0 14px 32px rgba(0, 0, 0, 0.34), 0 2px 6px rgba(0, 0, 0, 0.22);
  }

  /* On a dark ground a plain shadow does nothing, so the bubble is given the
     faintest purple lift instead — the only place the accent touches it. */
  .aside--dark .aside__bubble {
    box-shadow:
      var(--aside-shadow),
      0 0 0 3px color-mix(in srgb, var(--dm-wave) 7%, transparent);
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .aside--page {
      --aside-shadow: 0 12px 30px rgba(0, 0, 0, 0.5), 0 1px 3px rgba(0, 0, 0, 0.4);
    }
  }

  :root[data-theme='dark'] .aside--page {
    --aside-shadow: 0 12px 30px rgba(0, 0, 0, 0.5), 0 1px 3px rgba(0, 0, 0, 0.4);
  }

  /* ------------------------------------------------------------------ */
  /* The arrival                                                         */
  /* ------------------------------------------------------------------ */

  /*
   * Flicker, then him, then what he says — in that order and quickly, so it
   * reads as one small event rather than three staged ones. The whole thing is
   * under a second and nothing about it is loud.
   */
  .aside--here .aside__spark {
    animation: aside-spark 420ms var(--ease-out) both;
  }

  .aside--here .aside__art {
    animation:
      aside-arrive 460ms var(--ease-out) 200ms both,
      aside-lit 620ms var(--ease-out) 200ms both;
  }

  .aside--here .aside__bubble {
    animation: aside-speak 380ms var(--ease-out) 480ms both;
  }

  @keyframes aside-spark {
    0% {
      opacity: 0;
      scale: 0.7;
    }
    /* Two beats rather than one bloom: a flicker is something failing to
       settle, and a single fade is just a light coming on. */
    28% {
      opacity: 1;
      scale: 1.02;
    }
    44% {
      opacity: 0.42;
      scale: 0.99;
    }
    60% {
      opacity: 0.8;
      scale: 1.05;
    }
    100% {
      opacity: 0;
      scale: 1.16;
    }
  }

  /*
   * He is lit by the same light rather than standing in front of it. A drop
   * shadow follows his cut-out edge, so the glow is around him and not around
   * a rectangle, and it fades as the bloom behind him does.
   */
  @keyframes aside-lit {
    0% {
      filter: drop-shadow(0 0 14px color-mix(in srgb, var(--dm-core) 85%, transparent));
    }
    45% {
      filter: drop-shadow(0 0 10px color-mix(in srgb, var(--dm-glow) 55%, transparent));
    }
    100% {
      filter: drop-shadow(0 0 0 transparent);
    }
  }

  @keyframes aside-arrive {
    from {
      opacity: 0;
      transform: translate3d(0, 10px, 0) scale(0.97);
    }
    to {
      opacity: 1;
      transform: translate3d(0, 0, 0) scale(1);
    }
  }

  @keyframes aside-speak {
    from {
      opacity: 0;
      transform: translate3d(0, 6px, 0) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translate3d(0, 0, 0) scale(1);
    }
  }

  /* No flicker, no rise — he is simply there, which is the whole effect for
     anyone who has asked not to be moved at. */
  .aside--instant .aside__art,
  .aside--instant .aside__bubble {
    opacity: 1;
    transform: none;
  }

  .aside--instant .aside__spark {
    display: none;
  }

  /* ------------------------------------------------------------------ */
  /* Narrow                                                              */
  /* ------------------------------------------------------------------ */

  /*
   * Not the desktop composition made small. On a phone the bubble takes the
   * width it needs and he stands under his own remark at the right-hand edge,
   * which keeps the line lengths readable instead of squeezing a paragraph
   * into whatever is left beside a picture.
   */
  @media (max-width: 560px) {
    .aside__inner {
      display: block;
      max-width: none;
    }

    .aside__bubble {
      margin-bottom: 10px;
      margin-left: auto;
      max-width: 30ch;
      transform-origin: 100% 100%;
    }

    /* He is underneath now, so the tail turns to point down at him. */
    .aside__bubble::after {
      right: 22px;
      bottom: -6px;
      border-top: none;
      border-bottom: 1px solid var(--aside-line);
      border-top-right-radius: 0;
      border-bottom-right-radius: 2px;
    }

    .aside__figure {
      width: 84px;
      margin-left: auto;
    }
  }
</style>
