---
/**
 * The avatar's eyes, redrawn so they can look at the pointer.
 *
 * Sits directly over the portrait and does nothing at all until the designer
 * easter egg is running. The portrait is a 1024x1024 drawing in a square frame,
 * so this can be a plain viewBox of the same size and every coordinate lines up
 * with the artwork without a single magic offset.
 *
 * Each eye is the same two shapes: the aperture, filled with the sclera's own
 * colour to wipe out the iris that is painted into the picture, and the iris
 * itself, redrawn and free to move. Everything is clipped to the aperture, so
 * an iris that slides far enough simply disappears under the eyelid — which is
 * what eyes do.
 *
 * The paths come from `apps/cms/scripts/trace-avatar-eyes.js`, which reads them
 * off the drawing. Replace the portrait and that script has to run again.
 */
import { AVATAR_EYES, SCLERA } from '../lib/avatar-eyes';

// Two clip paths need ids, and an id has to be unique in the document.
const uid = crypto.randomUUID().slice(0, 8);
---

<svg
  class="eyes"
  data-avatar-eyes
  viewBox="0 0 1024 1024"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <clipPath id={`eye-l-${uid}`}>
      <path d={AVATAR_EYES.left.opening} />
    </clipPath>
    <clipPath id={`eye-r-${uid}`}>
      <path d={AVATAR_EYES.right.opening} />
    </clipPath>
  </defs>

  <g clip-path={`url(#eye-l-${uid})`}>
    <path d={AVATAR_EYES.left.opening} fill={SCLERA} />
    <path class="eyes__iris" d={AVATAR_EYES.left.iris} />
  </g>

  <g clip-path={`url(#eye-r-${uid})`}>
    <path d={AVATAR_EYES.right.opening} fill={SCLERA} />
    <path class="eyes__iris" d={AVATAR_EYES.right.iris} />
  </g>
</svg>

<style>
  .eyes {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    /*
     * Invisible, and costing nothing, until the egg runs. Opacity alone would
     * leave two clip paths and four filled shapes in the compositor for the
     * whole life of every page that shows the portrait.
     */
    display: none;
  }

  :global(:root[data-designer]) .eyes {
    display: block;
    animation: eyes-in 420ms var(--ease-out) both;
  }

  @keyframes eyes-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .eyes__iris {
    fill: var(--egg-purple);
    /*
     * The offset is written to these two by the egg's pointer handler, in the
     * portrait's own units — which is why nothing here has to know how large
     * the portrait happens to be drawn.
     */
    transform: translate(var(--eye-x, 0px), var(--eye-y, 0px));
    transition:
      transform 260ms var(--ease-glide),
      fill 520ms var(--ease-glide);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(:root[data-designer]) .eyes {
      animation: none;
    }

    .eyes__iris {
      transition: none;
    }
  }
</style>
