---
/**
 * Designer mode. An easter egg behind the portrait.
 *
 * Click the picture and the interface is taken apart: a shock leaves the
 * character, crosses the viewport, and shoves every component off its mark as
 * it passes; headings come apart into letters; on a phone the hidden sidebar is
 * dragged out and fights before it is taken. Everything stops at once, held in
 * a purple field, and then the power drops and the page puts itself back
 * exactly as it was.
 *
 * Nothing announces it. There is no label, no hover state and no cursor change:
 * the portrait is a picture, and a picture that turns out to do something is
 * only a surprise if you were not told to expect one. It is the same bargain as
 * the layout grid on the G key.
 *
 * This component is the markup the sequence needs — the shock rings, the wash,
 * and the canvas the field is drawn on — plus the wiring. The sequence itself
 * is scripts/designer-mode.ts, and the sound is scripts/designer-sound.ts.
 *
 * It sits at the end of <main>, outside every section, and it has to: the rings
 * are fixed to the viewport, and a transformed ancestor would become their
 * containing block and clip the whole thing to one part of the page.
 */
import EggSound from './EggSound.astro';
---

<div class="ring" data-egg-ring aria-hidden="true"></div>
<div class="ring ring--trail" data-egg-ring-trail aria-hidden="true"></div>
<div class="wash" data-egg-wash aria-hidden="true"></div>
<canvas class="dm-field" data-egg-field aria-hidden="true"></canvas>
<EggSound />

<script>
  import * as mode from '../scripts/designer-mode';
  import * as sound from '../scripts/designer-sound';

  /**
   * Whatever will shut the egg down, or nothing if it is not on this page.
   *
   * The two listeners below live on `document`, which survives navigation, so
   * they are bound once and delegate here. Binding them inside setup would add
   * another pair every time the visitor came back to the home page, each one
   * holding the previous page's elements.
   */
  let dismiss: () => void = () => {};
  let globalsBound = false;

  function setupEgg() {
    const ring = document.querySelector<HTMLElement>('[data-egg-ring]');
    const trail = document.querySelector<HTMLElement>('[data-egg-ring-trail]');
    const wash = document.querySelector<HTMLElement>('[data-egg-wash]');
    const field = document.querySelector<HTMLCanvasElement>('[data-egg-field]');
    const trigger = document.querySelector<HTMLElement>('[data-egg-trigger]');
    const toggle = document.querySelector<HTMLButtonElement>('[data-egg-sound]');
    const label = document.querySelector<HTMLElement>('[data-egg-sound-label]');
    if (!ring || !trail || !wash || !field || !trigger) {
      dismiss = () => {};
      return;
    }

    const root = document.documentElement;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /** Sends the shock out from the click. */
    function ripple(originX: number, originY: number): void {
      const reach = Math.hypot(
        Math.max(originX, window.innerWidth - originX),
        Math.max(originY, window.innerHeight - originY)
      );

      // The wash under the field is centred on the same point.
      root.style.setProperty('--dm-fx', `${originX}px`);
      root.style.setProperty('--dm-fy', `${originY}px`);

      for (const el of [ring!, trail!, wash!]) {
        el.style.setProperty('--egg-x', `${originX}px`);
        el.style.setProperty('--egg-y', `${originY}px`);
        el.style.setProperty('--egg-reach', `${Math.ceil(reach)}px`);

        // Restart rather than continue: a second click inside the first
        // animation would otherwise do nothing at all.
        el.classList.remove('is-rippling');
        void el.offsetWidth;
        el.classList.add('is-rippling');
      }
    }

    /** The picture recoils from the press that landed on it. */
    function hit(): void {
      trigger!.classList.remove('is-hit');
      void trigger!.offsetWidth;
      trigger!.classList.add('is-hit');
    }

    /* ------------------------------------------------------------------ */
    /* The mute switch                                                     */
    /* ------------------------------------------------------------------ */

    /**
     * Puts the control in the state the session already settled on.
     *
     * Called on every setup, not only on the first: the button is markup and is
     * replaced on each client-side navigation, while the preference lives in the
     * sound module and outlives it.
     */
    function paintSwitch(): void {
      if (!toggle) return;
      const off = sound.isMuted();
      toggle.setAttribute('aria-pressed', off ? 'true' : 'false');
      toggle.setAttribute(
        'aria-label',
        off ? 'Unmute easter egg sounds' : 'Mute easter egg sounds'
      );
      if (label) label.textContent = off ? 'Easter egg sounds off' : 'Easter egg sounds';
    }

    /** Timers for the control's own arrival and departure, cancelled on teardown. */
    let switchTimers: number[] = [];

    function clearSwitchTimers(): void {
      for (const id of switchTimers) window.clearTimeout(id);
      switchTimers = [];
    }

    /**
     * Brings the control in once the shock has already crossed.
     *
     * Not on the click. The first half second is the loudest thing the site
     * does and a control sliding in underneath it is one more moving object in
     * a frame that has plenty; by 700ms the wave has passed, the field has
     * taken hold, and there is somewhere quiet for it to arrive.
     */
    function showSwitch(): void {
      if (!toggle) return;
      clearSwitchTimers();
      paintSwitch();
      toggle.hidden = false;
      switchTimers.push(
        window.setTimeout(() => toggle!.setAttribute('data-shown', ''), 700)
      );
    }

    /**
     * Takes it away with the last of the sound rather than on the last frame.
     *
     * The storm's picture finishes before its audio does — end() fades the
     * master over 350ms after the final piece has landed — so a control that
     * left on the same frame would be gone while there was still something to
     * mute. It holds through that fade and then goes on its own 520ms.
     */
    function hideSwitch(): void {
      if (!toggle) return;
      clearSwitchTimers();
      switchTimers.push(
        window.setTimeout(() => toggle!.removeAttribute('data-shown'), 620)
      );
      switchTimers.push(
        window.setTimeout(() => {
          toggle!.hidden = true;
          toggle!.removeAttribute('data-said');
        }, 1240)
      );
    }

    function stop(): void {
      mode.setArcListener(null);
      mode.teardown();
      sound.end();
      hideSwitch();
      root.style.removeProperty('--dm-fx');
      root.style.removeProperty('--dm-fy');
      trigger!.classList.remove('is-hit');
    }

    /*
     * Warm the purple-eyed portrait on the way down, not on the way up.
     *
     * It is lazy — most visitors never trigger this, and it is not worth the
     * bytes on every home page load for them. But a cross-fade to a picture
     * that has not arrived yet is a blank square, so pointerdown, which lands a
     * moment before the click, is where it gets fetched and decoded.
     */
    /*
     * Hovering the portrait is the earliest honest warning that the egg is
     * about to be triggered, and it costs a context that starts suspended and
     * fifty milliseconds of synthesis. By the press there is nothing left to
     * build; by the click the device is already open.
     */
    trigger.addEventListener('pointerenter', () => sound.warm(), { once: true });

    const alt = document.querySelector<HTMLImageElement>('.hero__portrait-alt');
    trigger.addEventListener(
      'pointerdown',
      () => {
        /*
         * The audio starts warming here too, and for the same reason.
         *
         * Creating the context and synthesising four seconds of blast took long
         * enough inside the click that the sound arrived visibly after the
         * wave — and a fresh AudioContext also needs a moment to spin its
         * render thread up before the clock it is being scheduled against
         * starts moving. pointerdown is a user gesture like any other, so the
         * autoplay policy is satisfied, and it lands a hundred milliseconds or
         * so before the click. By the time the wave leaves, there is nothing
         * left to prepare.
         */
        sound.unlock();

        if (!alt || alt.complete) return;
        alt.loading = 'eager';
        if (typeof alt.decode === 'function') void alt.decode().catch(() => {});
      },
      { once: true }
    );

    trigger.addEventListener('click', (event) => {
      // Already running: let it finish. Re-triggering mid-sequence would fight
      // its own teardown for the page's transforms.
      if (mode.isRunning()) return;

      const point = event as MouseEvent;
      // A keyboard-driven click reports 0,0; put the shock on the portrait.
      const box = trigger.getBoundingClientRect();
      const x = point.clientX || box.left + box.width / 2;
      const y = point.clientY || box.top + box.height / 2;

      hit();

      /*
       * Reduced motion gets the colour and nothing else.
       *
       * The whole sequence is displacement — there is no gentler version of it
       * to offer. So the site simply turns purple for a moment and turns back,
       * which acknowledges the click without moving anything at all.
       */
      if (reduced) {
        root.dataset.designer = '';
        window.setTimeout(() => delete root.dataset.designer, 2600);
        return;
      }

      ripple(x, y);

      /*
       * The context is created here, inside the click, which is both the
       * autoplay policy and the right manners: nothing on this site makes a
       * noise until someone has asked it to.
       */
      sound.unlock();

      /*
       * The picture and the sound are handed the same beat, and the sound
       * schedules the whole sequence from it in one pass on the audio clock.
       *
       * There are no timers here any more. There used to be two, holding a
       * release at 2500ms and a strain of 1100ms — numbers that had to be kept
       * in step by hand with a decay that begins at 2400 and a fight that ends
       * at the freeze, and were not. Everything the sound does is now derived
       * from the instants below, so the two cannot drift apart.
       */
      sound.play(mode.beatFor(), {
        wave: mode.WAVE_CROSS_MS,
        fieldDecay: mode.FIELD_DECAY_MS,
      });
      mode.setArcListener(sound.tick);
      showSwitch();

      mode.run({
        originX: x,
        originY: y,
        character: trigger,
        field: field!,
        onEnd: stop,
      });
    });

    /*
     * Toggling touches the sound and nothing else.
     *
     * No part of this reaches the sequence: the picture does not know the sound
     * exists, the schedule is already placed on the audio clock, and the gate
     * the mute moves sits after everything that was scheduled. So a press
     * mid-storm silences it without the storm noticing — which is the point,
     * since the moment anyone wants this is the moment it is already running.
     */
    toggle?.addEventListener('click', () => {
      sound.setMuted(!sound.isMuted());
      paintSwitch();

      /*
       * Says what it just did, then stops saying it.
       *
       * On a phone there is no hover, so without this a press changes an icon
       * and offers no words for what the icon now means. Two seconds is long
       * enough to read four words and short enough not to become a label.
       */
      toggle!.setAttribute('data-said', '');
      switchTimers.push(
        window.setTimeout(() => toggle!.removeAttribute('data-said'), 2000)
      );
    });

    dismiss = stop;

    if (globalsBound) return;
    globalsBound = true;

    /*
     * The audio device is opened on the first press anywhere on the page.
     *
     * Opening one takes a fraction of a second the first time, and that fraction
     * is heard as the wave crossing the screen in silence and the sound turning
     * up afterwards. Hovering the portrait is too late if the pointer was
     * already over it when the page loaded, and pressing it is far too late.
     *
     * Any press is a user gesture, so this satisfies the autoplay policy, and
     * most visitors press something — a link, a filter, the theme switch —
     * long before they think to press the portrait. It costs one suspended
     * context and fifty milliseconds of synthesis, once.
     */
    document.addEventListener('pointerdown', () => sound.unlock(), {
      once: true,
      passive: true,
    });

    document.addEventListener('keydown', (event) => {
      if ((event as KeyboardEvent).key === 'Escape') dismiss();
    });

    // Leaving the page mid-sequence would otherwise carry it to the next one.
    document.addEventListener('astro:before-swap', () => dismiss());

    /*
     * A reload mid-storm has to take the sound with it.
     *
     * `dismiss` fades and lets the voices ring off, which is right when the
     * page is staying. It is not enough when the document is being replaced:
     * sources scheduled seconds into the future carry on regardless of the
     * document that scheduled them, so refreshing part way through left the
     * blast playing over the new page. pagehide covers a reload, a navigation
     * away and a tab being put into the back-forward cache alike.
     */
    window.addEventListener('pagehide', () => {
      dismiss();
      sound.shutdown();
    });
  }

  document.addEventListener('astro:page-load', setupEgg);
</script>

<style>
  /* ------------------------------------------------------------------ */
  /* The shock                                                           */
  /*                                                                     */
  /* Two rings and a wash, all from the point of the click, all purely   */
  /* transform and opacity. This crosses the whole viewport at once and  */
  /* anything that touched layout here would drop frames immediately.    */
  /* ------------------------------------------------------------------ */
  .ring,
  .wash {
    position: fixed;
    left: var(--egg-x, 50%);
    top: var(--egg-y, 50%);
    z-index: 9992;
    pointer-events: none;
    border-radius: 50%;
    opacity: 0;
    /* Sized off the click point so the scale below is the same number
       whatever the viewport, and the ring always just clears the corner. */
    width: calc(var(--egg-reach, 600px) * 2);
    height: calc(var(--egg-reach, 600px) * 2);
    margin-top: calc(var(--egg-reach, 600px) * -1);
    margin-left: calc(var(--egg-reach, 600px) * -1);
  }

  /*
   * The leading edge is the one place the hot end of the palette is spent
   * in quantity — it is the strongest moment in the whole sequence, and it
   * lasts about half a second.
   */
  .ring {
    border: 3px solid var(--dm-core);
    box-shadow:
      0 0 26px color-mix(in srgb, var(--dm-glow) 62%, transparent),
      inset 0 0 26px color-mix(in srgb, var(--dm-wave) 55%, transparent);
  }

  /* A second, thinner ring a beat behind. One ring is an outline; two are a
     shock front with something behind it. */
  .ring--trail {
    border-width: 1.5px;
    border-color: var(--dm-arc);
    box-shadow: none;
  }

  .wash {
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--dm-wave) 40%, transparent) 0%,
      color-mix(in srgb, var(--dm-field) 22%, transparent) 42%,
      color-mix(in srgb, var(--dm-deep) 10%, transparent) 62%,
      transparent 76%
    );
  }

  .ring.is-rippling {
    animation: egg-ring 420ms cubic-bezier(0.14, 0.76, 0.2, 1) both;
  }

  .ring--trail.is-rippling {
    animation: egg-ring-trail 540ms cubic-bezier(0.14, 0.76, 0.2, 1) 60ms both;
  }

  .wash.is-rippling {
    animation: egg-wash 620ms var(--ease-out) both;
  }

  @keyframes egg-ring {
    from {
      opacity: 1;
      transform: scale(0.012);
    }
    to {
      opacity: 0;
      transform: scale(1.06);
    }
  }

  @keyframes egg-ring-trail {
    0% {
      opacity: 0;
      transform: scale(0.012);
    }
    16% {
      opacity: 0.78;
    }
    100% {
      opacity: 0;
      transform: scale(1.06);
    }
  }

  @keyframes egg-wash {
    0% {
      opacity: 0;
      transform: scale(0.02);
    }
    26% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: scale(1.12);
    }
  }
</style>
