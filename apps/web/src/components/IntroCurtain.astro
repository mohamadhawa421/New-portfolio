---
/**
 * The loading curtain.
 *
 * The wordmark is inlined rather than referenced as an <img> for two reasons:
 * an <img> cannot be recoloured, so the black artwork stayed black on the dark
 * theme's near-black curtain, and it cannot be animated, so the mark could only
 * fade in while the small mark in the corner draws itself.
 *
 * Inlined, it does both — it paints with currentColor and draws its own
 * contour, the same gesture as the corner mark at full size.
 */
import fs from 'node:fs';
import path from 'node:path';
import type { Media } from '../lib/types';

interface Props {
  logo: Media | null;
}

const { logo } = Astro.props;

let viewBox = '';
let paths: string[] = [];

if (logo) {
  try {
    const file = path.join(process.cwd(), 'public', logo.url.replace(/^\//, ''));
    const raw = fs
      .readFileSync(file, 'utf8')
      // Design tools embed a provenance manifest larger than the artwork.
      .replace(/<metadata>[\s\S]*?<\/metadata>/g, '');

    viewBox = raw.match(/viewBox="([^"]+)"/)?.[1] ?? '';
    paths = [...raw.matchAll(/<path[^>]*\sd="([^"]+)"/g)].map((m) => m[1]);
  } catch {
    // Unreadable or not an SVG — the <img> fallback below still renders.
  }
}

const canDraw = Boolean(viewBox) && paths.length > 0;
---

{
  logo && (
    <div class="intro" data-intro role="button" tabindex="0" aria-label="Skip intro">
      {/* An electrical fault that is not one. See the note in the styles. */}
      <span class="intro__spark" aria-hidden="true"></span>

      <div class="intro__logo">
        {canDraw ? (
          <svg class="intro-logo" viewBox={viewBox} role="img" aria-label={logo.alt}>
            {paths.map((d) => (
              <path class="intro-logo__fill" d={d} fill="currentColor" />
            ))}
            {paths.map((d) => (
              <path
                class="intro-logo__stroke"
                d={d}
                pathLength="1"
                fill="none"
                stroke="currentColor"
              />
            ))}
          </svg>
        ) : (
          <img src={logo.url} alt={logo.alt} />
        )}
      </div>
    </div>
  )
}

{/*
  Without JavaScript, this is the whole site.

  The curtain is server-rendered on every page and is a fixed, opaque,
  full-viewport panel; the only thing that ever takes it away is the script
  below. So with scripting off — a blocked bundle, a text-mode browser, a proxy
  that strips modules — every URL renders as a logo on a blank ground with all
  of the content sitting in the DOM behind it, unreachable.

  `!important` because the rule it has to beat is the component's own scoped
  `display: flex`, which carries a higher specificity than a bare class.
*/}
<noscript>
  <style>
    .intro {
      display: none !important;
    }
  </style>
</noscript>

{/* Runs inline, immediately after the markup, so a repeat visit inside the same
    session removes the curtain before the browser paints it. */}
<script is:inline>
  function setupIntro() {
    var curtain = document.querySelector('[data-intro]');
    if (!curtain) return;

    var KEY = 'mh-intro-seen';
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var seen = false;

    try {
      seen = sessionStorage.getItem(KEY) === '1';
    } catch (err) {
      // Private mode or storage disabled — treat as a first visit.
    }

    if (seen || reduced) {
      curtain.remove();
      return;
    }

    try {
      sessionStorage.setItem(KEY, '1');
    } catch (err) {
      /* not fatal */
    }

    var timers = [];
    var finished = false;

    function finish(delay) {
      if (finished) return;
      finished = true;
      timers.forEach(clearTimeout);
      curtain.classList.add('intro--out');
      setTimeout(function () {
        curtain.remove();
      }, delay);
    }

    timers.push(
      setTimeout(function () {
        curtain.classList.add('intro--in');
      }, 200)
    );
    /*
     * The hint.
     *
     * Once, at 1240ms — deliberately not on the same beat as the wordmark
     * arriving at 200 or the curtain leaving at 1900, because a flicker that
     * lands with something else reads as part of it. On its own, in the gap, it
     * reads as a fault. That is the whole idea: not "here is an animation" but
     * "did something just happen?".
     */
    timers.push(
      setTimeout(function () {
        curtain.classList.add('intro--spark');
      }, 1240)
    );
    timers.push(
      setTimeout(function () {
        curtain.classList.add('intro--out');
      }, 1900)
    );
    timers.push(
      setTimeout(function () {
        curtain.remove();
      }, 2500)
    );

    curtain.addEventListener('click', function () {
      finish(460);
    });
    curtain.addEventListener('keydown', function (event) {
      if (event.key === 'Enter' || event.key === ' ' || event.key === 'Escape') {
        event.preventDefault();
        finish(460);
      }
    });
  }

  // The intro only ever plays on the first arrival, but the markup is part of
  // every page, so the client router re-inserts it on each navigation. Removing
  // it on page-load is too late — that fires after paint, so a full-screen
  // white panel flashes for a frame, which is glaring on the dark contact page.
  // Strip it from the incoming document instead, before it is ever shown.
  document.addEventListener('astro:before-swap', function (event) {
    var incoming = event.newDocument.querySelector('[data-intro]');
    if (incoming) incoming.remove();
  });

  document.addEventListener('astro:page-load', setupIntro);
</script>

<style>
  .intro {
    position: fixed;
    inset: 0;
    z-index: 400;
    background: var(--surface);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(28px, 7vw, 80px);
    cursor: pointer;
    opacity: 1;
    transition: opacity 620ms var(--ease-smooth);
  }

  .intro--out {
    opacity: 0;
  }

  /*
   * The easter egg, foreshadowed.
   *
   * A hairline of purple that appears for four frames somewhere off to the side
   * of the wordmark and is gone. No glow, no bloom, no growth — those all read
   * as intentional. What reads as an anomaly is something small, hard-edged and
   * too fast to have been looked at directly.
   *
   * The colour is the sequence's own core purple, so the connection is there to
   * be made later even though nobody could make it now.
   *
   * `steps()` rather than a fade: electricity does not ease.
   */
  .intro__spark {
    position: absolute;
    top: calc(50% - clamp(30px, 7vh, 62px));
    left: calc(50% + clamp(96px, 21vw, 208px));
    width: 1.5px;
    height: clamp(9px, 1.4vh, 15px);
    background: #a855f7;
    opacity: 0;
    /* Bent, so it is a spark and not a tick mark. */
    clip-path: polygon(40% 0, 100% 38%, 58% 44%, 100% 100%, 0 56%, 44% 50%);
    transform: rotate(14deg);
  }

  .intro--spark .intro__spark {
    animation: intro-spark 150ms steps(1, end) 1;
  }

  @keyframes intro-spark {
    0% {
      opacity: 0;
    }
    18% {
      opacity: 1;
    }
    34% {
      opacity: 0;
    }
    52% {
      opacity: 0.85;
      transform: rotate(14deg) translate(1px, -2px) scaleY(1.25);
    }
    72% {
      opacity: 0;
    }
    100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .intro--spark .intro__spark {
      animation: none;
    }
  }

  .intro__logo {
    width: min(560px, 72vw);
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 680ms var(--ease-smooth),
      transform 800ms var(--ease-smooth);
  }

  .intro--in .intro__logo {
    opacity: 1;
    transform: none;
  }

  .intro__logo img,
  .intro-logo {
    width: 100%;
    height: auto;
    display: block;
    /* Follows the theme ink, so the wordmark is black on the light curtain and
       white on the dark one. */
    color: var(--ink);
    overflow: visible;
  }

  .intro-logo__stroke {
    stroke-width: 5;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  .intro-logo__fill {
    opacity: 0;
  }

  /*
   * Keyed off the curtain's own entrance so the line starts drawing exactly as
   * the wordmark becomes visible, rather than part-drawn behind an opacity of
   * zero. The three glyph groups are offset slightly so it writes rather than
   * appearing all at once.
   */
  .intro--in .intro-logo__stroke {
    animation:
      mh-intro-draw 1150ms var(--ease-glide) forwards,
      mh-intro-lift 320ms var(--ease-out) 1120ms forwards;
  }

  .intro--in .intro-logo__stroke:nth-of-type(2) {
    animation-delay: 90ms, 1210ms;
  }

  .intro--in .intro-logo__stroke:nth-of-type(3) {
    animation-delay: 170ms, 1290ms;
  }

  .intro--in .intro-logo__fill {
    animation: mh-intro-ink 380ms var(--ease-out) 1000ms forwards;
  }

  @keyframes mh-intro-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  /* The contour hands off to the solid wordmark rather than sitting on top of
     it, which would leave the glyphs heavier than they are drawn. */
  @keyframes mh-intro-lift {
    to {
      opacity: 0;
    }
  }

  @keyframes mh-intro-ink {
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .intro {
      display: none;
    }
  }
</style>
