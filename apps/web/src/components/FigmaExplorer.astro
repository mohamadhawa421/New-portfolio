---
/**
 * The design file, opened inside the case study.
 *
 * One component for every project. It takes a slug, asks `lib/figma` what that
 * project is configured with, and renders one of two things in the same box: a
 * live Figma embed, or the placeholder that stands in for one until the links
 * exist. Nothing about the page around it changes between those states, which
 * is the point — the layout can be judged now and the source arrives later as
 * a configuration change rather than a build.
 *
 * The states, all of which are reachable today:
 *
 *   placeholder  no links yet — development only, see explorerFor()
 *   invite       configured, and waiting to be asked; no iframe exists yet
 *   loading      iframe building, skeleton showing
 *   ready        the embed is up
 *   error        it did not arrive, and there is a way out to Figma

 *
 * `invite` is the resting state and the only way out of it is the button in
 * it. Nothing here is loaded on scroll, and that is a decision rather than an
 * oversight: a Figma embed is an entire application, and starting one behind
 * somebody's back — four sections into a case study they may well never reach
 * the end of — spends their battery and their bandwidth on a guess. So the
 * section introduces itself first and costs a single image until it is
 * actually wanted.
 *
 * `data-state` on the root carries which one, and every visual difference
 * between them is a CSS rule keyed off it. The script's whole job is to move
 * that one attribute.
 */
import { explorerFor } from '../lib/figma';

interface Props {
  /** The project's slug — the same key `figmaProjects` is written against. */
  slug: string;
  /** Falls back to the configured name; the page's own title is better. */
  title?: string;
}

const { slug, title } = Astro.props;

const design = explorerFor(slug, import.meta.env.DEV);
const name = title || design.projectName;
---

{
  design.show && (
    <section class="section section--light case-figma" data-lift data-tile="light">
      <div class="shell--narrow">
        <div class="eyebrow--small" data-reveal="0">
          Explore the design
        </div>

        <div
          class="figma"
          data-figma
          data-state={design.live ? 'invite' : 'placeholder'}
          data-embed={design.live ? design.embedUrl : undefined}
          data-project-name={name}
          data-full="no"
          data-armed="no"
          data-reveal="0"
        >
          {/* A label, and nothing else.
              There is deliberately no way out of here into Figma. The embed
              is a read-only view of one frame; a link to the file is a link
              to the layers, the other projects, the version history and the
              comments, and none of that is a visitor's to see. */}
          <div class="figma__bar">
            <span class="figma__label">{name} — Figma</span>
          </div>

          {/* The box every state shares. Its height never depends on what is
              inside it, so the page does not move when the embed arrives. */}
          <div class="figma__stage" data-figma-stage>
            {/* Before anything is loaded: the invitation.
                He is doing the same job here he does beside the hero — saying
                what the thing is, in a voice a page of body copy cannot. The
                drawing is 560px wide and served at a third of that, so it is
                sharp on a retina screen and still the only weight this
                section carries until somebody presses the button. */}
            <div class="figma__invite">
              <span class="figma__invite-halo" aria-hidden="true">
                <img
                  class="figma__invite-face"
                  src="/character-presenting.webp"
                  alt=""
                  width="560"
                  height="496"
                  loading="lazy"
                  decoding="async"
                />
              </span>
              <p class="figma__invite-title">Explore the design</p>
              <p class="figma__invite-note">
                Want to see the work beyond the screenshots? The real file is right here.
              </p>
              <button class="figma__invite-go" data-figma-open type="button">
                Explore the Figma
              </button>
            </div>

            {/* Waiting. Two bars breathing, no spinner — a spinner in a frame
                this size reads as an error before it reads as progress. */}
            <div class="figma__skeleton" aria-hidden="true">
              <span />
              <span />
              <span class="figma__skeleton-say">Loading design…</span>
            </div>

            {/* No links yet. Deliberately not dressed up as a design tool:
                nobody should mistake this for a screenshot of Figma. */}
            <div class="figma__placeholder">
              <div class="figma__placeholder-mark" aria-hidden="true">
                <svg viewBox="0 0 24 36" width="20" height="30" focusable="false">
                  <circle cx="18" cy="18" r="6" fill="none" stroke="currentColor" stroke-width="1.4" />
                  <path
                    d="M12 12H6a6 6 0 010-12h6zM12 12h6a6 6 0 010 12h-6zM12 24H6a6 6 0 000 12 6 6 0 006-6z"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.4"
                    stroke-linejoin="round"
                  />
                </svg>
              </div>
              <p class="figma__placeholder-title">Figma design explorer</p>
              <p class="figma__placeholder-note">Ready for Figma source — {name}</p>
              <p class="figma__placeholder-dev">
                Development placeholder. Not rendered in production.
              </p>
            </div>

            {/* It did not arrive, and there is nothing to offer instead —
                the file is not somewhere a visitor can be sent. So this says
                what happened and stops, rather than dressing a dead end up as
                a choice. */}
            <div class="figma__fallen">
              <p class="figma__fallen-title">Design preview unavailable</p>
              <p class="figma__fallen-note">The rest of this case study still is.</p>
            </div>

            {/* Touch only. Takes the first tap so the page can be scrolled
                past an embed that would otherwise swallow every gesture. */}
            <button class="figma__shield" data-figma-arm type="button">
              <span>Tap to explore the design</span>
            </button>

            {/* The one control here that is ours, because it is the one the
                embed cannot do for us. Zoom belongs to Figma and is already
                drawn inside the canvas. */}
            <button class="figma__full" data-figma-full type="button" aria-label="Toggle fullscreen">
              <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
                <path
                  class="figma__full-in"
                  d="M6 2H2v4M10 2h4v4M6 14H2v-4M10 14h4v-4"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
                <path
                  class="figma__full-out"
                  d="M2 6h4V2M14 6h-4V2M2 10h4v4M14 10h-4v4"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </button>
          </div>
        </div>
      </div>
    </section>
  )
}

<script>
  import { bindFigmaExplorer } from '../scripts/figma-explorer';

  /*
   * Bound once for the life of the tab.
   *
   * Every listener inside is on `document`, which the router never replaces,
   * so a second binding would answer every press twice — and one binding is
   * enough for every page, including the ones whose own copy of this script
   * never runs, because nothing in there is bound to a page element.
   */
  if (!(window as unknown as { __mhFigma?: boolean }).__mhFigma) {
    (window as unknown as { __mhFigma?: boolean }).__mhFigma = true;
    bindFigmaExplorer();
  }
</script>

<style>
  /* ------------------------------------------------------------------ */
  /* The frame                                                           */
  /* ------------------------------------------------------------------ */

  .case-figma {
    padding-block: clamp(58px, min(12vh, 16vw), 132px);
  }

  .figma {
    margin-top: clamp(22px, 3vh, 34px);
  }

  /*
   * A label, on its own.
   *
   * Above the canvas rather than over it: a bar laid on top of the design is
   * browser chrome by another name, and the brief for this was the opposite of
   * that.
   */
  .figma__bar {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 12px;
    padding-inline: 2px;
  }

  .figma__label {
    font-size: 14px;
    letter-spacing: -0.01em;
    color: var(--ink-muted);
  }

  /*
   * The box, which is the same box in every state.
   *
   * Its height is viewport-relative with a floor and a ceiling, so a laptop
   * gets something immersive, a tall monitor does not get a canvas that runs
   * off the bottom of the reading position, and a phone gets something it can
   * still scroll past. Nothing inside it changes it: the skeleton, the
   * placeholder, the failure and the embed are all absolutely positioned
   * against it, so the page does not shift when one replaces another.
   */
  .figma__stage {
    position: relative;
    height: clamp(420px, 64vh, 780px);
    border-radius: var(--r-xl);
    overflow: hidden;
    background: var(--surface-parchment);
    /* Nothing here may push the page sideways, whatever the embed does with
       its own layout. */
    max-width: 100%;
    isolation: isolate;
  }

  :global(.figma__frame) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
    opacity: 0;
    transition: opacity 420ms var(--ease-out);
  }

  .figma[data-state='ready'] :global(.figma__frame) {
    opacity: 1;
  }

  /* ------------------------------------------------------------------ */
  /* What is in the box before the design is                             */
  /* ------------------------------------------------------------------ */

  .figma__skeleton,
  .figma__placeholder,
  .figma__fallen,
  .figma__invite {
    position: absolute;
    inset: 0;
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    text-align: center;
    padding: 24px;
  }

  .figma[data-state='loading'] .figma__skeleton,
  .figma[data-state='placeholder'] .figma__placeholder,
  .figma[data-state='error'] .figma__fallen,
  .figma[data-state='invite'] .figma__invite {
    display: flex;
  }

  /* ------------------------------------------------------------------ */
  /* The invitation                                                      */
  /* ------------------------------------------------------------------ */

  /*
   * He stands in the empty canvas rather than on top of it.
   *
   * Which is mostly a matter of what is *not* here: no card, no border, no
   * panel behind him, no drop shadow under the drawing. The stage already has
   * a surface and a corner radius, so anything else would be a second box
   * inside the first, and the brief for this section was the opposite of
   * browser chrome. What he gets instead is room — the gap below him is wider
   * than the gaps between the lines, so the eye reads him as standing in the
   * space and the words as captions to him.
   */
  .figma__invite {
    gap: 0;
    /*
     * Sits a little high. Centred by the flexbox and then lifted, because a
     * figure with a raised arm reads as centred when its *mass* is centred,
     * and his mass is his shoulders. Dead-centring the bounding box hangs him
     * low in the frame.
     */
    padding-bottom: 34px;
  }

  /*
   * Something for him to stand in.
   *
   * He is drawn in a black jacket with a black outline, and on the dark theme
   * the stage behind him is #131316 — so without this most of his body is the
   * same value as the surface and only his face and hands survive. A pool of
   * light behind him fixes that, and it is also the honest answer to
   * "integrated into the canvas rather than pasted onto it": the reason a
   * figure looks placed in a space is that the space is lit around them.
   *
   * One wash serves both themes because it is mixed from `--ink`, which is
   * near-black on the light theme and near-white on the dark one. So this is
   * a soft ground shadow where the surface is pale and a halo where it is
   * not — the same rule doing the opposite thing, correctly, in each.
   *
   * `closest-side` on an ellipse wider than it is tall, so the falloff
   * reaches the edge of the box in every direction at once and there is no
   * visible circle. Behind the drawing via `z-index`, never over it.
   */
  .figma__invite-halo {
    position: relative;
    display: block;
    line-height: 0;
  }

  .figma__invite-halo::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 54%;
    width: 178%;
    height: 152%;
    transform: translate(-50%, -50%);
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--ink) 11%, transparent),
      transparent
    );
    z-index: -1;
    pointer-events: none;
  }

  .figma__invite-face {
    width: clamp(132px, 15vw, 188px);
    height: auto;
    margin-bottom: 4px;
    /* The drawing is his own artwork on transparency: nothing tints it, and
       nothing rounds it. */
    user-select: none;
    -webkit-user-drag: none;
  }

  .figma__invite-title {
    font-size: clamp(19px, 2vw, 23px);
    font-weight: 600;
    letter-spacing: -0.018em;
  }

  .figma__invite-note {
    margin-top: 6px;
    max-width: 34ch;
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink-muted);
    text-wrap: pretty;
  }

  /*
   * The invitation itself.
   *
   * A filled button, and the only one in this section — everything else here
   * is furniture. It is the accent rather than the ink because it is a choice
   * being offered, not a control being provided.
   */
  .figma__invite-go {
    margin-top: 20px;
    /* Laid out as a box rather than as text with padding, so the 44px floor
       below is a floor and not a suggestion the line height can undercut. */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 22px;
    border: 0;
    border-radius: var(--r-pill);
    font: inherit;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--surface);
    background: var(--ink);
    cursor: pointer;
    transition:
      transform 240ms var(--ease-out),
      opacity 240ms var(--ease-out);
  }

  /* Guarded, for the reason the pager's hover is: iOS resolves `:hover` on
     tap and then keeps it, which would leave this lifted after the press. */
  @media (hover: hover) and (pointer: fine) {
    .figma__invite-go:hover {
      transform: translateY(-1px);
      opacity: 0.88;
    }
  }

  .figma__invite-go:active {
    transform: translateY(0) scale(0.98);
  }

  /* A drawn pointer cannot also be a system one. */
  :global(:root.has-custom-cursor) .figma__invite-go {
    cursor: none;
  }

  /*
   * Going. One fade, one degree of shrink, and out of the way.
   *
   * Written as a class rather than a state, because it has to overlap the
   * next state rather than follow it — the skeleton is already showing
   * underneath by the time this finishes. The brief asked for the canvas to
   * change mode rather than for the character to leave, and something that
   * leaves quietly while the next thing is already there is what that looks
   * like.
   */
  .figma__invite--going {
    display: flex !important;
    pointer-events: none;
    opacity: 0;
    transform: scale(0.985);
    transition:
      opacity 260ms var(--ease-out),
      transform 260ms var(--ease-out);
  }

  @media (prefers-reduced-motion: reduce) {
    .figma__invite--going {
      transition-duration: 1ms;
    }
  }

  /* The word under the bars while the design arrives. Deliberately the only
     spinner-shaped thing in the section: the bars already carry the motion. */
  .figma__skeleton-say {
    margin-top: 6px;
    font-size: 13px;
    letter-spacing: -0.01em;
    color: var(--ink-faint);
  }

  /* Two bars, breathing. Long enough to read as content arriving and slow
     enough not to strobe under a section somebody is reading. */
  .figma__skeleton span {
    display: block;
    height: 10px;
    border-radius: var(--r-pill);
    background: var(--ink);
    opacity: 0.06;
    animation: figma-breathe 1800ms var(--ease-out) infinite;
  }

  .figma__skeleton span:first-child {
    width: min(220px, 40%);
  }

  .figma__skeleton span:last-child {
    width: min(140px, 26%);
    animation-delay: 220ms;
  }

  @keyframes figma-breathe {
    0%,
    100% {
      opacity: 0.05;
    }
    50% {
      opacity: 0.12;
    }
  }

  .figma__placeholder-mark {
    color: var(--ink);
    opacity: 0.22;
    margin-bottom: 4px;
  }

  .figma__placeholder-title {
    font-size: clamp(17px, 1.8vw, 20px);
    font-weight: 600;
    letter-spacing: -0.016em;
  }

  .figma__placeholder-note {
    font-size: 15px;
    color: var(--ink-muted);
  }

  /*
   * The line that says this is scaffolding.
   *
   * It is set in the interface monospace at the size of a footnote because it
   * is addressed to whoever is building the page, not to whoever is reading
   * it — and in production nobody reads it at all, because the section is not
   * rendered. See `explorerFor`.
   */
  .figma__placeholder-dev {
    margin-top: 6px;
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
    opacity: 0.7;
  }

  .figma__fallen-title {
    font-size: clamp(17px, 1.8vw, 20px);
    font-weight: 600;
    letter-spacing: -0.016em;
  }

  .figma__fallen-note {
    font-size: 15px;
    color: var(--ink-muted);
  }

  /* ------------------------------------------------------------------ */
  /* Controls                                                            */
  /* ------------------------------------------------------------------ */

  /*
   * Top right, because Figma owns the bottom right.
   *
   * The embed draws its own zoom and pan controls in the lower-right corner of
   * the canvas — that is `viewportControls`, and it is on deliberately, since
   * they are the real thing and we cannot script a replacement. A fullscreen
   * button in the same corner sits on top of them, which is both a collision
   * and a trap: the two controls a visitor reaches for most end up in one
   * 38px square. The opposite corner is empty in every embed state, because
   * the page selector and the footer are both off.
   */
  .figma__full {
    position: absolute;
    right: 14px;
    top: 14px;
    width: 38px;
    height: 38px;
    display: none;
    place-items: center;
    border: 0;
    border-radius: 50%;
    color: #fff;
    background: rgba(20, 20, 22, 0.55);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    cursor: pointer;
    z-index: 3;
    transition: background 200ms var(--ease-out);
  }

  /* Only once there is something to look at full size. */
  .figma[data-state='ready'] .figma__full {
    display: grid;
  }

  .figma__full:hover {
    background: rgba(20, 20, 22, 0.75);
  }

  .figma__full-out {
    display: none;
  }

  .figma[data-full='yes'] .figma__full-in {
    display: none;
  }

  .figma[data-full='yes'] .figma__full-out {
    display: block;
  }

  /*
   * The shield, on touch only.
   *
   * Hidden by default and by `data-armed`, so it appears for exactly one tap
   * on a phone and never at all on a machine with a pointer. Without it the
   * explorer is a trap: every finger that lands on the canvas is panning
   * Figma, and the page cannot be scrolled past the section.
   */
  .figma__shield {
    position: absolute;
    inset: 0;
    display: none;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 22px;
    border: 0;
    background: transparent;
    cursor: pointer;
    z-index: 2;
  }

  .figma__shield span {
    font-size: 13px;
    color: #fff;
    background: rgba(20, 20, 22, 0.62);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    padding: 9px 16px;
    border-radius: var(--r-pill);
  }

  @media (hover: none) {
    .figma[data-state='ready'][data-armed='no'] .figma__shield {
      display: flex;
    }
  }

  /* ------------------------------------------------------------------ */
  /* Smaller screens                                                     */
  /* ------------------------------------------------------------------ */

  @media (max-width: 900px) {
    .figma__stage {
      height: clamp(360px, 56vh, 560px);
      border-radius: var(--r-lg);
    }
  }

  @media (max-width: 560px) {
    .figma__stage {
      /* Shorter again, because on a phone this section has to be something a
         thumb can get past, not a screen of its own. */
      height: clamp(320px, 48vh, 460px);
    }

    /*
     * He gets smaller before the words do.
     *
     * The stage is barely 320px tall here and the hierarchy has to survive
     * that: a drawing sized off the viewport would eat the copy and the
     * button, and what is left would be a picture with a caption rather than
     * an invitation. So the character takes the whole reduction, the type
     * stays where it is, and the button keeps a 44px target.
     */
    .figma__invite {
      padding: 20px;
      padding-bottom: 24px;
    }

    .figma__invite-face {
      width: 104px;
    }

    .figma__invite-note {
      max-width: 30ch;
      font-size: 14px;
    }

    .figma__invite-go {
      margin-top: 16px;
    }
  }

  /* ------------------------------------------------------------------ */
  /* Expanded                                                            */
  /* ------------------------------------------------------------------ */

  /*
   * The expanded stage, and the space it leaves behind.
   *
   * The box is pinned to the size and place it already had — the script
   * writes those four numbers — and the growing is done entirely by a
   * transform. That is not a shortcut, it is the requirement: resizing this
   * element resizes the iframe, and a resized Figma embed keeps the zoom and
   * the top-left anchor it was fitted with, which leaves the design in the
   * corner of a much larger canvas. Magnifying it instead keeps the fit that
   * was already correct. `figma-explorer.ts` has the measurements.
   *
   * Not the browser's fullscreen either. Real fullscreen changes the
   * viewport, so the page behind relays out mid-flight and there is no longer
   * a place for the box to have grown *from*. An overlay keeps one viewport
   * from the first frame to the last, which is what the pictures on this site
   * already do when they open.
   *
   * `figma__hold` keeps the stage's height in the section while it is out of
   * flow, so the page underneath does not jump.
   */
  :global(.figma__stage.figma__stage--big) {
    position: fixed;
    z-index: 90;
    max-width: none;
    transform-origin: top left;
    box-shadow: 0 40px 120px rgb(0 0 0 / 0.45);
  }

  :global(.figma__hold) {
    width: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .figma__skeleton span {
      animation: none;
      opacity: 0.08;
    }

    :global(.figma__frame) {
      transition-duration: 1ms;
    }
  }
</style>
