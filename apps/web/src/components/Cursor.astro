---
/**
 * Custom pointer.
 *
 * Two parts: a small solid dot that tracks the mouse exactly, and a larger ring
 * that eases toward it a frame behind. The lag is the whole effect — it is what
 * makes the pointer feel weighted rather than glued to the cursor.
 *
 * It is drawn in the site's own ink rather than blended, and it reads the
 * section under it: light ink over the dark tiles and the dark theme, dark ink
 * everywhere else. A hairline of the opposite value sits under both shapes, so
 * it stays legible over a project cover of any colour without the pointer ever
 * looking like an effect in its own right.
 *
 * Only ever shown on a device with a real pointer. Touch screens and anyone who
 * has asked for reduced motion keep the native cursor, and so does anyone whose
 * browser cannot run the script — the native cursor is only hidden from inside
 * the script, never from static CSS.
 */
---

<!--
  The directive belongs here rather than on <Cursor /> in the layout: Astro
  drops transition:persist when it is put on a component tag, silently, so the
  element was replaced on every navigation while the script below carried on
  driving the detached one. The pointer then had no visible element to move and
  the native cursor was still hidden — no pointer at all until a full reload.
-->
<div class="cursor" data-cursor aria-hidden="true" transition:persist="site-cursor">
  {/*
    The bolt that comes down on the pointer when he loses his temper. Empty
    until then, and redrawn several times a second while it holds — a bolt that
    keeps still is a shape, and this has to read as current.
  */}
  <svg class="cursor__bolt" data-cursor-bolt aria-hidden="true">
    <path class="cursor__bolt-glow" data-cursor-bolt-glow />
    <path class="cursor__bolt-fork" data-cursor-bolt-fork />
    <path class="cursor__bolt-core" data-cursor-bolt-core />
  </svg>
  {/*
    The contact. Drawn under the pointer's own ring, so the thing you are
    aiming with stays on top of the mark it makes.
  */}
  <div class="cursor__bloom" data-cursor-bloom></div>
  <div class="cursor__ring" data-cursor-ring></div>
  <div class="cursor__dot" data-cursor-dot></div>
  {/*
    The arcs, drawn once and left at opacity 0. Three short strokes around the
    pointer rather than a bolt across the screen — the pointer has to stay the
    thing you are aiming with.
  */}
  <svg class="cursor__zap" data-cursor-zap viewBox="0 0 64 64" aria-hidden="true">
    <g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
      <path d="M32 20 L27 13 L33 12 L29 5" />
      <path d="M44 32 L51 27 L52 33 L59 29" />
      <path d="M32 44 L36 51 L30 52 L34 59" />
    </g>
  </svg>
</div>

<script>
  /**
   * Re-states everything the router's DOM swap knocks out from under the
   * pointer. Set once the pointer is actually running; a no-op until then.
   */
  let restate: () => void = () => {};

  /** True once the custom pointer has taken over from the native one. */
  let running = false;

  /**
   * Hides the native cursor.
   *
   * The class has to be re-applied after every navigation. The client router
   * replaces the <html> element's attributes wholesale with the incoming
   * document's, and this class is only ever set at runtime — so it was there on
   * first paint and gone the moment the visitor followed any link.
   */
  function claimCursor() {
    if (running) document.documentElement.classList.add('has-custom-cursor');
  }

  function setupCursor() {
    /*
     * Re-acquired rather than captured once.
     *
     * The element is persisted across navigations, so ordinarily these three
     * stay valid for the life of the tab — but a persist that stops working is
     * a silent failure, and the symptom is a pointer that has vanished with no
     * clue why. Looking the elements up again after every swap costs three
     * queries and takes the whole failure mode off the table.
     */
    let root = document.querySelector<HTMLElement>('[data-cursor]');
    let ring = document.querySelector<HTMLElement>('[data-cursor-ring]');
    let dot = document.querySelector<HTMLElement>('[data-cursor-dot]');
    let zap = document.querySelector<SVGElement>('[data-cursor-zap]');
    let bloom = document.querySelector<HTMLElement>('[data-cursor-bloom]');
    let boltGlow = document.querySelector<SVGPathElement>('[data-cursor-bolt-glow]');
    let boltFork = document.querySelector<SVGPathElement>('[data-cursor-bolt-fork]');
    let boltCore = document.querySelector<SVGPathElement>('[data-cursor-bolt-core]');
    if (!root || !ring || !dot) return;

    /** True if the elements are still in the document this frame belongs to. */
    function reacquire(): boolean {
      if (root!.isConnected && ring!.isConnected && dot!.isConnected) return true;

      const nextRoot = document.querySelector<HTMLElement>('[data-cursor]');
      const nextRing = document.querySelector<HTMLElement>('[data-cursor-ring]');
      const nextDot = document.querySelector<HTMLElement>('[data-cursor-dot]');
      if (!nextRoot || !nextRing || !nextDot) return false;

      // Carry the visible state over to the replacement.
      nextRoot.className = root!.className;
      root = nextRoot;
      ring = nextRing;
      dot = nextDot;
      zap = document.querySelector<SVGElement>('[data-cursor-zap]');
      bloom = document.querySelector<HTMLElement>('[data-cursor-bloom]');
      boltGlow = document.querySelector<SVGPathElement>('[data-cursor-bolt-glow]');
      boltFork = document.querySelector<SVGPathElement>('[data-cursor-bolt-fork]');
      boltCore = document.querySelector<SVGPathElement>('[data-cursor-bolt-core]');
      return true;
    }

    const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!fine || reduced) return;

    // Only now is it safe to hide the real cursor.
    running = true;
    claimCursor();

    let targetX = window.innerWidth / 2;
    let targetY = window.innerHeight / 2;
    let ringX = targetX;
    let ringY = targetY;
    let visible = false;

    const INTERACTIVE =
      'a, button, [role="button"], [role="option"], input, select, textarea, label, summary';

    /*
     * Magnetism.
     *
     * Buttons and the other small controls, not links or cards: on something
     * the size of a project row the pull reads as the layout drifting.
     */
    /*
     * The portrait is in here too, in every mode — and it used not to be.
     *
     * The argument for holding it back was that the egg is unannounced by
     * design: no label, no hover state, no cursor change, because a picture
     * that turns out to do something is only a surprise if nobody told you to
     * expect one. So the pull was granted only in super designer mode, where
     * the secret is already out.
     *
     * That protected the surprise from the people who never found it, which is
     * the wrong way round. A lean of a few pixels under the pointer does not
     * say "this fires a shockwave" — it says the picture is aware of you, which
     * is an invitation to press it and no explanation of what pressing it does.
     * The reveal is still entirely the reveal. What the discretion actually
     * bought was an easter egg most visitors had no reason to touch.
     */
    const MAGNETIC =
      '.btn, .enquiry__send, .chip, .theme-toggle, .text-link, [data-egg-trigger]';

    /** Fraction of the pointer's offset from centre that the control leans. */
    const LEAN = 0.22;
    /** Hard ceiling on that lean. Past about this the control stops looking
     *  attached to the layout it sits in. */
    const LEAN_MAX = 10;
    /** How far the ring drifts off the true pointer toward the control. */
    const RING_PULL = 0.32;
    /** How far outside a control the field reaches. The pull has to start
     *  before the pointer arrives or it is not magnetism, just a hover state. */
    const FIELD = 26;
    /** How long the contact takes to arrive, swell and be gone. */
    const BLOOM_MS = 180;

    /*
     * Positions are stored in document space and measured once per page rather
     * than read per pointermove. Calling getBoundingClientRect() on every move
     * would force a layout flush on the one interaction that has to stay
     * perfectly smooth.
     */
    interface Magnet {
      el: HTMLElement;
      top: number;
      left: number;
      w: number;
      h: number;
      /** Ceilings for this control, per axis — see measureMagnets. */
      maxLeanX: number;
      maxLeanY: number;
    }

    let magnets: Magnet[] = [];
    let magnet: Magnet | null = null;
    let releasing: HTMLElement | null = null;
    let leanX = 0;
    let leanY = 0;

    const clamp = (v: number, max: number) => (v > max ? max : v < -max ? -max : v);

    function measureMagnets(): void {
      const sx = window.scrollX;
      const sy = window.scrollY;
      magnets = Array.from(document.querySelectorAll<HTMLElement>(MAGNETIC))
        /*
         * A thing the pointer cannot reach is not a thing the pointer leans
         * toward.
         *
         * The magnets are hit-tested against measured rectangles rather than
         * against the document, so `pointer-events: none` — which stops every
         * other kind of pointing — did nothing to the lean: the portrait went
         * on tugging at the cursor all the way through a storm it had stopped
         * responding to. Reading the computed value here is the general form
         * of that fix rather than a special case for one element, and it costs
         * one style read per magnet on a function that runs at load, on
         * resize, and on a mode change — never per frame.
         */
        .filter((el) => getComputedStyle(el).pointerEvents !== 'none')
        .map((el) => {
        const r = el.getBoundingClientRect();
        return {
          el,
          top: r.top + sy,
          left: r.left + sx,
          w: r.width,
          h: r.height,
          maxLeanX: LEAN_MAX,
          maxLeanY: LEAN_MAX,
        };
      });

      /*
       * Each control leans at most half the distance to whatever sits beside
       * it, so it can never reach its neighbour.
       *
       * Without this the lean is a flat maximum, and a flat maximum is wrong
       * wherever controls are close together: the hero's two buttons sit in a
       * 10px gap, so a 10px lean slid one straight into the other and read as
       * a second button appearing underneath. Filter chips have the same
       * problem at 8px.
       */
      for (const m of magnets) {
        let nearestX = Infinity;
        let nearestY = Infinity;

        for (const other of magnets) {
          if (other === m) continue;

          // Side by side: constrains sideways movement only.
          if (m.top < other.top + other.h && other.top < m.top + m.h) {
            const gap =
              other.left >= m.left + m.w
                ? other.left - (m.left + m.w)
                : m.left >= other.left + other.w
                  ? m.left - (other.left + other.w)
                  : 0;
            if (gap < nearestX) nearestX = gap;
          }

          // Stacked: constrains vertical movement only.
          if (m.left < other.left + other.w && other.left < m.left + m.w) {
            const gap =
              other.top >= m.top + m.h
                ? other.top - (m.top + m.h)
                : m.top >= other.top + other.h
                  ? m.top - (other.top + other.h)
                  : 0;
            if (gap < nearestY) nearestY = gap;
          }
        }

        // Per axis, because a row of buttons is crowded sideways and free
        // vertically — capping both by the tightest gap in either direction
        // would flatten the effect for no reason. A pixel of slack so
        // neighbours never quite touch.
        const cap = (gap: number) => Math.max(0, Math.min(LEAN_MAX, gap / 2 - 1));
        if (nearestX !== Infinity) m.maxLeanX = cap(nearestX);
        if (nearestY !== Infinity) m.maxLeanY = cap(nearestY);
      }

      magnet = null;
    }

    /**
     * The control the pointer belongs to: the one under it, or failing that the
     * nearest one within the field.
     *
     * Nearest matters. Two controls sitting side by side have overlapping
     * fields, and simply taking the first match in document order meant
     * hovering one button could pull its neighbour instead — which reads as a
     * second button lurching about underneath the one you are pointing at.
     */
    function fieldAt(px: number, py: number): Magnet | null {
      let best: Magnet | null = null;
      let bestDistance = Infinity;

      for (const m of magnets) {
        // Distance from the point to the rectangle, zero when inside it.
        const dx = px < m.left ? m.left - px : px > m.left + m.w ? px - (m.left + m.w) : 0;
        const dy = py < m.top ? m.top - py : py > m.top + m.h ? py - (m.top + m.h) : 0;

        // Directly over a control always wins outright.
        if (dx === 0 && dy === 0) return m;

        const distance = Math.hypot(dx, dy);
        if (distance <= FIELD && distance < bestDistance) {
          bestDistance = distance;
          best = m;
        }
      }

      return best;
    }

    function engage(next: Magnet | null): void {
      if (magnet === next) return;

      // Whatever was easing back has had its turn; a stray offset left on an
      // element is worse than one snapped frame.
      if (releasing && releasing !== next?.el) releasing.style.translate = '';
      releasing = null;

      if (magnet) {
        if (next) magnet.el.style.translate = '';
        else releasing = magnet.el;
      }

      magnet = next;

      if (next) {
        leanX = 0;
        leanY = 0;
      }

      /*
       * Deliberately no will-change here. Promoting the control to its own
       * compositor layer for the duration of the hover left a repainted copy
       * of it behind at its original position as it moved. A translate is
       * cheap enough to composite without the hint.
       */
    }

    /* ------------------------------------------------------------------ */
    /* Ink                                                                 */
    /* ------------------------------------------------------------------ */

    /**
     * Whether the pointer should be drawn light.
     *
     * The same rule the nav uses for its own ink: light over a section tagged
     * as a dark tile, and light everywhere once the page itself is dark. The
     * section is read off the element under the pointer, which is already in
     * hand from the move event — no layout is measured for it.
     */
    let overDarkTile = false;

    function pageIsDark(): boolean {
      // The void is dark in both themes, so it answers before the theme does.
      if (document.documentElement.dataset.surface === 'void') return true;
      const set = document.documentElement.dataset.theme;
      if (set === 'dark') return true;
      if (set === 'light') return false;
      return window.matchMedia('(prefers-color-scheme: dark)').matches;
    }

    function paintInk(): void {
      root!.classList.toggle('cursor--light', overDarkTile || pageIsDark());
    }

    function readTile(el: Element | null): void {
      const tile = el?.closest?.<HTMLElement>('[data-tile]');
      // No tile means the fixed chrome or the footer, both of which sit on the
      // page's own surface — the theme alone decides there.
      overDarkTile = tile?.dataset.tile === 'dark';
    }

    /* ------------------------------------------------------------------ */
    /* The loop                                                            */
    /* ------------------------------------------------------------------ */

    /*
     * The loop runs only while something is still moving.
     *
     * An unconditional requestAnimationFrame is a wake-up every 16ms for the
     * whole life of the tab, which on a laptop on battery or a weak GPU is a
     * real cost for a pointer that is usually sitting still. It stops as soon
     * as the ring has caught up and nothing is leaning, and any input starts
     * it again.
     */
    let looping = false;

    /** When the current punishment ends, or 0. Matched to PUNISH_MS. */
    const ZAP_MS = 380;
    let zapUntil = 0;

    /*
     * The pointer is held, for the one refusal that is not a telling-off.
     *
     * Six in a row and he stops being patient. What the pointer does then is
     * the whole point of it: it goes heavy. The real cursor keeps up with the
     * mouse — nothing can change that, and nothing should — but the drawn one
     * falls behind it for a second, which is the closest a page can get to
     * taking the pointer off someone without taking it off them.
     */
    const RAGE_MS = 1000;
    let rageUntil = 0;
    /** Where in the sky this one is coming from, fixed for its length. */
    let boltFromX = 0;
    let boltAt = 0;

    /*
     * A line from up there to the pointer, bent at nine places.
     *
     * The offsets are taken along the normal of the line rather than in x, so
     * the bolt is as jagged when the pointer is off to one side as when it is
     * straight below — and they are scaled by sin(pi * t), which is zero at
     * both ends. That is what keeps the last point exactly on the pointer: the
     * bolt is wild in the middle and lands on the spot.
     */
    function boltPath(x0: number, y0: number, x1: number, y1: number, spread: number): string {
      const dx = x1 - x0;
      const dy = y1 - y0;
      const len = Math.hypot(dx, dy) || 1;
      const nx = -dy / len;
      const ny = dx / len;

      let d = `M${x0.toFixed(1)} ${y0.toFixed(1)}`;
      for (let i = 1; i <= 9; i += 1) {
        const t = i / 9;
        const o = (Math.random() * 2 - 1) * Math.sin(Math.PI * t) * spread;
        d += ` L${(x0 + dx * t + nx * o).toFixed(1)} ${(y0 + dy * t + ny * o).toFixed(1)}`;
      }
      return d;
    }

    /** Redraws the bolt onto wherever the pointer has got to. */
    function drawBolt(x: number, y: number): void {
      // The strike wanders a little between flickers, the way a real one does
      // not come down the same channel twice.
      const fromX = boltFromX + (Math.random() * 2 - 1) * 60;
      const main = boltPath(fromX, -40, x, y, 38);
      boltGlow?.setAttribute('d', main);
      boltCore?.setAttribute('d', main);

      /*
       * A fork off the middle that goes nowhere, which is most of what makes a
       * drawn bolt look like a photographed one — a single clean line reads as
       * a crack in the glass instead.
       */
      const t = 0.35 + Math.random() * 0.3;
      const bx = fromX + (x - fromX) * t;
      const by = -40 + (y + 40) * t;
      boltFork?.setAttribute(
        'd',
        boltPath(bx, by, bx + (Math.random() * 2 - 1) * 180, by + 60 + Math.random() * 140, 26)
      );
    }
    /** Where the drawn pointer has got to, when it is not keeping up. */
    let dragX = targetX;
    let dragY = targetY;

    /*
     * When the pointer was last heard from.
     *
     * A native popup — an autofill suggestion list, a <select> menu, a
     * spellcheck menu — is browser furniture, not page content: while it is
     * open the page is sent no pointer events at all, so the drawn pointer
     * stops where it was and the visitor watches it sit still while their
     * mouse moves. There is nothing to be done about the events, but the
     * catching up afterwards is ours: see the snap in the move handler.
     */
    let lastMove = 0;

    /** Long enough that a gap can only be something taking the pointer away. */
    const STALL_MS = 220;

    /*
     * And far enough that it can only be a stranding.
     *
     * Resting on a control leaves the ring a few pixels off the pointer,
     * because it is drifting toward the control's centre — snapping that away
     * on the next move would put a pop into the most ordinary interaction on
     * the site. Sixty pixels is well past any lean and well short of what the
     * mouse covers while a menu is open.
     */
    const STALL_GAP = 60;

    function wake(): void {
      if (looping) return;
      looping = true;
      // No age on the first frame of a new run — see `steps` below.
      lastFrame = 0;
      requestAnimationFrame(frame);
    }

    /**
     * When the previous frame was, so this one knows how much time it owes.
     *
     * Zero means there was no previous frame in this run and the first one is
     * charged a single frame's worth, which is what it used to be charged
     * unconditionally.
     */
    let lastFrame = 0;

    /**
     * One frame, as this file has always meant it.
     *
     * Not a constant anyone is free to change: it is the rate the three eases
     * below were tuned against, and it is what the rest of the file means when
     * it says a frame — "a wake-up every 16ms", "roughly a frame and a half of
     * lag". Fixing those numbers to a duration is the whole point of `steps`;
     * they stay attached to the display they were chosen on.
     */
    const FRAME_MS = 1000 / 60;

    function frame() {
      const now = performance.now();

      if (rageUntil && now >= rageUntil) {
        rageUntil = 0;
        root!.classList.remove('cursor--raging', 'cursor--zapped');
        // Emptied rather than left hidden: a path with a d attribute is still
        // a thing the compositor carries around for the rest of the visit.
        for (const path of [boltGlow, boltFork, boltCore]) path?.removeAttribute('d');
      }

      /*
       * A heavy ease while he is holding it, and none at all otherwise: the
       * drag is snapped shut rather than released, so the frame the rage ends
       * on is the frame the pointer is back under the mouse.
       */
      /*
       * How many sixtieths of a second this frame is worth.
       *
       * The three eases below are exponential smoothers with a per-*frame*
       * coefficient, and a per-frame coefficient is a refresh-rate dependency:
       * `x += (target - x) * 0.18` retains 82% of the error every frame, so a
       * 144Hz display applies it 2.4 times as often and converges 2.4 times as
       * fast. The ring genuinely sat closer to the pointer on a fast display
       * and trailed on a slow one — the same code, two different amounts of
       * weight, which is exactly the thing this pass exists to remove.
       *
       * Raising the retained fraction to the number of frames' worth of time
       * that actually elapsed makes the curve a function of time instead. At
       * 16.7ms this is 1 and every coefficient below is untouched, so a 60Hz
       * display — the rate they were tuned at — is identical to the pixel.
       * At 6.9ms each step is smaller, and 2.4 of them land where one used to.
       *
       * Deliberately not clamped. Coming back to a tab after a minute hands
       * this an enormous dt, the retained fraction goes to nothing, and the
       * ring arrives at the pointer on the first frame — which is where it
       * should be, because that is where the mouse is.
       */
      const steps = lastFrame ? (now - lastFrame) / FRAME_MS : 1;
      lastFrame = now;
      const ease = (perFrame: number) => 1 - Math.pow(1 - perFrame, steps);

      if (rageUntil) {
        const grip = ease(0.055);
        dragX += (targetX - dragX) * grip;
        dragY += (targetY - dragY) * grip;
      } else {
        dragX = targetX;
        dragY = targetY;
      }

      // Everything below aims at where the pointer is *drawn*, which is the
      // mouse except for that one second.
      const px = dragX;
      const py = dragY;

      let wantX = 0;
      let wantY = 0;
      let ringToX = px;
      let ringToY = py;

      if (magnet) {
        // Document space back to viewport space.
        const cx = magnet.left + magnet.w / 2 - window.scrollX;
        const cy = magnet.top + magnet.h / 2 - window.scrollY;

        wantX = clamp((px - cx) * LEAN, magnet.maxLeanX);
        wantY = clamp((py - cy) * LEAN, magnet.maxLeanY);

        // The ring drifts toward the control's centre; the dot never does.
        // Keeping the dot honest is what stops this feeling like input lag —
        // the thing you aim with is always exactly where you put it.
        ringToX = px + (cx - px) * RING_PULL;
        ringToY = py + (cy - py) * RING_PULL;
      }

      const pull = ease(0.2);
      leanX += (wantX - leanX) * pull;
      leanY += (wantY - leanY) * pull;

      const held = magnet?.el ?? releasing;
      if (held) {
        if (!magnet && Math.abs(leanX) < 0.06 && Math.abs(leanY) < 0.06) {
          held.style.translate = '';
          releasing = null;
        } else {
          held.style.translate = `${leanX.toFixed(2)}px ${leanY.toFixed(2)}px`;
        }
      }

      // Exponential ease toward the pointer. 0.18 per sixtieth keeps roughly a
      // frame and a half of lag: enough to feel like weight, not enough to
      // feel broken. Per sixtieth, now, rather than per frame — see `steps`.
      const chase = ease(0.18);
      ringX += (ringToX - ringX) * chase;
      ringY += (ringToY - ringY) * chase;

      // Within a tenth of a pixel of everything it is chasing, and with no
      // control left to release: nothing would change on the next frame.
      const settled =
        !zapUntil &&
        !rageUntil &&
        !releasing &&
        Math.abs(ringToX - ringX) < 0.1 &&
        Math.abs(ringToY - ringY) < 0.1 &&
        Math.abs(wantX - leanX) < 0.02 &&
        Math.abs(wantY - leanY) < 0.02;

      if (settled) {
        ringX = ringToX;
        ringY = ringToY;
      }

      /*
       * The punishment is an offset on what is already being drawn.
       *
       * A page cannot move the real cursor, and animating the ring's transform
       * directly would take it off the pointer for the length of the animation.
       * Adding a decaying wobble to the coordinates this loop already writes
       * keeps it tracking throughout, and costs nothing when it is zero.
       */
      let zapX = 0;
      let zapY = 0;
      if (rageUntil) {
        // Not a decaying wobble but a sustained one: he is not striking it and
        // letting go, he is holding it there.
        const t = now / 7;
        zapX = Math.sin(t) * 9;
        zapY = Math.cos(t * 1.37) * 7.5;
      } else if (zapUntil) {
        const left = zapUntil - now;
        if (left <= 0) {
          zapUntil = 0;
          root!.classList.remove('cursor--zapped');
        } else {
          // Fast, small, and irregular enough not to read as a sine wave.
          const k = left / ZAP_MS;
          const t = now / 9;
          zapX = Math.sin(t) * 5.5 * k;
          zapY = Math.cos(t * 1.37) * 4.5 * k;
        }
      }

      /*
       * Redrawn on its own clock, not every frame. At sixty frames a second the
       * bolt strobes into a blur; at about twenty it flickers, which is what
       * current looks like. It is aimed at the pointer *including* the shake,
       * so the thing being hit and the thing being drawn are the same point.
       */
      if (rageUntil && now - boltAt > 48) {
        boltAt = now;
        drawBolt(px + zapX, py + zapY);
      }

      ring!.style.transform = `translate3d(${ringX + zapX}px, ${ringY + zapY}px, 0) translate(-50%, -50%)`;
      dot!.style.transform = `translate3d(${px + zapX}px, ${py + zapY}px, 0) translate(-50%, -50%)`;
      if (zap) {
        zap.style.transform = `translate3d(${px}px, ${py}px, 0) translate(-50%, -50%)`;
      }

      if (settled) {
        looping = false;
        return;
      }

      requestAnimationFrame(frame);
    }

    /* ------------------------------------------------------------------ */
    /* Input                                                               */
    /* ------------------------------------------------------------------ */

    function show(): void {
      if (!visible) {
        visible = true;
        // Jump the ring to the pointer the first time so it does not fly in
        // from the middle of the screen.
        ringX = targetX;
        ringY = targetY;
      }
      root!.classList.add('cursor--on');
    }

    /*
     * `visible` is reset here, not just the class.
     *
     * Leaving the flag set meant the guard in show() short-circuited for the
     * rest of the session, so once anything had hidden the pointer no amount of
     * moving the mouse brought it back — and with the native cursor hidden too,
     * that left no pointer on screen at all.
     */
    function hide(): void {
      visible = false;
      root!.classList.remove('cursor--on');
    }

    /**
     * The element the last move was over.
     *
     * Both of the questions asked about it — is this interactive, and which
     * section is it in — walk up the tree to answer. A pointer crossing a
     * heading fires dozens of moves over the same element, and re-walking for
     * every one of them is work with a guaranteed identical answer.
     */
    let lastTarget: Element | null = null;

    function adopt(el: Element | null): void {
      lastTarget = el;
      root!.classList.toggle('cursor--active', Boolean(el?.closest?.(INTERACTIVE)));
      readTile(el);
      paintInk();
    }

    /*
     * An iframe is a hole in the pointer stream.
     *
     * Once the pointer is over one, every move belongs to the framed document
     * and this one hears nothing more until it comes back out — so the drawn
     * pointer stops where it last was, which is on the frame's edge, and sits
     * there looking frozen while the real one moves around inside. The Figma
     * explorer is the case that made it obvious, because the canvas is large
     * and people stay in it.
     *
     * Nothing here needs to notice the exit. `onMove` calls `show()` on the
     * first move back in the parent document, and `show()`'s own first-time
     * branch snaps the ring to the pointer rather than easing it in — so the
     * pointer reappears where the hand actually is instead of flying back
     * from the edge it was stranded on.
     *
     * The framed document keeps its own native cursor, which is correct: the
     * `cursor: none` rule is written into this document and does not reach
     * inside another one. Figma draws the pointer its own canvas needs.
     */
    const overFrame = (node: EventTarget | null): boolean =>
      node instanceof Element && node.closest('iframe') !== null;

    function onMove(event: PointerEvent) {
      /*
       * Checked before anything else, and in both places, because the order of
       * the crossing events is not something to rely on: a `pointerover` on the
       * frame may or may not be followed by a `pointermove` naming it. Either
       * one hides, and neither undoes the other.
       */
      if (overFrame(event.target)) {
        targetX = event.clientX;
        targetY = event.clientY;
        hide();
        return;
      }

      const now = performance.now();
      /*
       * A gap in the stream means something took the pointer away — a native
       * suggestion list, a select menu, the OS. The mouse kept moving the whole
       * time and the drawn one did not, so easing back over ten frames from
       * wherever it was stranded is what reads as the pointer being stuck.
       * Coming back is not a movement to animate: it is a correction, and it
       * belongs on the frame the pointer is heard from again.
       */
      if (
        now - lastMove > STALL_MS &&
        Math.hypot(event.clientX - ringX, event.clientY - ringY) > STALL_GAP
      ) {
        ringX = event.clientX;
        ringY = event.clientY;
        dragX = event.clientX;
        dragY = event.clientY;
      }
      lastMove = now;

      targetX = event.clientX;
      targetY = event.clientY;
      show();

      const el = event.target as Element | null;
      if (el !== lastTarget) adopt(el);

      engage(fieldAt(targetX + window.scrollX, targetY + window.scrollY));
      wake();
    }

    /**
     * Puts the pointer back into the state the page it has landed on implies.
     *
     * A navigation replaces everything under a pointer that has not moved, so
     * without this the ring stays open over a link that is no longer there and
     * the ink stays light over a dark section that has just been swapped out.
     */
    function resync(): void {
      if (!reacquire()) return;
      claimCursor();
      measureMagnets();

      adopt(document.elementFromPoint(targetX, targetY));

      // The router's swap can fire a boundary event that hides the pointer on
      // the way out; the visitor never left the window, so put it back.
      if (visible) root!.classList.add('cursor--on');
      wake();
    }

    restate = resync;

    window.addEventListener('pointermove', onMove, { passive: true });
    /*
     * Document-space positions do not change when the page scrolls, only when
     * it reflows — so scrolling costs nothing here. A magnet is the exception:
     * its viewport-space centre moves, so the lean has to be recomputed.
     */
    window.addEventListener(
      'scroll',
      () => {
        if (magnet) wake();
      },
      { passive: true }
    );
    window.addEventListener('resize', measureMagnets, { passive: true });
    /*
     * The mode change no longer alters *what* is magnetic — the portrait is in
     * the list in all three modes now — but it does move things: the theme
     * wipe runs, the nav's lock dot appears, and the badge arrives in the
     * footer. The list holds document-space rectangles, so anything that
     * reflows has to rebuild it or the pull lands beside the control.
     */
    document.addEventListener('mh:super', measureMagnets);

    /*
     * The storm starting and ending both change what is magnetic — the
     * portrait leaves the set when it goes inert and rejoins when the page
     * is itself again. `engage(null)` first, because a lean already applied
     * belongs to a control that is no longer accepting one, and it would
     * otherwise sit there until the pointer next moved.
     */
    document.addEventListener('mh:storm', () => {
      engage(null);
      measureMagnets();
    });
    window.addEventListener('load', measureMagnets);
    measureMagnets();

    // Entrance animations translate elements into place, so anything measured
    // during one sits a few pixels off. Re-measure once they have settled.
    window.setTimeout(measureMagnets, 1400);

    /*
     * Bound on the document, which the router never replaces, so this survives
     * a navigation the way the pointer itself does.
     */
    document.addEventListener('mh:punish', (event) => {
      const shakes = (event as CustomEvent<{ shakes?: boolean }>).detail?.shakes !== false;
      root!.classList.remove('cursor--zapped');
      // Flushed, so a second refusal restarts the arcs rather than being
      // swallowed by the ones still fading.
      void root!.offsetWidth;
      root!.classList.add('cursor--zapped');
      zapUntil = shakes ? performance.now() + ZAP_MS : 0;
      if (!shakes) window.setTimeout(() => root!.classList.remove('cursor--zapped'), ZAP_MS);
      wake();
    });

    document.addEventListener('mh:rage', () => {
      root!.classList.remove('cursor--raging', 'cursor--zapped');
      void root!.offsetWidth;
      root!.classList.add('cursor--raging', 'cursor--zapped');
      zapUntil = 0;
      rageUntil = performance.now() + RAGE_MS;
      // Overhead, roughly. Off to one side by a fifth of the screen so it comes
      // down at an angle rather than dropping like a plumb line.
      boltFromX = targetX + (Math.random() * 2 - 1) * window.innerWidth * 0.2;
      boltAt = 0;
      // From wherever it is now, so the weight is felt from the first frame
      // rather than after a jump to the mouse.
      dragX = ringX;
      dragY = ringY;
      wake();
    });

    /*
     * The moment of contact.
     *
     * Not a ripple, and deliberately not the ring it replaces. A ring is a
     * shape that travels, which makes it an event — something the eye
     * follows and files as an animation that played. What belongs here is
     * smaller than that: the press is not the story on this site, the wave
     * that follows it is, and this only has to make the wave feel like it
     * came from a touch rather than from a timer.
     *
     * So it is light rather than line. A soft radial fall-off with no edge
     * anywhere in it — no border, no stroke, no ring, nothing that resolves
     * into a silhouette — which appears at the point of contact, swells by
     * about a fifth, and is gone inside a fifth of a second. Peak alpha at
     * the centre is around a quarter, over roughly forty pixels. It is
     * meant to be felt and not catalogued.
     *
     * It is drawn in `--cursor-bloom`, which follows the surface under the
     * pointer rather than the page: light where the pointer is dark and dark
     * where it is light, so the same rule reads as a highlight over a
     * project cover and as a pressure mark over paper. The purple modes tint
     * it toward the accent; nothing else does.
     *
     * Same coordinate as everything else the press starts. `event.clientX/Y`
     * is what the storm reads too, so the bloom and the wave leave from one
     * point by construction rather than by agreement.
     */
    let contact: Animation | null = null;
    const press_ = (event: PointerEvent) => {
      // The main button only. A right-click opens a menu, which is the
      // response to that press; a second one underneath it is noise.
      if (event.button !== 0 || !bloom) return;
      // The storm has its own answer to a press, and it is not a whisper.
      if (root!.classList.contains('cursor--raging')) return;

      contact?.cancel();
      const at = `translate3d(${event.clientX}px, ${event.clientY}px, 0) translate(-50%, -50%)`;

      /*
       * Three segments, and the shape of them is the whole effect.
       *
       * It arrives faster than it leaves — full strength by about forty
       * milliseconds, then a long quiet decay — because that is the
       * asymmetry every real impact has, and the reverse of it reads as a
       * fade-in, which is a thing appearing rather than a thing being hit.
       * The size barely moves across all of it: a fifth, not a doubling.
       * Something that grows a long way is a wave, and there is already a
       * wave.
       *
       * One `animate()` per press, no `fill`, so the CSS below is what this
       * element is the rest of the time and there is nothing to clean up.
       */
      contact = bloom.animate(
        [
          {
            transform: `${at} scale(0.5)`,
            opacity: 0,
            easing: 'cubic-bezier(0.2, 0.8, 0.4, 1)',
          },
          {
            transform: `${at} scale(0.88)`,
            opacity: 1,
            offset: 0.22,
            easing: 'cubic-bezier(0.4, 0, 0.5, 1)',
          },
          {
            transform: `${at} scale(1.06)`,
            opacity: 0.6,
            offset: 0.5,
            easing: 'cubic-bezier(0.4, 0, 0.7, 1)',
          },
          { transform: `${at} scale(1.18)`, opacity: 0 },
        ],
        { duration: BLOOM_MS }
      );
    };

    const press = (event: PointerEvent) => {
      root!.classList.add('cursor--down');
      press_(event);
    };
    const release = () => root!.classList.remove('cursor--down');
    window.addEventListener('pointerdown', press);
    window.addEventListener('pointerup', release);
    /*
     * A press that ends anywhere other than on the page never fires pointerup:
     * dragging out of the window, the browser cancelling the gesture, or the
     * tab losing focus to whatever the click opened. The ring would otherwise
     * stay contracted until the next click.
     */
    window.addEventListener('pointercancel', release);
    window.addEventListener('blur', release);

    /*
     * Only a genuine exit from the window hides the pointer.
     *
     * `mouseleave` on the document also fires when the element under the
     * pointer is removed — which the client router does to the entire page on
     * every navigation. `relatedTarget` is null only when the pointer has
     * really left; during a swap it names whatever it moved to instead.
     */
    document.addEventListener('mouseleave', (event) => {
      if ((event as MouseEvent).relatedTarget === null) hide();
    });
    document.addEventListener('mouseenter', show);

    // The other half of the iframe guard. See `overFrame`.
    document.addEventListener('pointerover', (event) => {
      if (overFrame(event.target)) hide();
    });

    // The ink follows the theme as well as the section, so it has to be
    // repainted when the switch is used or the OS changes underneath it.
    window.addEventListener('mh:themechange', paintInk);
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', paintInk);

    paintInk();
    wake();

    /*
     * The pointer is leaving with the old page: drop the magnet so the control
     * being removed does not take a stray offset to the grave. The loop itself
     * needs no restarting — the cursor element is persisted.
     */
    document.addEventListener('astro:before-swap', () => engage(null));
    document.addEventListener('astro:after-swap', resync);
  }

  /*
   * Runs exactly once per tab. The flag deliberately lives on window rather
   * than on <html>, whose attributes the client router replaces on every
   * navigation — keeping it there re-ran this on each page and stacked up
   * another copy of every window listener.
   */
  /*
   * The class goes back on before the new page is painted, not after it.
   *
   * The router replaces every attribute on <html> with the incoming
   * document's, and this one is only ever set at runtime — so following any
   * link dropped it, and it was not put back until astro:page-load, which is
   * after the transition has already been drawn. For those few hundred
   * milliseconds nothing was hiding the native cursor and it sat on top of the
   * drawn one. That is the arrow that kept appearing on the buttons that
   * navigate.
   *
   * astro:after-swap is the first moment after the wipe and still inside the
   * update callback, so the class is there before anything is on screen.
   */
  document.addEventListener('astro:after-swap', claimCursor);

  document.addEventListener('astro:page-load', () => {
    const w = window as unknown as { __mhCursor?: boolean };
    if (w.__mhCursor) {
      // Also covers the router's no-view-transition fallback path, where
      // astro:after-swap is not the moment the attributes are replaced.
      restate();
      return;
    }
    w.__mhCursor = true;
    setupCursor();
  });
</script>

<style is:global>
  /* Hidden until the script confirms a real pointer, so touch users and
     no-JS visitors never lose their cursor. */
  html.has-custom-cursor,
  html.has-custom-cursor * {
    cursor: none !important;
  }

  /*
   * And hidden over the transition, which is not part of that tree.
   *
   * A view transition paints its snapshot in the top layer, above the whole
   * document — so for the length of one, what is under the pointer is not any
   * descendant of <html> and inherits nothing from it. The native cursor came
   * back for those few hundred milliseconds and sat on top of the drawn one,
   * which is why it showed on exactly the two things that start a transition:
   * the theme toggle's wipe, and any link or button that navigates.
   *
   * The pseudo-elements have to be named directly for the same reason. They
   * are addressed off the root, and `*` above never reaches them.
   */
  html.has-custom-cursor::view-transition,
  html.has-custom-cursor::view-transition-group(*),
  html.has-custom-cursor::view-transition-image-pair(*),
  html.has-custom-cursor::view-transition-old(*),
  html.has-custom-cursor::view-transition-new(*) {
    cursor: none !important;
  }
</style>

<style>
  .cursor {
    /*
     * Not merely transparent when idle: this is a full-viewport fixed layer,
     * and on a phone — where the custom pointer never runs at all — it would
     * ride along with every scroll for nothing.
     *
     * The class is added by the script only on a device with a real pointer.
     */
    display: none;
    position: fixed;
    inset: 0;
    z-index: 9999;
    pointer-events: none;
    opacity: 0;
    transition: opacity 220ms var(--ease-glide);

    /*
     * The ring resizes as it opens over a control. Containment keeps that
     * inside this layer: without it a size change on the ring is a layout
     * invalidation the browser has to prove does not affect the page.
     */
    contain: layout size style;

    /* ---- Ink ------------------------------------------------------- */
    /*
     * The pointer is drawn in the palette rather than blended.
     *
     * A `mix-blend-mode: difference` pointer needs no theme awareness, which
     * is why it was there — but it inverts whatever is behind it, so over a
     * green project cover it turned magenta, and it forced the whole page
     * beneath the layer to be composited on every frame.
     *
     * `--cursor-veil` is a hairline of the opposite value sitting under both
     * shapes. It is what keeps a dark pointer readable over a dark photograph
     * without making the pointer itself look like an effect.
     */
    --cursor-ink: #1d1d1f;
    --cursor-veil: rgba(255, 255, 255, 0.7);
    /* The accent, referenced rather than copied, so a change to the site's
       blue reaches the pointer too. It is the blue in every mode — the
       purple the storm and the third theme use is `--dm-core`, which is
       what the bloom below mixes toward. */
    --cursor-accent: var(--blue);
    /*
     * What a press is drawn in.
     *
     * `--cursor-ink` by default, which is not a colour decision so much as
     * an inherited one: the ink already tracks the surface under the pointer
     * rather than the page, so this comes out as a soft highlight over a
     * dark project cover and as a soft pressure mark over a pale section,
     * with no theme branching anywhere. The purple modes are the only case
     * that wants a hue of its own, and they get it below.
     */
    --cursor-bloom: var(--cursor-ink);
  }

  /*
   * Purple, but only barely.
   *
   * `--dm-core` rather than `--cursor-accent`, which was the obvious choice
   * and the wrong one: measured under both modes, `--blue` stays #2997ff and
   * never becomes purple, so mixing toward the accent produced a muddy blue
   * where the rest of the interface had gone violet. `--dm-core` is the hue
   * the storm and the third theme are actually drawn in.
   *
   * Mixed back toward the ink rather than used neat, so the bloom reads as
   * the material catching the light it is already lit by — super mode has
   * pushed `--ink` itself to a violet white, and this stays a shade of that
   * — instead of as a coloured effect fired off on top of it.
   */
  :global(:root[data-super]) .cursor,
  :global(:root[data-designer]) .cursor {
    --cursor-bloom: color-mix(in srgb, var(--dm-core) 45%, var(--cursor-ink));
  }

  /* ------------------------------------------------------------------ */
  /* The punishment                                                      */
  /* ------------------------------------------------------------------ */

  /*
   * A fragment of the storm, at the size of the pointer.
   *
   * The same palette designer mode is built from, and nothing else borrowed
   * from it: three short arcs and a glow, both gone inside four tenths of a
   * second. It is drawn over the pointer rather than instead of it, so what
   * the visitor is aiming with never changes shape.
   */
  .cursor__zap {
    position: absolute;
    top: 0;
    left: 0;
    width: 46px;
    height: 46px;
    color: var(--dm-arc);
    opacity: 0;
    will-change: transform, opacity;
  }

  .cursor--zapped .cursor__zap {
    animation: cursor-zap 380ms var(--ease-out) both;
  }

  /* The glow sits on the ring rather than being another element: it is already
     centred on the pointer and already the right size. */
  .cursor--zapped .cursor__ring {
    border-color: color-mix(in srgb, var(--dm-core) 80%, transparent);
    box-shadow:
      0 0 12px color-mix(in srgb, var(--dm-core) 55%, transparent),
      inset 0 0 8px color-mix(in srgb, var(--dm-wave) 45%, transparent);
    animation: cursor-zap-ring 380ms var(--ease-out) both;
  }

  @keyframes cursor-zap {
    0% {
      opacity: 0;
      scale: 0.72;
    }
    /* Struck. */
    14% {
      opacity: 1;
      scale: 1.04;
    }
    /* Two flickers rather than a fade: current that is failing to hold. */
    38% {
      opacity: 0.35;
      scale: 1;
    }
    56% {
      opacity: 0.9;
      scale: 1.08;
    }
    100% {
      opacity: 0;
      scale: 1.16;
    }
  }

  @keyframes cursor-zap-ring {
    0%,
    100% {
      scale: 1;
    }
    18% {
      scale: 1.22;
    }
    52% {
      scale: 1.08;
    }
  }

  /*
   * The bolt.
   *
   * A full-viewport layer inside the pointer's own, so its user units are
   * viewport pixels and the coordinates the script works in need no mapping.
   * Three strokes over each other: a wide soft one for the light it throws, a
   * fork that goes nowhere, and a hot white core down the middle — which is
   * what a bolt actually is, and is why one flat purple line never looks like
   * one.
   */
  .cursor__bolt {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    overflow: visible;
  }

  .cursor--raging .cursor__bolt {
    opacity: 1;
  }

  .cursor__bolt-glow,
  .cursor__bolt-fork,
  .cursor__bolt-core {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .cursor__bolt-glow {
    stroke: var(--dm-core);
    stroke-width: 9;
    opacity: 0.42;
    filter: drop-shadow(0 0 16px color-mix(in srgb, var(--dm-core) 80%, transparent));
  }

  .cursor__bolt-fork {
    stroke: var(--dm-arc);
    stroke-width: 2.4;
    opacity: 0.8;
  }

  .cursor__bolt-core {
    stroke: color-mix(in srgb, var(--dm-arc) 40%, #fff);
    stroke-width: 2.2;
    filter: drop-shadow(0 0 7px var(--dm-arc));
  }

  /*
   * The rage: the same arcs, but held on rather than struck and let go.
   *
   * A loop of about a sixth of a second, which is short enough that the flicker
   * never resolves into a rhythm you could count — it reads as current that is
   * still arriving, not as an animation repeating.
   */
  .cursor--raging .cursor__zap {
    animation: cursor-rage 170ms steps(2, jump-none) infinite;
    scale: 1.5;
  }

  .cursor--raging .cursor__ring {
    border-color: var(--dm-core);
    box-shadow:
      0 0 26px color-mix(in srgb, var(--dm-core) 85%, transparent),
      inset 0 0 14px color-mix(in srgb, var(--dm-wave) 70%, transparent);
    animation: cursor-rage-ring 170ms ease-in-out infinite alternate;
  }

  @keyframes cursor-rage {
    0% {
      opacity: 1;
    }
    100% {
      opacity: 0.55;
    }
  }

  @keyframes cursor-rage-ring {
    0% {
      scale: 1.24;
    }
    100% {
      scale: 1.42;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor--raging .cursor__zap,
    .cursor--raging .cursor__ring {
      animation: none;
    }

    .cursor--raging .cursor__bolt {
      opacity: 0;
    }

    .cursor--raging .cursor__zap {
      opacity: 1;
    }

    .cursor--zapped .cursor__zap,
    .cursor--zapped .cursor__ring {
      animation-duration: 240ms;
      animation-name: cursor-zap-quiet;
    }

    @keyframes cursor-zap-quiet {
      0%,
      100% {
        opacity: 0;
      }
      40% {
        opacity: 1;
      }
    }
  }

  .cursor--light {
    --cursor-ink: #f5f5f7;
    --cursor-veil: rgba(0, 0, 0, 0.45);
    --cursor-accent: var(--blue-on-dark);
  }

  :global(html.has-custom-cursor) .cursor {
    display: block;
  }

  .cursor--on {
    opacity: 1;
  }

  .cursor__dot,
  .cursor__ring {
    position: absolute;
    top: 0;
    left: 0;
    border-radius: 50%;
    will-change: transform;
  }

  /*
   * The contact.
   *
   * Light with no edge in it: three stops of one radial fall-off, reaching
   * transparent well before the box does, so there is no circle to find at
   * any point in the animation. No border, no shadow, no veil pair — the
   * ring above needs those to stay legible because it is a hairline, and
   * this is the opposite kind of mark. Giving it an outline would make it
   * the thing it was written to replace.
   *
   * Invisible at rest and invisible again the moment the press animation
   * ends, because those keyframes carry no `fill`. This rule is the element
   * between clicks, which is why there is nothing to reset.
   */
  .cursor__bloom {
    position: absolute;
    top: 0;
    left: 0;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--cursor-bloom) 26%, transparent),
      color-mix(in srgb, var(--cursor-bloom) 11%, transparent) 38%,
      transparent
    );
    opacity: 0;
  }

  .cursor__ring {
