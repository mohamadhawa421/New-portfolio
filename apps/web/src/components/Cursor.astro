---
/**
 * Custom pointer.
 *
 * Two parts: a small solid dot that tracks the mouse exactly, and a larger ring
 * that eases toward it a frame behind. The lag is the whole effect — it is what
 * makes the pointer feel weighted rather than glued to the cursor.
 *
 * Only ever shown on a device with a real pointer. Touch screens and anyone who
 * has asked for reduced motion keep the native cursor, and so does anyone whose
 * browser cannot run the script — the native cursor is only hidden from inside
 * the script, never from static CSS.
 */
---

<div class="cursor" data-cursor aria-hidden="true">
  <div class="cursor__ring" data-cursor-ring></div>
  <div class="cursor__dot" data-cursor-dot></div>
</div>

<script>
  /** Set once the cursor is running, so navigations can trigger a re-measure. */
  let measure: () => void = () => {};

  function setupCursor() {
    const rootEl = document.querySelector<HTMLElement>('[data-cursor]');
    const ringEl = document.querySelector<HTMLElement>('[data-cursor-ring]');
    const dotEl = document.querySelector<HTMLElement>('[data-cursor-dot]');
    if (!rootEl || !ringEl || !dotEl) return;

    const root = rootEl;
    const ring = ringEl;
    const dot = dotEl;

    const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!fine || reduced) return;

    // Only now is it safe to hide the real cursor.
    document.documentElement.classList.add('has-custom-cursor');

    let targetX = window.innerWidth / 2;
    let targetY = window.innerHeight / 2;
    let ringX = targetX;
    let ringY = targetY;
    let visible = false;

    const INTERACTIVE = 'a, button, [role="button"], input, select, textarea, label, summary';

    /*
     * Magnetism.
     *
     * Buttons and the other small controls, not links or cards: on something
     * the size of a project row the pull reads as the layout drifting.
     */
    const MAGNETIC = '.btn, .enquiry__send, .chip, .theme-toggle, .text-link';

    /** Fraction of the pointer's offset from centre that the control leans. */
    const LEAN = 0.22;
    /** Hard ceiling on that lean. Past about this the control stops looking
     *  attached to the layout it sits in. */
    const LEAN_MAX = 10;
    /** How far the ring drifts off the true pointer toward the control. */
    const RING_PULL = 0.32;
    /** How far outside a control the field reaches. The pull has to start
     *  before the pointer arrives or it is not magnetism, just a hover state. */
    const FIELD = 26;

    /*
     * Positions are stored in document space and measured once per page rather
     * than read per pointermove. Calling getBoundingClientRect() on every move
     * would force a layout flush on the one interaction that has to stay
     * perfectly smooth.
     */
    interface Magnet {
      el: HTMLElement;
      top: number;
      left: number;
      w: number;
      h: number;
      /** Ceilings for this control, per axis — see measureMagnets. */
      maxLeanX: number;
      maxLeanY: number;
    }

    let magnets: Magnet[] = [];
    let magnet: Magnet | null = null;
    let releasing: HTMLElement | null = null;
    let leanX = 0;
    let leanY = 0;

    const clamp = (v: number, max: number) => (v > max ? max : v < -max ? -max : v);

    // Exposed so a navigation can re-measure without re-running setup.
    measure = measureMagnets;

    function measureMagnets(): void {
      const sx = window.scrollX;
      const sy = window.scrollY;
      magnets = Array.from(document.querySelectorAll<HTMLElement>(MAGNETIC)).map((el) => {
        const r = el.getBoundingClientRect();
        return {
          el,
          top: r.top + sy,
          left: r.left + sx,
          w: r.width,
          h: r.height,
          maxLeanX: LEAN_MAX,
          maxLeanY: LEAN_MAX,
        };
      });

      /*
       * Each control leans at most half the distance to whatever sits beside
       * it, so it can never reach its neighbour.
       *
       * Without this the lean is a flat maximum, and a flat maximum is wrong
       * wherever controls are close together: the hero's two buttons sit in a
       * 10px gap, so a 10px lean slid one straight into the other and read as
       * a second button appearing underneath. Filter chips have the same
       * problem at 8px.
       */
      for (const m of magnets) {
        let nearestX = Infinity;
        let nearestY = Infinity;

        for (const other of magnets) {
          if (other === m) continue;

          // Side by side: constrains sideways movement only.
          if (m.top < other.top + other.h && other.top < m.top + m.h) {
            const gap =
              other.left >= m.left + m.w
                ? other.left - (m.left + m.w)
                : m.left >= other.left + other.w
                  ? m.left - (other.left + other.w)
                  : 0;
            if (gap < nearestX) nearestX = gap;
          }

          // Stacked: constrains vertical movement only.
          if (m.left < other.left + other.w && other.left < m.left + m.w) {
            const gap =
              other.top >= m.top + m.h
                ? other.top - (m.top + m.h)
                : m.top >= other.top + other.h
                  ? m.top - (other.top + other.h)
                  : 0;
            if (gap < nearestY) nearestY = gap;
          }
        }

        // Per axis, because a row of buttons is crowded sideways and free
        // vertically — capping both by the tightest gap in either direction
        // would flatten the effect for no reason. A pixel of slack so
        // neighbours never quite touch.
        const cap = (gap: number) => Math.max(0, Math.min(LEAN_MAX, gap / 2 - 1));
        if (nearestX !== Infinity) m.maxLeanX = cap(nearestX);
        if (nearestY !== Infinity) m.maxLeanY = cap(nearestY);
      }

      magnet = null;
    }

    /**
     * The control the pointer belongs to: the one under it, or failing that the
     * nearest one within the field.
     *
     * Nearest matters. Two controls sitting side by side have overlapping
     * fields, and simply taking the first match in document order meant
     * hovering one button could pull its neighbour instead — which reads as a
     * second button lurching about underneath the one you are pointing at.
     */
    function fieldAt(px: number, py: number): Magnet | null {
      let best: Magnet | null = null;
      let bestDistance = Infinity;

      for (const m of magnets) {
        // Distance from the point to the rectangle, zero when inside it.
        const dx = px < m.left ? m.left - px : px > m.left + m.w ? px - (m.left + m.w) : 0;
        const dy = py < m.top ? m.top - py : py > m.top + m.h ? py - (m.top + m.h) : 0;

        // Directly over a control always wins outright.
        if (dx === 0 && dy === 0) return m;

        const distance = Math.hypot(dx, dy);
        if (distance <= FIELD && distance < bestDistance) {
          bestDistance = distance;
          best = m;
        }
      }

      return best;
    }

    function engage(next: Magnet | null): void {
      if (magnet === next) return;

      // Whatever was easing back has had its turn; a stray offset left on an
      // element is worse than one snapped frame.
      if (releasing && releasing !== next?.el) releasing.style.translate = '';
      releasing = null;

      if (magnet) {
        if (next) magnet.el.style.translate = '';
        else releasing = magnet.el;
      }

      magnet = next;

      if (next) {
        leanX = 0;
        leanY = 0;
      }

      /*
       * Deliberately no will-change here. Promoting the control to its own
       * compositor layer for the duration of the hover left a repainted copy
       * of it behind at its original position as it moved. A translate is
       * cheap enough to composite without the hint.
       */
    }

    function frame() {
      let wantX = 0;
      let wantY = 0;
      let ringToX = targetX;
      let ringToY = targetY;

      if (magnet) {
        // Document space back to viewport space.
        const cx = magnet.left + magnet.w / 2 - window.scrollX;
        const cy = magnet.top + magnet.h / 2 - window.scrollY;

        wantX = clamp((targetX - cx) * LEAN, magnet.maxLeanX);
        wantY = clamp((targetY - cy) * LEAN, magnet.maxLeanY);

        // The ring drifts toward the control's centre; the dot never does.
        // Keeping the dot honest is what stops this feeling like input lag —
        // the thing you aim with is always exactly where you put it.
        ringToX = targetX + (cx - targetX) * RING_PULL;
        ringToY = targetY + (cy - targetY) * RING_PULL;
      }

      leanX += (wantX - leanX) * 0.2;
      leanY += (wantY - leanY) * 0.2;

      const held = magnet?.el ?? releasing;
      if (held) {
        if (!magnet && Math.abs(leanX) < 0.06 && Math.abs(leanY) < 0.06) {
          held.style.translate = '';
          releasing = null;
        } else {
          held.style.translate = `${leanX.toFixed(2)}px ${leanY.toFixed(2)}px`;
        }
      }

      // Exponential ease toward the pointer. 0.18 keeps roughly a frame and a
      // half of lag: enough to feel like weight, not enough to feel broken.
      ringX += (ringToX - ringX) * 0.18;
      ringY += (ringToY - ringY) * 0.18;

      ring.style.transform = `translate3d(${ringX}px, ${ringY}px, 0) translate(-50%, -50%)`;
      dot.style.transform = `translate3d(${targetX}px, ${targetY}px, 0) translate(-50%, -50%)`;

      requestAnimationFrame(frame);
    }

    function onMove(event: PointerEvent) {
      targetX = event.clientX;
      targetY = event.clientY;

      if (!visible) {
        visible = true;
        // Jump the ring to the pointer the first time so it does not fly in
        // from the middle of the screen.
        ringX = targetX;
        ringY = targetY;
        root.classList.add('cursor--on');
      }

      const el = event.target as Element | null;
      const overInteractive = el?.closest?.(INTERACTIVE);
      root.classList.toggle('cursor--active', Boolean(overInteractive));

      engage(fieldAt(targetX + window.scrollX, targetY + window.scrollY));
    }

    window.addEventListener('pointermove', onMove, { passive: true });
    /*
     * Document-space positions do not change when the page scrolls, only when
     * it reflows — so scrolling costs nothing here and only a resize, a late
     * image, or a new page needs a re-measure.
     */
    window.addEventListener('resize', measureMagnets, { passive: true });
    window.addEventListener('load', measureMagnets);
    measureMagnets();

    // Entrance animations translate elements into place, so anything measured
    // during one sits a few pixels off. Re-measure once they have settled.
    window.setTimeout(measureMagnets, 1400);
    window.addEventListener('pointerdown', () => root.classList.add('cursor--down'));
    window.addEventListener('pointerup', () => root.classList.remove('cursor--down'));
    document.addEventListener('mouseleave', () => root.classList.remove('cursor--on'));
    document.addEventListener('mouseenter', () => root.classList.add('cursor--on'));

    requestAnimationFrame(frame);

    /*
     * The pointer is leaving with the old page: drop the magnet so the control
     * being removed does not take a stray offset to the grave, and re-measure
     * once the new page is up. The loop itself keeps running — the cursor
     * element is persisted, so there is nothing to restart.
     */
    document.addEventListener('astro:before-swap', () => engage(null));
    document.addEventListener('astro:after-swap', measureMagnets);
  }

  /*
   * Runs exactly once per tab. The flag deliberately lives on window rather
   * than on <html>, whose attributes the client router replaces on every
   * navigation — keeping it there re-ran this on each page and stacked up
   * another copy of every window listener.
   */
  document.addEventListener('astro:page-load', () => {
    const w = window as unknown as { __mhCursor?: boolean };
    if (w.__mhCursor) {
      measure();
      return;
    }
    w.__mhCursor = true;
    setupCursor();
  });
</script>

<style is:global>
  /* Hidden until the script confirms a real pointer, so touch users and
     no-JS visitors never lose their cursor. */
  html.has-custom-cursor,
  html.has-custom-cursor * {
    cursor: none !important;
  }
</style>

<style>
  .cursor {
    position: fixed;
    inset: 0;
    z-index: 9999;
    pointer-events: none;
    opacity: 0;
    transition: opacity 220ms var(--ease-glide);
    /*
     * Drawn white and blended with difference, so the pointer inverts against
     * whatever is behind it: it renders black over the white sections and
     * white over the near-black ones. A fixed black cursor disappears entirely
     * on the dark contact page — and would do the same across a dark theme.
     * This needs no theme awareness at all.
     */
    mix-blend-mode: difference;
  }

  .cursor--on {
    opacity: 1;
  }

  .cursor__dot,
  .cursor__ring {
    position: absolute;
    top: 0;
    left: 0;
    border-radius: 50%;
    will-change: transform;
  }

  .cursor__dot {
    width: 7px;
    height: 7px;
    /* White, not var(--ink) — the difference blend above does the inverting. */
    background: #fff;
    transition: width 260ms var(--ease-glide), height 260ms var(--ease-glide);
  }

  .cursor__ring {
    width: 34px;
    height: 34px;
    border: 1.5px solid #fff;
    opacity: 0.55;
    transition:
      width 320ms var(--ease-glide),
      height 320ms var(--ease-glide),
      opacity 320ms var(--ease-glide),
      background-color 320ms var(--ease-glide);
  }

  /* Over anything clickable the ring opens up and the dot shrinks away. */
  .cursor--active .cursor__ring {
    width: 52px;
    height: 52px;
    opacity: 1;
    background: rgba(255, 255, 255, 0.12);
  }

  .cursor--active .cursor__dot {
    width: 0;
    height: 0;
  }

  .cursor--down .cursor__ring {
    width: 28px;
    height: 28px;
  }
</style>
