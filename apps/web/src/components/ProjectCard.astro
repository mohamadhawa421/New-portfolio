---
import type { Project } from '../lib/types';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<a
  class="card"
  href={`/work/${project.slug}`}
  data-reveal="0"
  data-category={project.category}
>
  <div class="card__tile" style={`background:${project.chipBg};color:${project.chipInk}`}>
    {
      project.cover ? (
        <img src={project.cover.url} alt={project.cover.alt} loading="lazy" decoding="async" />
      ) : (
        <span class="card__initials">{project.initials}</span>
      )
    }
  </div>

  <div class="card__body">
    <div class="card__meta">{project.num} — {project.category}</div>
    <h2 class="card__title">{project.title}</h2>
    <p class="card__summary">{project.summary}</p>
    <span class="card__cta">View project&nbsp;›</span>
  </div>
</a>

<style>
  /* The work page filters by setting the `hidden` attribute. Without this the
     browser's own [hidden]{display:none} loses to display:flex below and the
     cards never actually disappear. */
  .card[hidden] {
    display: none;
  }

  .card {
    display: flex;
    flex-direction: column;
    position: relative;
    background: var(--surface-card);
    border-radius: var(--r-xl);
    overflow: hidden;
    color: inherit;
    transform: translateZ(0);
    transition:
      transform 180ms var(--ease-out),
      opacity 520ms var(--ease-smooth);
  }

  /* Compositor-only hover fill — see ProjectRow.astro for why this is a
     separate opacity layer instead of a `background` transition. */
  .card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--surface-card-hover);
    opacity: 0;
    transition: opacity 140ms ease-out;
  }

  .card:hover {
    transform: translate3d(0, -6px, 0);
    color: inherit;
  }

  .card:hover::after {
    opacity: 1;
  }

  .card__tile {
    position: relative;
    aspect-ratio: 16 / 10;
    display: flex;
    align-items: flex-end;
    padding: clamp(18px, 2vw, 26px);
    overflow: hidden;
    /* Its own layer, so the 1.03 scale on hover composites the already-decoded
       image instead of asking the browser to re-rasterise it every frame. */
    transform: translateZ(0);
    transition: transform 420ms var(--ease-out);
  }

  .card:hover .card__tile {
    transform: scale(1.03);
  }

  .card__tile img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .card__initials {
    font-size: clamp(34px, 4.4vw, 58px);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .card__body {
    padding: clamp(20px, 2.2vw, 28px);
    display: flex;
    flex-direction: column;
    gap: 7px;
    flex: 1;
  }

  .card__meta {
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .card__title {
    font-size: clamp(21px, 2.2vw, 28px);
    line-height: 1.14;
    letter-spacing: -0.016em;
    font-weight: 600;
  }

  .card__summary {
    font-size: 17px;
    line-height: 1.47;
    letter-spacing: -0.022em;
    color: var(--ink-muted);
  }

  .card__cta {
    margin-top: auto;
    padding-top: 14px;
    font-size: 17px;
    letter-spacing: -0.022em;
    color: var(--blue);
  }
</style>
