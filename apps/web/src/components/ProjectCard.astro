---
import type { Project } from '../lib/types';

interface Props {
  project: Project;
  /** Position in the grid, counting from zero. */
  index?: number;
}

const { project, index = 0 } = Astro.props;

/*
 * The first covers are not lazy.
 *
 * Every cover carried loading="lazy", including the ones the visitor opens the
 * page looking at. A lazy image is invisible to the preload scanner and is not
 * fetched until layout has decided where it goes, so the cards at the top of
 * the grid — the largest thing on the page and the one the visitor is waiting
 * for — were the last images to be asked for.
 *
 * Three covers the eager path: one column on a phone, two on a tablet and
 * three on a desktop, which is the most that can be above the fold in any of
 * the layouts. The first also declares itself the priority, since on this page
 * it is what the largest paint is going to be.
 */
const eager = index < 3;

// Pipe-delimited rather than JSON: the filter script only has to split it, and
// no service title contains a pipe. Read by the Work page's chips.
const filterKey = project.categories.join('|');

/*
 * The placeholder colour is only painted when there is no cover.
 *
 * Behind one, it is never meant to be seen — and it was: a rounded, clipped
 * frame and the picture inside it are rasterised separately, so the corner
 * pixels blend the two and a pale placeholder under a dark cover surfaces as a
 * hairline along whichever edge happens to land off the pixel grid. It moved
 * from project to project with the layout, and re-rasterising the layer on
 * scroll made it come and go.
 *
 * With nothing to bleed through, there is nothing to see.
 */
const tileStyle = project.cover
  ? `color:${project.chipInk}`
  : `background:${project.chipBg};color:${project.chipInk}`;

/*
 * The small renderings of the cover, if the export made any.
 *
 * Measured on the work grid: the tile is 364 CSS px wide and the file behind
 * it is 1440, so on a 2x screen the browser decodes four times the pixels it
 * draws and rescales them on every raster — and it re-rasters on every frame
 * of the entrance, because a fading card is repainted rather than composited.
 * Fifteen cards is 88MB of decoded bitmap against the 20MB the page shows.
 *
 * The names are a convention with apps/cms/scripts/export-content.js, which
 * writes `foo-480.webp` and `foo-960.webp` beside `foo.webp`. Nothing records
 * them in content.json — the filename already says it — so the gate on which
 * ones exist has to match the exporter's: it writes a width only when the
 * original is at least 1.25x it. Keep the two in step; they are commented at
 * both ends.
 *
 * No srcset at all when the cover is too small to have variants, or is not a
 * webp. `src` is unchanged either way, so the worst case is what shipped
 * before.
 */
const VARIANT_WIDTHS = [420, 840, 1200];

const cover = project.cover;
const coverSrcset =
  cover && cover.url.endsWith('.webp')
    ? VARIANT_WIDTHS.filter((at) => (cover.width ?? 0) >= at * 1.15)
        .map((at) => `${cover.url.slice(0, -'.webp'.length)}-${at}.webp ${at}w`)
        .concat(cover.width ? [`${cover.url} ${cover.width}w`] : [])
        .join(', ')
    : '';

/*
 * What the tile is actually going to be, so the browser can pick from the
 * list above before it has done layout.
 *
 * Measured rather than estimated, because `sizes` being 16% high is enough to
 * push every card up a step: the grid is
 * `repeat(auto-fit, minmax(min(100%, 320px), 1fr))` inside the shell, and the
 * tile came out at 89.2% of the viewport one-up (390-640px), 43.6% two-up
 * (767-1279px), and a flat 397px three-up, because above 1440 the shell stops
 * growing and the vw-relative figure keeps shrinking — 28.4% at 1280, 20.7%
 * at 1920. A percentage for that last band would over-ask on a wide monitor
 * and under-ask at 1280, so it is stated in pixels.
 */
const COVER_SIZES = '(max-width: 700px) 90vw, (max-width: 1279px) 44vw, 397px';
---

<a
  class="card"
  href={`/work/${project.slug}`}
  data-reveal="0"
  data-stagger
  data-categories={filterKey}
>
  <!-- Pairs with the cover on the case study. The browser lifts this element
       out of the page transition and morphs it into its counterpart, so the
       project reads as expanding out of its own card rather than the card
       being replaced by a new page. -->
  <div
    class="card__tile"
    data-morph
    data-slug={project.slug}
    style={tileStyle}
  >
    {
      project.cover ? (
        <img
          src={project.cover.url}
          srcset={coverSrcset || undefined}
          sizes={coverSrcset ? COVER_SIZES : undefined}
          width={project.cover.width}
          height={project.cover.height}
          alt={project.cover.alt}
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={index === 0 ? 'high' : undefined}
          decoding="async"
        />
      ) : (
        <span class="card__initials">{project.initials}</span>
      )
    }
  </div>

  <div class="card__body">
    <div class="card__meta">{project.num} — {project.category}</div>
    <h2 class="card__title">{project.title}</h2>
    <p class="card__summary">{project.summary}</p>
    <span class="card__cta">View project&nbsp;›</span>
  </div>
</a>

<style>
  /* The work page filters by setting the `hidden` attribute. Without this the
     browser's own [hidden]{display:none} loses to display:flex below and the
     cards never actually disappear. */
  .card[hidden] {
    display: none;
  }

  .card {
    display: flex;
    flex-direction: column;
    position: relative;
    background: var(--surface-card);
    border-radius: var(--r-xl);
    overflow: hidden;
    color: inherit;
    /* The hover fill below sits at z-index -1, which only stays inside the card
       if the card is a stacking context. `isolation` makes one without asking
       for a compositor layer, which is what the old translateZ(0) did. */
    isolation: isolate;
  }

  /* Compositor-only hover fill — a pseudo-element whose opacity animates
     rather than a background colour that would repaint. This is a
     separate opacity layer instead of a `background` transition. */
  .card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--surface-card-hover);
    opacity: 0;
    transition: opacity 280ms var(--ease-glide);
  }

  .card__tile {
    position: relative;
    aspect-ratio: 16 / 10;
    display: flex;
    align-items: flex-end;
    padding: clamp(18px, 2vw, 26px);
    overflow: hidden;
    /*
     * The tile states its own corner rather than borrowing the card's clip.
     * Visually identical — the card already clips it to exactly this shape —
     * but the morph into a case study reads the radius off this element, and
     * an inherited clip reads as zero. The cover then started square and
     * snapped round at the end of the move.
     */
    border-radius: var(--r-xl) var(--r-xl) 0 0;
  }

  .card__tile img {
    /*
     * Half a pixel of bleed on every side.
     *
     * The tile and the image inside it are rasterised separately, and at a
     * fractional device-pixel width the rounded clip antialiases against the
     * tile's own background — a pale hairline down one edge of a card, on
     * exactly the covers whose layout happens to land off the pixel grid.
     * Overlapping the frame puts the picture under the seam.
     *
     * `max-width` has to be overridden: the global `img { max-width: 100% }`
     * would otherwise clamp the extra pixel straight back off.
     */
    position: absolute;
    top: -0.5px;
    left: -0.5px;
    width: calc(100% + 1px);
    height: calc(100% + 1px);
    max-width: none;
    object-fit: cover;
    display: block;
  }

  .card__initials {
    font-size: clamp(2.125rem, 4.4vw, 3.625rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .card__body {
    padding: clamp(20px, 2.2vw, 28px);
    display: flex;
    flex-direction: column;
    gap: 7px;
    flex: 1;
  }

  /*
   * The primary category only, not the whole list.
   *
   * At this tracking a project filed under two services wraps to a second
   * line, and a wrapped label pushes that one card's title below its
   * neighbours' — the titles across a row stop lining up. The case study has a
   * column to itself and lists every category there; here the filter chips are
   * what surface the rest.
   */
  .card__meta {
    font-size: 0.8125rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .card__title {
    font-size: clamp(1.3125rem, 2.2vw, 1.75rem);
    line-height: 1.14;
    letter-spacing: -0.016em;
    font-weight: 600;
  }

  .card__summary {
    font-size: 1.0625rem;
    line-height: 1.47;
    letter-spacing: -0.022em;
    color: var(--ink-muted);
  }

  .card__cta {
    margin-top: auto;
    padding-top: 14px;
    font-size: 1.0625rem;
    letter-spacing: -0.022em;
    color: var(--blue);
  }

  /*
   * Everything below this line exists for the hover state, and every line of it
   * costs a compositor layer per card.
   *
   * Twelve cards on a phone meant twelve promoted cards, twelve promoted cover
   * images and twelve pre-rasterised hover fills — thirty-six layers for an
   * interaction a touch screen cannot perform. Past the browser's layer budget
   * it starts recycling them mid-scroll, which is the stutter that showed up
   * as cards flickering while dragging through the grid.
   */
  @media (hover: hover) and (pointer: fine) {
    .card {
      transform: translateZ(0);
      transition:
        transform 340ms var(--ease-glide),
        opacity 520ms var(--ease-smooth);
    }

    .card:hover {
      transform: translate3d(0, -6px, 0);
      color: inherit;
    }

    .card:hover::after {
      opacity: 1;
    }

    .card:hover .card__tile {
      transform: scale(1.03);
    }

    .card__tile {
      /* Its own layer, so the 1.03 scale on hover composites the
         already-decoded image instead of re-rasterising it every frame. */
      transform: translateZ(0);
      transition: transform 620ms var(--ease-glide);
    }

    .card::after {
      /* Promoted up front. A layer that sits at opacity 0 is not rasterised
         until something needs it, so the very first hover pays for creating and
         uploading it — that is the hesitation before the first fade, which then
         disappears once the layer is cached. Declaring the intent lets the
         browser prepare it during idle time instead. */
      will-change: opacity;
    }
  }

  /*
   * Rounder on a phone, because the card is smaller and the corner is not.
   *
   * A card is most of the viewport here, so it takes a corner of its own
   * rather than the token's. `--r-xl` now floors at 20px, and doubling that
   * would put the tile past 16% of its short side — well beyond the 11.6% the
   * desktop card measures, which is the point where a surface stops looking
   * rounded and starts looking like a sticker. 24px is the measured match:
   * 11.1% on the tile against the desktop's 11.6%, and 6.9% on the card
   * against 7.3%.
   *
   * Stated as a number on purpose. Written as a multiple of the token it moved
   * the moment the token's floor was raised for every other surface, which is
   * how it overshot in the first place.
   */
  @media (max-width: 767px) {
    .card {
      border-radius: 24px;
    }

    .card__tile {
      border-radius: 24px 24px 0 0;
    }
  }
</style>
