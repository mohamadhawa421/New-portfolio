---
/**
 * The card designer mode puts up. See DesignerEgg.astro for the rest of it.
 *
 * It lives here, inside the portrait, rather than with the wave — the picture
 * is what was clicked, and a card pinned to the bottom of the window reads as
 * an unrelated notification. The wave cannot live here too: it is fixed to the
 * viewport, and the flinch puts a transform on this section, which would make
 * the section its containing block and clip the wave to the hero.
 */

/** The joke, in one place. */
const TRAITS = [
  { label: 'Curiosity', value: 94 },
  { label: 'Pixel perfectionism', value: 97 },
  { label: 'Coffee dependency', value: 89 },
  { label: 'Deadline avoidance', value: 12 },
];

/**
 * How long designer mode holds before it lets go on its own.
 *
 * Long enough to read four short lines and watch them fill, short enough that
 * it still reads as something that happened rather than a mode you are now in.
 */
const HOLD_MS = 5200;
---

<aside class="card" data-egg-card data-hold={HOLD_MS} hidden>
  <p class="card__eyebrow">Designer personality unlocked</p>

  <dl class="card__traits">
    {
      TRAITS.map((trait, i) => (
        <div class="trait" style={`--i:${i}`}>
          <dt class="trait__label">{trait.label}</dt>
          <dd class="trait__value">
            <span data-trait-to={String(trait.value)}>{trait.value}</span>%
          </dd>
          <div class="trait__track">
            <div class="trait__fill" style={`--to:${trait.value}%`} />
          </div>
        </div>
      ))
    }
  </dl>
</aside>

<style>
  /* ------------------------------------------------------------------ */
  /* The card                                                            */
  /* ------------------------------------------------------------------ */

  /*
   * Hung off the portrait rather than off the window.
   *
   * The picture is what was clicked, and a card pinned to the bottom of the
   * screen reads as an unrelated notification — worse, on a phone the bottom of
   * the screen is usually where the portrait is, so the card covered the eyes
   * it had just brought to life.
   */
  .card {
    position: absolute;
    z-index: 9991;
    top: calc(100% + 14px);
    left: 0;
    right: 0;
    padding: 18px 20px 20px;
    border-radius: var(--r-xl);
    background: var(--surface-card);
    color: var(--ink);
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.06),
      0 18px 44px rgba(0, 0, 0, 0.16);
    /* The same hairline the rest of the site uses to separate a raised
       surface from the one behind it, which matters most in dark mode where
       the shadow alone does almost nothing. */
    outline: 1px solid var(--line);
    outline-offset: -1px;
    cursor: pointer;

    opacity: 0;
    translate: 0 14px;
    transition:
      opacity 380ms var(--ease-out),
      translate 460ms var(--ease-out);
  }

  .card[hidden] {
    display: none;
  }

  .card.is-on {
    opacity: 1;
    translate: 0 0;
  }

  /* Wide enough to sit under one corner of the picture rather than all of it. */
  @media (min-width: 768px) {
    .card {
      left: auto;
      width: 320px;
    }
  }

  .card__eyebrow {
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--blue);
    transition: color 620ms var(--ease-glide);
  }

  .card__traits {
    margin: 16px 0 0;
    display: flex;
    flex-direction: column;
    gap: 13px;
  }

  .trait {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 7px 12px;
  }

  .trait__label {
    font-size: 15px;
    letter-spacing: -0.016em;
    color: var(--ink-muted);
  }

  .trait__value {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.016em;
    color: var(--ink);
    /* So the figure does not jostle its own label while it counts. */
    font-variant-numeric: tabular-nums;
  }

  .trait__track {
    grid-column: 1 / -1;
    height: 3px;
    border-radius: var(--r-pill);
    background: var(--surface-chip);
    overflow: hidden;
  }

  .trait__fill {
    height: 100%;
    width: 0;
    border-radius: inherit;
    background: var(--blue);
    transition:
      width 760ms var(--ease-out),
      background-color 620ms var(--ease-glide);
    /* Each bar starts a beat after the one above it, so the card fills in
       reading order rather than all at once. */
    transition-delay: calc(var(--i) * 90ms);
  }

  .card.is-on .trait__fill {
    width: var(--to);
  }

</style>
