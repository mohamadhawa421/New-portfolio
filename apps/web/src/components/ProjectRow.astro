---
import type { Project } from '../lib/types';

interface Props {
  project: Project;
  /** Stagger index for the reveal-on-scroll animation. */
  index?: number;
}

const { project, index = 0 } = Astro.props;

/*
 * The placeholder colour is only painted when there is no cover.
 *
 * Behind one, it is never meant to be seen — and it was: a rounded, clipped
 * frame and the picture inside it are rasterised separately, so the corner
 * pixels blend the two and a pale placeholder under a dark cover surfaces as a
 * hairline along whichever edge happens to land off the pixel grid. It moved
 * from project to project with the layout, and re-rasterising the layer on
 * scroll made it come and go.
 *
 * With nothing to bleed through, there is nothing to see.
 */
const thumbStyle = project.cover
  ? `color:${project.chipInk}`
  : `background:${project.chipBg};color:${project.chipInk}`;
---

<a class="row" href={`/work/${project.slug}`} data-reveal={String(index)}>
  <div
    class="row__thumb"
    data-morph
    data-slug={project.slug}
    style={thumbStyle}
  >
    {
      project.cover ? (
        <img src={project.cover.url} alt={project.cover.alt} loading="lazy" decoding="async" />
      ) : (
        <span>{project.initials}</span>
      )
    }
  </div>

  <div class="row__text">
    <h3 class="row__title">{project.title}</h3>
    <p class="row__summary">{project.summary}</p>
  </div>

  <div class="row__aside">
    <span class="row__tag">{project.discipline}</span>
    <span class="row__chevron" aria-hidden="true">›</span>
  </div>
</a>

<style>
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(12px, 2.4vw, 30px);
    padding: clamp(20px, 2.8vh, 30px) clamp(10px, 1.4vw, 18px);
    margin: 0 calc(-1 * clamp(10px, 1.4vw, 18px));
    border-radius: var(--r-sm);
    color: inherit;
    position: relative;
    overflow: hidden;
    /* The hover fill below sits at z-index -1, which only stays inside the row
       if the row is a stacking context. `isolation` makes one without asking
       for a compositor layer, which is what the old translateZ(0) did. */
    isolation: isolate;
  }

  /* The divider is drawn as a line rather than a border: a border on a rounded
     box follows the corner radius and shows two curled ends. */
  .row::before {
    content: '';
    position: absolute;
    top: 0;
    left: clamp(10px, 1.4vw, 18px);
    right: clamp(10px, 1.4vw, 18px);
    height: 1px;
    background: var(--line);
    z-index: 1;
  }

  /*
   * The hover fill used to transition `background-color` directly, which is a
   * paint operation the browser redoes on every frame of the animation — on a
   * row with a large thumbnail image that paint is expensive enough to feel
   * laggy even though the slide itself was already compositor-only.
   *
   * A separate full-size layer that only ever animates `opacity` avoids that:
   * opacity is compositor-only, same as transform, so the whole hover — fill
   * and slide together — now costs the GPU nothing extra to run.
   */
  .row::after {
    content: '';
    position: absolute;
    inset: 0;
    /* .row is a stacking context (isolation: isolate), so z-index here is
       scoped to it: this sits behind the thumbnail and text rather than
       covering them. */
    z-index: -1;
    background: var(--surface-row-hover);
    opacity: 0;
    transition: opacity 280ms var(--ease-glide);
  }

  .row__thumb {
    flex: none;
    width: clamp(84px, 10vw, 120px);
    aspect-ratio: 16 / 10;
    border-radius: var(--r-2xs);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: clamp(15px, 1.5vw, 18px);
    font-weight: 600;
    letter-spacing: -0.01em;
    overflow: hidden;
  }

  .row__thumb img {
    /*
     * Half a pixel of bleed on every side.
     *
     * The tile and the image inside it are rasterised separately, and at a
     * fractional device-pixel width the rounded clip antialiases against the
     * tile's own background — a pale hairline down one edge of a card, on
     * exactly the covers whose layout happens to land off the pixel grid.
     * Overlapping the frame puts the picture under the seam.
     *
     * `max-width` has to be overridden: the global `img { max-width: 100% }`
     * would otherwise clamp the extra pixel straight back off.
     */
    width: calc(100% + 1px);
    height: calc(100% + 1px);
    margin: -0.5px;
    max-width: none;
    object-fit: cover;
    display: block;
  }

  .row__text {
    flex: 1 1 200px;
    min-width: 0;
  }

  .row__title {
    font-size: clamp(20px, 2.2vw, 28px);
    line-height: 1.14;
    letter-spacing: -0.017em;
    font-weight: 600;
    text-wrap: pretty;
  }

  .row__summary {
    margin-top: 6px;
    max-width: 52ch;
    font-size: 16px;
    line-height: 1.45;
    letter-spacing: -0.022em;
    color: var(--ink-muted);
    text-wrap: pretty;
  }

  .row__aside {
    flex: none;
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: clamp(12px, 2vw, 24px);
  }

  .row__tag {
    font-size: 14px;
    letter-spacing: -0.016em;
    color: var(--ink-softer);
    white-space: nowrap;
  }

  .row__chevron {
    font-size: 19px;
    color: var(--blue);
  }

  /* ------------------------------------------------------------------ */
  /* Phones: stack it                                                    */
  /*                                                                     */
  /* Side by side, a 84px thumbnail next to wrapped text reads as a       */
  /* cramped list item. Stacked, each project gets a full-width image and */
  /* its own block of text — much closer to how the cards read.           */
  /* ------------------------------------------------------------------ */
  @media (max-width: 767px) {
    .row {
      flex-direction: column;
      align-items: stretch;
      gap: 14px;
      padding: 18px clamp(10px, 1.4vw, 18px) 26px;
    }

    .row__thumb {
      width: 100%;
      aspect-ratio: 16 / 9;
      /* Full width now, so it follows the card scale rather than the row's. */
      border-radius: var(--r-xl);
    }

    .row__text {
      flex: 1 1 auto;
    }

    .row__aside {
      margin-left: 0;
      justify-content: space-between;
      width: 100%;
    }
  }

  /* ------------------------------------------------------------------ */
  /* Hover                                                               */
  /*                                                                     */
  /* All of it is behind a pointer query. A touch screen cannot hover, so */
  /* every layer these rules promote — the row, its downscaled thumbnail, */
  /* the pre-rasterised fill — is memory a phone spends on nothing, and   */
  /* enough of them together is what makes a long list stutter as it is   */
  /* dragged.                                                             */
  /* ------------------------------------------------------------------ */
  @media (hover: hover) and (pointer: fine) {
    .row {
      /* Promote to its own layer so the slide composites instead of
         repainting the thumbnail on every frame. */
      transform: translateZ(0);
      /* Short enough to read as a direct response to the pointer. Anything
         past roughly 200ms starts to feel like the row is catching up. */
      transition:
        transform 320ms var(--ease-glide),
        opacity 520ms var(--ease-smooth);
    }

    .row::after {
      /* Promoted up front. A layer that sits at opacity 0 is not rasterised
         until something needs it, so the very first hover pays for creating
         and uploading it — that is the hesitation before the first fade. */
      will-change: opacity;
    }

    .row:hover {
      transform: translate3d(8px, 0, 0);
      color: inherit;
    }

    .row:hover::after {
      opacity: 1;
    }

    .row__thumb img {
      /*
       * Its own compositor layer. The source is a 1440px cover displayed at
       * ~120px, and without this the downscale is re-rasterised inside the
       * row's layer on every frame of the hover slide.
       */
      transform: translateZ(0);
      backface-visibility: hidden;
    }
  }

  /* Stacked on a phone, a sideways slide only reads as drift. */
  @media (hover: hover) and (pointer: fine) and (max-width: 767px) {
    .row:hover {
      transform: translateZ(0);
    }
  }
</style>
