---
import type { Project } from '../lib/types';

interface Props {
  project: Project;
  /** Stagger index for the reveal-on-scroll animation. */
  index?: number;
}

const { project, index = 0 } = Astro.props;
---

<a class="row" href={`/work/${project.slug}`} data-reveal={String(index)}>
  <div class="row__thumb" style={`background:${project.chipBg};color:${project.chipInk}`}>
    {
      project.cover ? (
        <img src={project.cover.url} alt={project.cover.alt} loading="lazy" decoding="async" />
      ) : (
        <span>{project.initials}</span>
      )
    }
  </div>

  <div class="row__text">
    <h3 class="row__title">{project.title}</h3>
    <p class="row__summary">{project.summary}</p>
  </div>

  <div class="row__aside">
    <span class="row__tag">{project.discipline}</span>
    <span class="row__chevron" aria-hidden="true">›</span>
  </div>
</a>

<style>
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(12px, 2.4vw, 30px);
    padding: clamp(20px, 2.8vh, 30px) clamp(10px, 1.4vw, 18px);
    margin: 0 calc(-1 * clamp(10px, 1.4vw, 18px));
    border-top: 1px solid var(--line);
    border-radius: var(--r-sm);
    color: inherit;
    will-change: transform;
    transition:
      background 420ms var(--ease-out),
      transform 520ms var(--ease-out),
      opacity 520ms var(--ease-smooth);
  }

  .row:hover {
    background: var(--surface-row-hover);
    transform: translateX(10px);
    color: inherit;
  }

  .row__thumb {
    flex: none;
    width: clamp(84px, 10vw, 120px);
    aspect-ratio: 16 / 10;
    border-radius: var(--r-2xs);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: clamp(15px, 1.5vw, 18px);
    font-weight: 600;
    letter-spacing: -0.01em;
    overflow: hidden;
  }

  .row__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .row__text {
    flex: 1 1 200px;
    min-width: 0;
  }

  .row__title {
    font-size: clamp(20px, 2.2vw, 28px);
    line-height: 1.14;
    letter-spacing: -0.017em;
    font-weight: 600;
    text-wrap: pretty;
  }

  .row__summary {
    margin-top: 6px;
    max-width: 52ch;
    font-size: 16px;
    line-height: 1.45;
    letter-spacing: -0.022em;
    color: var(--ink-muted);
    text-wrap: pretty;
  }

  .row__aside {
    flex: none;
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: clamp(12px, 2vw, 24px);
  }

  .row__tag {
    font-size: 14px;
    letter-spacing: -0.016em;
    color: var(--ink-softer);
    white-space: nowrap;
  }

  .row__chevron {
    font-size: 19px;
    color: var(--blue);
  }
</style>
