---
import type { Project } from '../lib/types';

interface Props {
  project: Project;
  /** Stagger index for the reveal-on-scroll animation. */
  index?: number;
}

const { project, index = 0 } = Astro.props;
---

<a class="row" href={`/work/${project.slug}`} data-reveal={String(index)}>
  <div class="row__thumb" style={`background:${project.chipBg};color:${project.chipInk}`}>
    {
      project.cover ? (
        <img src={project.cover.url} alt={project.cover.alt} loading="lazy" decoding="async" />
      ) : (
        <span>{project.initials}</span>
      )
    }
  </div>

  <div class="row__text">
    <h3 class="row__title">{project.title}</h3>
    <p class="row__summary">{project.summary}</p>
  </div>

  <div class="row__aside">
    <span class="row__tag">{project.discipline}</span>
    <span class="row__chevron" aria-hidden="true">›</span>
  </div>
</a>

<style>
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(12px, 2.4vw, 30px);
    padding: clamp(20px, 2.8vh, 30px) clamp(10px, 1.4vw, 18px);
    margin: 0 calc(-1 * clamp(10px, 1.4vw, 18px));
    border-radius: var(--r-sm);
    color: inherit;
    position: relative;
    overflow: hidden;
    /* Promote to its own layer so the slide composites instead of repainting
       the thumbnail on every frame. */
    transform: translateZ(0);
    /* Short enough to read as a direct response to the pointer. Anything past
       roughly 200ms starts to feel like the row is catching up with you. */
    transition:
      transform 160ms var(--ease-out),
      opacity 520ms var(--ease-smooth);
  }

  /* The divider is drawn as a line rather than a border: a border on a rounded
     box follows the corner radius and shows two curled ends. */
  .row::before {
    content: '';
    position: absolute;
    top: 0;
    left: clamp(10px, 1.4vw, 18px);
    right: clamp(10px, 1.4vw, 18px);
    height: 1px;
    background: var(--line);
    z-index: 1;
  }

  /*
   * The hover fill used to transition `background-color` directly, which is a
   * paint operation the browser redoes on every frame of the animation — on a
   * row with a large thumbnail image that paint is expensive enough to feel
   * laggy even though the slide itself was already compositor-only.
   *
   * A separate full-size layer that only ever animates `opacity` avoids that:
   * opacity is compositor-only, same as transform, so the whole hover — fill
   * and slide together — now costs the GPU nothing extra to run.
   */
  .row::after {
    content: '';
    position: absolute;
    inset: 0;
    /* .row is already a stacking context (transform: translateZ(0) forces
       one), so z-index here is scoped to it: this sits behind the thumbnail
       and text rather than covering them. */
    z-index: -1;
    background: var(--surface-row-hover);
    opacity: 0;
    transition: opacity 140ms ease-out;
  }

  .row:hover {
    transform: translate3d(8px, 0, 0);
    color: inherit;
  }

  .row:hover::after {
    opacity: 1;
  }

  /* Touch screens have no hover; the slide would only ever fire on tap. */
  @media (hover: none) {
    .row:hover {
      transform: translateZ(0);
    }

    .row:hover::after {
      opacity: 0;
    }
  }

  .row__thumb {
    flex: none;
    width: clamp(84px, 10vw, 120px);
    aspect-ratio: 16 / 10;
    border-radius: var(--r-2xs);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: clamp(15px, 1.5vw, 18px);
    font-weight: 600;
    letter-spacing: -0.01em;
    overflow: hidden;
  }

  .row__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .row__text {
    flex: 1 1 200px;
    min-width: 0;
  }

  .row__title {
    font-size: clamp(20px, 2.2vw, 28px);
    line-height: 1.14;
    letter-spacing: -0.017em;
    font-weight: 600;
    text-wrap: pretty;
  }

  .row__summary {
    margin-top: 6px;
    max-width: 52ch;
    font-size: 16px;
    line-height: 1.45;
    letter-spacing: -0.022em;
    color: var(--ink-muted);
    text-wrap: pretty;
  }

  .row__aside {
    flex: none;
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: clamp(12px, 2vw, 24px);
  }

  .row__tag {
    font-size: 14px;
    letter-spacing: -0.016em;
    color: var(--ink-softer);
    white-space: nowrap;
  }

  .row__chevron {
    font-size: 19px;
    color: var(--blue);
  }
</style>
