---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAboutPage, getSiteSettings } from '../lib/content';

const [about, settings] = await Promise.all([getAboutPage(), getSiteSettings()]);
/*
 * The portrait's alt, composed rather than written.
 *
 * The CMS supplies "Mohamad Hawa" — the name and nothing else, which is
 * correct as a label and thin as a description. An image search has only the
 * alt text, the filename and the page around it to go on, and a cut-out on a
 * transparent background gives it nothing else to read. Joining the name to
 * the role the CMS already holds says who is in the picture and what he does,
 * in his own words, without a line of copy being hardcoded here.
 *
 * The purple-eyed duplicate stacked on top keeps `alt=""` on purpose. It is
 * the same photograph of the same person; describing it twice would have a
 * screen reader announce him twice and offer a search engine a duplicate.
 */
const portraitAlt = [settings.portrait?.alt || settings.siteName, settings.roleTitle]
  .filter(Boolean)
  .join(' — ');
---

<BaseLayout seo={about.seo}>
  <main id="main" data-shell="1">
    <section class="section section--light about-hero" data-lift data-tile="light">
      <div class="shell">
        <div class="eyebrow about-hero__eyebrow" data-reveal="0">{about.eyebrow}</div>
        <h1 class="about-hero__heading"><span data-rise="0">{about.heading}</span></h1>
      </div>
    </section>

    <section class="section section--parchment about-body" data-lift data-tile="parchment">
      <div class="shell about-body__inner">
        <div class="about-body__aside" data-reveal="0">
          <div class="about-body__portrait">
            {
              settings.portrait && (
                <img
                  src={settings.portrait.url}
                  alt={portraitAlt}
                  loading="eager"
                  decoding="async"
                  style={`object-position:${settings.portraitTallFocus}`}
                />
              )
            }
          </div>

          <div class="about-body__stats">
            {
              about.stats.map((stat) => (
                <div>
                  <div class="stat__value" data-num={stat.animate ? '1' : undefined}>
                    {stat.value}
                  </div>
                  <div class="stat__label">{stat.label}</div>
                </div>
              ))
            }
          </div>
        </div>

        <div class="about-body__copy" data-reveal="1">
          <p class="about-body__lead">{about.lead}</p>
          <p class="about-body__primary">{about.bodyPrimary}</p>
          <p class="about-body__secondary">{about.bodySecondary}</p>

          <div class="experience">
            {
              about.experience.map((entry) => (
                <div class="experience__row">
                  <div>
                    <div class="experience__role">{entry.role}</div>
                    <div class="experience__org">{entry.organisation}</div>
                  </div>
                  <div class="experience__period">{entry.period}</div>
                </div>
              ))
            }
          </div>

          <div class="skills">
            {about.skills.map((skill) => <span class="skill">{skill}</span>)}
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .about-hero {
    padding-top: clamp(100px, min(17vh, 26vw), 196px);
    padding-bottom: clamp(44px, 6.5vh, 80px);
  }

  .about-hero__eyebrow {
    margin-bottom: 18px;
  }

  .about-hero__heading {
    /* Clips the rising text until it slides into place. The padding stops
       descenders being shaved off by the same clip. */
    overflow: hidden;
    /*
     * Room for the descenders inside the clip, cancelled again by the margin so
     * the heading occupies exactly the space it did before. A tight
     * line-height puts the line box above the bottom of the glyphs, and the
     * same overflow that hides the rising text was shaving them.
     */
    padding-bottom: 0.16em;
    margin-bottom: -0.1em;
    max-width: 18ch;
    font-size: clamp(40px, 5.6vw, 80px);
    line-height: 1.04;
    letter-spacing: -0.019em;
    font-weight: 600;
  }

  .about-body {
    padding-block: clamp(46px, min(9vh, 12vw), 100px);
  }

  .about-body__inner {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(30px, 5vw, 80px);
  }

  .about-body__aside {
    flex: 1 1 320px;
    min-width: 240px;
    max-width: 400px;
  }

  .about-body__portrait {
    width: 100%;
    aspect-ratio: 4 / 5;
    border-radius: var(--r-portrait);
    overflow: hidden;
    background: var(--surface-placeholder);
  }

  .about-body__portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /*
   * On a phone the portrait leaves the column and takes the screen.
   *
   * It was 89% of the viewport — the shell's content width — which on a narrow
   * screen is a picture with a margin around it rather than a picture. The
   * page has one photograph and this is it, so it gets the full width: pulled
   * out of the shell's padding by exactly the padding, which is the only way
   * to break out without hardcoding a number that stops being true at the next
   * breakpoint.
   *
   * The corner survives the move. Edge to edge means the left and right of the
   * radius fall off the screen, and what is left is a curve at the top and the
   * bottom — which still reads as the same family as every other surface here
   * rather than as a band that happens to be an image.
   */
  @media (max-width: 767px) {
    .about-body__portrait {
      /*
       * The column's width, with the column's gutters.
       *
       * A full-bleed version of this was tried and taken out again. Edge to
       * edge, the picture has nothing holding it — it reads as a banner the
       * page happens to start with rather than as the portrait belonging to
       * the writing under it, and the gutter that every other block on the
       * page keeps is exactly what says those two things are related.
       *
       * What it keeps from that attempt is the shorter ratio. 4/5 in a 347px
       * column is 434px of photograph, most of a phone screen for one image;
       * the band below leaves the first line of prose on screen with it, which
       * is the point of putting them together.
       */
      aspect-ratio: 4 / 3.4;
    }

    /*
     * And the heading gets room to breathe between its lines.
     *
     * 1.04 is a display line-height, written for a heading that holds one or
     * two lines on a wide screen. The same words wrap to four on a phone, and
     * four lines at 1.04 is a solid block with the ascenders of one line
     * touching the descenders of the last.
     */
    .about-hero__heading {
      line-height: 1.12;
    }
  }

  .about-body__stats {
    display: flex;
    gap: 36px;
    margin-top: 24px;
  }

  .stat__value {
    font-size: clamp(30px, 3vw, 34px);
    font-weight: 600;
    letter-spacing: -0.024em;
    font-variant-numeric: tabular-nums;
  }

  .stat__label {
    font-size: 14px;
    color: var(--ink-muted);
    margin-top: 6px;
  }

  .about-body__copy {
    flex: 1 1 420px;
    min-width: 0;
  }

  .about-body__lead {
    font-size: clamp(20px, 2.1vw, 28px);
    font-weight: 300;
    line-height: 1.38;
    max-width: 34ch;
  }

  .about-body__primary {
    margin-top: 22px;
    font-size: 17px;
    line-height: 1.5;
    letter-spacing: -0.022em;
    max-width: 56ch;
  }

  .about-body__secondary {
    margin-top: 18px;
    font-size: 17px;
    line-height: 1.5;
    letter-spacing: -0.022em;
    color: var(--ink-muted);
    max-width: 56ch;
  }

  .experience {
    margin-top: clamp(36px, 6vh, 60px);
    display: flex;
    flex-direction: column;
  }

  .experience__row {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 20px 0;
    border-top: 1px solid var(--line-parchment);
  }

  .experience__row:last-child {
    border-bottom: 1px solid var(--line-parchment);
  }

  .experience__role {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.022em;
  }

  .experience__org {
    font-size: 14px;
    color: var(--ink-muted);
    margin-top: 6px;
  }

  .experience__period {
    font-size: 14px;
    color: var(--ink-muted);
    white-space: nowrap;
  }

  .skills {
    margin-top: clamp(30px, 5vh, 48px);
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .skill {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 14px;
    padding: 0 18px;
    border-radius: var(--r-pill);
    background: var(--surface);
    color: var(--ink);
  }
</style>
