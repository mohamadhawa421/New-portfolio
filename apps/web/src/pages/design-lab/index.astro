---
/**
 * The Design Lab.
 *
 * A room off the portfolio rather than a second Work page. The difference is
 * stated three ways and none of them is decoration:
 *
 *   The banner is the only dark panel on the site that is dark in all three
 *   themes. Work and About follow the palette; this one holds its own ground,
 *   so arriving here is arriving somewhere.
 *
 *   The index is a ledger with a diptych, not a list with a photograph — the
 *   before and the after are the point, and they are legible from the index.
 *
 *   The language is first person and speculative throughout. Nothing here is
 *   attributed to a client, and nothing claims a result. See the note above
 *   "What I'd test" in the project page.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import LabIndex from '../../components/LabIndex.astro';
import {
  POSES,
  featuredExperiment,
  getExperiments,
  labFilters,
  labShape,
} from '../../lib/lab';

const experiments = getExperiments();
const shape = labShape();
const featured = featuredExperiment();
const filters = labFilters();
const lab = POSES.lab;

/*
 * One experiment, and the page says so rather than hiding the fact.
 *
 * The alternative — a ledger with a single row, or a "Featured experiment"
 * label with an empty index under it — reads as a section waiting for content,
 * which is worse than a section that is simply small. So at one entry the
 * index is not rendered at all, the lead loses its label and gains the
 * experiment's own summary, and a line underneath states plainly that it is
 * the first. Nothing is switched off; the page is a different shape.
 */
const solo = shape === 'solo';

const seo = {
  metaTitle: 'Design Lab — Mohamad Hawa',
  metaDescription:
    'Redesigns, feature concepts and interaction experiments. Personal explorations outside client work, with the reasoning left in.',
};
---

<BaseLayout seo={seo}>
  <main id="main" data-shell="1">
    {/* ---------------------------------------------------------------- */}
    {/* The banner                                                        */}
    {/* ---------------------------------------------------------------- */}
    <section class="section section--light lab-hero" data-lift data-tile="light">
      <div class="shell">
        {/*
          The panel, and the one place this section departs from the palette.

          Dark in all three themes on purpose — it is the door into the room,
          and a door that changes colour with the rest of the house is not a
          door. The material is a single low-angle gradient over the site's own
          dark surface plus one inset hairline of light along the top edge:
          enough to read as a lit surface rather than a filled rectangle, and
          deliberately short of the blur-and-border recipe, which would put a
          piece of somebody else's design system in the middle of this one.
        */}
        <div class="lab-panel">
          <div class="lab-panel__copy">
            <div class="eyebrow lab-panel__eyebrow" data-reveal="0">Design Lab</div>

            {/*
              The `{' '}` is load-bearing.

              These two are `display: block` on a wide screen, where the line
              break between them is the layout — but below 767px they go inline
              so the headline can wrap as a sentence, and at that width they
              need a word space between them. Astro strips the whitespace
              between adjacent elements, so the source newline is not one: it
              rendered "redesignsand product" on every phone.
            */}
            <h1 class="lab-panel__title">
              <span data-rise="0">Experiments, redesigns</span>{' '}
              <span data-rise="1">and product explorations.</span>
            </h1>

            <p class="lab-panel__lead" data-reveal="2">
              A space for ideas I wanted to explore beyond client work — the ones that
              start as an irritation with something I use every day.
            </p>

            <p class="lab-panel__note" data-reveal="3">
              None of this was commissioned. Nothing here shipped. What is here instead
              is the thinking: what I noticed, what I changed, and what I would want to
              find out before believing any of it.
            </p>
          </div>

          {/*
            The one character moment on this page.

            He belongs in the banner and nowhere else here — the section below
            is a list of work, and a narrator standing beside a list is a
            mascot. Inside the panel he is the room's occupant, which is the
            only reading that earns him the space.
          */}
          <div class="lab-panel__figure" data-reveal="1">
            <img
              src={lab.src}
              alt={lab.alt}
              width={lab.width}
              height={lab.height}
              fetchpriority="high"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </section>

    {/* ---------------------------------------------------------------- */}
    {/* The lead experiment, if the collection is big enough to have one   */}
    {/* ---------------------------------------------------------------- */}
    {
      featured && (
        <section
          class="section lab-lead"
          class:list={[solo ? 'section--light' : 'section--parchment', { 'lab-lead--solo': solo }]}
          data-lift
          data-tile={solo ? 'light' : 'parchment'}
        >
          <div class="shell">
            <div class="eyebrow eyebrow--small" data-reveal="0">
              {solo ? 'The experiment' : 'Featured experiment'}
            </div>

            <a class="lab-lead__hit" href={`/design-lab/${featured.slug}`}>
              <div class="lab-lead__copy">
                <h2 class="h2 lab-lead__title" data-reveal="1">
                  {featured.title}
                </h2>
                <p class="lead lab-lead__statement" data-reveal="2">
                  {featured.statement}
                </p>

                {/* The summary only when this is the whole page. Above a list
                    it would be a third length of copy competing with the rows
                    directly under it. */}
                {solo && (
                  <p class="body lab-lead__summary" data-reveal="3">
                    {featured.summary}
                  </p>
                )}

                <span class="text-link lab-lead__go" data-reveal="3">
                  Explore
                  <span class="lab-lead__arrow" aria-hidden="true">
                    &nbsp;→
                  </span>
                </span>
              </div>

              {featured.cover ? (
                <span
                  class="lab-lead__plate"
                  style={`--plate-ratio:${featured.cover.width / featured.cover.height}`}
                  data-reveal="2"
                >
                  <img
                    src={featured.cover.src}
                    alt={featured.cover.alt}
                    width={featured.cover.width}
                    height={featured.cover.height}
                    loading="lazy"
                    decoding="async"
                  />
                </span>
              ) : featured.before && featured.after ? (
                <span
                  class="lab-lead__plate lab-lead__plate--pair"
                  style={`--plate-ratio:${featured.after.width / featured.after.height}`}
                  data-reveal="2"
                >
                  <img
                    src={featured.before.src}
                    alt={featured.before.alt}
                    width={featured.before.width}
                    height={featured.before.height}
                    loading="lazy"
                    decoding="async"
                  />
                  <img
                    src={featured.after.src}
                    alt={featured.after.alt}
                    width={featured.after.width}
                    height={featured.after.height}
                    loading="lazy"
                    decoding="async"
                  />
                </span>
              ) : null}
            </a>
          </div>
        </section>
      )
    }

    {/* ---------------------------------------------------------------- */}
    {/* The index, once there is more than one thing to index             */}
    {/* ---------------------------------------------------------------- */}
    {
      !solo && (
        <section class="section section--light lab-list" data-lift data-tile="light">
          <div class="shell">
            <div class="lab-list__head" data-reveal="0">
              <div class="eyebrow eyebrow--small">
                {experiments.length}{' '}
                {experiments.length === 1 ? 'experiment' : 'experiments'}
              </div>
              <h2 class="h2 lab-list__heading">The index</h2>
            </div>

            {experiments.length === 0 ? (
              <p class="lab-list__empty">
                Nothing in here yet. The first experiment is being written up.
              </p>
            ) : (
              <LabIndex
                experiments={experiments}
                filters={filters}
                featuredSlug={featured?.slug}
              />
            )}
          </div>
        </section>
      )
    }

    {/*
      What the index would otherwise have said.

      One line, in the page's own voice, doing the job the missing section
      would have done: it tells the visitor the count is deliberate and that
      there will be more. Without it a single entry reads as a section that
      failed to load.
    */}
    {
      solo && (
        <section class="section section--parchment lab-more" data-lift data-tile="parchment">
          <div class="shell lab-more__inner" data-reveal="0">
            <p class="lab-more__line">
              That is the first one. The Lab is new — experiments land here as I finish
              them, and each gets the same treatment: what I noticed, what I changed, and
              what I would want to find out before believing it.
            </p>
          </div>
        </section>
      )
    }

    {/* ---------------------------------------------------------------- */}
    {/* Out                                                               */}
    {/* ---------------------------------------------------------------- */}
    <section class="section section--parchment lab-out" data-lift data-tile="parchment">
      <div class="shell lab-out__inner" data-reveal="0">
        <p class="lab-out__line">
          Client work, where the constraints came from somebody else.
        </p>
        <a class="text-link" href="/work">Selected work&nbsp;→</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  /* ---- Banner -------------------------------------------------------- */

  .lab-hero {
    padding-top: clamp(100px, min(17vh, 26vw), 196px);
    padding-bottom: clamp(42px, min(8vh, 11vw), 104px);
  }

  .lab-panel {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: clamp(20px, 4vw, 56px);
    padding: clamp(28px, 4.4vw, 64px);
    border-radius: var(--r-2xl);
    overflow: hidden;
    color: var(--ink-on-dark);

    /*
     * Dark in every theme, and lit from one corner.
     *
     * `--surface-dark` is the site's own third step, so this is the same
     * near-black the manifesto and the contact block already use — the panel
     * is not a new colour, it is an existing one used at a different scale.
     * The gradient over it is a single low-angle sweep, about four per cent
     * of lift at the top left and nothing at the bottom right, which is the
     * amount that reads as a surface catching light rather than as a
     * gradient.
     */
    background:
      linear-gradient(
        128deg,
        rgba(255, 255, 255, 0.07) 0%,
        rgba(255, 255, 255, 0.02) 38%,
        rgba(255, 255, 255, 0) 72%
      ),
      var(--surface-dark);

    /*
     * One hairline of light along the top edge, inside the shape. An outline
     * would draw the panel; this lights it. It is `inset` so it follows the
     * squircle corner rather than boxing it.
     */
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.1),
      0 24px 60px -32px rgba(0, 0, 0, 0.6);
  }

  .lab-panel__eyebrow {
    color: var(--ink-on-dark-muted);
  }

  .lab-panel__title {
    margin-top: clamp(14px, 1.6vh, 22px);
    font-size: clamp(38px, 5.6vw, 76px);
    line-height: 1.04;
    letter-spacing: -0.028em;
    font-weight: 600;
  }

  .lab-panel__title span {
    display: block;
  }

  .lab-panel__lead {
    margin-top: clamp(18px, 2.4vh, 30px);
    max-width: 44ch;
    font-size: clamp(18px, 1.7vw, 22px);
    font-weight: 300;
    line-height: 1.45;
    color: var(--ink-on-dark-muted);
  }

  .lab-panel__note {
    margin-top: 16px;
    max-width: 52ch;
    font-size: 15px;
    line-height: 1.55;
    letter-spacing: -0.01em;
    /*
     * Quieter than the lead, and still text rather than decoration: this is
     * the disclaimer that keeps the whole section honest, so it reads at the
     * bottom of the hierarchy but it reads.
     */
    color: rgba(255, 255, 255, 0.58);
  }

  .lab-panel__figure {
    width: clamp(150px, 20vw, 268px);
    /* He stands on the floor of the panel rather than floating in it — the
       bottom of the artwork meets the bottom of the padding box. */
    align-self: end;
    margin-bottom: calc(clamp(28px, 4.4vw, 64px) * -1);
  }

  .lab-panel__figure img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ---- Featured ------------------------------------------------------ */

  .lab-lead {
    padding-block: clamp(58px, min(12vh, 16vw), 140px);
  }

  .lab-lead__hit {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    align-items: center;
    gap: clamp(24px, 4vw, 64px);
    margin-top: clamp(18px, 2.4vh, 28px);
    color: inherit;
    text-decoration: none;
  }

  .lab-lead__statement {
    margin-top: 14px;
    max-width: 38ch;
  }

  .lab-lead__summary {
    margin-top: 16px;
    max-width: 46ch;
  }

  /*
   * The solo lead carries the page, so it gets the room the index would have
   * had — and the picture leads, because with nothing under it the section has
   * to do the work of showing what the Lab is as well as saying it.
   */
  .lab-lead--solo {
    padding-block: clamp(64px, min(13vh, 17vw), 150px);
  }

  /*
   * The solo lead stacks, at every width.
   *
   * Two reasons, and the second was a bug. A diptych of two 1440x1024 screens
   * is a 2.8:1 band — beside a column of text it is short and wide and reads
   * as a strip rather than as the work. Full width under the copy it is the
   * thing the section is about, which is what a page with one experiment on it
   * needs.
   *
   * And this rule is (0,2,0): as `grid-template-columns: 1fr` inside a
   * `max-width: 900px` block it would have outranked the collapse rule, which
   * carries no extra weight for being in a media query. That is exactly what
   * happened with the two-column version — the phone kept a 139px-wide
   * picture next to a 616px column of text.
   */
  .lab-lead--solo .lab-lead__hit {
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(26px, 3.6vh, 46px);
  }

  .lab-lead--solo .lab-lead__plate {
    order: 0;
  }

  /* ---- The line where the index would be --------------------------- */

  .lab-more {
    padding-block: clamp(44px, min(9vh, 12vw), 96px);
  }

  .lab-more__line {
    max-width: 62ch;
    font-size: clamp(18px, 1.7vw, 21px);
    font-weight: 300;
    line-height: 1.45;
    color: var(--ink-muted);
    text-wrap: pretty;
  }

  .lab-lead__go {
    margin-top: 10px;
  }

  .lab-lead__arrow,
  .lab-lead__plate img {
    transition: transform 420ms var(--ease-glide);
  }

  .lab-lead__hit:hover .lab-lead__arrow {
    transform: translate3d(4px, 0, 0);
  }

  .lab-lead__hit:hover .lab-lead__plate img {
    transform: scale(1.02);
  }

  /* Shape from the artwork — see the note on `.plate` in LabIndex. A pair is
     twice the width of one, so neither half is cropped to fit. */
  .lab-lead__plate {
    display: block;
    aspect-ratio: var(--plate-ratio, 1.6);
    border-radius: var(--r-2xl);
    overflow: hidden;
    background: var(--surface-placeholder);
  }

  .lab-lead__plate img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .lab-lead__plate--pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    aspect-ratio: calc(var(--plate-ratio, 1.6) * 2);
    background: var(--line-parchment);
  }

  /*
   * On a phone the pair stacks, because side by side it is not a comparison.
   *
   * Two 1440x684 screens in one row make a 4.2:1 band. At 1240px that is a
   * 620x295 half — readable. At 347px it is 173x82, which is not a screenshot,
   * it is a smear: the same failure as any other picture forced to share a
   * phone's width with something else.
   *
   * Stacked, each half gets the full column — 347x165 — and the plate's ratio
   * is the artwork's halved rather than doubled. Before above after, which is
   * the order they are read in.
   */
  @media (max-width: 767px) {
    .lab-lead__plate--pair {
      grid-template-columns: minmax(0, 1fr);
      grid-auto-rows: 1fr;
      aspect-ratio: calc(var(--plate-ratio, 1.6) / 2);
    }
  }

  .lab-lead__plate--pair img {
    object-fit: contain;
  }

  /* ---- Index --------------------------------------------------------- */

  .lab-list {
    padding-block: clamp(58px, min(12vh, 16vw), 140px);
  }

  .lab-list__heading {
    margin-top: 10px;
  }

  .lab-list__empty {
    margin-top: clamp(30px, 5vh, 56px);
    font-size: 17px;
    color: var(--ink-muted);
  }

  /* ---- Out ----------------------------------------------------------- */

  .lab-out {
    padding-block: clamp(46px, min(9vh, 12vw), 100px);
  }

  .lab-out__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
  }

  .lab-out__line {
    font-size: 17px;
    color: var(--ink-muted);
    max-width: 44ch;
  }

  /* ---- Narrow -------------------------------------------------------- */

  @media (max-width: 900px) {
    .lab-lead__hit {
      grid-template-columns: 1fr;
    }

    /* The picture leads on a phone: it is the thing that says what this is,
       and the heading is right above it either way. */
    .lab-lead__plate {
      order: -1;
    }
  }

  @media (max-width: 767px) {
    /*
     * He moves under the words rather than beside them.
     *
     * Two columns at this width gives the title about eighteen characters a
     * line, which turns a two-line headline into five. Stacked, the headline
     * keeps its measure and he keeps his size — and he sits at the right-hand
     * edge, so the panel still reads as a room with somebody in it rather than
     * a card with a picture under it.
     */
    .lab-panel {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 4px;
    }

    .lab-panel__figure {
      width: clamp(132px, 38vw, 186px);
      justify-self: end;
      margin-bottom: calc(clamp(28px, 4.4vw, 64px) * -1);
      margin-right: calc(clamp(28px, 4.4vw, 64px) * -0.3);
    }

    .lab-panel__title {
      font-size: clamp(34px, 9vw, 46px);
      line-height: 1.08;
    }

    /* Two clauses on one line at this width would break anywhere; let them
       run as a sentence instead. */
    .lab-panel__title span {
      display: inline;
    }

    .lab-panel__lead {
      font-size: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lab-lead__arrow,
    .lab-lead__plate img {
      transition: none;
    }
  }
</style>
