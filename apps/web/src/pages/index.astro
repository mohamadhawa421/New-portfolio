---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedProject from '../components/FeaturedProject.astro';
import ProjectRow from '../components/ProjectRow.astro';
import CharacterAside from '../components/CharacterAside.astro';
import ContactBlock from '../components/ContactBlock.astro';
import DesignerEgg from '../components/DesignerEgg.astro';
import {
  getContactPage,
  getHomePage,
  getHomeProjectSplit,
  getProcessSteps,
  getProjects,
  getServices,
  getSiteSettings,
  pad,
} from '../lib/content';

const [home, settings, services, steps, projects, contact, split] = await Promise.all([
  getHomePage(),
  getSiteSettings(),
  getServices(),
  getProcessSteps(),
  getProjects(),
  getContactPage(),
  getHomeProjectSplit(),
]);

const leadWords = home.manifestoLead.split(/\s+/).filter(Boolean);
const tailWords = home.manifestoTail.split(/\s+/).filter(Boolean);
---

<BaseLayout seo={home.seo}>
  <main id="main" data-shell="1">
    {/* ---------------------------------------------------------------- */}
    {/* Hero                                                              */}
    {/* ---------------------------------------------------------------- */}
    <section class="section section--light hero" data-lift data-tile="light">
      <div class="shell hero__inner">
        <div class="hero__copy">
          <h1 class="hero__title"><span data-rise="0">{home.heroTitle}</span></h1>
          <div class="hero__subtitle"><span data-rise="1">{home.heroSubtitle}</span></div>
          <p class="hero__intro" data-reveal="3">{home.heroIntro}</p>
          <div class="hero__actions" data-reveal="4">
            <a class="btn btn--primary" href="/work">{home.primaryCtaLabel}</a>
            <a class="btn btn--secondary" href="/contact">{home.secondaryCtaLabel}</a>
          </div>
        </div>

        <div class="hero__portrait" data-reveal="1">
          {/* No label, no hover state, no cursor change. The portrait is a
              picture; that it also does something is the whole point. */}
          <div class="hero__portrait-frame" data-egg-trigger>
            {
              settings.portrait && (
                <img
                  src={settings.portrait.url}
                  alt={settings.portrait.alt}
                  width={settings.portrait.width}
                  height={settings.portrait.height}
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                  style={`object-position:${settings.portraitFocus}`}
                />
              )
            }
            {/* The same drawing with purple eyes, cross-faded in while designer
                mode runs. A second <img> rather than a swapped src: swapping
                the source would blank the portrait for however long the new
                file took to decode, and the whole effect is meant to land in
                one beat. */}
            <img
              class="hero__portrait-alt"
              src="/avatar-designer.webp"
              alt=""
              width="1024"
              height="1024"
              loading="lazy"
              decoding="async"
              aria-hidden="true"
            />
          </div>
        </div>
      </div>
    </section>

    {/* ---------------------------------------------------------------- */}
    {/* Selected work                                                     */}
    {/* ---------------------------------------------------------------- */}
    <section class="section section--light work" data-lift data-tile="light">
      <div class="shell">
        <div class="work__header" data-reveal="0">
          <div>
            <div class="eyebrow">{home.workEyebrow}</div>
            <h2 class="h2 work__heading">{projects.length} {home.workHeadingSuffix}</h2>
          </div>
          <a class="text-link" href="/work">{home.workLinkLabel}&nbsp;›</a>
        </div>

        <div class="work__list">
          {split.lead && <FeaturedProject project={split.lead} />}
          {split.rest.map((project, i) => <ProjectRow project={project} index={i} />)}
          <div class="work__rule"></div>
        </div>
      </div>
    </section>

    {/* ---------------------------------------------------------------- */}
    {/* Services                                                          */}
    {/* ---------------------------------------------------------------- */}
    <section class="section section--parchment services" data-lift data-tile="parchment">
      <div class="shell">
        <div class="eyebrow" data-reveal="0">{home.servicesEyebrow}</div>
        <h2 class="h2 services__heading" data-reveal="1">{home.servicesHeading}</h2>
        <p class="services__intro" data-reveal="2">{home.servicesIntro}</p>

        <div class="services__list">
          {
            services.map((service, i) => (
              <a
                class="service"
                href={`/contact?service=${encodeURIComponent(service.title)}`}
                data-reveal={String(i)}
              >
                <div class="service__num">{pad(i + 1)}</div>
                <div class="service__title">{service.title}</div>
                <div class="service__desc">{service.description}</div>
                <div class="service__cta">
                  <span>{service.ctaLabel}</span>
                  <span class="service__chevron" aria-hidden="true">
                    ›
                  </span>
                </div>
              </a>
            ))
          }
          <div class="services__rule"></div>
        </div>
      </div>
    </section>

    {/* ---------------------------------------------------------------- */}
    {/* Manifesto                                                         */}
    {/* ---------------------------------------------------------------- */}
    <section class="section section--dark manifesto" data-lift data-tile="dark">
      <div class="shell">
        <h2 class="manifesto__heading">
          {
            leadWords.map((word, i) => (
              <>
                <span data-reveal={String(i)}>{word}</span>{' '}
              </>
            ))
          }
          {
            tailWords.map((word, i) => (
              <>
                <span class="manifesto__tail" data-reveal={String(leadWords.length + i)}>
                  {word}
                </span>{' '}
              </>
            ))
          }
        </h2>
        <p class="manifesto__body">{home.manifestoBody}</p>
      </div>
    </section>

    {/* ---------------------------------------------------------------- */}
    {/* How I work                                                        */}
    {/* ---------------------------------------------------------------- */}
    <section class="section section--light process" data-lift data-tile="light">
      <div class="shell process__inner">
        <div class="process__label" data-reveal="0">
          <div class="eyebrow">{home.processEyebrow}</div>
        </div>

        <div class="process__list" data-reveal="1">
          {
            steps.map((step) => (
              <div class="process__step">
                <div class="process__title">{step.title}</div>
                <div class="process__desc">{step.description}</div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* ---------------------------------------------------------------- */}
    {/* About preview                                                     */}
    {/* ---------------------------------------------------------------- */}
    <section class="section section--parchment about" data-lift data-tile="parchment">
      <div class="shell about__inner">
        <div class="about__portrait" data-reveal="0">
          <div class="about__portrait-frame">
            {
              settings.portrait && (
                <img
                  src={settings.portrait.url}
                  alt={settings.portrait.alt}
                  loading="lazy"
                  decoding="async"
                  style={`object-position:${settings.portraitTallFocus}`}
                />
              )
            }
          </div>
        </div>

        <div class="about__copy" data-reveal="1">
          <div class="eyebrow about__eyebrow">{home.aboutEyebrow}</div>
          <h2 class="about__heading">{home.aboutHeading}</h2>
          <p class="about__body">{home.aboutBody}</p>

          <div class="about__stats">
            {
              home.stats.map((stat) => (
                <div>
                  <div class="about__stat-value" data-num={stat.animate ? '1' : undefined}>
                    {stat.value}
                  </div>
                  <div class="about__stat-label">{stat.label}</div>
                </div>
              ))
            }
          </div>

          <a class="text-link about__link" href="/about">{home.aboutLinkLabel}&nbsp;›</a>
        </div>
      </div>
    </section>

    {/* ---------------------------------------------------------------- */}
    {/* Contact                                                           */}
    {/* ---------------------------------------------------------------- */}
    <section class="section section--dark contact" data-lift data-tile="dark">
      <ContactBlock
        settings={settings}
        contact={contact}
        services={services}
        variant="home"
        heading={home.contactHeading}
        body={home.contactBody}
        formId="home"
      />

      {/*
        Inside the contact section rather than after it, so he stands on the
        same dark ground and inside the same shell as the form above him — at
        the end of the page without a section of his own.
      */}
      <CharacterAside
        src="/character-thinking.webp"
        alt="Mohamad, thinking"
        message="You've read everything. You haven't clicked everything."
        tone="dark"
      />
    </section>

    {/* Outside every [data-lift] section on purpose: the wave is fixed to the
        viewport, and a transformed ancestor would become its containing block
        and clip it to that section. */}
    <DesignerEgg />
  </main>
</BaseLayout>

<style>
  /* ---- Hero ---------------------------------------------------------- */
  .hero {
    padding-top: clamp(100px, min(17vh, 26vw), 196px);
    padding-bottom: clamp(42px, min(8vh, 11vw), 104px);
  }

  .hero__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(30px, 4.4vw, 72px);
  }

  .hero__copy {
    flex: 1 1 340px;
    min-width: 0;
  }

  .hero__title {
    font-size: clamp(40px, 6.6vw, 92px);
    line-height: 1.02;
    letter-spacing: -0.021em;
    font-weight: 600;
    overflow: hidden;
    /*
     * Room for the descenders inside the clip, cancelled again by the margin so
     * the heading occupies exactly the space it did before. A tight
     * line-height puts the line box above the bottom of the glyphs, and the
     * same overflow that hides the rising text was shaving them.
     */
    padding-bottom: 0.16em;
    margin-bottom: -0.12em;
  }

  .hero__subtitle {
    margin-top: clamp(10px, 1.6vh, 16px);
    max-width: 18ch;
    font-size: clamp(22px, 3.1vw, 40px);
    font-weight: 300;
    line-height: 1.14;
    letter-spacing: -0.004em;
    overflow: hidden;
    /*
     * Room for the descenders inside the clip, cancelled again by the margin so
     * the heading occupies exactly the space it did before. A tight
     * line-height puts the line box above the bottom of the glyphs, and the
     * same overflow that hides the rising text was shaving them.
     */
    padding-bottom: 0.16em;
    margin-bottom: -0.1em;
  }

  .hero__intro {
    margin-top: clamp(20px, 3.4vh, 30px);
    max-width: 46ch;
    font-size: 17px;
    line-height: 1.52;
    letter-spacing: -0.022em;
    color: var(--ink-muted);
    text-wrap: pretty;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    /* Also the room the magnetic lean moves into: at 10px the buttons had
       almost none, so the pull was capped to nearly nothing. */
    gap: 16px;
    margin-top: clamp(26px, 4vh, 38px);
  }

  .hero__portrait {
    /* The egg's card hangs off this on a wide screen. */
    position: relative;
    flex: 1 1 300px;
    min-width: 230px;
    max-width: 420px;
    margin-inline: auto;
  }

  .hero__portrait-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: var(--r-portrait);
    overflow: hidden;
    background: var(--surface-parchment);
  }

  .hero__portrait-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Stacked exactly over the portrait, and invisible until the egg runs. */
  .hero__portrait-alt {
    position: absolute;
    inset: 0;
    opacity: 0;
    /*
     * On fast, off slow. The purple-eyed version arrives with the shock, and
     * takes nearly two seconds to give way again — so the character powering
     * down happens across the same stretch as the rest of the page settling,
     * rather than being a swap at the end of it.
     */
    transition: opacity 1900ms var(--ease-glide);
  }

  :global(:root[data-designer]) .hero__portrait-alt {
    transition-duration: 420ms;
  }

  :global(:root[data-designer]) .hero__portrait-alt {
    opacity: 1;
  }

  /*
   * The source.
   *
   * It is the one thing on the page that does not move while the sequence
   * runs — everything else is being thrown about by it, and a controller that
   * is also being thrown is just another victim. It charges instead.
   */
  :global(.hero__portrait-frame.dm-source) {
    animation: portrait-charge 1900ms var(--ease-glide) infinite alternate;
  }

  /*
   * The source shutting down. Losing the animation on its own would drop the
   * glow in a single frame; this lets it go out over the same long beat the
   * eyes take to fade.
   */
  .hero__portrait-frame {
    transition: box-shadow 1700ms var(--ease-out);
  }

  @keyframes portrait-charge {
    from {
      box-shadow: 0 0 30px -8px color-mix(in srgb, var(--dm-field) 80%, transparent);
    }
    to {
      box-shadow: 0 0 74px -4px color-mix(in srgb, var(--dm-core) 85%, transparent);
    }
  }

  /*
   * The picture takes the hit.
   *
   * A press that only changes colour somewhere else does not feel like it
   * landed on the thing that was pressed. The spring curve is the one the
   * buttons already use, so the recoil belongs to the same site.
   */
  :global(.hero__portrait-frame.is-hit) {
    animation: portrait-hit 520ms var(--spring) both;
  }

  @keyframes portrait-hit {
    0% {
      transform: scale(1);
    }
    22% {
      transform: scale(0.945);
    }
    100% {
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.hero__portrait-frame.is-hit),
    :global(.hero__portrait-frame.dm-source) {
      animation: none;
    }

    .hero__portrait-alt {
      transition: none;
    }
  }

  /* ---- Selected work ------------------------------------------------- */
  .work {
    padding-bottom: clamp(54px, min(11vh, 15vw), 124px);
  }

  .work__header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    padding-bottom: clamp(24px, 3.6vh, 34px);
  }

  .work__heading {
    margin-top: 12px;
  }

  .work__list {
    display: flex;
    flex-direction: column;
  }

  .work__rule {
    border-top: 1px solid var(--line);
  }

  /* ---- Services ------------------------------------------------------ */
  .services {
    padding-block: clamp(58px, min(12vh, 16vw), 140px);
  }

  .services__heading {
    margin: 12px 0 clamp(30px, 4.4vh, 46px);
    max-width: 20ch;
  }

  .services__intro {
    margin: -14px 0 clamp(26px, 4vh, 40px);
    max-width: 46ch;
    font-size: 17px;
    line-height: 1.5;
    letter-spacing: -0.022em;
    color: var(--ink-muted);
  }

  .services__list {
    display: flex;
    flex-direction: column;
  }

  .service {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: clamp(10px, 2.6vw, 40px);
    padding: clamp(20px, 2.8vh, 28px) clamp(10px, 1.4vw, 18px);
    margin: 0 calc(-1 * clamp(10px, 1.4vw, 18px));
    border-radius: var(--r-sm);
    color: inherit;
    position: relative;
    overflow: hidden;
    /* The hover fill below sits at z-index -1, which only stays inside the row
       if the row is a stacking context. `isolation` makes one without asking
       for a compositor layer — see ProjectRow.astro. */
    isolation: isolate;
  }

  /* Line, not border — see ProjectRow for why. */
  .service::before {
    content: '';
    position: absolute;
    top: 0;
    left: clamp(10px, 1.4vw, 18px);
    right: clamp(10px, 1.4vw, 18px);
    height: 1px;
    background: var(--line-parchment);
    z-index: 1;
  }

  /* Compositor-only hover fill — see ProjectRow.astro for why this is a
     separate opacity layer instead of a `background` transition. */
  .service::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--surface-row-hover-parchment);
    opacity: 0;
    transition: opacity 280ms var(--ease-glide);
  }

  /* Behind a pointer query for the same reason as ProjectRow's: a touch screen
     cannot hover, so the layers these rules promote are spent on nothing. */
  @media (hover: hover) and (pointer: fine) {
    .service {
      transform: translateZ(0);
      transition:
        transform 320ms var(--ease-glide),
        opacity 520ms var(--ease-smooth);
    }

    .service::after {
      will-change: opacity;
    }

    .service:hover {
      transform: translate3d(8px, 0, 0);
      color: inherit;
    }

    .service:hover::after {
      opacity: 1;
    }
  }

  .service__num {
    flex: none;
    font-size: 12px;
    letter-spacing: 0.1em;
    color: var(--ink-softer);
    font-variant-numeric: tabular-nums;
  }

  .service__title {
    flex: 1 1 220px;
    min-width: 0;
    font-size: clamp(20px, 2vw, 26px);
    font-weight: 600;
    letter-spacing: -0.014em;
    line-height: 1.2;
  }

  .service__desc {
    flex: 1 1 300px;
    min-width: 0;
    font-size: 17px;
    line-height: 1.47;
    letter-spacing: -0.022em;
    color: var(--ink-muted);
    text-wrap: pretty;
  }

  .service__cta {
    flex: none;
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 17px;
    letter-spacing: -0.022em;
    color: var(--blue);
    white-space: nowrap;
  }

  .service__chevron {
    font-size: 19px;
    line-height: 1;
  }

  .services__rule {
    border-top: 1px solid var(--line-parchment);
  }

  /* ---- Manifesto ----------------------------------------------------- */
  .manifesto {
    padding-block: clamp(76px, min(16vh, 21vw), 180px);
  }

  .manifesto__heading {
    font-size: clamp(29px, 5.2vw, 72px);
    line-height: 1.07;
    letter-spacing: -0.017em;
    font-weight: 600;
    max-width: 22ch;
  }

  .manifesto__heading span {
    display: inline-block;
  }

  .manifesto__tail {
    color: var(--ink-on-dark-muted);
  }

  .manifesto__body {
    margin-top: clamp(28px, 5vh, 48px);
    max-width: 52ch;
    font-size: clamp(19px, 2vw, 24px);
    font-weight: 300;
    line-height: 1.5;
    color: var(--ink-on-dark-muted);
  }

  /* ---- How I work ---------------------------------------------------- */
  .process {
    padding-block: clamp(58px, min(12vh, 16vw), 140px);
  }

  .process__inner {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(26px, 4vw, 80px);
  }

  .process__label {
    flex: 0 1 260px;
    min-width: 200px;
  }

  .process__list {
    flex: 1 1 460px;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .process__step {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(10px, 3vw, 44px);
    align-items: baseline;
    padding: clamp(18px, 2.8vh, 26px) 0;
    border-top: 1px solid var(--line-light);
  }

  .process__step:last-child {
    border-bottom: 1px solid var(--line-light);
  }

  .process__title {
    flex: 1 1 240px;
    min-width: 0;
    font-size: clamp(22px, 2.5vw, 32px);
    font-weight: 600;
    letter-spacing: -0.016em;
    line-height: 1.18;
  }

  .process__desc {
    flex: 1 1 240px;
    min-width: 0;
    font-size: 17px;
    line-height: 1.47;
    letter-spacing: -0.022em;
    color: var(--ink-muted);
  }

  /* ---- About preview ------------------------------------------------- */
  .about {
    padding-block: clamp(58px, min(12vh, 16vw), 140px);
  }

  .about__inner {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(30px, 5vw, 80px);
    align-items: center;
  }

  .about__portrait {
    flex: 1 1 320px;
    min-width: 240px;
    max-width: 400px;
  }

  .about__portrait-frame {
    width: 100%;
    aspect-ratio: 4 / 5;
    border-radius: var(--r-portrait);
    overflow: hidden;
    background: var(--surface-placeholder);
  }

  .about__portrait-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .about__copy {
    flex: 1 1 420px;
    min-width: 0;
  }

  .about__eyebrow {
    margin-bottom: 16px;
  }

  .about__heading {
    font-size: clamp(26px, 3.4vw, 42px);
    line-height: 1.1;
    letter-spacing: -0.016em;
    font-weight: 600;
    max-width: 20ch;
  }

  .about__body {
    margin-top: 20px;
    font-size: 17px;
    line-height: 1.5;
    letter-spacing: -0.022em;
    max-width: 54ch;
  }

  .about__stats {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(28px, 5vw, 56px);
    margin-top: clamp(24px, 4vh, 36px);
    padding-top: 22px;
    border-top: 1px solid var(--line-parchment);
  }

  .about__stat-value {
    font-size: clamp(26px, 3vw, 34px);
    font-weight: 600;
    letter-spacing: -0.024em;
    font-variant-numeric: tabular-nums;
  }

  .about__stat-label {
    font-size: 14px;
    color: var(--ink-muted);
    margin-top: 6px;
  }

  .about__link {
    margin-top: 18px;
  }

  /* ---- Contact ------------------------------------------------------- */
  .contact {
    padding-block: clamp(68px, min(14vh, 19vw), 160px);
  }
</style>
