---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found — Mohamad Hawa" description="That page does not exist.">
  <main id="main" data-shell="1">
    <section class="section section--light notfound" data-tile="light">
      <div class="shell--narrow">
        <div class="eyebrow">404</div>
        <h1 class="notfound__heading">That page does not exist.</h1>
        <p class="notfound__body">
          The link may be old, or the project may have moved. The work index is the best
          place to pick things back up.
        </p>
        <div class="notfound__actions">
          <a class="btn btn--primary" href="/work">See the work</a>
          <a class="btn btn--secondary" href="/">Back home</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .notfound {
    padding-top: clamp(150px, 22vh, 240px);
    padding-bottom: clamp(90px, 14vh, 160px);
  }

  .notfound__heading {
    margin-top: 16px;
    max-width: 18ch;
    font-size: clamp(33px, 5.6vw, 76px);
    line-height: 1.04;
    letter-spacing: -0.019em;
    font-weight: 600;
  }

  .notfound__body {
    margin-top: 20px;
    max-width: 46ch;
    font-size: 17px;
    line-height: 1.52;
    letter-spacing: -0.022em;
    color: var(--ink-muted);
  }

  .notfound__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: clamp(26px, 4vh, 38px);
  }
</style>
