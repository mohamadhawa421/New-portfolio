  }

  .club__tools button:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .club__tools-div {
    width: 1px;
    height: 18px;
    margin: 0 4px;
    background: var(--c-line);
  }

  /* ---- Preview ---------------------------------------------------- */

  .club[data-mode='preview'] .club__bar,
  .club[data-mode='preview'] .club__panel,
  .club[data-mode='preview'] .club__overlay,
  .club[data-mode='preview'] .club__tools {
    display: none;
  }

  .club[data-mode='preview'] .club__body {
    grid-template-columns: minmax(0, 1fr);
  }

  .club[data-mode='preview'] {
    grid-template-rows: 1fr;
  }

  .club__resume {
    position: fixed;
    right: 18px;
    bottom: 18px;
    z-index: 70;
    height: 32px;
    padding: 0 14px;
    border: 0;
    border-radius: 999px;
    background: var(--c-fill);
    color: #fff;
    font-size: 11px;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 8px 24px #00000059;
  }

  /* ---- The tour --------------------------------------------------- */

  .club__coach {
    position: fixed;
    z-index: 80;
    width: 268px;
    padding: 12px 13px 11px;
    border-radius: var(--c-r-lg);
    background: var(--c-panel);
    border: 1px solid var(--c-line);
    box-shadow: 0 14px 44px #000000b3;
  }

  .club__coach p {
    margin: 0 0 11px;
    font-size: 12px;
    line-height: 1.45;
    color: var(--c-ink);
  }

  .club__coach-foot {
