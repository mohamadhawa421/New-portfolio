    font-size: 11px;
    font-weight: 500;
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .club__spot {
      transition: none;
    }
  }
</style>

<script>
  /*
   * Nothing of the editor loads until the window is big enough to hold it.
   *
   * The dynamic import is the point: on a phone this module is never fetched,
   * never parsed and never run, so the too-small state costs a few hundred
   * bytes of markup rather than an editor's worth of JavaScript. It also keeps
   * every byte of the Club out of the normal portfolio's bundle, because
   * nothing else imports it.
   */
  const FITS = '(min-width: 1024px)';

  function boot(): void {
    const root = document.querySelector<HTMLElement>('[data-club-root]');
    if (!root) return;

    const fits = window.matchMedia(FITS).matches && !window.matchMedia('(pointer: coarse)').matches;
    if (!fits) return;

    root.hidden = false;
    void import('../scripts/club/index').then((m) => m.startClub(root));
  }

  document.addEventListener('astro:page-load', boot);
</script>
