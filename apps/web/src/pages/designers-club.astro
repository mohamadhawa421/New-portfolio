  .club__canvas[data-tool='rect'],
  .club__canvas[data-tool='ellipse'],
  .club__canvas[data-tool='frame'],
  .club__canvas[data-tool='text'] {
    cursor: crosshair;
  }

  /*
   * The artboard.
   *
   * Transformed rather than resized: scaling the frame would make the page
   * inside it re-layout at a different width, so a designer zooming out would
   * watch the portfolio reflow into its tablet breakpoint. A transform leaves
   * the document at its real width and only changes how big it is drawn, which
   * is what zoom means in a design tool.
   */
  .club__stage {
    position: absolute;
    top: 0;
    left: 0;
    transform-origin: 0 0;
    /*
     * A ring and a shadow, because on a near-black ground a shadow alone is
     * invisible — the artboard's white edge needs something to sit against or
     * it reads as a hole cut in the canvas rather than a sheet laid on it.
     */
    box-shadow:
      0 0 0 1px var(--c-edge),
      0 18px 60px #000000b3;
    background: #fff;
    will-change: transform;
  }

  .club__frame {
    display: block;
    border: 0;
    background: #fff;
  }

  .club__overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* ---- Selection -------------------------------------------------- */

  .club__sel {
    position: absolute;
    border: 1px solid var(--c-mark);
    pointer-events: none;
  }

  .club__hover {
    position: absolute;
    border: 1px solid var(--c-mark);
    opacity: 0.5;
    pointer-events: none;
  }

  .club__handle {
    position: absolute;
    width: 7px;
    height: 7px;
    margin: -4px 0 0 -4px;
    border: 1px solid var(--c-mark);
    border-radius: 1px;
    background: #fff;
    pointer-events: auto;
  }

  /*
   * The size badge, under the selection, where Figma puts it.
   *
   * It is the one label a designer reads mid-drag, and below rather than above
   * keeps it off whatever is being selected.
   */
  .club__tag {
    position: absolute;
    padding: 1px 5px;
    border-radius: 3px;
    background: var(--c-fill);
    color: #fff;
    font-size: 10px;
    font-weight: 500;
    white-space: nowrap;
    pointer-events: none;
  }

  /*
   * Padding, shown while Alt is held.
   *
   * Figma's own colour for this, and for a good reason: it is the one overlay
   * that has to be legible *through* whatever it is lying on, which rules out
   * anything in the blue family the selection already owns.
   */
  .club__pad {
    position: absolute;
    display: grid;
    place-items: center;
    background: var(--c-measure-soft);
    pointer-events: none;
  }

  .club__pad-n {
    padding: 0 4px;
    border-radius: 3px;
    background: var(--c-measure-fill);
    color: #fff;
    font-size: 10px;
    font-weight: 600;
    line-height: 15px;
    white-space: nowrap;
  }

  /*
   * The measurement between two things, in the same key as the padding.
   *
   * A hairline rather than a band, because a distance is a line and an area is
   * a fill — reading them as the same thing is what makes a measuring overlay
   * confusing the moment both are on screen at once.
   */
  .club__measure {
    position: absolute;
    display: grid;
    place-items: center;
    background: var(--c-measure);
    pointer-events: none;
  }

  .club__measure-n {
    padding: 0 4px;
    border-radius: 3px;
    background: var(--c-measure-fill);
    color: #fff;
    font-size: 10px;
    font-weight: 600;
    line-height: 15px;
    white-space: nowrap;
  }

  /* ---- Floating tool pill ----------------------------------------- */

  /*
   * At the bottom, over the canvas, where the tool it is imitating puts it.
   *
   * A toolbar in the top chrome is a website's toolbar; a pill floating over
   * the artboard is a design tool's. It also puts the tools nearer the work
   * than a strip at the top of an 860-pixel window ever could.
   */
  .club__tools {
    position: absolute;
    left: 50%;
    bottom: 18px;
    z-index: 55;
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 5px;
    transform: translateX(-50%);
    border-radius: var(--c-r-lg);
    background: var(--c-panel);
    border: 1px solid var(--c-line);
    box-shadow:
