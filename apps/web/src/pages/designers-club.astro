    gap: 4px;
    margin-right: auto;
  }

  .club__dots i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #ffffff38;
  }

  .club__dots i[data-on='1'] {
    background: var(--c-mark);
  }

  /*
   * The spotlight: one element that moves, rather than four masks.
   *
   * A huge spread shadow is what dims everything outside the hole, which means
   * the "cut-out" is really just this box's own border-radius. Nothing is
   * layered over the UI, so the editor underneath stays visible and legible
   * the whole way through the tour.
   */
  .club__spot {
    position: fixed;
    z-index: 75;
    border-radius: 10px;
    pointer-events: none;
    box-shadow: 0 0 0 9999px #00000073;
    transition:
      top 300ms var(--ease-out),
      left 300ms var(--ease-out),
      width 300ms var(--ease-out),
      height 300ms var(--ease-out);
  }

  /* ---- Toast ------------------------------------------------------ */

  .club__toast {
