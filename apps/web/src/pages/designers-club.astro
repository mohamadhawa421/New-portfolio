  /* ---- Colour ----------------------------------------------------- */

  /*
   * A swatch that opens an inline picker, not the operating system's.
   *
   * `<input type="color">` hands the whole interaction to a native dialog that
   * looks nothing like this and cannot be dragged smoothly — and dragging is
   * the entire point of choosing a colour. The picker is two draggable
   * surfaces and a hex field, which is what every design tool offers and what
   * a designer's hands already know.
   */
  .club__swatch {
    display: flex;
    align-items: center;
    gap: 7px;
    width: 100%;
    height: 24px;
    padding: 0 6px;
    border: 1px solid transparent;
