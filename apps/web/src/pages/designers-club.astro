---
/**
 * The Designers Club.
 *
 * A room off the portfolio where a visitor can take the thing apart and put it
 * back differently. The canvas is the real site in a same-origin frame — see
 * `club/sandbox.ts` — so what is being redesigned is genuinely this portfolio
 * rather than a drawing of it.
 *
 * The chrome follows Figma's grammar deliberately: dark panels either side, a
 * floating tool pill at the bottom, layers on the left, contextual properties
 * on the right, and a blue selection. A designer should not have to learn
 * where anything is. The one place it departs is the canvas, which is somebody
 * else's finished website rather than a blank artboard — so the selection is
 * drawn a hair quieter than Figma's, because it sits on top of real work.
 *
 * The workspace is dark whatever the portfolio is wearing, for the reason
 * every design tool is: the chrome has to recede so the work can be judged.
 * The canvas inside it still follows the visitor's own theme.
 *
 * The page ships three states and only ever shows one: the desktop editor, the
 * too-small message, and nothing at all while it decides. Which one is decided
 * in CSS from the viewport, before any script runs, so a phone never sees a
 * flash of an editor it cannot use — and the editor's own code sits behind a
 * dynamic import that a phone never reaches.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteSettings } from '../lib/content';

const settings = await getSiteSettings();

/**
 * The pages the Club can open.
 *
 * Navigation lives here rather than in the canvas: inside the frame every link
 * is inert, because a click there means "select this", so the only way to
 * another page is to ask for it from the panel. That is also how Figma works —
 * you change page in the sidebar, not by clicking something in the design.
 */
const PAGES = [
  { path: '/', label: 'Home' },
  { path: '/work', label: 'Work' },
  { path: '/about', label: 'About' },
  { path: '/contact', label: 'Contact' },
];
---

<BaseLayout
  title={`Designers Club — ${settings.siteName}`}
  description="A little playground for designers. Redesign this portfolio in the browser, then send the result over."
>
  {/*
    The skip link's destination, which every page owes it.

    No `data-shell` here, unlike the rest of the site: that opts a page into
    the shell's padding and section rhythm, and the Club is a fixed workspace
    that fills the window rather than a document that flows down it.
  */}
  <main id="main">
    {/*
      The too-small state.

      Not an error and not an apology. Panels and a canvas is a desktop
      interaction model, and squeezing it onto a phone would make a worse thing
      rather than a smaller one — so this says what it is and offers the way in.
      He is here because this is still an invitation, just a deferred one.
    */}
    <div class="club-small" data-club-small>
      <img src="/character-club.webp" alt="" width="560" height="463" />
      <h1>Designers Club is made for desktop.</h1>
      <p>Open the portfolio on a bigger screen to enter the club and play with the design.</p>
      <a class="btn btn--secondary" href="/">Back to the portfolio</a>
    </div>

    <div class="club" data-club-root hidden>
      {/* ---- Top bar: identity, view controls, and the way out -------- */}
      <header class="club__bar">
        <a class="club__home" href="/" aria-label="Leave the club">
          <svg viewBox="0 0 9 14" aria-hidden="true" focusable="false">
            <path d="M7.5 1 1.5 7l6 6" fill="none" stroke="currentColor" stroke-width="1.8"></path>
          </svg>
        </a>
        <span class="club__wordmark">Designers&nbsp;Club</span>
        {/*
          Said once, quietly, and never again.

          A designer needs to know within a second that this is a sandbox and
          not the live site — and then never be told twice. A banner across the
          top would be a disclaimer; a word in the title bar is a file name.
        */}
        <span class="club__where">Editing sandbox</span>

        <div class="club__right">
          <button class="club__ghost" type="button" data-act="zoom-out" aria-label="Zoom out">−</button>
          <span class="club__zoom" data-club-zoom>100%</span>
          <button class="club__ghost" type="button" data-act="zoom-in" aria-label="Zoom in">+</button>
          <button class="club__ghost" type="button" data-act="fit">Fit</button>
          <span class="club__div"></span>
          <button class="club__ghost" type="button" data-act="reset">Reset</button>
          <button class="club__ghost" type="button" data-act="preview">Preview</button>
          <button class="club__go" type="button" data-act="export">Export my redesign</button>
        </div>
      </header>

      <div class="club__body">
        {/* ---- Left: pages, then layers ------------------------------ */}
        <aside class="club__panel club__panel--left" aria-label="Pages and layers">
          <div class="club__section">
            <div class="club__section-head">Pages</div>
            <div class="club__pages" data-club-pages role="tablist" aria-label="Portfolio pages">
              {
                PAGES.map((page, i) => (
                  <button
                    class="club__page"
                    type="button"
                    role="tab"
                    data-page={page.path}
                    aria-selected={i === 0 ? 'true' : 'false'}
                  >
                    <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                      <rect
                        x="2.5"
                        y="2"
                        width="11"
                        height="12"
                        rx="1.5"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.2"
                      />
                      <path
                        d="M5 5.5h6M5 8h6M5 10.5h3.5"
                        stroke="currentColor"
                        stroke-width="1.2"
                        fill="none"
                      />
                    </svg>
                    <span>{page.label}</span>
                  </button>
                ))
              }
            </div>
          </div>

          <div class="club__section club__section--grow">
            <div class="club__section-head">Layers</div>
            <div class="club__layers" data-club-layers role="tree" aria-label="Page layers"></div>
          </div>
        </aside>

        {/* ---- Canvas ------------------------------------------------- */}
        <div class="club__canvas" data-club-canvas>
          <div class="club__stage" data-club-stage>
            <iframe
              class="club__frame"
              data-club-frame
              title="Portfolio sandbox"
              src="about:blank"
              scrolling="no"></iframe>
            <div class="club__overlay" data-club-overlay aria-hidden="true"></div>
          </div>
        </div>

        {/* ---- Right: contextual properties --------------------------- */}
        <aside class="club__panel club__panel--right" aria-label="Properties">
          <div class="club__section-head club__section-head--main" data-club-prop-head>
            Properties
          </div>
          <div class="club__props" data-club-props></div>
        </aside>
      </div>

      {/* ---- The tool pill, floating over the canvas ----------------- */}
      <div class="club__tools" role="toolbar" aria-label="Tools" data-club-tools>
        <button type="button" data-tool="select" aria-pressed="true" title="Move — V">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3l14 8-6 1.6L9.6 19z"></path></svg>
          <span class="club__sr">Move</span>
        </button>
        <button type="button" data-tool="hand" aria-pressed="false" title="Hand — H">
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><path
              d="M8 11V5.6a1.6 1.6 0 0 1 3.2 0V11m0-.8V4.4a1.6 1.6 0 0 1 3.2 0v5.8m0-.4a1.6 1.6 0 0 1 3.2 0V15a5.6 5.6 0 0 1-5.6 5.6h-1A5.6 5.6 0 0 1 5.2 15v-2.6a1.6 1.6 0 0 1 3-.8"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"></path></svg
          >
          <span class="club__sr">Hand</span>
        </button>
        <span class="club__tools-div"></span>
        <button type="button" data-tool="frame" aria-pressed="false" title="Frame — F">
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><path
              d="M7 3v18M17 3v18M3 7h18M3 17h18"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"></path></svg
          >
          <span class="club__sr">Frame</span>
        </button>
        <button type="button" data-tool="rect" aria-pressed="false" title="Rectangle — R">
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><rect
              x="4"
              y="5"
              width="16"
              height="14"
              rx="2.5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"></rect></svg
          >
          <span class="club__sr">Rectangle</span>
        </button>
        <button type="button" data-tool="ellipse" aria-pressed="false" title="Ellipse — O">
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><circle cx="12" cy="12" r="7.5" fill="none" stroke="currentColor" stroke-width="1.6"
            ></circle></svg
          >
          <span class="club__sr">Ellipse</span>
        </button>
        <button type="button" data-tool="text" aria-pressed="false" title="Text — T">
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><path d="M5 6h14M12 6v13" fill="none" stroke="currentColor" stroke-width="1.7"
            ></path></svg
          >
          <span class="club__sr">Text</span>
        </button>
        <span class="club__tools-div"></span>
        <button type="button" data-act="undo" title="Undo — ⌘Z" disabled>
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><path
              d="M9 7 4 11l5 4M4 11h9a6 6 0 0 1 0 12h-1"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"></path></svg
          >
          <span class="club__sr">Undo</span>
        </button>
        <button type="button" data-act="redo" title="Redo — ⇧⌘Z" disabled>
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><path
              d="m15 7 5 4-5 4M20 11h-9a6 6 0 0 0 0 12h1"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"></path></svg
          >
          <span class="club__sr">Redo</span>
        </button>
      </div>

      {/*
        The tour, which is chrome rather than a character.

        He does the inviting, on the home page and on the too-small screen,
        and then gets out of the way. Five speech bubbles from a cartoon over a
        design tool is a mascot explaining an interface, and the interface is
        the thing being learnt.
      */}
      <div class="club__coach" data-club-host hidden role="dialog" aria-label="Designers Club tour">
        <p data-club-says></p>
        <div class="club__coach-foot">
          <span class="club__dots" data-club-dots></span>
          <button class="club__ghost" type="button" data-tour="skip">Skip</button>
          <button class="club__go" type="button" data-tour="next">Next</button>
        </div>
      </div>

      {/* Preview mode's way back, and the only chrome left on screen. */}
      <button class="club__resume" type="button" data-club-resume hidden>Edit again</button>

      <div class="club__toast" data-club-toast role="status" aria-live="polite" hidden></div>

      {/* Spotlight for the tour. One element, moved and resized. */}
      <div class="club__spot" data-club-spot hidden aria-hidden="true"></div>
    </div>
  </main>
</BaseLayout>

<style is:global>
  /*
   * The Club takes the window.
   *
   * The site's own page chrome — nav, logo, footer, the drawn scrollbar — is
   * the portfolio's furniture, and in here the portfolio is the *content*.
   * Leaving them on screen would put two navs in view at once, one of them
   * inside the artboard.
   */
  html:has(.club),
  html:has(.club-small) {
    overflow: hidden;
  }

  /*
   * Matched on the data attributes, not the class names.
   *
   * The first version guessed `.site-nav`, and the nav's class is `nav` — so
   * the portfolio's own menu went on rendering across the top of the
   * workspace, over the canvas, with the editor's bar underneath it. The
   * logo's `data-logo` was right by luck. `data-nav` and `data-logo` are what
   * the site's own scripts address these by, which makes them the stable
   * handles; a class is a styling detail and moved once already.
   */
  html:has(.club) [data-nav],
  html:has(.club) [data-logo],
  html:has(.club) body > footer,
  html:has(.club) .scroller,
  html:has(.club-small) [data-nav],
  html:has(.club-small) body > footer {
    display: none !important;
  }
</style>

<!--
  Global, and it has to be.

  Astro scopes a component's styles by stamping `data-astro-cid-…` on the
  elements in its markup and adding a matching attribute selector to every
  rule. That works perfectly for markup and not at all for elements built in
  JavaScript — and the layers rows, every property field, the selection
  overlay and the colour picker are all built in JavaScript. Scoped, they
  matched nothing: a layer row rendered as an unstyled 240-pixel block and the
  picker's saturation square had no height, which is why dragging it returned
  black.

  Every selector below is already namespaced under `.club` or `.club-small`,
  so there is nothing here that can reach the rest of the site.
-->
<style is:global>
  /* ---------------------------------------------------------------- */
  /* Which state shows                                                 */
  /* ---------------------------------------------------------------- */

  .club-small {
    display: none;
    min-height: 100dvh;
    place-content: center;
    justify-items: center;
    text-align: center;
    gap: 14px;
    padding: 8vh 24px;
  }

  .club-small img {
    width: min(260px, 54vw);
    height: auto;
  }

  .club-small h1 {
    margin: 4px 0 0;
    font-size: clamp(1.3rem, 4.4vw, 1.75rem);
    letter-spacing: -0.02em;
  }

  .club-small p {
    margin: 0;
    max-width: 34ch;
    color: var(--ink-muted);
  }

  .club-small .btn {
    margin-top: 10px;
  }

  /*
   * Decided in CSS, before a line of script.
   *
   * A phone must never see a frame of an editor it cannot use, and the
   * decision cannot wait for JavaScript to measure the window.
   */
  @media (max-width: 1023px), (pointer: coarse) and (max-width: 1279px) {
    .club-small {
      display: grid;
    }

    .club {
      display: none !important;
    }
  }

  /* ---------------------------------------------------------------- */
  /* The workspace                                                     */
  /* ---------------------------------------------------------------- */

  /*
   * The workspace's palette is the portfolio's, not the tool's.
   *
   * Every value below is lifted from `tokens.css` — the dark theme's three
   * surfaces and two rules, and the violet the storm and super designer mode
   * are painted in. Nothing here is Figma's: its greys are a shade warmer than
   * this site's near-blacks and its blue belongs to it, and a workspace
   * wearing them would be a clone rather than a room in this portfolio.
   *
   * The accent is split the way the site splits its own, and for the reason
   * written out in `tokens.css`: a colour bright enough to be read *as a line*
   * on a near-black ground is not dark enough to carry white text on top of
   * it. So `--c-mark` draws — selection outlines, guides, the active dot — and
   * `--c-fill` fills anything with white words on it. #6d28d9 carries white at
   * 7:1, which is the same pair the enquiry form's primary button uses.
   *
   * Measurements get the site's blue under the same split, because they have
   * to be legible *beside* the violet rather than through it. Figma uses red
   * for this; red is not in this palette at all.
   *
   * Dark whatever the visitor's theme is, deliberately. A design tool's chrome
   * recedes so the work can be judged — and the work, inside the frame, still
   * follows the visitor's own theme.
   */
  .club {
    /* --surface, --surface-card, --surface-chip in the dark theme. */
    --c-bg: #0b0b0d;
    --c-panel: #141417;
    --c-field: #1b1b1f;
    --c-field-hi: #232328;
    /* --line and --line-dark. */
    --c-line: #232328;
    --c-edge: #33333a;
    /* --ink and --ink-muted. */
    --c-ink: #f5f5f7;
    --c-dim: #a1a1a6;
    /* --blue-on-dark and --blue-fill / --blue-fill-hover, in the violet key. */
    --c-mark: #a855f7;
    --c-fill: #6d28d9;
    --c-fill-hi: #7c3aed;
    /* The same split again, in the site's blue, for spacing overlays. */
    --c-measure: #2997ff;
    --c-measure-fill: #0066cc;
    --c-measure-soft: rgb(41 151 255 / 0.22);

    /*
     * Corners keep the family's *ratio* rather than its numbers.
     *
     * `tokens.css` tunes every surface to roughly a fifth of its short side at
     * the small end — a 120x75 thumbnail takes 15px. A 26px-tall field at the
     * same ratio is 5px, and a 42px tool pill is 9px. Borrowing the numbers
     * instead would put a 12px radius on a 24px input, which is a pill.
     */
    --c-r: 5px;
    --c-r-lg: 9px;

    --c-bar: 44px;
    --c-panel-w: 240px;

    position: fixed;
    inset: 0;
    z-index: 60;
    display: grid;
    grid-template-rows: var(--c-bar) 1fr;
    background: var(--c-bg);
    color: var(--c-ink);
    font-family: var(--font-sans);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
  }

  /* ---- Top bar ---------------------------------------------------- */

  .club__bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 8px 0 4px;
    background: var(--c-panel);
    border-bottom: 1px solid var(--c-line);
  }

  .club__home,
  .club__ghost,
  .club__go {
    display: inline-grid;
    place-items: center;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    border-radius: var(--c-r);
    font: inherit;
    transition: background-color 120ms ease;
  }

  .club__home {
    width: 26px;
    height: 26px;
    flex: none;
  }

  .club__home svg {
    width: 8px;
    height: 13px;
  }

  .club__wordmark {
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .club__where {
    color: var(--c-dim);
    white-space: nowrap;
  }

  .club__right {
    display: flex;
    align-items: center;
    gap: 3px;
    margin-left: auto;
  }

  .club__zoom {
    min-width: 40px;
    text-align: center;
    color: var(--c-dim);
  }

  .club__ghost,
  .club__go {
    height: 26px;
    padding: 0 9px;
    font-size: 11px;
    font-weight: 500;
  }

  .club__ghost:hover {
    background: #ffffff1a;
  }

  .club__go {
    background: var(--c-fill);
    color: #fff;
    font-weight: 600;
  }

  .club__go:hover {
    background: var(--c-fill-hi);
  }

  .club__div {
    width: 1px;
    height: 16px;
    margin: 0 4px;
    background: var(--c-line);
  }

  .club__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ---- Panels ----------------------------------------------------- */

  .club__body {
    display: grid;
    grid-template-columns: var(--c-panel-w) minmax(0, 1fr) var(--c-panel-w);
    min-height: 0;
  }

  .club__panel {
    background: var(--c-panel);
    min-height: 0;
    display: flex;
    flex-direction: column;
  }

  .club__panel--left {
    border-right: 1px solid var(--c-line);
  }

  .club__panel--right {
    border-left: 1px solid var(--c-line);
    overflow: auto;
    overscroll-behavior: contain;
  }

  .club__section {
    display: flex;
    flex-direction: column;
    min-height: 0;
    border-bottom: 1px solid var(--c-line);
  }

  .club__section--grow {
    flex: 1;
    border-bottom: 0;
  }

  /*
   * Section headings in Figma's key: small, bold, air above, and a rule
   * underneath rather than a box around. It is the grammar that makes a long
   * panel readable at a glance.
   */
  .club__section-head {
    padding: 10px 10px 7px;
    font-weight: 600;
    color: var(--c-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .club__section-head--main {
    border-bottom: 1px solid var(--c-line);
    position: sticky;
    top: 0;
    background: var(--c-panel);
    z-index: 2;
  }

  /* ---- Pages ------------------------------------------------------ */

  .club__pages {
    padding: 0 4px 8px;
  }

  .club__page {
    display: flex;
    align-items: center;
    gap: 7px;
    width: 100%;
    height: 26px;
    padding: 0 7px;
    border: 0;
    border-radius: var(--c-r);
    background: transparent;
    color: var(--c-dim);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .club__page svg {
    width: 13px;
    height: 13px;
    flex: none;
    opacity: 0.85;
  }

  .club__page:hover {
    background: #ffffff12;
    color: var(--c-ink);
  }

  .club__page[aria-selected='true'] {
    background: var(--c-fill);
    color: #fff;
  }

  /* ---- Layers ----------------------------------------------------- */

  .club__layers {
    flex: 1;
    overflow: auto;
    padding: 0 4px 16px;
    overscroll-behavior: contain;
  }

  .club__layer {
    display: flex;
    align-items: center;
    gap: 6px;
    width: 100%;
    height: 24px;
    padding: 0 6px;
    border: 0;
    border-radius: var(--c-r);
    background: transparent;
    color: var(--c-dim);
    font: inherit;
    text-align: left;
    cursor: default;
    user-select: none;
  }

  .club__layer:hover {
    background: #ffffff12;
  }

  /*
   * The selected row gets Figma's own treatment: a filled blue row, not a tint
   * with a border. It is the strongest signal in the panel and it has to
   * survive being one of forty rows of very similar text.
   */
  .club__layer[aria-selected='true'] {
    background: var(--c-fill);
    color: #fff;
  }

  .club__layer[aria-selected='true'] .club__type {
    opacity: 1;
  }

  .club__layer--section {
    color: var(--c-ink);
    font-weight: 500;
  }

  .club__type {
    flex: none;
    width: 12px;
    height: 12px;
    opacity: 0.7;
  }

  .club__type svg {
    width: 12px;
    height: 12px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.3;
  }

  .club__layer-name {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .club__layer[data-hidden='1'] .club__layer-name {
    opacity: 0.45;
  }

  .club__eye {
    flex: none;
    width: 18px;
    height: 18px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 3px;
    background: transparent;
    color: inherit;
    opacity: 0;
    cursor: pointer;
  }

  .club__layer:hover .club__eye,
  .club__eye[data-on='0'],
  .club__eye:focus-visible {
    opacity: 0.8;
  }

  .club__eye:hover {
    opacity: 1;
    background: #ffffff1f;
  }

  .club__eye svg {
    width: 12px;
    height: 12px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  /* ---- Properties ------------------------------------------------- */

  .club__props {
    padding-bottom: 20px;
  }

  .club__group {
    padding: 9px 10px 11px;
    border-bottom: 1px solid var(--c-line);
  }

  .club__group:last-child {
    border-bottom: 0;
  }

  .club__group-name {
    margin-bottom: 8px;
    font-weight: 600;
    color: var(--c-ink);
  }

  .club__fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px 8px;
  }

  .club__field {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
  }

  .club__field--wide {
    grid-column: 1 / -1;
  }

  .club__field--stack {
    display: grid;
    gap: 4px;
  }

  /*
   * The label sits at the field's leading edge rather than above it.
   *
   * Figma puts a tiny X, Y, W, H beside the number instead of a caption over
   * it, and the result is twice the density with no loss of clarity — which is
   * what lets a properties panel hold this much without scrolling.
