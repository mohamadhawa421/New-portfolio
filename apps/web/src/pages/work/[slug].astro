---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FigmaExplorer from '../../components/FigmaExplorer.astro';
import { getProjects } from '../../lib/content';
import type { Project } from '../../lib/types';

export async function getStaticPaths() {
  const projects = await getProjects();

  return projects.map((project, index) => ({
    params: { slug: project.slug },
    props: {
      project,
      next: projects[(index + 1) % projects.length],
    },
  }));
}

interface Props {
  project: Project;
  next: Project;
}

const { project, next } = Astro.props;

// Metrics are designed for short figures ("50%", "44+ Screens"). Some projects
// list what shipped by name instead, and a phrase like "Podcasts & Editorial
// Content" runs 500px wide at that size and breaks the row. Decide once per
// project so a row never mixes both sizes.
const compactMetrics = project.metrics.some((metric) => metric.value.length > 14);

/*
 * The placeholder colour is only painted when there is no cover.
 *
 * Behind one, it is never meant to be seen — and it was: a rounded, clipped
 * frame and the picture inside it are rasterised separately, so the corner
 * pixels blend the two and a pale placeholder under a dark cover surfaces as a
 * hairline along whichever edge happens to land off the pixel grid. It moved
 * from project to project with the layout, and re-rasterising the layer on
 * scroll made it come and go.
 *
 * With nothing to bleed through, there is nothing to see.
 */
/*
 * What the page opens on.
 *
 * The approach shot where there is one, because that is the real work and
 * because it is the picture the home page's index was showing a moment ago —
 * a shared-element transition between two different images is a crossfade
 * wearing a morph's clothes. The brand cover is the fallback, and it keeps
 * its own job on the work grid, where a mark at card size is exactly right.
 */
const opener = project.approachShot ?? project.cover;

const coverStyle = project.cover
  ? `color:${project.chipInk}`
  : `background:${project.chipBg};color:${project.chipInk}`;
---

<BaseLayout seo={project.seo}>
  <main id="main" data-shell="1">
    {/* ---------------------------------------------------------------- */}
    {/* Hero                                                              */}
    {/* ---------------------------------------------------------------- */}
    <section class="section section--light case-hero" data-lift data-tile="light">
      <div class="shell--narrow">
        <a class="text-link" href="/work" data-back>‹&nbsp;All work</a>

        <div class="eyebrow case-hero__meta" data-reveal="0">
          {project.num} — {project.categories.join(' · ')}
        </div>
        <h1 class="case-hero__title"><span data-rise="0">{project.title}</span></h1>
        <p class="lead case-hero__summary"><span data-rise="1">{project.summary}</span></p>

        <dl class="case-hero__facts" data-reveal="3">
          <div>
            <dt>Discipline</dt>
            <dd>{project.discipline}</dd>
          </div>
          <div>
            <dt>Role</dt>
            <dd>{project.role}</dd>
          </div>
        </dl>
      </div>
    </section>

    {/* ---------------------------------------------------------------- */}
    {/* Cover, brief, problem                                             */}
    {/* ---------------------------------------------------------------- */}
    <section class="section section--parchment case-brief" data-lift data-tile="parchment">
      <div class="shell--narrow">
        {/*
          The page opens on the work, and that is also what makes the morph
          work.

          It used to open on the brand mark — the same flat field of client
          colour the work grid carries — which was the wrong picture twice
          over. It told a reader who had just chosen this project nothing they
          had not already been told by the title, and it was the far end of a
          shared-element transition whose near end, on the home page, is a
          screenshot. Measured, those two were rgb(8,24,40) and rgb(248,248,248):
          the morph was crossfading black into white while it moved, which is
          the "weird" in entering a project.

          Now both ends are the same file. The home page's index frame shows
          `approachShot` and so does this, so the transition has nothing to
          cross-fade and is purely a box changing size and place — which is
          the only thing a shared element should ever be doing.

          It still does not open to fullscreen. It is the establishing shot,
          and it is repeated nowhere else on the page now, so there is nothing
          behind a zoom of it that is not already on screen. The gallery
          opens, because those are the screens somebody came to read.
        */}
        <div
          class="case-cover"
          data-morph
          data-slug={project.slug}
          style={coverStyle}
        >
          {
            opener ? (
              <img
                src={opener.url}
                alt={opener.alt}
                width={opener.width}
                height={opener.height}
                fetchpriority="high"
                decoding="async"
              />
            ) : (
              <span class="case-cover__initials">{project.initials}</span>
            )
          }
        </div>

        {project.approachCaption && project.approachShot && (
          <div class="case-caption case-caption--opener">{project.approachCaption}</div>
        )}

        {
          (project.briefLead || project.briefBody) && (
            <div class="case-row" data-reveal="0">
              <div class="eyebrow--small case-row__label">The brief</div>
              <div class="case-row__body">
                {project.briefLead && <p class="case-lead">{project.briefLead}</p>}
                {project.briefBody && <p class="case-body">{project.briefBody}</p>}
              </div>
            </div>
          )
        }

        {
          (project.problemLead || project.constraints.length > 0) && (
            <div class="case-row" data-reveal="0">
              <div class="eyebrow--small case-row__label">The problem</div>
              <div class="case-row__body">
                {project.problemLead && <p class="case-lead">{project.problemLead}</p>}

                {project.constraints.length > 0 && (
                  <div class="constraints">
                    {project.constraints.map((constraint, i) => (
                      <div class="constraint">
                        <span class="constraint__num">{String(i + 1).padStart(2, '0')}</span>
                        <div>
                          <div class="constraint__title">{constraint.title}</div>
                          {constraint.body && (
                            <p class="case-body constraint__body">{constraint.body}</p>
                          )}
                        </div>
                      </div>
                    ))}
                  </div>
                )}
              </div>
            </div>
          )
        }
      </div>
    </section>

    {/* ---------------------------------------------------------------- */}
    {/* Approach                                                          */}
    {/* ---------------------------------------------------------------- */}
    {
      (project.approachLead || project.approachBody || project.decisions.length > 0) && (
        <section class="section section--light case-approach" data-lift data-tile="light">
          <div class="shell--narrow">
            <div class="case-row case-row--flush" data-reveal="0">
              <div class="eyebrow--small case-row__label">The approach</div>
              <div class="case-row__body">
                {project.approachLead && <p class="case-lead">{project.approachLead}</p>}
                {project.approachBody && <p class="case-body">{project.approachBody}</p>}
              </div>
            </div>

            {/*
              No picture here any more.

              The approach shot moved to the top of the page, where it is the
              establishing image and the far end of the morph. Repeating it a
              screen and a half later was the same photograph twice, and the
              prose is what this section is actually for.
            */}

            {project.decisions.length > 0 && (
              <div class="decisions" data-reveal="0">
                {project.decisions.map((decision) => (
                  <div>
                    <div class="eyebrow--small">{decision.eyebrow}</div>
                    <div class="decision__title">{decision.title}</div>
                    <p class="decision__body">{decision.body}</p>
                  </div>
                ))}
              </div>
            )}
          </div>
        </section>
      )
    }

    {/* ---------------------------------------------------------------- */}
    {/* What shipped                                                      */}
    {/* ---------------------------------------------------------------- */}
    {
      (project.gallery.length > 0 || project.metrics.length > 0) && (
        <section class="section section--parchment case-shipped" data-lift data-tile="parchment">
          <div class="shell--narrow">
            <div class="eyebrow--small" data-reveal="0">What shipped</div>
            <h2 class="case-shipped__heading" data-reveal="0">{project.shippedHeading}</h2>

            {project.gallery.length > 0 && (
              <div class="gallery">
                {project.gallery.map((image, i) => (
                  <div class="gallery__item" data-reveal={String(i)} data-zoom>
                    <img
                      src={image.url}
                      alt={image.alt}
                      width={image.width}
                      height={image.height}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                ))}
              </div>
            )}

            {project.metrics.length > 0 && (
              <div class="metrics" data-reveal="0">
                {project.metrics.map((metric) => (
                  <div>
                    <div
                      class="metric__value"
                      class:list={[{ 'metric__value--text': compactMetrics }]}
                      data-num={metric.animate ? '1' : undefined}
                    >
                      {metric.value}
                    </div>
                    <div class="metric__label">{metric.label}</div>
                  </div>
                ))}
              </div>
            )}
          </div>
        </section>
      )
    }

    {/* ---------------------------------------------------------------- */}
    {/* Explore the design                                                */}
    {/* ---------------------------------------------------------------- */}
    {/*
      After the work has been shown and before it is reflected on, which is
      where somebody who has just been convinced wants to look closer. The
      component decides whether it renders at all — a project with no explorer
      configured contributes nothing to this page, not an empty section.
    */}
    <FigmaExplorer slug={project.slug} title={project.title} />

    {/* ---------------------------------------------------------------- */}
    {/* Looking back                                                      */}
    {/* ---------------------------------------------------------------- */}
    {
      (project.reflectionLead || project.reflectionBody) && (
        <section class="section section--light case-reflection" data-lift data-tile="light">
          <div class="shell--narrow case-row case-row--flush">
            <div class="eyebrow--small case-row__label">Looking back</div>
            <div class="case-row__body">
              {project.reflectionLead && <p class="case-lead">{project.reflectionLead}</p>}
              {project.reflectionBody && <p class="case-body">{project.reflectionBody}</p>}
            </div>
          </div>
        </section>
      )
    }

    {/* ---------------------------------------------------------------- */}
    {/* The end of the article, and the two things to do at it            */}
    {/* ---------------------------------------------------------------- */}
    {/*
      Onward, or out.

      Reaching the bottom of a case study is a decision, and until now the
      page only offered one side of it: there was a large invitation to read
      the next project and no way back to the listing short of scrolling the
      whole article again to the link at the top. The nav is fixed and always
      has a "Work" in it, so nobody was ever *stuck* — but "Work" is a
      forward navigation that lands at the top of fifteen projects, which is
      not the same as going back to the one you opened.

      So both live here now, in the order of their weight: the next project
      loud, because it is the thing most people want, and the way out quiet
      underneath it, because the people who want that already know they do.
      It is deliberately the same small link, with the same label and the
      same behaviour, as the one at the head of the article — a bookend
      rather than a new control to learn.

      One section rather than two, and it renders whether or not there is a
      next project, because the way out is not conditional on anything.
    */}
    <section class="section section--light case-foot" data-lift data-tile="light">
      <div class="shell--narrow">
        {next && next.slug !== project.slug && (
          <div class="case-next">
            <div class="case-next__label">Next project</div>
            <h2 class="case-next__title">
              <a href={`/work/${next.slug}`}>{next.title}</a>
            </h2>
            <div class="case-next__cta">
              <a class="text-link" href={`/work/${next.slug}`}>View project&nbsp;›</a>
            </div>
          </div>
        )}

        <div class="case-out">
          <a class="text-link" href="/work" data-back>‹&nbsp;All work</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  /**
   * "All work" walks back through history when the listing is genuinely the
   * previous page, rather than pushing a new entry onto it.
   *
   * Two things come free with that: the browser restores the scroll position,
   * so the visitor lands on the card they opened rather than the top of the
   * page, and the cover morphs back into that card instead of into whatever
   * happens to be at the top.
   *
   * If they arrived here from outside — a shared link, a search result — the
   * link stays an ordinary link, because going back would take them off the
   * site entirely.
   */
  function setupBackLink() {
    /*
     * There are two of these: one at the head of the article and one at its
     * foot. They are the same control in both places — same label, same
     * behaviour — so they are set up together rather than separately, which
     * is what stops the two ends of the page from ever disagreeing about
     * where "back" goes.
     */
    const links = document.querySelectorAll<HTMLAnchorElement>('[data-back]');
    if (!links.length) return;

    const from = () => (window as unknown as { __mhFrom?: string }).__mhFrom;
    const canGoBack = () => from() === '/work' || from() === '/';

    for (const link of links) {
      /*
       * The label has to follow the behaviour. Coming from the home page,
       * this link returns there — calling that "All work" would be a lie,
       * and the visitor would not know they were about to land back where
       * they were.
       */
      link.textContent = from() === '/' ? '\u2039\u00a0Back' : '\u2039\u00a0All work';

      if (link.dataset.bound) continue;
      link.dataset.bound = '1';

      link.addEventListener('click', (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;

        if (!canGoBack()) return;

        event.preventDefault();
        history.back();
      });
    }
  }

  document.addEventListener('astro:page-load', setupBackLink);
</script>

<style>
  /* ---- Hero ---------------------------------------------------------- */
  .case-hero {
    padding-top: clamp(96px, min(16vh, 25vw), 188px);
    padding-bottom: clamp(34px, 5vh, 60px);
  }

  .case-hero__meta {
    margin: clamp(26px, 4vh, 44px) 0 16px;
  }

  .case-hero__title {
    /* Clips the rising text until it slides into place. */
    overflow: hidden;
    /*
     * Room for the descenders inside the clip, cancelled again by the margin so
     * the heading occupies exactly the space it did before. A tight
     * line-height puts the line box above the bottom of the glyphs, and the
     * same overflow that hides the rising text was shaving them.
     */
    padding-bottom: 0.16em;
    margin-bottom: -0.1em;
    max-width: 16ch;
    font-size: clamp(33px, 5.6vw, 76px);
    line-height: 1.04;
    letter-spacing: -0.019em;
    font-weight: 600;
  }

  .case-hero__summary {
    /* Clips the rising text until it slides into place. */
    overflow: hidden;
    /*
     * Room for the descenders inside the clip, cancelled again by the margin so
     * the heading occupies exactly the space it did before. A tight
     * line-height puts the line box above the bottom of the glyphs, and the
     * same overflow that hides the rising text was shaving them.
     */
    padding-bottom: 0.16em;
    margin-bottom: -0.1em;
    margin-top: 20px;
    max-width: 46ch;
  }

  .case-hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(24px, 5vw, 64px);
    margin: clamp(32px, 5vh, 56px) 0 0;
    padding-top: 22px;
    border-top: 1px solid var(--line-light);
    font-size: 17px;
    letter-spacing: -0.022em;
  }

  .case-hero__facts dt {
    font-size: 14px;
    color: var(--ink-muted);
    margin-bottom: 8px;
  }

  .case-hero__facts dd {
    margin: 0;
  }

  /* ---- Shared case rows ---------------------------------------------- */
  .case-row {
    margin-top: clamp(48px, 7vh, 84px);
    display: flex;
    flex-wrap: wrap;
    gap: clamp(26px, 5vw, 72px);
  }

  .case-row--flush {
    margin-top: 0;
  }

  .case-row__label {
    flex: 0 1 220px;
    min-width: 180px;
  }

  .case-row__body {
    flex: 1 1 420px;
    min-width: 0;
  }

  .case-lead {
    font-size: clamp(20px, 2.1vw, 27px);
    font-weight: 300;
    line-height: 1.42;
    letter-spacing: -0.008em;
    max-width: 40ch;
    text-wrap: pretty;
  }

  .case-body {
    margin-top: 22px;
    font-size: 17px;
    line-height: 1.55;
    letter-spacing: -0.022em;
    color: var(--ink-muted);
    max-width: 58ch;
    text-wrap: pretty;
    /* Imported case studies carry bullet lists as newline-separated text.
       pre-line keeps those breaks without turning the copy into <pre>. */
    white-space: pre-line;
  }

  /* ---- Cover --------------------------------------------------------- */
  .case-brief {
    padding-top: clamp(40px, 6vh, 70px);
    padding-bottom: clamp(58px, min(12vh, 16vw), 130px);
  }

  .case-cover {
    border-radius: var(--r-2xl);
    overflow: hidden;
    aspect-ratio: 16 / 10;
    display: flex;
    align-items: center;
    justify-content: center;
    /*
     * The last cover still on the entrance curve.
     *
     * Three surfaces on this site scale under the pointer — the work card's
     * tile, the featured tile and this one — and global.css states that hover
     * belongs to --ease-glide. The card was moved onto it, the featured tile
     * followed, and this was the one left behind on --ease-out at a full
     * second, which is nearly finished in its first third and then crawls.
     *
     * 620ms to match the card tile, its closest analogue: an image scaling
     * inside a rounded frame. A second of --ease-glide would have been the
     * wrong answer on its own — that curve is slow to leave the mark, and on
     * hover-in the delay is felt — so the duration moves with the easing.
     * scale(1.014) stays: this surface is the largest of the three, and the
     * smaller amount is what keeps its edge travelling the same distance.
     */
    transition: transform 620ms var(--ease-glide);
  }

  .case-cover:hover {
    transform: scale(1.014);
  }

  .case-cover img {
    /*
     * Half a pixel of bleed on every side.
     *
     * The tile and the image inside it are rasterised separately, and at a
     * fractional device-pixel width the rounded clip antialiases against the
     * tile's own background — a pale hairline down one edge of a card, on
     * exactly the covers whose layout happens to land off the pixel grid.
     * Overlapping the frame puts the picture under the seam.
     *
     * `max-width` has to be overridden: the global `img { max-width: 100% }`
     * would otherwise clamp the extra pixel straight back off.
     */
    width: calc(100% + 1px);
    height: calc(100% + 1px);
    margin: -0.5px;
    max-width: none;
    object-fit: cover;
    display: block;
  }

  .case-cover__initials {
    font-size: clamp(48px, 8vw, 120px);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  /* ---- Constraints --------------------------------------------------- */
  .constraints {
    margin-top: 26px;
    display: flex;
    flex-direction: column;
  }

  .constraint {
    display: flex;
    gap: 20px;
    padding: 18px 0;
    border-top: 1px solid var(--line-parchment);
  }

  .constraint:last-child {
    border-bottom: 1px solid var(--line-parchment);
  }

  .constraint__num {
    flex: none;
    font-size: 14px;
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
    padding-top: 2px;
  }

  .constraint__title {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.022em;
  }

  .constraint__body {
    margin-top: 6px;
  }

  /* ---- Approach ------------------------------------------------------ */
  .case-approach {
    padding-block: clamp(58px, min(12vh, 16vw), 132px);
  }

  .case-shot {
    margin-top: clamp(40px, 6vh, 64px);
    /*
     * The cover's corner, not the gallery's.
     *
     * It is the largest single image on the page — 768px on the short side
     * against the gallery tile's 394 — so cutting it to the tile's radius made
     * it the flattest surface in the case study at 3.9% of its short side. One
     * shape for every picture was the right instinct and the wrong unit: what
     * has to match is the ratio, and matching the ratio means these two take
     * different numbers.
     */
    border-radius: var(--r-2xl);
    overflow: hidden;
    background: var(--surface-parchment);
  }

  /*
   * The expand badge sits off the corner by ten pixels plus a share of the
   * curve, which is what keeps its clearance even across two surfaces cut to
   * different radii — and keeps it even again on a phone, where both radii
   * shrink and a fixed inset would leave the badge stranded in open space.
   */
  .case-shot {
    --zoom-inset: calc(10px + var(--r-2xl) * 0.28);
  }

  .gallery__item {
    --zoom-inset: calc(10px + var(--r-lg) * 0.28);
  }

  .case-shot img {
    width: 100%;
    height: auto;
    display: block;
  }

  .case-caption {
    margin-top: 14px;
    font-size: 14px;
    color: var(--ink-faint);
  }

  /*
   * The opener's caption sits under the establishing shot and needs a little
   * more air beneath it than a caption in the middle of a section does — what
   * follows it is the brief, not more of the same block.
   */
  .case-caption--opener {
    margin-bottom: clamp(6px, 1.4vh, 16px);
  }

  .decisions {
    margin-top: clamp(56px, 8vh, 96px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: clamp(20px, 3vw, 40px);
  }

  .decision__title {
    margin-top: 14px;
    font-size: clamp(19px, 2vw, 23px);
    font-weight: 600;
    letter-spacing: -0.016em;
    line-height: 1.2;
  }

  .decision__body {
    margin-top: 9px;
    font-size: 17px;
    line-height: 1.55;
    letter-spacing: -0.022em;
    color: var(--ink-muted);
    max-width: 34ch;
    text-wrap: pretty;
  }

  /* ---- What shipped -------------------------------------------------- */
  .case-shipped {
    padding-block: clamp(58px, min(12vh, 16vw), 132px);
  }

  .case-shipped__heading {
    margin: 14px 0 clamp(34px, 5vh, 52px);
    font-size: clamp(26px, 3.6vw, 46px);
    line-height: 1.06;
    letter-spacing: -0.019em;
    font-weight: 600;
    max-width: 22ch;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: clamp(18px, 2.4vw, 30px);
  }

  /*
   * Every tile the same size and the same corner, in every project.
   *
   * These were sized by their own pictures, which meant a row of two took the
   * height of the taller one and the shorter one sat in a slab of empty
   * surface — measured on Rowad at 1440px: a 327px image inside a 471px tile,
   * 143px of nothing beneath it. It read as the picture failing to fill its
   * frame, because that is what it was.
   *
   * A fixed ratio with `cover` fixes it by making the tile the constant and
   * the picture the thing that yields, which is the right way round for a
   * grid: the gallery is a set of equal openings onto the work, not a set of
   * differently proportioned pictures. Four by three sits between the two
   * shapes these screenshots come in — a wide desktop capture and a squarer
   * app one — so neither is cropped hard.
   *
   * Cropping costs nothing here, and that is what makes it acceptable: the
   * tile is a way in, and the tile opens. The lightbox fits the picture from
   * its natural size, so what is trimmed to square up the grid is all there
   * the moment somebody presses it — and the opening animation is built for
   * exactly this, travelling from the tile's aspect to the picture's own with
   * the crop resolving as it goes.
   */
  .gallery__item {
    aspect-ratio: 4 / 3;
    /* 394px on the short side puts it a band below the panels — and on the
       same corner as the lightbox it opens into, so the morph does not have to
       change shape as well as size. */
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--surface);
  }

  .gallery__item img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
  }

  .metrics {
    margin-top: clamp(48px, 7vh, 84px);
    display: flex;
    flex-wrap: wrap;
    gap: clamp(28px, 5vw, 72px);
    padding-top: 26px;
    border-top: 1px solid var(--line-parchment);
  }

  .metric__value {
    font-size: clamp(30px, 3.4vw, 42px);
    font-weight: 600;
    letter-spacing: -0.024em;
