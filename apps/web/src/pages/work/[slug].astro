---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects } from '../../lib/content';
import type { Project } from '../../lib/types';

export async function getStaticPaths() {
  const projects = await getProjects();

  return projects.map((project, index) => ({
    params: { slug: project.slug },
    props: {
      project,
      next: projects[(index + 1) % projects.length],
    },
  }));
}

interface Props {
  project: Project;
  next: Project;
}

const { project, next } = Astro.props;

// Metrics are designed for short figures ("50%", "44+ Screens"). Some projects
// list what shipped by name instead, and a phrase like "Podcasts & Editorial
// Content" runs 500px wide at that size and breaks the row. Decide once per
// project so a row never mixes both sizes.
const compactMetrics = project.metrics.some((metric) => metric.value.length > 14);
---

<BaseLayout seo={project.seo}>
  <main id="main" data-shell="1">
    {/* ---------------------------------------------------------------- */}
    {/* Hero                                                              */}
    {/* ---------------------------------------------------------------- */}
    <section class="section section--light case-hero" data-tile="light">
      <div class="shell--narrow">
        <a class="text-link" href="/work">‹&nbsp;All work</a>

        <div class="eyebrow case-hero__meta" data-reveal="0">
          {project.num} — {project.category}
        </div>
        <h1 class="case-hero__title" data-reveal="1">{project.title}</h1>
        <p class="lead case-hero__summary" data-reveal="2">{project.summary}</p>

        <dl class="case-hero__facts" data-reveal="3">
          <div>
            <dt>Discipline</dt>
            <dd>{project.discipline}</dd>
          </div>
          <div>
            <dt>Role</dt>
            <dd>{project.role}</dd>
          </div>
          {
            project.timeline && (
              <div>
                <dt>Timeline</dt>
                <dd>{project.timeline}</dd>
              </div>
            )
          }
          {
            project.scope && (
              <div>
                <dt>Scope</dt>
                <dd>{project.scope}</dd>
              </div>
            )
          }
        </dl>
      </div>
    </section>

    {/* ---------------------------------------------------------------- */}
    {/* Cover, brief, problem                                             */}
    {/* ---------------------------------------------------------------- */}
    <section class="section section--parchment case-brief" data-tile="parchment">
      <div class="shell--narrow">
        <div class="case-cover" style={`background:${project.chipBg};color:${project.chipInk}`}>
          {
            project.cover ? (
              <img src={project.cover.url} alt={project.cover.alt} decoding="async" />
            ) : (
              <span class="case-cover__initials">{project.initials}</span>
            )
          }
        </div>

        {
          (project.briefLead || project.briefBody) && (
            <div class="case-row" data-reveal="0">
              <div class="eyebrow--small case-row__label">The brief</div>
              <div class="case-row__body">
                {project.briefLead && <p class="case-lead">{project.briefLead}</p>}
                {project.briefBody && <p class="case-body">{project.briefBody}</p>}
              </div>
            </div>
          )
        }

        {
          (project.problemLead || project.constraints.length > 0) && (
            <div class="case-row" data-reveal="0">
              <div class="eyebrow--small case-row__label">The problem</div>
              <div class="case-row__body">
                {project.problemLead && <p class="case-lead">{project.problemLead}</p>}

                {project.constraints.length > 0 && (
                  <div class="constraints">
                    {project.constraints.map((constraint, i) => (
                      <div class="constraint">
                        <span class="constraint__num">{String(i + 1).padStart(2, '0')}</span>
                        <div>
                          <div class="constraint__title">{constraint.title}</div>
                          {constraint.body && (
                            <p class="case-body constraint__body">{constraint.body}</p>
                          )}
                        </div>
                      </div>
                    ))}
                  </div>
                )}
              </div>
            </div>
          )
        }
      </div>
    </section>

    {/* ---------------------------------------------------------------- */}
    {/* Approach                                                          */}
    {/* ---------------------------------------------------------------- */}
    {
      (project.approachLead || project.approachBody || project.approachShot ||
        project.decisions.length > 0) && (
        <section class="section section--light case-approach" data-tile="light">
          <div class="shell--narrow">
            <div class="case-row case-row--flush" data-reveal="0">
              <div class="eyebrow--small case-row__label">The approach</div>
              <div class="case-row__body">
                {project.approachLead && <p class="case-lead">{project.approachLead}</p>}
                {project.approachBody && <p class="case-body">{project.approachBody}</p>}
              </div>
            </div>

            {project.approachShot && (
              <>
                <div class="case-shot" data-reveal="0">
                  <img
                    src={project.approachShot.url}
                    alt={project.approachShot.alt}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                {project.approachCaption && (
                  <div class="case-caption">{project.approachCaption}</div>
                )}
              </>
            )}

            {project.decisions.length > 0 && (
              <div class="decisions" data-reveal="0">
                {project.decisions.map((decision) => (
                  <div>
                    <div class="eyebrow--small">{decision.eyebrow}</div>
                    <div class="decision__title">{decision.title}</div>
                    <p class="decision__body">{decision.body}</p>
                  </div>
                ))}
              </div>
            )}
          </div>
        </section>
      )
    }

    {/* ---------------------------------------------------------------- */}
    {/* What shipped                                                      */}
    {/* ---------------------------------------------------------------- */}
    {
      (project.gallery.length > 0 || project.metrics.length > 0) && (
        <section class="section section--parchment case-shipped" data-tile="parchment">
          <div class="shell--narrow">
            <div class="eyebrow--small" data-reveal="0">What shipped</div>
            <h2 class="case-shipped__heading" data-reveal="0">{project.shippedHeading}</h2>

            {project.gallery.length > 0 && (
              <div class="gallery">
                {project.gallery.map((image, i) => (
                  <div class="gallery__item" data-reveal={String(i)}>
                    <img src={image.url} alt={image.alt} loading="lazy" decoding="async" />
                  </div>
                ))}
              </div>
            )}

            {project.metrics.length > 0 && (
              <div class="metrics" data-reveal="0">
                {project.metrics.map((metric) => (
                  <div>
                    <div
                      class="metric__value"
                      class:list={[{ 'metric__value--text': compactMetrics }]}
                      data-num={metric.animate ? '1' : undefined}
                    >
                      {metric.value}
                    </div>
                    <div class="metric__label">{metric.label}</div>
                  </div>
                ))}
              </div>
            )}
          </div>
        </section>
      )
    }

    {/* ---------------------------------------------------------------- */}
    {/* Looking back                                                      */}
    {/* ---------------------------------------------------------------- */}
    {
      (project.reflectionLead || project.reflectionBody) && (
        <section class="section section--light case-reflection" data-tile="light">
          <div class="shell--narrow case-row case-row--flush">
            <div class="eyebrow--small case-row__label">Looking back</div>
            <div class="case-row__body">
              {project.reflectionLead && <p class="case-lead">{project.reflectionLead}</p>}
              {project.reflectionBody && <p class="case-body">{project.reflectionBody}</p>}
            </div>
          </div>
        </section>
      )
    }

    {/* ---------------------------------------------------------------- */}
    {/* Next project                                                      */}
    {/* ---------------------------------------------------------------- */}
    {
      next && next.slug !== project.slug && (
        <section class="section section--light case-next" data-tile="light">
          <div class="shell--narrow">
            <div class="case-next__label">Next project</div>
            <h2 class="case-next__title">
              <a href={`/work/${next.slug}`}>{next.title}</a>
            </h2>
            <div class="case-next__cta">
              <a class="text-link" href={`/work/${next.slug}`}>View project&nbsp;›</a>
            </div>
          </div>
        </section>
      )
    }
  </main>
</BaseLayout>

<style>
  /* ---- Hero ---------------------------------------------------------- */
  .case-hero {
    padding-top: clamp(126px, 16vh, 188px);
    padding-bottom: clamp(34px, 5vh, 60px);
  }

  .case-hero__meta {
    margin: clamp(26px, 4vh, 44px) 0 16px;
  }

  .case-hero__title {
    max-width: 16ch;
    font-size: clamp(33px, 5.6vw, 76px);
    line-height: 1.04;
    letter-spacing: -0.019em;
    font-weight: 600;
  }

  .case-hero__summary {
    margin-top: 20px;
    max-width: 46ch;
  }

  .case-hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(24px, 5vw, 64px);
    margin: clamp(32px, 5vh, 56px) 0 0;
    padding-top: 22px;
    border-top: 1px solid var(--line-light);
    font-size: 17px;
    letter-spacing: -0.022em;
  }

  .case-hero__facts dt {
    font-size: 14px;
    color: var(--ink-muted);
    margin-bottom: 8px;
  }

  .case-hero__facts dd {
    margin: 0;
  }

  /* ---- Shared case rows ---------------------------------------------- */
  .case-row {
    margin-top: clamp(48px, 7vh, 84px);
    display: flex;
    flex-wrap: wrap;
    gap: clamp(26px, 5vw, 72px);
  }

  .case-row--flush {
    margin-top: 0;
  }

  .case-row__label {
    flex: 0 1 220px;
    min-width: 180px;
  }

  .case-row__body {
    flex: 1 1 420px;
    min-width: 0;
  }

  .case-lead {
    font-size: clamp(20px, 2.1vw, 27px);
    font-weight: 300;
    line-height: 1.42;
    letter-spacing: -0.008em;
    max-width: 40ch;
    text-wrap: pretty;
  }

  .case-body {
    margin-top: 22px;
    font-size: 17px;
    line-height: 1.55;
    letter-spacing: -0.022em;
    color: var(--ink-muted);
    max-width: 58ch;
    text-wrap: pretty;
    /* Imported case studies carry bullet lists as newline-separated text.
       pre-line keeps those breaks without turning the copy into <pre>. */
    white-space: pre-line;
  }

  /* ---- Cover --------------------------------------------------------- */
  .case-brief {
    padding-top: clamp(40px, 6vh, 70px);
    padding-bottom: clamp(78px, 12vh, 130px);
  }

  .case-cover {
    border-radius: var(--r-xl);
    overflow: hidden;
    aspect-ratio: 16 / 10;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 1000ms var(--ease-out);
  }

  .case-cover:hover {
    transform: scale(1.014);
  }

  .case-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .case-cover__initials {
    font-size: clamp(48px, 8vw, 120px);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  /* ---- Constraints --------------------------------------------------- */
  .constraints {
    margin-top: 26px;
    display: flex;
    flex-direction: column;
  }

  .constraint {
    display: flex;
    gap: 20px;
    padding: 18px 0;
    border-top: 1px solid var(--line-parchment);
  }

  .constraint:last-child {
    border-bottom: 1px solid var(--line-parchment);
  }

  .constraint__num {
    flex: none;
    font-size: 14px;
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
    padding-top: 2px;
  }

  .constraint__title {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.022em;
  }

  .constraint__body {
    margin-top: 6px;
  }

  /* ---- Approach ------------------------------------------------------ */
  .case-approach {
    padding-block: clamp(78px, 12vh, 132px);
  }

  .case-shot {
    margin-top: clamp(40px, 6vh, 64px);
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--surface-parchment);
  }

  .case-shot img {
    width: 100%;
    height: auto;
    display: block;
  }

  .case-caption {
    margin-top: 14px;
    font-size: 14px;
    color: var(--ink-faint);
  }

  .decisions {
    margin-top: clamp(56px, 8vh, 96px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: clamp(20px, 3vw, 40px);
  }

  .decision__title {
    margin-top: 14px;
    font-size: clamp(19px, 2vw, 23px);
    font-weight: 600;
    letter-spacing: -0.016em;
    line-height: 1.2;
  }

  .decision__body {
    margin-top: 9px;
    font-size: 17px;
    line-height: 1.55;
    letter-spacing: -0.022em;
    color: var(--ink-muted);
    max-width: 34ch;
    text-wrap: pretty;
  }

  /* ---- What shipped -------------------------------------------------- */
  .case-shipped {
    padding-block: clamp(78px, 12vh, 132px);
  }

  .case-shipped__heading {
    margin: 14px 0 clamp(34px, 5vh, 52px);
    font-size: clamp(26px, 3.6vw, 46px);
    line-height: 1.06;
    letter-spacing: -0.019em;
    font-weight: 600;
    max-width: 22ch;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: clamp(18px, 2.4vw, 30px);
  }

  .gallery__item {
    border-radius: var(--r-md);
    overflow: hidden;
    background: var(--surface);
  }

  .gallery__item img {
    width: 100%;
    height: auto;
    display: block;
  }

  .metrics {
    margin-top: clamp(48px, 7vh, 84px);
    display: flex;
    flex-wrap: wrap;
    gap: clamp(28px, 5vw, 72px);
    padding-top: 26px;
    border-top: 1px solid var(--line-parchment);
  }

  .metric__value {
    font-size: clamp(30px, 3.4vw, 42px);
    font-weight: 600;
    letter-spacing: -0.024em;
    font-variant-numeric: tabular-nums;
  }

  /* Applied to every metric in a project whose values are names rather than
     figures — see `compactMetrics` above. Sized like the outcome titles. */
  .metric__value--text {
    font-size: clamp(19px, 2vw, 23px);
    letter-spacing: -0.016em;
    line-height: 1.25;
    max-width: 16ch;
  }

  .metric__label {
    font-size: 14px;
    color: var(--ink-muted);
    margin-top: 7px;
    max-width: 22ch;
  }

  /* ---- Looking back -------------------------------------------------- */
  .case-reflection {
    padding-block: clamp(70px, 11vh, 120px);
  }

  /* ---- Next ---------------------------------------------------------- */
  .case-next {
    padding-block: clamp(60px, 10vh, 110px);
    text-align: center;
  }

  .case-next__label {
    font-size: 14px;
    color: var(--ink-muted);
    margin-bottom: 12px;
  }

  .case-next__title {
    font-size: clamp(26px, 3.6vw, 44px);
    line-height: 1.08;
    letter-spacing: -0.016em;
    font-weight: 600;
  }

  .case-next__title a {
    /* inline-flex + min-height keeps this a 44px tap target on phones, where
       the line box alone is only ~31px tall. */
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: inherit;
    transition: color 0.25s ease;
  }

  .case-next__title a:hover {
    color: var(--blue);
  }

  .case-next__cta {
    margin-top: 18px;
  }
</style>
