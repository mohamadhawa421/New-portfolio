---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CharacterAside from '../../components/CharacterAside.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects, getServices, getWorkPage } from '../../lib/content';

const [work, projects, services] = await Promise.all([
  getWorkPage(),
  getProjects(),
  getServices(),
]);

/*
 * The chips are the service list, in the order the services are offered — so
 * the filters read the same way here as they do on the home page and in the
 * enquiry form, rather than in whatever order the projects happen to be in.
 *
 * A service with nothing behind it is left out. An empty filter is a dead end:
 * the visitor presses it, the grid empties, and the only thing they have learnt
 * is that the control was pointless. Anything a project claims that is not in
 * the service list still gets a chip, so a category can never become
 * unreachable by being mistyped in the CMS.
 */
const filled = new Set(projects.flatMap((project) => project.categories));

const categories = [
  work.allFilterLabel,
  ...services.map((service) => service.title).filter((title) => filled.has(title)),
  ...[...filled].filter((category) => !services.some((service) => service.title === category)),
];
---

<BaseLayout seo={work.seo}>
  <main id="main" data-shell="1">
    <section class="section section--light work-hero" data-lift data-tile="light">
      <div class="shell">
        <div class="eyebrow work-hero__eyebrow" data-reveal="0">{work.eyebrow}</div>
        <h1 class="work-hero__heading"><span data-rise="0">{work.heading}</span></h1>
        <p class="lead work-hero__intro"><span data-rise="1">{work.intro}</span></p>
      </div>
    </section>

    <section class="section section--light work-grid" data-lift data-tile="light">
      <div
        class="shell work-grid__filters"
        data-reveal="0"
        role="group"
        aria-label="Filter by the kind of work"
      >
        {
          categories.map((category, i) => (
            <button
              type="button"
              class="chip"
              class:list={[{ 'chip--active': i === 0 }]}
              data-filter={category}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              {category}
            </button>
          ))
        }
        {/* Pressing a chip changes nothing else on screen above the fold, so
            without this a screen reader gets no confirmation that the filter
            did anything. */}
        <span class="work-grid__count" aria-live="polite">
          <span data-count>{projects.length}</span>
          {' '}{work.countLabel}
        </span>
      </div>

      <div class="shell work-grid__list" data-work-grid data-all-label={work.allFilterLabel}>
        {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
      </div>

      <p class="shell work-grid__empty" data-empty hidden>
        Nothing in that category yet.
      </p>

      {/*
        At the foot of the grid, which is where the oldest projects are — he is
        standing next to the ones he is talking about. He waits to be scrolled
        to rather than for a fraction of the page, since on this page the
        position is the joke.
      */}
      <CharacterAside
        src="/character-hush.webp"
        alt="Mohamad, asking for quiet"
        width={560}
        height={640}
        lines={[
          "Shh — the older ones are placeholders. They don't know they're being replaced.",
          "The good ones are at the top. That isn't an accident.",
          'Number eleven still thinks it is getting a case study.',
          "I've been meaning to deal with this for about two years.",
          'Right. Back to work. Both of us.',
        ]}
      />
    </section>
  </main>
</BaseLayout>

<script is:inline>
  (function () {
    function setupFilters() {
      const grid = document.querySelector('[data-work-grid]');
      if (!grid || grid.dataset.filtersBound) return;
      grid.dataset.filtersBound = '1';

      const chips = document.querySelectorAll('[data-filter]');
      // An array, not the live NodeList: the rearrangement below sorts the
      // cards into those staying, leaving and returning, which NodeList cannot do.
      const cards = Array.from(document.querySelectorAll('[data-work-grid] [data-categories]'));
      // Read from the DOM rather than interpolating CMS text into this script.
      const allLabel = grid.dataset.allLabel || 'All';
      const counter = document.querySelector('[data-count]');
      const empty = document.querySelector('[data-empty]');
      if (!chips.length || !cards.length) return;

      // A project can answer to several filters, so the card carries a list.
      // Split once here rather than on every chip press.
      const filed = new Map();
      cards.forEach((card) => {
        filed.set(card, (card.dataset.categories || '').split('|').filter(Boolean));
      });

      /*
       * Filtering is one movement.
       *
       * The cards that no longer belong fade out where they stand, the ones
       * that stay travel to their new places, and the ones arriving fade in at
       * theirs — all at once, on the curve the cover morph and the hover states
       * already use. A card whose width changes carries that with it, so
       * growing to fill the row is part of getting there rather than something
       * that happens afterwards.
       *
       * Positions come from the browser's own layout, read either side of the
       * change, so this stays right at any column count, any viewport and any
       * ordering. Nothing is placed by hand and no card is ever moved to a
       * position it is not going to.
       */
      const MOVE_MS = 460;
      const LEAVE_MS = 200;
      const ENTER_MS = 320;
      const GLIDE = 'cubic-bezier(0.33, 0.02, 0.18, 1)';

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const canAnimate = typeof Element.prototype.animate === 'function';

      /** Whether a card belongs to the filter being applied. */
      function belongs(card, value) {
        return value === allLabel || filed.get(card).indexOf(value) !== -1;
      }

      function settle(shown) {
        if (counter) counter.textContent = String(shown);
        if (empty) empty.hidden = shown !== 0;

        // Reveals are handled by IntersectionObserver, which picks the newly
        // visible cards up on its own. The nav still needs to know the page got
        // shorter or taller.
        window.dispatchEvent(new Event('scroll'));
      }

      const boxes = (list) => new Map(list.map((card) => [card, card.getBoundingClientRect()]));

      /** Puts a card that was lifted out of the grid back the way it was found. */
      function release(card) {
        card.style.position = '';
        card.style.left = '';
        card.style.top = '';
        card.style.width = '';
        card.style.height = '';
        card.style.margin = '';
        card.style.pointerEvents = '';
      }

      /**
       * The rearrangement in the air, or null.
       *
       * A chip pressed while one is still running lands it first, so the next
       * measurement never reads a position from halfway through a move. It is
       * also what the timer holds: a backgrounded tab stops advancing
       * animations, and the promises that would have tidied up never settle.
       */
      let flight = null;

      function applyFilter(value, animate) {
        const shown = cards.filter((card) => belongs(card, value)).length;

        if (!animate || reduced || !canAnimate) {
          cards.forEach((card) => {
            card.hidden = !belongs(card, value);
          });
          settle(shown);
          return;
        }

        if (flight) flight.land();

        const onScreen = cards.filter((card) => !card.hidden);
        const staying = onScreen.filter((card) => belongs(card, value));
        const leaving = onScreen.filter((card) => !belongs(card, value));
        const entering = cards.filter((card) => card.hidden && belongs(card, value));

        if (!leaving.length && !entering.length) {
          settle(shown);
          return;
        }

        /* ---- Where everything is now ---------------------------------- */

        const gridBox = grid.getBoundingClientRect();
        const from = boxes(onScreen);
        const height = gridBox.height;

        // Held open at the height it has, so the page below does not jump when
        // the cards that are leaving come out of the flow a moment from now.
        grid.dataset.reflowing = '';
        grid.style.height = height + 'px';

        /* ---- Change what is in the grid -------------------------------- */

        // Lifted out where they stand, so the rest can close the gap at once
        // while these fade from the positions they already held.
        leaving.forEach((card) => {
          const box = from.get(card);
          card.style.position = 'absolute';
          card.style.left = box.left - gridBox.left + 'px';
          card.style.top = box.top - gridBox.top + 'px';
          card.style.width = box.width + 'px';
          card.style.height = box.height + 'px';
          card.style.margin = '0';
          card.style.pointerEvents = 'none';
        });

        entering.forEach((card) => {
          card.hidden = false;
        });

        /* ---- And where the browser has just put it --------------------- */

        // Measured with the pin off: a grid holding a height that disagrees
        // with its contents distributes the difference across its rows, and
        // every destination read while that is true is wrong in proportion.
        grid.style.height = '';
        const to = boxes(staying);
        const tall = grid.getBoundingClientRect().height;
        grid.style.height = height + 'px';

        /* ---- One movement ---------------------------------------------- */

        let landed = false;
        const running = [];

        const land = () => {
          if (landed) return;
          landed = true;
          window.clearTimeout(timer);
          if (flight && flight.land === land) flight = null;

          running.forEach((a) => a.cancel());
          cards.forEach((card) => {
            card.hidden = !belongs(card, value);
            release(card);
          });
          grid.style.height = '';
          delete grid.dataset.reflowing;
          settle(shown);
        };

        if (Math.abs(tall - height) > 0.5) {
          running.push(
            grid.animate([{ height: height + 'px' }, { height: tall + 'px' }], {
              duration: MOVE_MS,
              easing: GLIDE,
            })
          );
        }

        staying.forEach((card) => {
          const here = from.get(card);
          const there = to.get(card);
          const dx = here.left - there.left;
          const dy = here.top - there.top;
          const sized = Math.abs(here.width - there.width) > 0.5;
          if (!dx && !dy && !sized) return;

          const a = { transform: 'translate(' + dx + 'px, ' + dy + 'px)' };
          const b = { transform: 'none' };

          /*
           * An explicit width on a grid item only makes it narrower than the
           * track it is already in, so this never feeds back into the layout:
           * the track is the new one from the first frame and the card grows
           * into it.
           */
          if (sized) {
            a.width = here.width + 'px';
            b.width = there.width + 'px';
          }

          running.push(card.animate([a, b], { duration: MOVE_MS, easing: GLIDE }));
        });

        leaving.forEach((card) => {
          const gone = card.animate([{ opacity: 1 }, { opacity: 0 }], {
            duration: LEAVE_MS,
            easing: 'linear',
            fill: 'forwards',
          });
          running.push(gone);

          const finish = () => {
            // Once the whole thing has landed this has already been done, and
            // doing it again would hide a card the next filter has just asked
            // for — cancelling rejects the promise, so this runs on every
            // interruption too.
            if (landed) return;
            card.hidden = true;
            release(card);
            gone.cancel();
          };
          gone.finished.then(finish, finish);
        });

        entering.forEach((card) => {
          // One that has never been revealed is at opacity 0 under the
          // entrance's own rules and the observer is about to bring it in.
          // Fading it here would be two things doing the same job.
          if (card.hasAttribute('data-hidden')) return;

          running.push(
            card.animate([{ opacity: 0 }, { opacity: 1 }], {
              duration: ENTER_MS,
              easing: GLIDE,
              delay: MOVE_MS - ENTER_MS,
              fill: 'backwards',
            })
          );
        });

        /*
         * The net under the promises. An animation in a backgrounded tab does
         * not advance, so `finished` never settles, and the grid would be left
         * holding an inline height and a half-finished layout for as long as
         * the visitor stayed away.
         */
        const timer = window.setTimeout(land, MOVE_MS + 600);
        flight = { land: land };
        Promise.all(running.map((a) => a.finished)).then(land, land);

        // The count and the empty state belong to the filter rather than to the
        // animation, so they change on the press.
        settle(shown);
      }

      /** Presses a chip and filters the grid. */
      function select(value, writeUrl) {
        chips.forEach((chip) => {
          const active = chip.dataset.filter === value;
          chip.classList.toggle('chip--active', active);
          chip.setAttribute('aria-pressed', active ? 'true' : 'false');
        });

        applyFilter(value, writeUrl);

        if (!writeUrl) return;

        /*
         * The filter lives in the URL so that history carries it.
         *
         * Opening a project and coming back used to land on an unfiltered
         * grid: the selection was a variable in this closure, and the closure
         * went with the page. Putting it in the address means the browser
         * restores it for us on the way back, along with the scroll position
         * that was recorded against the same entry — and it makes a filtered
         * grid something the visitor can send to someone.
         *
         * replaceState, not push: a chip is a change of view, not a place. And
         * the existing state object is passed straight back through, because
         * the router keeps its scroll offsets in there and dropping them would
         * cost us the restore this is meant to protect.
         */
        const url = new URL(window.location.href);
        if (value === allLabel) url.searchParams.delete('filter');
        else url.searchParams.set('filter', value);
        history.replaceState(history.state, '', url);
      }

      chips.forEach((chip) => {
        chip.addEventListener('click', () => select(chip.dataset.filter, true));
      });

      // Restore whatever the address asks for, ignoring a filter that no
      // longer exists — a link kept from before the services were recut.
      const asked = new URLSearchParams(window.location.search).get('filter');
      const known = asked && Array.prototype.some.call(chips, (c) => c.dataset.filter === asked);
      select(known ? asked : allLabel, false);
    }

    /*
     * Called at once, not only on astro:page-load.
     *
     * The router re-runs this script during the swap, which is before the
     * scroll position is restored — and the grid has to be the right height by
     * then, or the restore lands against a full-length list and the visitor
     * arrives somewhere they have never been.
     */
    setupFilters();

    /*
     * The listener is a belt to that brace, for the fallback path where the
     * router replaces the document instead of swapping it. It is registered
     * once and not once per visit: this script runs again on every swap, and
     * a fresh `setupFilters` is a different function every time, so
     * addEventListener would stack them — each one holding the chips and cards
     * of a page that has already been thrown away.
     */
    if (!window.__mhWorkFilters) {
      window.__mhWorkFilters = true;
      document.addEventListener('astro:page-load', function () {
        setupFilters();
      });
    }
  })();
</script>

<style>
  .work-hero {
    padding-top: clamp(100px, min(17vh, 26vw), 196px);
    padding-bottom: clamp(38px, 5.5vh, 70px);
  }

  .work-hero__eyebrow {
    margin-bottom: 18px;
  }

  .work-hero__heading {
    /* Clips the rising text until it slides into place. The padding stops
       descenders being shaved off by the same clip. */
    overflow: hidden;
    /*
     * Room for the descenders inside the clip, cancelled again by the margin so
     * the heading occupies exactly the space it did before. A tight
     * line-height puts the line box above the bottom of the glyphs, and the
     * same overflow that hides the rising text was shaving them.
     */
    padding-bottom: 0.16em;
    margin-bottom: -0.1em;
    max-width: 16ch;
    font-size: clamp(36px, 6.2vw, 84px);
    line-height: 1.03;
    letter-spacing: -0.019em;
    font-weight: 600;
  }

  .work-hero__intro {
    /* Clips the rising text until it slides into place. The padding stops
       descenders being shaved off by the same clip. */
    overflow: hidden;
    /*
     * Room for the descenders inside the clip, cancelled again by the margin so
     * the heading occupies exactly the space it did before. A tight
     * line-height puts the line box above the bottom of the glyphs, and the
     * same overflow that hides the rising text was shaving them.
     */
    padding-bottom: 0.16em;
    margin-bottom: -0.1em;
    margin-top: 20px;
    max-width: 48ch;
  }

  .work-grid {
    padding-bottom: clamp(58px, min(12vh, 16vw), 130px);
  }

  .work-grid__filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    padding-bottom: clamp(24px, 3.4vh, 34px);
  }

  .chip {
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 14px;
    letter-spacing: -0.016em;
    padding: 0 18px;
    border: none;
    border-radius: var(--r-pill);
    background: var(--surface-chip);
    color: var(--ink);
    white-space: nowrap;
    transition:
      background 340ms var(--ease-out),
      color 340ms ease,
      transform 300ms var(--ease-out);
  }

  .chip:active {
    transform: scale(0.96);
  }

  .chip--active {
    background: var(--ink);
    /* Not #fff: the chip fills with the ink colour, which in dark mode is
       near-white — so a hardcoded white label was white-on-white and the
       selected filter read as blank. The page surface is the correct
       counterpart to ink in either theme. */
    color: var(--surface);
  }

  .work-grid__count {
    margin-left: auto;
    font-size: 14px;
    color: var(--ink-soft);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .work-grid__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: clamp(16px, 2vw, 26px);
    /* A card on its way out is taken out of the flow so the rest can close the
       gap at once, and is held where it stood. This is what it is held against. */
    position: relative;
  }

  /*
   * Only while a filter is being applied.
   *
   * The box is travelling between two heights and its contents are travelling
   * between two layouts, and for part of that the contents are the taller of
   * the two — going back to everything, the twelve cards are laid out before
   * the box has finished opening for them. Clipping for those few hundred
   * milliseconds keeps that inside the grid instead of over the page below it.
   */
  .work-grid__list[data-reflowing] {
    overflow: clip;
    /*
     * And the rows keep their own heights while it is.
     *
     * The height is pinned for the length of the rearrangement so the page
     * below never jumps, which leaves the grid with a definite height that
     * disagrees with its contents — and a grid resolves that by distributing
     * the difference across its rows. Every row then sits somewhere other than
     * where it will end up, so every destination measured during the
     * rearrangement is wrong in proportion: with twelve cards in a box still
     * the height of one, a card bound for 1664px was measured at 1028, which is
     * 894/2114 of the way there, exactly the ratio of the two heights.
     *
     * `start` takes the rows out of that negotiation. They are laid out from
     * the top at the size their content asks for, whatever the box is doing,
     * and the overflow above keeps the difference from painting over the page.
     */
    align-content: start;
  }

  .work-grid__empty {
    margin-top: 40px;
    font-size: 17px;
    color: var(--ink-muted);
  }
</style>
