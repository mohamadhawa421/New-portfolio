---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CharacterAside from '../../components/CharacterAside.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects, getServices, getWorkPage } from '../../lib/content';

const [work, projects, services] = await Promise.all([
  getWorkPage(),
  getProjects(),
  getServices(),
]);

/*
 * The chips are the service list, in the order the services are offered — so
 * the filters read the same way here as they do on the home page and in the
 * enquiry form, rather than in whatever order the projects happen to be in.
 *
 * A service with nothing behind it is left out. An empty filter is a dead end:
 * the visitor presses it, the grid empties, and the only thing they have learnt
 * is that the control was pointless. Anything a project claims that is not in
 * the service list still gets a chip, so a category can never become
 * unreachable by being mistyped in the CMS.
 */
const filled = new Set(projects.flatMap((project) => project.categories));

const categories = [
  work.allFilterLabel,
  ...services.map((service) => service.title).filter((title) => filled.has(title)),
  ...[...filled].filter((category) => !services.some((service) => service.title === category)),
];
---

<BaseLayout seo={work.seo}>
  <main id="main" data-shell="1">
    <section class="section section--light work-hero" data-lift data-tile="light">
      <div class="shell">
        <div class="eyebrow work-hero__eyebrow" data-reveal="0">{work.eyebrow}</div>
        <h1 class="work-hero__heading"><span data-rise="0">{work.heading}</span></h1>
        <p class="lead work-hero__intro"><span data-rise="1">{work.intro}</span></p>
      </div>
    </section>

    <section class="section section--light work-grid" data-lift data-tile="light">
      <div
        class="shell work-grid__filters"
        data-reveal="0"
        role="group"
        aria-label="Filter by the kind of work"
      >
        {
          categories.map((category, i) => (
            <button
              type="button"
              class="chip"
              class:list={[{ 'chip--active': i === 0 }]}
              data-filter={category}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              {category}
            </button>
          ))
        }
        {/* Pressing a chip changes nothing else on screen above the fold, so
            without this a screen reader gets no confirmation that the filter
            did anything. */}
        <span class="work-grid__count" aria-live="polite">
          <span data-count>{projects.length}</span>
          {' '}{work.countLabel}
        </span>
      </div>

      <div class="shell work-grid__list" data-work-grid data-all-label={work.allFilterLabel}>
        {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
      </div>

      <p class="shell work-grid__empty" data-empty hidden>
        Nothing in that category yet.
      </p>

      {/*
        At the foot of the grid, which is where the oldest projects are — he is
        standing next to the ones he is talking about. He waits to be scrolled
        to rather than for a fraction of the page, since on this page the
        position is the joke.
      */}
      <CharacterAside
        src="/character-hush.webp"
        alt="Mohamad, asking for quiet"
        width={560}
        height={640}
        lines={[
          "Shh — the older ones are placeholders. They don't know they're being replaced.",
          "The good ones are at the top. That isn't an accident.",
          'Number eleven still thinks it is getting a case study.',
          "I've been meaning to deal with this for about two years.",
          'Right. Back to work. Both of us.',
        ]}
      />
    </section>
  </main>
</BaseLayout>

<script is:inline>
  (function () {
    function setupFilters() {
      const grid = document.querySelector('[data-work-grid]');
      if (!grid || grid.dataset.filtersBound) return;
      grid.dataset.filtersBound = '1';

      const chips = document.querySelectorAll('[data-filter]');
      // An array, not the live NodeList: everything below filters and maps it.
      const cards = Array.prototype.slice.call(
        document.querySelectorAll('[data-work-grid] [data-categories]')
      );
      // Read from the DOM rather than interpolating CMS text into this script.
      const allLabel = grid.dataset.allLabel || 'All';
      const counter = document.querySelector('[data-count]');
      const empty = document.querySelector('[data-empty]');
      if (!chips.length || !cards.length) return;

      // A project can answer to several filters, so the card carries a list.
      // Split once here rather than on every chip press.
      const filed = new Map();
      cards.forEach((card) => {
        filed.set(card, (card.dataset.categories || '').split('|').filter(Boolean));
      });

      /* ---- The rearrangement ------------------------------------------ */

      /*
       * FLIP, with the moving cards taken out of flow for the length of it.
       *
       * First and Last are the two measurements; Invert and Play are one
       * Web Animations call per card. The part that is not in the textbook is
       * the absolute positioning: while cards are being moved they are laid
       * out against the grid rather than against each other, so a card that
       * changes width cannot push the row it is in around while the row is
       * still being animated. The grid's own height is animated over the same
       * stretch, which is what stops the page below jumping when a row goes.
       *
       * The Web Animations API rather than inline transforms and a transition:
       * the card already owns `transform` for its hover lift and owns the
       * transition on it. An animation composites over that and hands it back
       * untouched at the end, so nothing has to be turned off and on.
       *
       * Widths are animated rather than scaled. The track sizing is never
       * touched — `auto-fit` already collapses the empty tracks, so one
       * survivor is in a full-width track and two are in half-width ones — and
       * a card given an explicit width simply grows into the track it is
       * already in. A scale would have stretched the type and the covers.
       */
      const MOVE_MS = 460;
      const LEAVE_MS = 190;
      const ENTER_DELAY = 130;
      const EASE = 'cubic-bezier(0.33, 0.02, 0.18, 1)';

      /** Bumped by every run, so a callback can tell if it is still wanted. */
      let run = 0;
      /** Lands the run in flight, or null. See settle(). */
      let finish = null;

      const still = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      function paint(shown) {
        if (counter) counter.textContent = String(shown);
        if (empty) empty.hidden = shown !== 0;
        // Reveals are handled by IntersectionObserver, which picks the newly
        // visible cards up on its own. The nav still needs to know the page got
        // shorter or taller.
        window.dispatchEvent(new Event('scroll'));
      }

      /** Takes every mark a run leaves off the DOM. Safe to call twice. */
      function strip() {
        grid.style.position = '';
        grid.style.height = '';
        cards.forEach((card) => {
          card.style.position = '';
          card.style.left = '';
          card.style.top = '';
          card.style.width = '';
          card.style.margin = '';
        });
      }

      /*
       * Ends whatever is running, on the state it was heading for.
       *
       * Not a cancel. A run that is abandoned half way has cards out of flow
       * and a grid pinned to a height, and the only safe place to leave that is
       * the arrangement it was going to. Pressing a second chip mid-flight
       * therefore starts from something settled rather than from a guess — this
       * is the whole of what used to empty the grid.
       */
      function settle() {
        if (finish) finish();
      }

      window.__mhWorkSettle = settle;

      function applyFilter(value, animate) {
        const wanted = new Map();
        let shown = 0;
        cards.forEach((card) => {
          const match = value === allLabel || filed.get(card).indexOf(value) !== -1;
          wanted.set(card, match);
          if (match) shown += 1;
        });

        settle();

        if (!animate || still() || typeof grid.animate !== 'function') {
          cards.forEach((card) => {
            card.hidden = !wanted.get(card);
          });
          paint(shown);
          return;
        }

        const token = ++run;
        const playing = [];

        const before = cards.filter((card) => !card.hidden);
        const leaving = before.filter((card) => !wanted.get(card));
        const staying = before.filter((card) => wanted.get(card));
        const entering = cards.filter((card) => card.hidden && wanted.get(card));

        if (!leaving.length && !entering.length) {
          paint(shown);
          return;
        }

        finish = function () {
          finish = null;
          run += 1;
          playing.forEach((animation) => {
            try {
              animation.cancel();
            } catch (error) {
              /* Already gone with the element. */
            }
          });
          playing.length = 0;
          cards.forEach((card) => {
            card.hidden = !wanted.get(card);
          });
          strip();
          paint(shown);
        };

        /* First. */
        const from = new Map();
        before.forEach((card) => from.set(card, card.getBoundingClientRect()));
        const heightBefore = grid.offsetHeight;

        /*
         * The ones that go, fading where they stand.
         *
         * Nothing moves during this — the layout is still the old one — so the
         * grid empties in place before anything rearranges, which is the order
         * it reads in: these are leaving, and then the rest close the gap.
         */
        leaving.forEach((card) => {
          playing.push(
            card.animate([{ opacity: 1 }, { opacity: 0 }], {
              duration: LEAVE_MS,
              easing: 'ease-out',
              fill: 'forwards',
            })
          );
        });

        window.setTimeout(function () {
          if (token !== run) return;

          /* Last. */
          leaving.forEach((card) => {
            card.hidden = true;
          });
          entering.forEach((card) => {
            card.hidden = false;
          });
          // Before measuring: a card that has never been on screen is revealed
          // by the observer, and the reveal moves it.
          paint(shown);

          const movers = staying.concat(entering);
          const to = new Map();
          movers.forEach((card) => to.set(card, card.getBoundingClientRect()));
          const heightAfter = grid.offsetHeight;

          const box = grid.getBoundingClientRect();
          const style = window.getComputedStyle(grid);
          // The containing block is the padding box, so the origin is the grid's
          // own corner plus whatever border and padding it carries.
          const originX = box.left + parseFloat(style.borderLeftWidth) + parseFloat(style.paddingLeft);
          const originY = box.top + parseFloat(style.borderTopWidth) + parseFloat(style.paddingTop);

          if (style.position === 'static') grid.style.position = 'relative';
          grid.style.height = heightBefore + 'px';

          movers.forEach((card) => {
            const end = to.get(card);
            card.style.position = 'absolute';
            card.style.margin = '0';
            card.style.left = end.left - originX + 'px';
            card.style.top = end.top - originY + 'px';
            card.style.width = end.width + 'px';
          });

          /* Invert, and Play. */
          movers.forEach((card) => {
            const end = to.get(card);
            const start = from.get(card);

            if (start) {
              playing.push(
                card.animate(
                  [
                    {
                      transform:
                        'translate(' + (start.left - end.left) + 'px, ' + (start.top - end.top) + 'px)',
                      width: start.width + 'px',
                    },
                    { transform: 'translate(0px, 0px)', width: end.width + 'px' },
                  ],
                  { duration: MOVE_MS, easing: EASE }
                )
              );
              return;
            }

            /*
             * A card arriving. It is already where it belongs, so it only has
             * to appear — a beat after the others have set off, so it lands in
             * a gap rather than on top of a card still moving out of one.
             *
             * `backwards` holds the first frame through the delay. Setting the
             * opacity inline instead would have to be cleared afterwards, and
             * the frame between the animation ending and the clearing is a
             * flash of nothing.
             */
            playing.push(
              card.animate(
                [
                  { opacity: 0, transform: 'scale(0.965)' },
                  { opacity: 1, transform: 'scale(1)' },
                ],
                { duration: MOVE_MS, delay: ENTER_DELAY, easing: EASE, fill: 'backwards' }
              )
            );
          });

          if (heightBefore !== heightAfter) {
            playing.push(
              grid.animate(
                [{ height: heightBefore + 'px' }, { height: heightAfter + 'px' }],
                { duration: MOVE_MS, easing: EASE }
              )
            );
          } else {
            grid.style.height = heightAfter + 'px';
          }

          /*
           * Landed on a timer rather than on the animations' own promises.
           *
           * Cancelling an animation rejects `finished`, and a rejection that
           * arrives after the next run has already decided what is visible is
           * how the grid came to be emptied by a chip press. A timer that
           * checks the token cannot arrive late for anything.
           */
          window.setTimeout(function () {
            if (token === run && finish) finish();
          }, MOVE_MS + ENTER_DELAY + 80);
        }, LEAVE_MS);
      }

      /** Presses a chip and filters the grid. */
      function select(value, writeUrl) {
        chips.forEach((chip) => {
          const active = chip.dataset.filter === value;
          chip.classList.toggle('chip--active', active);
          chip.setAttribute('aria-pressed', active ? 'true' : 'false');
        });

        applyFilter(value, writeUrl);

        if (!writeUrl) return;

        /*
         * The filter lives in the URL so that history carries it.
         *
         * Opening a project and coming back used to land on an unfiltered
         * grid: the selection was a variable in this closure, and the closure
         * went with the page. Putting it in the address means the browser
         * restores it for us on the way back, along with the scroll position
         * that was recorded against the same entry — and it makes a filtered
         * grid something the visitor can send to someone.
         *
         * replaceState, not push: a chip is a change of view, not a place. And
         * the existing state object is passed straight back through, because
         * the router keeps its scroll offsets in there and dropping them would
         * cost us the restore this is meant to protect.
         */
        const url = new URL(window.location.href);
        if (value === allLabel) url.searchParams.delete('filter');
        else url.searchParams.set('filter', value);
        history.replaceState(history.state, '', url);
      }

      chips.forEach((chip) => {
        chip.addEventListener('click', () => select(chip.dataset.filter, true));
      });

      // Restore whatever the address asks for, ignoring a filter that no
      // longer exists — a link kept from before the services were recut.
      const asked = new URLSearchParams(window.location.search).get('filter');
      const known = asked && Array.prototype.some.call(chips, (c) => c.dataset.filter === asked);
      select(known ? asked : allLabel, false);
    }

    /*
     * Called at once, not only on astro:page-load.
     *
     * The router re-runs this script during the swap, which is before the
     * scroll position is restored — and the grid has to be the right height by
     * then, or the restore lands against a full-length list and the visitor
     * arrives somewhere they have never been.
     */
    setupFilters();

    /*
     * The listener is a belt to that brace, for the fallback path where the
     * router replaces the document instead of swapping it. It is registered
     * once and not once per visit: this script runs again on every swap, and
     * a fresh `setupFilters` is a different function every time, so
     * addEventListener would stack them — each one holding the chips and cards
     * of a page that has already been thrown away.
     */
    if (!window.__mhWorkFilters) {
      window.__mhWorkFilters = true;
      document.addEventListener('astro:page-load', function () {
        setupFilters();
      });

      /*
       * A card is out of flow while it is being moved, and the case study
       * morphs out of the card. Opening a project mid-rearrangement would hand
       * the transition an absolutely positioned element halfway to somewhere.
       *
       * Read off `window` rather than captured: this script runs again on every
       * swap, so the settle held in a closure here would be the one belonging
       * to a page that has already been thrown away.
       */
      document.addEventListener('astro:before-preparation', function () {
        if (typeof window.__mhWorkSettle === 'function') window.__mhWorkSettle();
      });
    }
  })();
</script>

<style>
  .work-hero {
    padding-top: clamp(100px, min(17vh, 26vw), 196px);
    padding-bottom: clamp(38px, 5.5vh, 70px);
  }

  .work-hero__eyebrow {
    margin-bottom: 18px;
  }

  .work-hero__heading {
    /* Clips the rising text until it slides into place. The padding stops
       descenders being shaved off by the same clip. */
    overflow: hidden;
    /*
     * Room for the descenders inside the clip, cancelled again by the margin so
     * the heading occupies exactly the space it did before. A tight
     * line-height puts the line box above the bottom of the glyphs, and the
     * same overflow that hides the rising text was shaving them.
     */
    padding-bottom: 0.16em;
    margin-bottom: -0.1em;
    max-width: 16ch;
    font-size: clamp(36px, 6.2vw, 84px);
    line-height: 1.03;
    letter-spacing: -0.019em;
    font-weight: 600;
  }

  .work-hero__intro {
    /* Clips the rising text until it slides into place. The padding stops
       descenders being shaved off by the same clip. */
    overflow: hidden;
    /*
     * Room for the descenders inside the clip, cancelled again by the margin so
     * the heading occupies exactly the space it did before. A tight
     * line-height puts the line box above the bottom of the glyphs, and the
     * same overflow that hides the rising text was shaving them.
     */
    padding-bottom: 0.16em;
    margin-bottom: -0.1em;
    margin-top: 20px;
    max-width: 48ch;
  }

  .work-grid {
    padding-bottom: clamp(58px, min(12vh, 16vw), 130px);
  }

  .work-grid__filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    padding-bottom: clamp(24px, 3.4vh, 34px);
  }

  .chip {
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 14px;
    letter-spacing: -0.016em;
    padding: 0 18px;
    border: none;
    border-radius: var(--r-pill);
    background: var(--surface-chip);
    color: var(--ink);
    white-space: nowrap;
    transition:
      background 340ms var(--ease-out),
      color 340ms ease,
      transform 300ms var(--ease-out);
  }

  .chip:active {
    transform: scale(0.96);
  }

  .chip--active {
    background: var(--ink);
    /* Not #fff: the chip fills with the ink colour, which in dark mode is
       near-white — so a hardcoded white label was white-on-white and the
       selected filter read as blank. The page surface is the correct
       counterpart to ink in either theme. */
    color: var(--surface);
  }

  .work-grid__count {
    margin-left: auto;
    font-size: 14px;
    color: var(--ink-soft);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .work-grid__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: clamp(16px, 2vw, 26px);
  }

  .work-grid__empty {
    margin-top: 40px;
    font-size: 17px;
    color: var(--ink-muted);
  }
</style>
