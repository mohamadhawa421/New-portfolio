---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects, getWorkPage } from '../../lib/content';

const [work, projects] = await Promise.all([getWorkPage(), getProjects()]);

const categories = [
  work.allFilterLabel,
  ...Array.from(new Set(projects.map((project) => project.category).filter(Boolean))),
];
---

<BaseLayout seo={work.seo}>
  <main id="main" data-shell="1">
    <section class="section section--light work-hero" data-lift data-tile="light">
      <div class="shell">
        <div class="eyebrow work-hero__eyebrow" data-reveal="0">{work.eyebrow}</div>
        <h1 class="work-hero__heading"><span data-rise="0">{work.heading}</span></h1>
        <p class="lead work-hero__intro"><span data-rise="1">{work.intro}</span></p>
      </div>
    </section>

    <section class="section section--light work-grid" data-lift data-tile="light">
      <div class="shell work-grid__filters" data-reveal="0">
        {
          categories.map((category, i) => (
            <button
              type="button"
              class="chip"
              class:list={[{ 'chip--active': i === 0 }]}
              data-filter={category}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              {category}
            </button>
          ))
        }
        <span class="work-grid__count">
          <span data-count>{projects.length}</span>
          {' '}{work.countLabel}
        </span>
      </div>

      <div class="shell work-grid__list" data-grid data-all-label={work.allFilterLabel}>
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>

      <p class="shell work-grid__empty" data-empty hidden>
        Nothing in that category yet.
      </p>
    </section>
  </main>
</BaseLayout>

<script is:inline>
  (function () {
    function setupFilters() {
      const grid = document.querySelector('[data-grid]');
      const chips = document.querySelectorAll('[data-filter]');
      const cards = document.querySelectorAll('[data-grid] [data-category]');
      // Read from the DOM rather than interpolating CMS text into this script.
      const allLabel = grid ? grid.dataset.allLabel : 'All';
      const counter = document.querySelector('[data-count]');
      const empty = document.querySelector('[data-empty]');
      if (!chips.length || !cards.length) return;

      function applyFilter(value) {
        let shown = 0;

        cards.forEach((card) => {
          const match = value === allLabel || card.dataset.category === value;
          card.hidden = !match;
          if (match) shown += 1;
        });

        if (counter) counter.textContent = String(shown);
        if (empty) empty.hidden = shown !== 0;

        // Reveals are handled by IntersectionObserver, which picks the newly
        // visible cards up on its own. The nav still needs to know the page got
        // shorter or taller.
        window.dispatchEvent(new Event('scroll'));
      }

      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          chips.forEach((other) => {
            const active = other === chip;
            other.classList.toggle('chip--active', active);
            other.setAttribute('aria-pressed', active ? 'true' : 'false');
          });
          applyFilter(chip.dataset.filter);
        });
      });
    }

    document.addEventListener('astro:page-load', setupFilters);
  })();
</script>

<style>
  .work-hero {
    padding-top: clamp(132px, 17vh, 196px);
    padding-bottom: clamp(38px, 5.5vh, 70px);
  }

  .work-hero__eyebrow {
    margin-bottom: 18px;
  }

  .work-hero__heading {
    /* Clips the rising text until it slides into place. The padding stops
       descenders being shaved off by the same clip. */
    overflow: hidden;
    padding-bottom: 0.06em;
    max-width: 16ch;
    font-size: clamp(36px, 6.2vw, 84px);
    line-height: 1.03;
    letter-spacing: -0.019em;
    font-weight: 600;
  }

  .work-hero__intro {
    /* Clips the rising text until it slides into place. The padding stops
       descenders being shaved off by the same clip. */
    overflow: hidden;
    padding-bottom: 0.06em;
    margin-top: 20px;
    max-width: 48ch;
  }

  .work-grid {
    padding-bottom: clamp(80px, 12vh, 130px);
  }

  .work-grid__filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    padding-bottom: clamp(24px, 3.4vh, 34px);
  }

  .chip {
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 14px;
    letter-spacing: -0.016em;
    padding: 0 18px;
    border: none;
    border-radius: var(--r-pill);
    background: var(--surface-chip);
    color: var(--ink);
    white-space: nowrap;
    transition:
      background 340ms var(--ease-out),
      color 340ms ease,
      transform 300ms var(--ease-out);
  }

  .chip:active {
    transform: scale(0.96);
  }

  .chip--active {
    background: var(--ink);
    /* Not #fff: the chip fills with the ink colour, which in dark mode is
       near-white — so a hardcoded white label was white-on-white and the
       selected filter read as blank. The page surface is the correct
       counterpart to ink in either theme. */
    color: var(--surface);
  }

  .work-grid__count {
    margin-left: auto;
    font-size: 14px;
    color: var(--ink-soft);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .work-grid__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: clamp(16px, 2vw, 26px);
  }

  .work-grid__empty {
    margin-top: 40px;
    font-size: 17px;
    color: var(--ink-muted);
  }
</style>
