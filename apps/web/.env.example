# Canonical origin, used for <link rel="canonical"> and sitemap.xml.
# Everything else the site needs is baked into src/data/content.json.
SITE_URL=https://mohamadhawa.vercel.app

# ---- Portfolio Studio (admin.mohamadhawa.com only) -------------------------
# Set these on the *admin* Vercel project, never on the public one. The public
# build does not read them and must not need them.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=<publishable / anon key — never the service_role key>
# STUDIO_EMAIL=<the Auth email of the owner account>
