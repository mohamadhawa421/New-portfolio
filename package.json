{
  "name": "mohamad-hawa-portfolio",
  "private": true,
  "version": "1.0.0",
  "description": "Showcase site for Mohamad Hawa — Astro front end, Strapi CMS.",
  "workspaces": [
    "apps/web",
    "apps/cms"
  ],
  "engines": {
    "node": ">=20.0.0 <=22.x.x"
  },
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:lan": "npm run dev:lan --workspace=apps/web",
    "dev:cms": "npm run dev --workspace=apps/cms",
    "export": "npm run export --workspace=apps/cms",
    "refresh": "npm run export && npm run dev:web",
    "build:site": "npm run export --workspace=apps/cms && npm run build --workspace=apps/web",
    "build": "npm run build:site",
    "build:web": "npm run build --workspace=apps/web",
    "build:cms": "npm run build --workspace=apps/cms",
    "seed": "npm run seed --workspace=apps/cms",
    "preview": "npm run preview --workspace=apps/web",
    "deploy": "node scripts/publish.js",
    "edit": "npm run dev --workspace=apps/cms",
    "prune-media": "npm run prune-media --workspace=apps/cms"
  }
}
